<Window x:Class="NoteApp.Desktop.Training.TrainingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sætningerne" Width="1000" Height="720" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource Baggrund}">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- TOPPEN SCROLLER IKKE MED.
         Lukkeknappen skal kunne nås, uanset hvor langt nede man er — en liste
         på hundrede sætninger, hvor man skal scrolle tilbage til toppen for at
         komme ud, er en fælde. Esc lukker også. -->
    <Border Grid.Row="0" Background="#FF1D2530" BorderBrush="{StaticResource PanelKant}"
            BorderThickness="0,0,0,1" Padding="24,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock x:Name="Overskrift" FontSize="17" FontWeight="SemiBold" />
          <TextBlock x:Name="Underskrift" FontSize="12.5" Margin="0,4,0,0"
                     Foreground="{StaticResource TekstMeget}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                    Margin="0,0,20,0">
          <StackPanel Margin="0,0,22,0">
            <TextBlock x:Name="TalForkerte" FontSize="17" FontWeight="SemiBold" FontFamily="Consolas"
                       HorizontalAlignment="Center" Foreground="{StaticResource Advarsel}" />
            <TextBlock Text="hørt forkert" Style="{StaticResource Underskrift}" HorizontalAlignment="Center" />
          </StackPanel>
          <StackPanel>
            <TextBlock x:Name="TalProcent" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="rigtige" Style="{StaticResource Underskrift}" HorizontalAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <Button Grid.Column="2" Content="✕" Click="Luk_Click" VerticalAlignment="Center"
                Width="38" Height="38" FontSize="15" ToolTip="Luk (Esc)" />
      </Grid>
    </Border>

    <Border Grid.Row="1" BorderBrush="{StaticResource PanelKant}" BorderThickness="0,0,0,1"
            Padding="24,10">
      <Grid>
        <TextBlock x:Name="ListeTekst" VerticalAlignment="Center" FontSize="12.5"
                   TextWrapping="Wrap" Margin="0,0,190,0" Foreground="{StaticResource TekstMeget}" />
        <CheckBox x:Name="KunFejl" Content="Vis kun dem med fejl" IsChecked="True"
                  HorizontalAlignment="Right" VerticalAlignment="Center"
                  Click="KunFejl_Klik" FontSize="12.5" />
      </Grid>
    </Border>

    <ItemsControl x:Name="Liste" Grid.Row="2" Padding="24,14,24,10">
      <ItemsControl.Template>
        <ControlTemplate TargetType="ItemsControl">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{TemplateBinding Padding}">
            <ItemsPresenter />
          </ScrollViewer>
        </ControlTemplate>
      </ItemsControl.Template>
    </ItemsControl>

    <Border Grid.Row="3" Background="#FF1D2530" BorderBrush="{StaticResource PanelKant}"
            BorderThickness="0,1,0,0" Padding="24,12">
      <Grid>
        <TextBlock x:Name="Bund" VerticalAlignment="Center" FontSize="12"
                   TextWrapping="Wrap" Margin="0,0,140,0" Foreground="{StaticResource TekstMeget}" />
        <Button Content="Luk" Click="Luk_Click" HorizontalAlignment="Right" Padding="26,9"
                IsCancel="True" MinWidth="110" />
      </Grid>
    </Border>
  </Grid>
</Window>
