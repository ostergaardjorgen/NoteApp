<UserControl x:Class="NoteApp.Desktop.Training.TrainingDetail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- HELE STRIBEN ER KNAPPEN.
       Sætningerne åbnes i et vindue frem for at ligge her: hundrede sætninger
       under boksene skubbede alt andet af skærmen, så man ikke kunne se de tre
       tekster, mens man arbejdede med den ene.

       Der er BÅDE en synlig knap og et klik på hele striben. Knappen siger,
       hvad der sker — en flade, der bare reagerer, når man rammer den, er ikke
       til at gætte for en, der ikke bruger computer til daglig. -->
  <Button Click="Aabn_Click" Padding="0" BorderThickness="0" Background="Transparent"
          Cursor="Hand" HorizontalContentAlignment="Stretch" VerticalAlignment="Top">
    <Button.Template>
      <ControlTemplate TargetType="Button">
        <Border x:Name="kant" Background="#FF1D2530" CornerRadius="10"
                BorderBrush="{StaticResource PanelKant}" BorderThickness="1" Padding="20,15">
          <ContentPresenter />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="kant" Property="Background" Value="#FF232C3A" />
            <Setter TargetName="kant" Property="BorderBrush" Value="{StaticResource Accent}" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Button.Template>

    <StackPanel>
      <Grid>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="StatOverskrift" FontSize="14.5" FontWeight="SemiBold"
                     Foreground="{StaticResource Tekst}" />
          <TextBlock x:Name="StatUnder" FontSize="12" Margin="0,3,0,0"
                     Foreground="{StaticResource TekstMeget}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <StackPanel Margin="0,0,24,0">
            <TextBlock x:Name="TalOrd" FontSize="18" FontWeight="SemiBold" FontFamily="Consolas"
                       HorizontalAlignment="Center" Foreground="{StaticResource Tekst}" />
            <TextBlock Text="ord i alt" Style="{StaticResource Underskrift}" HorizontalAlignment="Center" />
          </StackPanel>
          <StackPanel Margin="0,0,24,0">
            <TextBlock x:Name="TalForkerte" FontSize="18" FontWeight="SemiBold" FontFamily="Consolas"
                       HorizontalAlignment="Center" Foreground="{StaticResource Advarsel}" />
            <TextBlock Text="hørt forkert" Style="{StaticResource Underskrift}" HorizontalAlignment="Center" />
          </StackPanel>
          <StackPanel>
            <TextBlock x:Name="TalProcent" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="rigtige" Style="{StaticResource Underskrift}" HorizontalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- Skalaen ender ved loftet, ikke ved hundrede. En skala til hundrede
           ville love noget, ingen kan levere — heller ikke to mennesker, der
           skriver den samme optagelse ned. -->
      <Grid Margin="0,13,0,0" Height="9">
        <Border CornerRadius="5" Background="#FF2A303A" />
        <Grid HorizontalAlignment="Stretch">
          <Border x:Name="Bjaelke" HorizontalAlignment="Left" CornerRadius="5" Width="0" />
        </Grid>
      </Grid>

      <Grid Margin="0,5,0,0">
        <TextBlock Text="0 %" FontSize="10.5" HorizontalAlignment="Left"
                   Foreground="{StaticResource TekstMeget}" />
        <TextBlock x:Name="LoftTekst" FontSize="10.5" HorizontalAlignment="Right"
                   Foreground="{StaticResource TekstMeget}" />
      </Grid>

      <TextBlock x:Name="StatRaad" FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap"
                 LineHeight="20" Foreground="{StaticResource TekstSvag}" />

      <Grid Margin="0,14,0,0">
        <TextBlock x:Name="StatGenlaest" FontSize="12" TextWrapping="Wrap" LineHeight="19"
                   VerticalAlignment="Center" Margin="0,0,220,0"
                   Foreground="{StaticResource TekstMeget}" />

        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                Background="{StaticResource Accent}" CornerRadius="7" Padding="18,10">
          <TextBlock x:Name="AabnTekst" FontSize="13.5" FontWeight="SemiBold"
                     Foreground="#FF0B1220" Text="Se sætningerne og ret dem  →" />
        </Border>
      </Grid>
    </StackPanel>
  </Button>
</UserControl>
