<Window x:Class="NoteApp.Desktop.Training.ReadAgainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Læs sætningen op igen" Width="720" SizeToContent="Height" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource Baggrund}">

  <StackPanel Margin="28">
    <TextBlock x:Name="Overskrift" FontSize="18" FontWeight="SemiBold" />
    <TextBlock Style="{StaticResource Underskrift}" Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="20"
               Text="Læs sætningen op i dit normale tempo — ikke tydeligere, end du ville sige den på et møde. Det er netop dét, der skal måles." />

    <!-- SÆTNINGEN. Den er hele grunden til, at vinduet findes, og den skal
         kunne læses fra normal skærmafstand uden at man lener sig frem. -->
    <Border Background="#FF1D2530" BorderBrush="{StaticResource Accent}" BorderThickness="1"
            CornerRadius="10" Padding="22,18" Margin="0,16,0,0">
      <StackPanel>
        <TextBlock Text="LÆS DETTE HØJT" FontSize="11" FontWeight="SemiBold"
                   Foreground="{StaticResource Accent}" />
        <TextBlock x:Name="Saetning" FontSize="19" Margin="0,10,0,0" TextWrapping="Wrap"
                   LineHeight="30" Foreground="{StaticResource Tekst}" />
      </StackPanel>
    </Border>

    <!-- Optagelsen -->
    <Border Background="#FF181B22" BorderBrush="{StaticResource PanelKant}" BorderThickness="1"
            CornerRadius="10" Padding="20,16" Margin="0,16,0,0">
      <StackPanel>
        <Grid>
          <Button x:Name="OptagKnap" Click="Optag_Click" HorizontalAlignment="Left"
                  Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand">
            <Border x:Name="OptagFlade" CornerRadius="8" Background="{StaticResource Optager}" Padding="22,11">
              <TextBlock x:Name="OptagTekst" Text="● Optag" FontSize="14.5" FontWeight="SemiBold"
                         Foreground="#FFFFFFFF" />
            </Border>
          </Button>

          <TextBlock x:Name="Ur" HorizontalAlignment="Right" VerticalAlignment="Center"
                     FontSize="20" FontFamily="Consolas" Text="0,0 sek" />
        </Grid>

        <Border Height="8" CornerRadius="4" Background="#FF2A303A" Margin="0,14,0,0">
          <Grid HorizontalAlignment="Stretch">
            <Border x:Name="Niveau" HorizontalAlignment="Left" CornerRadius="4" Width="0"
                    Background="{StaticResource Godkendt}" />
          </Grid>
        </Border>

        <!-- Mikrofonen står HER, hvor der optages. Ellers taler man ind i en
             anden enhed end den, man tror, og opdager det, når klippet er tavst. -->
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="Mikrofon" VerticalAlignment="Center" Margin="0,0,12,0"
                     FontSize="12" Foreground="{StaticResource TekstMeget}" />

          <ComboBox x:Name="Mikrofoner" Grid.Column="1" SelectionChanged="Mikrofon_Valgt">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding FriendlyName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>

        <TextBlock x:Name="OptagStatus" FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap"
                   LineHeight="19" Foreground="{StaticResource TekstMeget}"
                   Text="Tryk «Optag», læs sætningen op, og tryk «Gem». Appen lytter ikke før du trykker." />
      </StackPanel>
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="Annullér" Click="Annuller_Click" Padding="18,9" Margin="0,0,10,0" IsCancel="True" />
      <Button x:Name="GemKnap" Content="Gem" Click="Gem_Click" Padding="26,9" IsDefault="True"
              IsEnabled="False" Background="{StaticResource Accent}" Foreground="#FF0B1220"
              BorderThickness="0" FontWeight="SemiBold" />
    </StackPanel>
  </StackPanel>
</Window>
