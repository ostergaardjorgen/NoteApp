<UserControl x:Class="NoteApp.Desktop.Engine.EngineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Baggrund}">

  <!-- ======================== HVORFOR SKÆRMEN ER TOM FOR VALG ============
       Her lå to faner og en liste med seks Whisper-modeller og et katalog
       af lokale sprogmodeller, man kunne hente og skifte imellem.

       Det er væk 18-08-2026, og ikke for at gemme noget:

       · Sprogmodellen. Målt på et rigtigt møde tabte den lokale model 72 %
         af navnene og brugte 59 minutter. Mistral Medium 3.5 i Frankrig
         tabte 23 % og brugte 25 sekunder, for 21 øre. Se doc/maaling-sky.md.
         Et valg mellem de to er ikke et valg — det er en fælde.

       · Whisper-modellerne. De små er hurtigere og mærkbart dårligere på
         dansk, og «small.en» kan slet ikke dansk: den giver volapyk frem for
         en fejl. Et valg, hvor alle alternativer er ringere, hjælper ingen.

       Tilbage står, hvad der ER: to lag, hver med én model, og deres
       tilstand. Vil man undersøge Whisper på egen hånd, står vejen i
       doc/whisper.md. -->

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="AI-modeller" Style="{StaticResource Overskrift}" />
      <TextBlock Style="{StaticResource Underskrift}" TextWrapping="Wrap" MaxWidth="900"
                 HorizontalAlignment="Left"
                 Text="Fire modeller gør hver sit. Tre af dem kører her på maskinen; kun dokumenter laves i Europa. Alt er valgt på forhånd — der er ikke noget at stille ind. Under «Compliance» står hver komponent for sig med sin egen licens." />
    </StackPanel>

    <!-- ===================== ÉN FANE PR. MODEL =====================

         Her lå to store paneler under hinanden i en rulle. Da der kom to
         modeller mere til — talergenkendelsen og den lokale opsummering —
         blev siden længere, end en skærm er høj, og så kunne man ikke se,
         hvad appen kører på uden at rulle.

         DE LOKALE STÅR FØRST. Rækkefølgen på en skærm ER en anbefaling,
         uanset hvad teksten ved siden af siger, og appens præmis er, at data
         bliver på maskinen. Skyen er den sidste fane, fordi den er den
         bevidste undtagelse. -->
    <TabControl Grid.Row="1" Style="{StaticResource Fanerude}"
                Background="Transparent" BorderThickness="0">

      <TabItem Header="Lyd til tekst" Style="{StaticResource Fane}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

        <!-- ===================== 1 · Whisper ========================== -->
        <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="20" Margin="0,0,0,14"
                BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="1 · LYD TIL TEKST — HER PÅ MASKINEN" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource Accent}" />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <!-- TO KOMPONENTER, SYNLIGT ADSKILT.
                   Laget er eet - man vaelger ikke mellem dem - men det
                   BESTAAR af to ting med hver sin rettighedshaver: et
                   program og en modelfil. Stod de som een linje, kunne man
                   ikke se, hvorfor Compliance opregner tre navne, naar der
                   staar to paneler her. -->
              <StackPanel Grid.Column="0" Margin="0,0,16,0">

                <Border Background="#FF181B22" BorderBrush="{StaticResource PanelKant}"
                        BorderThickness="1" CornerRadius="8" Padding="14,11">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="72" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="MOTOR" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TekstMeget}" Margin="0,3,0,0" />
                    <StackPanel Grid.Column="1">
                      <TextBlock x:Name="LydMotor" FontSize="14.5" FontWeight="SemiBold" />
                      <TextBlock x:Name="LydMotorLinje" FontSize="12" Margin="0,3,0,0"
                                 TextWrapping="Wrap" Foreground="{StaticResource TekstMeget}" />
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Background="#FF181B22" BorderBrush="{StaticResource PanelKant}"
                        BorderThickness="1" CornerRadius="8" Padding="14,11" Margin="0,8,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="72" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="MODEL" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TekstMeget}" Margin="0,3,0,0" />
                    <StackPanel Grid.Column="1">
                      <TextBlock x:Name="LydModel" FontSize="14.5" FontWeight="SemiBold" />
                      <TextBlock x:Name="LydResume" FontSize="12.5" LineHeight="20" Margin="0,5,0,0"
                                 TextWrapping="Wrap" Foreground="{StaticResource TekstSvag}" />

                      <!-- Modellen faar ikke nye udgaver. Det skal staa VED
                           modellen, ikke i en note et andet sted: knappen
                           "Hent igen" ved siden af "Opdatér motoren" laeses
                           ellers, som om der ogsaa kommer noget nyere ud af
                           den. -->
                      <TextBlock x:Name="ModelNote" FontSize="11.5" LineHeight="18" Margin="0,7,0,0"
                                 TextWrapping="Wrap" Foreground="{StaticResource TekstMeget}" />
                    </StackPanel>
                  </Grid>
                </Border>

                <TextBlock x:Name="LydStatus" FontSize="11.5" Margin="2,10,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource Accent}" />
              </StackPanel>

              <StackPanel Grid.Column="1" VerticalAlignment="Top" MinWidth="150">
                <!-- Samme raekkefoelge som kasserne til venstre: motoren
                     oeverst, modellen under. To knapper til to komponenter,
                     der hentes og opdateres hver for sig. -->
                <Button x:Name="MotorKnap" Click="Motor_Klik"
                        HorizontalAlignment="Stretch" Padding="16,8" />
                <Button x:Name="LydKnap" Click="Lyd_Klik" HorizontalAlignment="Stretch"
                        Padding="16,8" Margin="0,8,0,0" />
              </StackPanel>
            </Grid>

            <!-- Det tekniske står i en foldbar. Man slår det op den ene gang,
                 noget driller — det skal ikke fylde skærmen hver dag. -->
            <Expander Header="Det tekniske" Margin="0,14,0,0" FontSize="12"
                      Foreground="{StaticResource TekstMeget}">
              <Grid Margin="0,10,0,0" MaxWidth="520" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Motor" Margin="0,0,24,0"
                           Foreground="{StaticResource TekstMeget}" FontSize="12.5" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="MotorNavn" HorizontalAlignment="Right" FontSize="12.5" />

                <TextBlock Grid.Row="1" Grid.Column="0" x:Name="AlderLabel" Text="Sidst opdateret"
                           Margin="0,6,24,0" Foreground="{StaticResource TekstMeget}" FontSize="12.5" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="MotorVersion" HorizontalAlignment="Right"
                           FontSize="12.5" Margin="0,6,0,0" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Beregning" Margin="0,6,24,0"
                           Foreground="{StaticResource TekstMeget}" FontSize="12.5" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="MotorBeregning" HorizontalAlignment="Right"
                           FontSize="12.5" Margin="0,6,0,0" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Modelfil" Margin="0,6,24,0"
                           Foreground="{StaticResource TekstMeget}" FontSize="12.5" />
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ModelNavn" HorizontalAlignment="Right"
                           FontSize="12.5" FontWeight="SemiBold" Margin="0,6,0,0" />

                <TextBlock Grid.Row="4" Grid.ColumnSpan="2" x:Name="MotorSti" Margin="0,12,0,0"
                           FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TekstMeget}" />
              </Grid>
            </Expander>
          </StackPanel>
        </Border>
        </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ===================== Talergenkendelsen ===================== -->
      <TabItem Header="Talergenkendelse" Style="{StaticResource Fane}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0"
                      HorizontalScrollBarVisibility="Disabled">
          <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="20"
                  BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="HVEM SAGDE HVAD — HER PÅ MASKINEN" FontSize="11"
                         FontWeight="SemiBold" Foreground="{StaticResource Accent}" />

              <TextBlock FontSize="12.5" LineHeight="20" Margin="0,8,0,0" TextWrapping="Wrap"
                         MaxWidth="720" HorizontalAlignment="Left"
                         Foreground="{StaticResource TekstSvag}"
                         Text="Et onlinemøde optages på to spor, og det siger hvilken SIDE der talte — ikke hvem. Sad der tre i den anden ende, ville de alle stå som «Gæster». De her to modeller skiller stemmerne ad, så hver enkelt kan navngives." />

              <TextBlock x:Name="TalerStatus" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"
                         Foreground="{StaticResource Accent}" />

              <ItemsControl x:Name="Talerdele" Margin="0,12,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#FF181B22" BorderBrush="{StaticResource PanelKant}"
                            BorderThickness="1" CornerRadius="8" Padding="14,11" Margin="0,0,0,8">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="96" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Slags}" FontSize="10"
                                   FontWeight="SemiBold" Margin="0,3,10,0"
                                   Foreground="{StaticResource TekstMeget}" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Navn}" FontSize="14" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Note}" FontSize="12" Margin="0,3,0,0"
                                     TextWrapping="Wrap" Foreground="{StaticResource TekstMeget}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Stoerrelse}" FontSize="12"
                                   FontFamily="Consolas" VerticalAlignment="Top"
                                   Foreground="{StaticResource TekstMeget}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock FontSize="11.5" LineHeight="19" Margin="0,4,0,0" TextWrapping="Wrap"
                         MaxWidth="720" HorizontalAlignment="Left"
                         Foreground="{StaticResource TekstMeget}"
                         Text="Målt på et møde på 35 minutter med to talere: begge stemmer fundet, og den ene blev genkendt igen efter ti minutters tavshed. Den kører samtidig med udskrivningen og lægger derfor kun omkring halvandet minut til et møde på en time." />

              <TextBlock x:Name="TalerSti" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"
                         Foreground="{StaticResource TekstMeget}" />
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>

      <!-- ===================== Den lokale opsummering ================= -->
      <TabItem Header="Opsummering" Style="{StaticResource Fane}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0"
                      HorizontalScrollBarVisibility="Disabled">
          <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="20"
                  BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="KORT OPSUMMERING — HER PÅ MASKINEN" FontSize="11"
                         FontWeight="SemiBold" Foreground="{StaticResource Accent}" />

              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                  <TextBlock x:Name="LokalModel" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock x:Name="LokalStoerrelse" FontSize="12.5" FontFamily="Consolas"
                             VerticalAlignment="Center" Margin="12,3,0,0"
                             Foreground="{StaticResource TekstMeget}" />
                </StackPanel>

                <!-- Samme knap uanset om modellen mangler eller ligger der:
                     hent, eller hent igen som reparation. En 2,3 GB-fil kan
                     blive beskadiget, og det er en fejl, man skal kunne komme
                     ud af — praecis som med whisper-modellen. -->
                <Button Grid.Column="1" x:Name="LokalKnap" Click="LokalModel_Klik"
                        VerticalAlignment="Top" Padding="16,8" MinWidth="150" />
              </Grid>

              <TextBlock FontSize="12.5" LineHeight="20" Margin="0,8,0,0" TextWrapping="Wrap"
                         MaxWidth="720" HorizontalAlignment="Left"
                         Foreground="{StaticResource TekstSvag}"
                         Text="Ti linjer om, hvad mødet handlede om — til at huske det med. Den kører på grafikkortet her, og intet forlader maskinen. Skal teksten være et rigtigt referat, laves det som et dokument efter en skabelon." />

              <TextBlock x:Name="LokalStatus" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"
                         Foreground="{StaticResource Accent}" />

              <Border Background="#FF181B22" BorderBrush="{StaticResource PanelKant}"
                      BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,14,0,0">
                <StackPanel>
                  <TextBlock Text="Hvad den kan og ikke kan" FontSize="13" FontWeight="SemiBold" />
                  <TextBlock FontSize="12" LineHeight="19" Margin="0,6,0,0" TextWrapping="Wrap"
                             MaxWidth="680" HorizontalAlignment="Left"
                             Foreground="{StaticResource TekstMeget}"
                             Text="Målt på et møde på en time: 34 sekunder. Den fandt deltagerne, emnet og mødets aftale. Den er bedt om ikke at skrive tal — en tidligere kørsel skrev «allerede seks kunder i Danmark», og de ord faldt ikke ét sted i mødet. Alt, hvad den skriver, bliver holdt op mod udskriften bagefter, og det, der ikke kan findes, bliver markeret." />
                </StackPanel>
              </Border>

              <TextBlock x:Name="LokalSti" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"
                         Foreground="{StaticResource TekstMeget}" />
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>

      <!-- ===================== Dokumenter i Europa =================== -->
      <TabItem Header="Dokumenter (i skyen)" Style="{StaticResource Fane}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,0,0"
                      HorizontalScrollBarVisibility="Disabled">
        <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="20"
                BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="TEKST TIL DOKUMENT — I EUROPA" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource Accent}" />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="SkyModel" FontSize="16" FontWeight="SemiBold" />
                  <Border Background="{StaticResource Accent}" CornerRadius="3"
                          Padding="6,1" Margin="10,2,0,0" VerticalAlignment="Center">
                    <TextBlock Text="EU" FontSize="10" FontWeight="SemiBold" Foreground="#FF0B1220" />
                  </Border>
                </StackPanel>

                <TextBlock FontSize="12.5" LineHeight="20" Margin="0,8,0,0" TextWrapping="Wrap"
                           MaxWidth="620" HorizontalAlignment="Left"
                           Foreground="{StaticResource TekstSvag}"
                           Text="Den færdige tekst bliver til et referat, en opgaveliste eller hvad du har lavet af skabeloner. Optagelsen og udskriften bliver på maskinen — kun teksten sendes, og kun til det europæiske endepunkt." />

                <TextBlock x:Name="SkyStatus" FontSize="11.5" Margin="0,10,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource Accent}" />
              </StackPanel>

              <Button Grid.Column="1" x:Name="SkyKnap" Click="Sky_Klik" VerticalAlignment="Top"
                      Padding="16,8" MinWidth="150" />
            </Grid>

            <!-- ================== Vejledningen ==========================
                 Den står KUN, når nøglen mangler, og forsvinder når den er
                 sat. En vejledning til noget, der er gjort, er en skærm, man
                 lærer at læse forbi.

                 Trinnene står i den rækkefølge, de skal gøres i, og de to
                 vigtigste er ikke dem, man selv ville gætte: betalingen skal
                 sættes op, før nøglen virker, og træningen skal slås fra på
                 kontoen — appen kan ikke gøre nogen af delene. -->
            <Border x:Name="SkyVejledning" Visibility="Collapsed" Margin="0,16,0,0"
                    Background="#FF181B22" BorderBrush="{StaticResource PanelKant}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14">
              <StackPanel>
                <TextBlock Text="Sådan kommer du i gang — fem minutter" FontSize="13.5"
                           FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                           Foreground="{StaticResource TekstMeget}"
                           Text="Mistral er en fransk leverandør. Du opretter dig hos dem selv, og nøglen er din — den følger aldrig med appen." />

                <!-- Trin 1 -->
                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Margin="0,1,12,0"
                          Background="{StaticResource Accent}" VerticalAlignment="Top">
                    <TextBlock Text="1" FontSize="12" FontWeight="SemiBold" Foreground="#FF0B1220"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Opret en konto" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock FontSize="12.5" LineHeight="20" TextWrapping="Wrap" Margin="0,3,0,0"
                               MaxWidth="560" HorizontalAlignment="Left"
                               Foreground="{StaticResource TekstSvag}"
                               Text="Gå til console.mistral.ai og opret dig. Der skal ikke vælges abonnement undervejs." />
                  </StackPanel>
                </Grid>

                <!-- Trin 2 -->
                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Margin="0,1,12,0"
                          Background="{StaticResource Accent}" VerticalAlignment="Top">
                    <TextBlock Text="2" FontSize="12" FontWeight="SemiBold" Foreground="#FF0B1220"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Sæt betaling op — vælg «Pay as you go»" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock FontSize="12.5" LineHeight="20" TextWrapping="Wrap" Margin="0,3,0,0"
                               MaxWidth="560" HorizontalAlignment="Left"
                               Foreground="{StaticResource TekstSvag}"
                               Text="Under Billing. Uden den afviser nøglen alle kald, og fejlen ligner et forkert indtastet tegn. Du betaler pr. referat, ikke pr. måned — et mødereferat koster omkring 21 øre, så et normalt forbrug lander på nogle få kroner om måneden." />
                    <TextBlock FontSize="12" LineHeight="19" TextWrapping="Wrap" Margin="0,6,0,0"
                               MaxWidth="560" HorizontalAlignment="Left"
                               Foreground="{StaticResource TekstMeget}"
                               Text="Pay as you go er også det niveau, den databehandleraftale gælder for, som appen bygger på. Gratisniveauet har andre vilkår for, hvad dine data må bruges til." />
                  </StackPanel>
                </Grid>

                <!-- Trin 3 -->
                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Margin="0,1,12,0"
                          Background="{StaticResource Advarsel}" VerticalAlignment="Top">
                    <TextBlock Text="3" FontSize="12" FontWeight="SemiBold" Foreground="#FF0B1220"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Slå fra, at dine data må bruges til træning" FontSize="13"
                               FontWeight="SemiBold" Foreground="{StaticResource Advarsel}" />
                    <TextBlock FontSize="12.5" LineHeight="20" TextWrapping="Wrap" Margin="0,3,0,0"
                               MaxWidth="560" HorizontalAlignment="Left"
                               Foreground="{StaticResource TekstSvag}"
                               Text="Workspace → Data. Det er slået TIL som udgangspunkt, og appen kan ikke ændre det for dig. Det er det eneste trin, hvor det gør en forskel for dine mødedata, om du husker det." />
                  </StackPanel>
                </Grid>

                <!-- Trin 4 -->
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Margin="0,1,12,0"
                          Background="{StaticResource Accent}" VerticalAlignment="Top">
                    <TextBlock Text="4" FontSize="12" FontWeight="SemiBold" Foreground="#FF0B1220"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Lav en API-nøgle og sæt den ind her" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock FontSize="12.5" LineHeight="20" TextWrapping="Wrap" Margin="0,3,0,0"
                               MaxWidth="560" HorizontalAlignment="Left"
                               Foreground="{StaticResource TekstSvag}"
                               Text="Under API Keys. Kopiér den med det samme — den vises kun én gang. Tryk så «Sæt op …» heroppe og indsæt den." />
                  </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="34,12,0,0">
                  <Button Content="Åbn console.mistral.ai" Click="AabnKonsol_Klik" Padding="14,7" />
                  <Button Content="Priser hos Mistral" Click="AabnPriser_Klik" Padding="14,7" Margin="8,0,0,0" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
        </ScrollViewer>
      </TabItem>

    </TabControl>

    <!-- ========================== Bundbjælke =========================== -->
    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <ProgressBar x:Name="Fremdrift" Height="6" Minimum="0" Maximum="100" Visibility="Collapsed"
                     Background="#FF2C323D" Foreground="{StaticResource Accent}" BorderThickness="0" />
        <TextBlock x:Name="Status" Style="{StaticResource Underskrift}" Margin="0,6,0,0" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="AfbrydKnap" Content="Afbryd" Click="Afbryd_Click" Visibility="Collapsed" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
