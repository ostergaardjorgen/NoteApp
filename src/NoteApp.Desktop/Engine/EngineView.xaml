<UserControl x:Class="NoteApp.Desktop.Engine.EngineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Baggrund}">

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="Motor og model" Style="{StaticResource Overskrift}" />
      <TextBlock Style="{StaticResource Underskrift}"
                 Text="Transskriptionen laves af Whisper, som kører lokalt på denne pc. Her kan du se hvad der er i brug, skifte model og hente opdateringer." />
    </StackPanel>

    <!-- ===================== Hvad er i brug lige nu ===================== -->
    <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="10"
            BorderBrush="{StaticResource PanelKant}" BorderThickness="1" Padding="18" Margin="0,0,0,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Motor" Style="{StaticResource Underskrift}" />
        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="MotorNavn" HorizontalAlignment="Right" FontSize="13" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Version" Style="{StaticResource Underskrift}" Margin="0,8,0,0" />
        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="MotorVersion" HorizontalAlignment="Right" FontSize="13" Margin="0,8,0,0" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Beregning" Style="{StaticResource Underskrift}" Margin="0,8,0,0" />
        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="MotorBeregning" HorizontalAlignment="Right" FontSize="13" Margin="0,8,0,0" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Model i brug" Style="{StaticResource Underskrift}" Margin="0,8,0,0" />
        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ModelNavn" HorizontalAlignment="Right" FontSize="13"
                   FontWeight="SemiBold" Margin="0,8,0,0" />

        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" x:Name="MotorSti" Style="{StaticResource Underskrift}"
                   Foreground="{StaticResource TekstMeget}" Margin="0,10,0,0" FontSize="11" />

      </Grid>
    </Border>

    <!-- =========================== Modeller ============================ -->
    <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="10"
            BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Modeller" FontSize="15" FontWeight="SemiBold" Margin="18,16,18,4" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,0,18,16">
          <ItemsControl x:Name="Modeller">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="#FF11141A" CornerRadius="8" Padding="16" Margin="0,0,0,10"
                        BorderThickness="1" BorderBrush="{Binding KantFarve}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Navn}" FontSize="14" FontWeight="SemiBold" />
                        <Border Background="{Binding MaerkatFarve}" CornerRadius="3" Padding="6,2" Margin="10,0,0,0"
                                VerticalAlignment="Center">
                          <TextBlock Text="{Binding Maerkat}" FontSize="10" Foreground="White" />
                        </Border>
                        <TextBlock Text="{Binding Stoerrelse}" Style="{StaticResource Underskrift}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                      </StackPanel>

                      <TextBlock Text="{Binding Resume}" FontSize="12" Margin="0,8,0,0"
                                 Foreground="{StaticResource TekstSvag}" />

                      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="+" FontSize="13" FontWeight="Bold" Width="14"
                                   Foreground="{StaticResource Godkendt}" />
                        <TextBlock Text="{Binding Fordele}" FontSize="12" Width="520"
                                   Foreground="{StaticResource TekstSvag}" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="–" FontSize="13" FontWeight="Bold" Width="14"
                                   Foreground="{StaticResource Advarsel}" />
                        <TextBlock Text="{Binding Ulemper}" FontSize="12" Width="520"
                                   Foreground="{StaticResource TekstSvag}" />
                      </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="130">
                      <Button Content="{Binding KnapTekst}" Tag="{Binding Id}" Click="Model_Click"
                              IsEnabled="{Binding KnapAktiv}" HorizontalAlignment="Stretch" />
                      <TextBlock Text="{Binding Status}" Style="{StaticResource Underskrift}"
                                 HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- ========================== Bundbjælke =========================== -->
    <Grid Grid.Row="3" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <ProgressBar x:Name="Fremdrift" Height="6" Minimum="0" Maximum="100" Visibility="Collapsed"
                     Background="#FF232833" Foreground="{StaticResource Accent}" BorderThickness="0" />
        <TextBlock x:Name="Status" Style="{StaticResource Underskrift}" Margin="0,6,0,0" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="AfbrydKnap" Content="Afbryd" Click="Afbryd_Click" Visibility="Collapsed" Margin="0,0,8,0" />
        <Button x:Name="OpdaterKnap" Content="Søg efter opdatering" Click="Opdater_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
