<UserControl x:Class="NoteApp.Desktop.Files.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Baggrund}">

  <!-- Skærmen er fire paneler under hinanden. Uden en ScrollViewer blev det
       nederste klippet på en lav skærm, og der var ingen vej til det. -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" MinHeight="140" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="Filer og sikkerhedskopi" Style="{StaticResource Overskrift}" />
      <TextBlock Style="{StaticResource Underskrift}"
                 Text="Hvor dine optagelser og din ordbog ligger — og hvor sikkerhedskopien lander." />
    </StackPanel>

    <!-- ========================== Datamappen =========================== -->
    <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="10" Padding="20" Margin="0,0,0,14"
            BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,16,0">
          <TextBlock Text="Dine filer" FontSize="15" FontWeight="SemiBold" />
          <TextBlock x:Name="DataSti" FontSize="13" FontFamily="Consolas" Margin="0,6,0,0" TextWrapping="Wrap" />
          <TextBlock x:Name="DataIndhold" Style="{StaticResource Underskrift}" Margin="0,6,0,0" />
          <TextBlock Style="{StaticResource Underskrift}" Margin="0,8,0,0" Foreground="{StaticResource TekstMeget}"
                     Text="Optagelser, noter, ordbog og indlærte rettelser. Skifter du mappe, flyttes alt med." />
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <Button Content="Skift mappe…" Click="SkiftData_Click" MinWidth="130" />
          <Button Content=".bn mappen" Click="AabnData_Click" Margin="0,8,0,0" MinWidth="130" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ======================== Sikkerhedskopi ========================= -->
    <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="10" Padding="20"
            BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,16,0">
          <TextBlock Text="Sikkerhedskopi" FontSize="15" FontWeight="SemiBold" />
          <TextBlock x:Name="BackupSti" FontSize="13" FontFamily="Consolas" Margin="0,6,0,0" TextWrapping="Wrap" />
          <TextBlock x:Name="BackupSenest" Style="{StaticResource Underskrift}" Margin="0,6,0,0" />
          <TextBlock x:Name="BackupAdvarsel" FontSize="12" Margin="0,8,0,0"
                     Foreground="{StaticResource Advarsel}" Visibility="Collapsed" TextWrapping="Wrap" />

          <!-- Hvad kommer med. Lyd er fra som standard: den fylder alt, og
               den er det, der er lettest at undvære — arbejdet ligger i
               transskriptionen og de indlærte rettelser. -->
          <Border Background="#FF181B22" CornerRadius="6" Padding="12,10" Margin="0,12,0,0"
                  BorderThickness="1" BorderBrush="{StaticResource PanelKant}">
            <StackPanel>
              <TextBlock Text="Hvad kommer med" Style="{StaticResource Underskrift}" Margin="0,0,0,8" />

              <TextBlock FontSize="12" Foreground="{StaticResource TekstSvag}" Margin="0,0,0,8"
                         Text="Altid med: ordbog og indlærte rettelser, noter, transskriptioner, mødedata og indstillinger." />

              <CheckBox x:Name="TagLydMed" Content="Tag også lydfilerne med" Click="Lyd_Klik" />
              <TextBlock x:Name="LydStoerrelse" Style="{StaticResource Underskrift}" Margin="24,4,0,0"
                         Foreground="{StaticResource TekstMeget}" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <Button Content="Skift mappe…" Click="SkiftBackup_Click" MinWidth="130" />
          <Button x:Name="KoerKnap" Content="Tag backup nu" Click="Koer_Click"
                  Style="{StaticResource Primaer}" Margin="0,8,0,0" MinWidth="130" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ========================== Arkiverne ============================ -->
    <Border Grid.Row="3" Background="{StaticResource Panel}" CornerRadius="10" Margin="0,14,0,0"
            BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="18,16,18,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Gemte sikkerhedskopier" FontSize="14" FontWeight="SemiBold" />
            <TextBlock x:Name="ValgtArkiv" Style="{StaticResource Underskrift}" Margin="0,3,0,0"
                       Text="Vælg et arkiv for at se, hvad det indeholder." />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="ProeveKnap" Content="Prøvekørsel" Click="Proeve_Click"
                    IsEnabled="False" Margin="0,0,8,0" />
            <Button x:Name="GendanKnap" Content="Gendan…" Click="Gendan_Click" IsEnabled="False" />
          </StackPanel>
        </Grid>

        <ListBox x:Name="Arkiver" Grid.Row="1" Background="Transparent" BorderThickness="0"
                 Margin="10,0,10,12" Foreground="{StaticResource Tekst}"
                 SelectionChanged="Arkiv_Valgt">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="6,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Navn}" FontSize="13" FontFamily="Consolas"
                           Margin="0,0,16,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Detaljer}" Style="{StaticResource Underskrift}"
                           VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <TextBlock Grid.Row="4" x:Name="Status" Style="{StaticResource Underskrift}" Margin="0,12,0,0" />
  </Grid>
  </ScrollViewer>
</UserControl>
