<Application x:Class="NoteApp.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>

    <!-- Farver. Mørk baggrund med vilje: teleprompteren læses i lange stræk,
         og lys tekst på mørk bund trætter mindre end det omvendte. -->
    <SolidColorBrush x:Key="Baggrund"      Color="#FF14161A" />
    <SolidColorBrush x:Key="Panel"         Color="#FF1C1F26" />
    <SolidColorBrush x:Key="PanelKant"     Color="#FF2A2F3A" />
    <SolidColorBrush x:Key="Tekst"         Color="#FFE8EAF0" />
    <SolidColorBrush x:Key="TekstSvag"     Color="#FF8B93A3" />
    <SolidColorBrush x:Key="TekstMeget"    Color="#FF5A6172" />
    <SolidColorBrush x:Key="Accent"        Color="#FF4C8DFF" />
    <SolidColorBrush x:Key="Optager"       Color="#FFE5484D" />
    <SolidColorBrush x:Key="Godkendt"      Color="#FF3DA35D" />
    <SolidColorBrush x:Key="Advarsel"      Color="#FFE0A030" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Tekst}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Overskrift" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Tekst}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="Underskrift" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TekstSvag}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Tekst}" />
      <Setter Property="Background" Value="{StaticResource Panel}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelKant}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="kant" CornerRadius="6"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="kant" Property="Background" Value="#FF262B35" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Primaer" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Fare" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Optager}" />
      <Setter Property="BorderBrush" Value="{StaticResource Optager}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Sidebjælkens navigation. RadioButton frem for Button, fordi valget
         er gensidigt udelukkende og skal SES — man skal kunne aflæse, hvor
         man er, uden at gætte. -->
    <Style x:Key="NavKnap" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource TekstSvag}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="kant" CornerRadius="6" Background="Transparent" Padding="12,9">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="kant" Property="Background" Value="#FF232833" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="kant" Property="Background" Value="#FF2A3242" />
                <Setter Property="Foreground" Value="{StaticResource Tekst}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FF11141A" />
      <Setter Property="Foreground" Value="{StaticResource Tekst}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelKant}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CaretBrush" Value="{StaticResource Tekst}" />
    </Style>

    <!-- ComboBox og DataGrid arver ikke temaet af sig selv: uden disse to
         står dropdowns hvide og gitterets overskrifter mørke på mørk bund. -->
    <!-- Hele skabelonen skrives ud, fordi WPF's standardchrome er hvid og
         ignorerer Background. Kombineret med den globale TextBlock-stil, der
         gør tekst lys, blev resultatet lys tekst på hvid bund — altså en
         dropdown der så tom ud. -->
    <Style TargetType="ComboBox">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Background" Value="#FF11141A" />
      <Setter Property="Foreground" Value="{StaticResource Tekst}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelKant}" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="knap" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="kant" CornerRadius="4"
                            Background="{StaticResource Baggrund}"
                            BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
                      <Path x:Name="pil" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,10,0" Data="M 0 0 L 4 4 L 8 0 Z"
                            Fill="{StaticResource TekstSvag}" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="kant" Property="BorderBrush" Value="{StaticResource Accent}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>

              <ContentPresenter x:Name="valgt" IsHitTestVisible="False"
                                Margin="10,0,26,0" VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />

              <Popup x:Name="liste" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelKant}"
                        BorderThickness="1" CornerRadius="4" MinWidth="{TemplateBinding ActualWidth}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Tekst}" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="kant" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="kant" Property="Background" Value="#FF2A3242" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#FF232833" />
      <Setter Property="Foreground" Value="{StaticResource Tekst}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelKant}" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style TargetType="DataGridCell">
      <Setter Property="Foreground" Value="{StaticResource Tekst}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,6" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#FF2A3242" />
          <Setter Property="Foreground" Value="{StaticResource Tekst}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="DataGridRow">
      <Setter Property="Foreground" Value="{StaticResource Tekst}" />
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Tekst}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
    </Style>

  </Application.Resources>
</Application>
