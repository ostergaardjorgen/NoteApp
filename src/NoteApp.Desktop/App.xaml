<Application x:Class="NoteApp.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>

    <!-- ==================== PALETTEN ====================================

         VÆRDIERNE HER ER KUN ET UDGANGSPUNKT. De rigtige farver står i
         NoteApp.Core.Tema, hvor de kan regnes på — og Temaskift.Anvend()
         skriver dem ind i penslerne herunder, før det første vindue vises.

         Det, der står her, er de lyse: det er dem, der gælder, hvis Windows
         står lyst, og det er Windows' egen standard.

         HVORFOR HVER FARVE STÅR TO GANGE

         WPF FRYSER SELV RESURSER FRA XAML. En SolidColorBrush med en fast
         farve bliver gjort uforanderlig ved indlæsningen — det er hurtigere
         at tegne, og det er som regel det, man vil have. Her er det præcis
         det modsatte: en frossen pensel kan ikke skifte farve, og temaskiftet
         sprang så samtlige femogtyve over. Uden en lyd.

         Det blev fundet 28-08-2026, fordi skiftet ikke virkede, og fordi
         koden skrev ud, HVAD den så: «FROSSET» ud for hver eneste nøgle.

         Derfor går farven gennem en DynamicResource. En Freezable med en
         uafklaret dynamisk reference KAN ikke fryses — så lader WPF den være.
         Det er `<Color>`-værdien, temaskiftet bytter; penslen følger med af
         sig selv, og alle 969 opslag på `{StaticResource ...}` mærker intet.

         Farverne er efterprøvet mod WCAG 2.1: brødtekst over 7:1, dæmpet
         tekst og betydningsfarver over 4,5:1, feltkanter over 3:1. Det er
         ikke et løfte, det er en prøve, der fejler. Se TemaTest. -->
    <Color x:Key="BaggrundFarve">#FFF7F7F5</Color>
    <SolidColorBrush x:Key="Baggrund"      Color="{DynamicResource BaggrundFarve}" />
    <Color x:Key="PanelFarve">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="Panel"         Color="{DynamicResource PanelFarve}" />
    <Color x:Key="PanelKantFarve">#FFCCCCC5</Color>
    <SolidColorBrush x:Key="PanelKant"     Color="{DynamicResource PanelKantFarve}" />

    <!-- Kanten om noget, man kan SKRIVE i. Kraftigere end PanelKant med
         vilje: en panelkant deler to flader og må gerne være svag, men
         kanten om et felt er det eneste, der siger, at feltet er der.
         WCAG 1.4.11 kræver 3:1 for netop den slags. -->
    <Color x:Key="FeltKantFarve">#FF909081</Color>
    <SolidColorBrush x:Key="FeltKant"      Color="{DynamicResource FeltKantFarve}" />

    <!-- Musen over, knappen nede, raekken valgt. Se Tema.cs. -->
    <Color x:Key="SvaevFarve">#FFEFEFEA</Color>
    <SolidColorBrush x:Key="Svaev"         Color="{DynamicResource SvaevFarve}" />
    <Color x:Key="TrykketFarve">#FFE4E4DD</Color>
    <SolidColorBrush x:Key="Trykket"       Color="{DynamicResource TrykketFarve}" />
    <Color x:Key="ValgtFarve">#FFD9E6F8</Color>
    <SolidColorBrush x:Key="Valgt"         Color="{DynamicResource ValgtFarve}" />

    <Color x:Key="TekstFarve">#FF1B1B19</Color>
    <SolidColorBrush x:Key="Tekst"         Color="{DynamicResource TekstFarve}" />
    <Color x:Key="TekstSvagFarve">#FF5A5A54</Color>
    <SolidColorBrush x:Key="TekstSvag"     Color="{DynamicResource TekstSvagFarve}" />
    <Color x:Key="TekstMegetFarve">#FF6E6E67</Color>
    <SolidColorBrush x:Key="TekstMeget"    Color="{DynamicResource TekstMegetFarve}" />

    <!-- Tekst paa noget, der er slaaet fra. -->
    <Color x:Key="SlukketFarve">#FF909087</Color>
    <SolidColorBrush x:Key="Slukket"       Color="{DynamicResource SlukketFarve}" />
    <Color x:Key="AccentFarve">#FF2A6DD4</Color>
    <SolidColorBrush x:Key="Accent"        Color="{DynamicResource AccentFarve}" />
    <Color x:Key="OptagerFarve">#FFC9313A</Color>
    <SolidColorBrush x:Key="Optager"       Color="{DynamicResource OptagerFarve}" />
    <Color x:Key="GodkendtFarve">#FF1B7340</Color>
    <SolidColorBrush x:Key="Godkendt"      Color="{DynamicResource GodkendtFarve}" />
    <Color x:Key="AdvarselFarve">#FF8A5A00</Color>
    <SolidColorBrush x:Key="Advarsel"      Color="{DynamicResource AdvarselFarve}" />

    <!-- Farven til "noget ER gaaet galt", modsat Advarsel som er "pas paa".
         Den fandtes ikke, men blev brugt: SkySetupWindow slog op paa
         StaticResource "Fare", og WPF kaster paa en noegle, der ikke findes.
         Vinduet kunne derfor slet ikke aabnes - man kunne ikke naa hen til
         det felt, fejlen skulle have staaet i. Fundet 18-08-2026.

         Den hedder FejlTekst og ikke "Fare", fordi "Fare" allerede er navnet
         paa en knap-stil laengere nede. To resurser med samme x:Key i samme
         ordbog er en fejl ved indlaesning - saa ville hele temaet vaelte i
         stedet for bare eet vindue. -->
    <Color x:Key="FejlTekstFarve">#FFC9313A</Color>
    <SolidColorBrush x:Key="FejlTekst"     Color="{DynamicResource FejlTekstFarve}" />

    <!-- Tekst oven paa en farvet knap, og de fire tonede flader. Se Tema.cs. -->
    <Color x:Key="PaaAccentFarve">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="PaaAccent"     Color="{DynamicResource PaaAccentFarve}" />
    <Color x:Key="PaaOptagerFarve">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="PaaOptager"    Color="{DynamicResource PaaOptagerFarve}" />
    <Color x:Key="AccentFladeFarve">#FFEAF1FC</Color>
    <SolidColorBrush x:Key="AccentFlade"   Color="{DynamicResource AccentFladeFarve}" />
    <Color x:Key="GodkendtFladeFarve">#FFE7F4EC</Color>
    <SolidColorBrush x:Key="GodkendtFlade" Color="{DynamicResource GodkendtFladeFarve}" />
    <Color x:Key="AdvarselFladeFarve">#FFFAF0DC</Color>
    <SolidColorBrush x:Key="AdvarselFlade" Color="{DynamicResource AdvarselFladeFarve}" />
    <Color x:Key="FejlFladeFarve">#FFFBEAEB</Color>
    <SolidColorBrush x:Key="FejlFlade"     Color="{DynamicResource FejlFladeFarve}" />

    <!-- Dokumenter, og det, en soegning har fundet. Se Tema.cs. -->
    <Color x:Key="DokumentFarve">#FF7B3FAF</Color>
    <SolidColorBrush x:Key="Dokument"      Color="{DynamicResource DokumentFarve}" />
    <Color x:Key="FremhaevFarve">#FFFFE99A</Color>
    <SolidColorBrush x:Key="Fremhaev"      Color="{DynamicResource FremhaevFarve}" />
    <Color x:Key="PaaFremhaevFarve">#FF1B1B19</Color>
    <SolidColorBrush x:Key="PaaFremhaev"   Color="{DynamicResource PaaFremhaevFarve}" />

    <!-- ================== MENUER ==================
         Appen havde ingen menu foer Kopier-knappen, og saa arvede den
         Windows' egne farver: hvid flade med hvid tekst i det moerke tema -
         ordene var der, man kunne bare ikke se dem.

         MenuItem faar en hel skabelon og ikke bare farver. Standardskabelonen
         henter sin markeringsfarve fra systemet, og en Setter paa Background
         slaar ikke igennem paa den. Samme fejl som traeerne havde. -->
    <Style TargetType="ContextMenu">
      <Setter Property="Background" Value="{StaticResource Panel}" />
      <Setter Property="Foreground" Value="{StaticResource Tekst}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelKant}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="{StaticResource Tekst}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="flade" Background="Transparent" CornerRadius="5" Padding="12,7">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="flade" Property="Background" Value="{StaticResource Valgt}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource TekstMeget}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Tekst}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Overskrift" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Tekst}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="Underskrift" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TekstSvag}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="Button">
      <!-- HJAELPETEKSTEN SKAL OGSAA VISES, NAAR KNAPPEN ER GRAA.
           WPF skjuler som udgangspunkt ToolTip paa deaktiverede kontroller.
           Det er praecis omvendt af, hvad man har brug for: en knap, man kan
           trykke paa, kan man proeve; en graa knap kan man kun gaette om.
           Med ikoner uden tekst var foelgen, at fem af seks ikoner slet ikke
           kunne forklare sig selv. Fundet 18-08-2026. -->
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
      <Setter Property="Foreground" Value="{StaticResource Tekst}" />
      <Setter Property="Background" Value="{StaticResource Panel}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelKant}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="kant" CornerRadius="6"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="kant" Property="Background" Value="{StaticResource Svaev}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Primaer" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ====================== Ikonknap i vaerktoejslinjen ==============
         Kvadratisk, gennemsigtig, med en glyf fra Segoe MDL2 Assets. Skriften
         foelger med Windows 10 og 11 - der er ingen billedfiler at holde styr
         paa, og ikonerne skalerer med skaermen.

         Glyfferne er efterproevet mod skrifttypens cmap-tabel, ikke gaettet.
         Et manglende tegn bliver til en tom firkant, og det opdager man ikke
         ved at laese koden.

         Deaktiveret staar den graa og reagerer ikke paa musen. Det er hele
         pointen med at samle dem her: man kan se, hvad der kan lade sig goere
         med det, der er valgt - foer man klikker. -->
    <Style x:Key="IkonKnap" TargetType="Button">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{StaticResource TekstSvag}" />
      <Setter Property="ToolTipService.InitialShowDelay" Value="350" />
      <Setter Property="ToolTipService.ShowDuration" Value="20000" />
      <!-- Se den implicitte Button-stil ovenfor: uden den her er hjaelpe-
           teksten vaek praecis paa de ikoner, der er graa. -->
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />

      <!-- HJAELPETEKSTEN SKAL OP OVER RAEKKEN.
           Som standard laegger WPF den under musen - altsaa hen over de
           naeste ikoner i vaerktoejslinjen. Saa kan man ikke glide videre til
           nabo-ikonet og faa DETS tekst: man rammer boblen i stedet.
           Placement=Top loefter den fri af raekken. -->
      <Setter Property="ToolTipService.Placement" Value="Top" />
      <Setter Property="ToolTipService.VerticalOffset" Value="-6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="kant" CornerRadius="6" Background="Transparent" Padding="0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="kant" Property="Background" Value="{StaticResource Svaev}" />
                <Setter Property="Foreground" Value="{StaticResource Tekst}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="kant" Property="Background" Value="{StaticResource Valgt}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Slukket}" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Samme knap, men roed naar den kan bruges. Kun til sletning: den er
         den eneste handling i vaerktoejslinjen, der ikke kan fortrydes. -->
    <Style x:Key="IkonKnapFare" TargetType="Button" BasedOn="{StaticResource IkonKnap}">
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="True">
          <Setter Property="Foreground" Value="{StaticResource FejlTekst}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ======================= Bibliotekstraeet ========================= -->
    <Style x:Key="Biblioteksknude" TargetType="TreeViewItem">
      <Setter Property="IsExpanded" Value="True" />
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="Foreground" Value="{StaticResource TekstSvag}" />
      <Setter Property="AllowDrop" Value="True" />
    </Style>

    <!-- ======================== Faner i en rude =========================
         WPF's egne faner er lysegraa med en 3D-kant og staar fuldstaendig
         forkert paa et moerkt tema. Denne er flad: en understregning under
         den valgte, og ellers ingenting.

         Den findes, fordi skabelonruden havde fire ting at vise - navn,
         instruktion, brugerprompt og feltliste - i eet vindue. Hvert af de
         to store tekstfelter fik derfor en tredjedel af hoejden, og man
         redigerede en prompt paa halvfems linjer gennem en rude paa fem.
         Med faner faar det, man arbejder i, hele pladsen. -->
    <Style x:Key="Fanerude" TargetType="TabControl">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <DockPanel>
              <Border DockPanel.Dock="Top" BorderBrush="{StaticResource PanelKant}"
                      BorderThickness="0,0,0,1">
                <TabPanel IsItemsHost="True" Panel.ZIndex="1" Margin="0,0,0,-1" />
              </Border>
              <ContentPresenter ContentSource="SelectedContent" Margin="0,14,0,0" />
            </DockPanel>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Fane" TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource TekstMeget}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="kant" Padding="14,9" Margin="0,0,4,0"
                    Background="Transparent" BorderThickness="0,0,0,2"
                    BorderBrush="Transparent">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TekstSvag}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="kant" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="{StaticResource Tekst}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Fare" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Optager}" />
      <Setter Property="BorderBrush" Value="{StaticResource Optager}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Sidebjælkens navigation. RadioButton frem for Button, fordi valget
         er gensidigt udelukkende og skal SES — man skal kunne aflæse, hvor
         man er, uden at gætte. -->
    <Style x:Key="NavKnap" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource TekstSvag}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="kant" CornerRadius="6" Background="Transparent" Padding="12,9">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="kant" Property="Background" Value="{StaticResource Svaev}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="kant" Property="Background" Value="{StaticResource Valgt}" />
                <Setter Property="Foreground" Value="{StaticResource Tekst}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Fanevalg: to eller tre grupper ved siden af hinanden inde på en
         skærm. Mindre og fladere end menuen i venstre side, så det er
         tydeligt, at man skifter udsnit og ikke skifter skærm. -->
    <Style x:Key="Fanevalg" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource TekstMeget}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="kant" CornerRadius="14" Background="Transparent" Padding="14,6"
                    BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="kant" Property="Background" Value="{StaticResource Svaev}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="kant" Property="Background" Value="{StaticResource Valgt}" />
                <Setter TargetName="kant" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="{StaticResource Tekst}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Tooltips: WPF's standard er en smal, lys strimmel med én linje, der
         bliver klippet. Når et kort er for lille til hele teksten, er det
         tooltippen, der skal bære den — så den skal kunne rumme et afsnit og
         være til at læse på en mørk flade. -->
    <Style TargetType="ToolTip">
      <Setter Property="Foreground" Value="{StaticResource Tekst}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="MaxWidth" Value="430" />
      <Setter Property="HasDropShadow" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="{StaticResource Svaev}" BorderBrush="{StaticResource Accent}"
                    BorderThickness="1" CornerRadius="8" Padding="16,13">
              <ContentPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Trykket}" />
      <Setter Property="Foreground" Value="{StaticResource Tekst}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelKant}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CaretBrush" Value="{StaticResource Tekst}" />
    </Style>

    <!-- DATOVAELGEREN ARVER HELLER IKKE TEMAET.
         Uden den her staar den som en HVID kasse midt i en moerk skaerm - og
         vaerst naar den er laast, hvor WPF's standardchrome slaar helt
         igennem. Feltet inde i den er en DatePickerTextBox, som skal saettes
         for sig; den arver ikke den almindelige TextBox-stil. -->
    <Style TargetType="DatePickerTextBox">
      <Setter Property="Background" Value="{StaticResource Trykket}" />
      <Setter Property="Foreground" Value="{StaticResource Tekst}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CaretBrush" Value="{StaticResource Tekst}" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DatePickerTextBox">
            <Border x:Name="flade" Background="{TemplateBinding Background}"
                    BorderThickness="0" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
            </Border>

            <!-- LAAST SKAL VAERE MOERKT, IKKE GRAAT.
                 WPF's egen skabelon maler en lys flade, naar feltet er slaaet
                 fra, og resultatet var en graa kasse midt i en moerk skaerm -
                 den lignede noget, der var gaaet i stykker, ikke noget, der
                 var laast. Set to steder, foer aarsagen stod klar. -->
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="flade" Property="Background" Value="{StaticResource Trykket}" />
                <Setter Property="Foreground" Value="{StaticResource TekstMeget}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="DatePicker">
      <Setter Property="Background" Value="{StaticResource Trykket}" />
      <Setter Property="Foreground" Value="{StaticResource Tekst}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelKant}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="2" />
      <Style.Triggers>
        <!-- LAAST BETYDER DAEMPET, IKKE HVID. Et felt, man ikke kan rette,
             skal se ud som noget, der er laast - ikke som noget, der er
             gaaet i stykker. -->
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.6" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ComboBox og DataGrid arver ikke temaet af sig selv: uden disse to
         står dropdowns hvide og gitterets overskrifter mørke på mørk bund. -->
    <!-- Hele skabelonen skrives ud, fordi WPF's standardchrome er hvid og
         ignorerer Background. Kombineret med den globale TextBlock-stil, der
         gør tekst lys, blev resultatet lys tekst på hvid bund — altså en
         dropdown der så tom ud. -->
    <Style TargetType="ComboBox">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Background" Value="{StaticResource Trykket}" />
      <Setter Property="Foreground" Value="{StaticResource Tekst}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelKant}" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="knap" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="kant" CornerRadius="4"
                            Background="{StaticResource Baggrund}"
                            BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
                      <Path x:Name="pil" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,10,0" Data="M 0 0 L 4 4 L 8 0 Z"
                            Fill="{StaticResource TekstSvag}" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="kant" Property="BorderBrush" Value="{StaticResource Accent}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>

              <ContentPresenter x:Name="valgt" IsHitTestVisible="False"
                                Margin="10,0,26,0" VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />

              <Popup x:Name="liste" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelKant}"
                        BorderThickness="1" CornerRadius="4" MinWidth="{TemplateBinding ActualWidth}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Tekst}" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="kant" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="kant" Property="Background" Value="{StaticResource Valgt}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{StaticResource Svaev}" />
      <Setter Property="Foreground" Value="{StaticResource Tekst}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelKant}" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style TargetType="DataGridCell">
      <Setter Property="Foreground" Value="{StaticResource Tekst}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,6" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{StaticResource Valgt}" />
          <Setter Property="Foreground" Value="{StaticResource Tekst}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="DataGridRow">
      <Setter Property="Foreground" Value="{StaticResource Tekst}" />
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Tekst}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
    </Style>

  </Application.Resources>
</Application>
