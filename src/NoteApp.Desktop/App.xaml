<Application x:Class="NoteApp.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NoteApp.Desktop"
             StartupUri="MainWindow.xaml">
  <Application.Resources>

    <!-- ==================== PALETTEN ====================================

         VÆRDIERNE HER ER KUN ET UDGANGSPUNKT. De rigtige farver står i
         NoteApp.Core.Tema, hvor de kan regnes på — og Temaskift.Anvend()
         skriver dem ind i penslerne herunder, før det første vindue vises.

         Det, der står her, er STANDARDTEMAET — det mørke. Står de på det
         forkerte, ser man et glimt af den anden palet, når appen åbner.
         En prøve holder de to i trit; se TemafilTest.

         PENSLERNE HER BLIVER UDSKIFTET, IKKE ÆNDRET

         WPF fryser selv resurser fra XAML, og en frossen pensel kan aldrig
         ændre farve igen. To omveje blev prøvet — at sætte `Color` direkte,
         og at lade farven komme fra en `<Color>` gennem en DynamicResource —
         og begge så rigtige ud ved opstart og virkede ikke under drift.

         Målt 28-08-2026 efter et tryk på knappen: `Baggrund` skiftede,
         `Panel` og `Tekst` gjorde ikke. Forskellen er, at de to sidste bruges
         i STILARTER, og WPF forsegler en stil første gang den bruges — det
         fryser de Freezables, der står i dens settere.

         Derfor skiftes hele penslen ud, og derfor slås paletten op med
         **DynamicResource** ude i skærmbillederne. Et StaticResource-opslag
         slår op én gang og ville aldrig opdage, at penslen var en anden.

         Stilarterne herunder — Overskrift, Primaer, Fanerude — bliver ved med
         at være StaticResource. De skiftes aldrig ud.

         Farverne er efterprøvet mod WCAG 2.1: brødtekst over 7:1, dæmpet
         tekst og betydningsfarver over 4,5:1, feltkanter over 3:1. Det er
         ikke et løfte, det er en prøve, der fejler. Se TemaTest. -->
    <SolidColorBrush x:Key="Baggrund"      Color="#FF0B1220" />
    <SolidColorBrush x:Key="Panel"         Color="#FF111C2D" />
    <SolidColorBrush x:Key="PanelKant"     Color="#FF24354B" />

    <!-- ============ KANTEN OM NOGET, MAN KAN SKRIVE I ============

         TO NOEGLER, IKKE EEN. Foer hed den «FeltKant» og var EN farve: en
         maettet blaa, som hvert eneste felt bar hele tiden. Alle felter
         raabte lige hoejt, ogsaa de tomme, og feltet med markoeren i saa ud
         som alle de andre.

         InputKant er hvilekanten - graablaa, lige praecis synlig. WCAG
         1.4.11 kraever 3:1 for noget, man skal kunne finde.
         InputFokusKant er den klare blaa og staar KUN, hvor der skrives.
         Se udloeserne paa TextBox og RichTextBox laengere nede. -->
    <SolidColorBrush x:Key="InputKant"      Color="#FF556D86" />
    <SolidColorBrush x:Key="InputFokusKant" Color="#FF73C2FB" />

    <!-- Musen over, knappen nede, raekken valgt. Se Tema.cs. -->
    <SolidColorBrush x:Key="Svaev"         Color="#FF17283B" />
    <SolidColorBrush x:Key="Trykket"       Color="#FF0E1A2B" />
    <SolidColorBrush x:Key="Valgt"         Color="#FF1B3A5C" />

    <SolidColorBrush x:Key="Tekst"         Color="#FFEFF5FA" />
    <SolidColorBrush x:Key="TekstSvag"     Color="#FFB3C7DB" />
    <SolidColorBrush x:Key="TekstMeget"    Color="#FF8CABC9" />

    <!-- Tekst paa noget, der er slaaet fra. -->
    <SolidColorBrush x:Key="Slukket"       Color="#FF64788A" />

    <!-- ACCENT ER HANDLING OG FOKUS - og intet andet.
         Den var groen, og Godkendt var den SAMME groenne. Farven betoed
         derfor «tryk her», «du staar her», «den arbejder» og «det gik godt»
         paa een gang. Nu: blaa = handling, groen = det gik godt, koral =
         der optages / det gik galt, gul = se lige her. -->
    <SolidColorBrush x:Key="Accent"        Color="#FF73C2FB" />
    <SolidColorBrush x:Key="Optager"       Color="#FFFF7770" />
    <SolidColorBrush x:Key="Godkendt"      Color="#FF30C993" />
    <SolidColorBrush x:Key="Advarsel"      Color="#FFEFAE31" />

    <!-- Farven til "noget ER gaaet galt", modsat Advarsel som er "pas paa".
         Den fandtes ikke, men blev brugt: SkySetupWindow slog op paa
         StaticResource "Fare", og WPF kaster paa en noegle, der ikke findes.
         Vinduet kunne derfor slet ikke aabnes - man kunne ikke naa hen til
         det felt, fejlen skulle have staaet i. Fundet 18-08-2026.

         Den hedder FejlTekst og ikke "Fare", fordi "Fare" allerede er navnet
         paa en knap-stil laengere nede. To resurser med samme x:Key i samme
         ordbog er en fejl ved indlaesning - saa ville hele temaet vaelte i
         stedet for bare eet vindue. -->
    <SolidColorBrush x:Key="FejlTekst"     Color="#FFFF7770" />

    <!-- Tekst oven paa en farvet knap, og de fire tonede flader. Se Tema.cs. -->
    <SolidColorBrush x:Key="PaaAccent"     Color="#FF0B1220" />
    <SolidColorBrush x:Key="PaaOptager"    Color="#FF0B1220" />
    <SolidColorBrush x:Key="AccentFlade"   Color="#FF0F2E4A" />
    <SolidColorBrush x:Key="GodkendtFlade" Color="#FF0B3C31" />
    <SolidColorBrush x:Key="AdvarselFlade" Color="#FF523B0F" />
    <SolidColorBrush x:Key="FejlFlade"     Color="#FF5A1512" />

    <!-- Fladen bag «der optages nu». Se DiktatBjaelke. -->
    <SolidColorBrush x:Key="OptagerFlade"  Color="#FF4A1416" />

    <!-- ============ SIDEBJAELKEN HAR SIN EGEN FLADE ============

         Den er moerkeblaa i BEGGE temaer. I det lyse er det appens ansigt -
         uden den var skaermen hvide paneler paa lysegraat, altsaa til
         forveksling som enhver anden Windows-app.

         Derfor kan teksten derinde ikke hente sin farve i «Tekst»: den er
         moerk paa lyst og ville vaere usynlig paa en natblaa bjaelke. To
         egne tekstnoegler i stedet. -->
    <SolidColorBrush x:Key="NavigationFlade"   Color="#FF0D1524" />
    <SolidColorBrush x:Key="NavigationValgt"   Color="#FF1B3C5C" />
    <SolidColorBrush x:Key="NavigationKant"    Color="#FF1B2A3E" />
    <SolidColorBrush x:Key="PaaNavigation"     Color="#FFEFF5FA" />
    <SolidColorBrush x:Key="PaaNavigationSvag" Color="#FFA9C0D6" />

    <!-- Dokumenter, og det, en soegning har fundet. Se Tema.cs. -->
    <SolidColorBrush x:Key="Dokument"      Color="#FFCB90F0" />
    <SolidColorBrush x:Key="Fremhaev"      Color="#FFF4CB23" />
    <SolidColorBrush x:Key="PaaFremhaev"   Color="#FF0B1220" />

    <!-- ================== MENUER ==================
         Appen havde ingen menu foer Kopier-knappen, og saa arvede den
         Windows' egne farver: hvid flade med hvid tekst i det moerke tema -
         ordene var der, man kunne bare ikke se dem.

         MenuItem faar en hel skabelon og ikke bare farver. Standardskabelonen
         henter sin markeringsfarve fra systemet, og en Setter paa Background
         slaar ikke igennem paa den. Samme fejl som traeerne havde. -->
    <Style TargetType="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource Panel}" />
      <Setter Property="Foreground" Value="{DynamicResource Tekst}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelKant}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource Tekst}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="flade" Background="Transparent" CornerRadius="5" Padding="12,7">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="flade" Property="Background" Value="{DynamicResource Valgt}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TekstMeget}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Tekst}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Overskrift" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Tekst}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="Underskrift" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TekstSvag}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="Button">
      <!-- HJAELPETEKSTEN SKAL OGSAA VISES, NAAR KNAPPEN ER GRAA.
           WPF skjuler som udgangspunkt ToolTip paa deaktiverede kontroller.
           Det er praecis omvendt af, hvad man har brug for: en knap, man kan
           trykke paa, kan man proeve; en graa knap kan man kun gaette om.
           Med ikoner uden tekst var foelgen, at fem af seks ikoner slet ikke
           kunne forklare sig selv. Fundet 18-08-2026. -->
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
      <Setter Property="Foreground" Value="{DynamicResource Tekst}" />
      <Setter Property="Background" Value="{DynamicResource Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelKant}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="kant" CornerRadius="6"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="kant" Property="Background" Value="{DynamicResource Svaev}" />
              </Trigger>
              <!-- EN GRAA KNAP SKAL STADIG KUNNE LAESES.
                   Her stod Opacity 0.4. Paa en naesten sort bund var det
                   fint - blaat ved 40 % er stadig blaat. Paa en HVID bund
                   blev den primaere knap lyseblaa med hvid skrift, og saa
                   kunne man ikke se, hvad den hed. Set paa Optagelser
                   28-08-2026, hvor «Opret transskription» var toma.

                   Nu saettes farverne i stedet. Det virker begge steder, og
                   teksten kan laeses - hvilket den skal, for ellers kan man
                   ikke regne ud, hvorfor knappen ikke kan trykkes. -->
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="kant" Property="Background" Value="{DynamicResource Trykket}" />
                <Setter TargetName="kant" Property="BorderBrush" Value="{DynamicResource PanelKant}" />
                <Setter Property="Foreground" Value="{DynamicResource Slukket}" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Primaer" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource PaaAccent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ====================== Ikonknap i vaerktoejslinjen ==============
         Kvadratisk, gennemsigtig, med en glyf fra Segoe MDL2 Assets. Skriften
         foelger med Windows 10 og 11 - der er ingen billedfiler at holde styr
         paa, og ikonerne skalerer med skaermen.

         Glyfferne er efterproevet mod skrifttypens cmap-tabel, ikke gaettet.
         Et manglende tegn bliver til en tom firkant, og det opdager man ikke
         ved at laese koden.

         Deaktiveret staar den graa og reagerer ikke paa musen. Det er hele
         pointen med at samle dem her: man kan se, hvad der kan lade sig goere
         med det, der er valgt - foer man klikker. -->
    <!-- ============ GLYFFEN SKAL FOELGE KNAPPENS FARVE ============

         Den implicitte TextBlock-stil oevre i filen saetter Foreground til
         «Tekst». En stil-setter vinder over nedarvning - saa ikonet blev
         tegnet naesten hvidt, uanset hvad knappen sagde. Baade den daempede
         hvilefarve og den graa «slukket» ved IsEnabled=False var altsaa uden
         virkning, og et ikon, der ikke kunne bruges, saa praecis ud som et,
         der kunne. Maalt 04-09-2026: alle syv glyffer i optagelsernes
         vaerktoejslinje stod paa #FFF0F4F8, ogsaa de fem slukkede.

         Det er den SAMME faelde, kommentaren i TranscribeView.xaml beskriver
         for FontFamily; Foreground blev overset dengang.

         Den kan ikke loeses inde i knappens ControlTemplate: glyffen er
         knappens INDHOLD, sat i XAML, og dens implicitte stil slaas op ad den
         logiske traestruktur - ikke i skabelonens ressourcer. Derfor en
         navngiven stil, der saettes paa hver glyf. Den binder til knappens
         Foreground, saa svaev, tryk og slukket alle slaar igennem. -->
    <Style x:Key="Ikonglyf" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="Foreground"
              Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
    </Style>

    <Style x:Key="IkonKnap" TargetType="Button">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource TekstSvag}" />
      <Setter Property="ToolTipService.InitialShowDelay" Value="350" />
      <Setter Property="ToolTipService.ShowDuration" Value="20000" />
      <!-- Se den implicitte Button-stil ovenfor: uden den her er hjaelpe-
           teksten vaek praecis paa de ikoner, der er graa. -->
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />

      <!-- HJAELPETEKSTEN SKAL OP OVER RAEKKEN.
           Som standard laegger WPF den under musen - altsaa hen over de
           naeste ikoner i vaerktoejslinjen. Saa kan man ikke glide videre til
           nabo-ikonet og faa DETS tekst: man rammer boblen i stedet.
           Placement=Top loefter den fri af raekken. -->
      <Setter Property="ToolTipService.Placement" Value="Top" />
      <Setter Property="ToolTipService.VerticalOffset" Value="-6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="kant" CornerRadius="6" Background="Transparent" Padding="0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="kant" Property="Background" Value="{DynamicResource Svaev}" />
                <Setter Property="Foreground" Value="{DynamicResource Tekst}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="kant" Property="Background" Value="{DynamicResource Valgt}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Slukket}" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Samme knap, men roed naar den kan bruges. Kun til sletning: den er
         den eneste handling i vaerktoejslinjen, der ikke kan fortrydes. -->
    <Style x:Key="IkonKnapFare" TargetType="Button" BasedOn="{StaticResource IkonKnap}">
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource FejlTekst}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ======================= Bibliotekstraeet ========================= -->
    <Style x:Key="Biblioteksknude" TargetType="TreeViewItem">
      <Setter Property="IsExpanded" Value="True" />
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="Foreground" Value="{DynamicResource TekstSvag}" />
      <Setter Property="AllowDrop" Value="True" />
    </Style>

    <!-- ======================== Faner i en rude =========================
         WPF's egne faner er lysegraa med en 3D-kant og staar fuldstaendig
         forkert paa et moerkt tema. Denne er flad: en understregning under
         den valgte, og ellers ingenting.

         Den findes, fordi skabelonruden havde fire ting at vise - navn,
         instruktion, brugerprompt og feltliste - i eet vindue. Hvert af de
         to store tekstfelter fik derfor en tredjedel af hoejden, og man
         redigerede en prompt paa halvfems linjer gennem en rude paa fem.
         Med faner faar det, man arbejder i, hele pladsen. -->
    <Style x:Key="Fanerude" TargetType="TabControl">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <DockPanel>
              <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource PanelKant}"
                      BorderThickness="0,0,0,1">
                <TabPanel IsItemsHost="True" Panel.ZIndex="1" Margin="0,0,0,-1" />
              </Border>
              <ContentPresenter ContentSource="SelectedContent" Margin="0,14,0,0" />
            </DockPanel>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Fane" TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource TekstMeget}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="kant" Padding="14,9" Margin="0,0,4,0"
                    Background="Transparent" BorderThickness="0,0,0,2"
                    BorderBrush="Transparent">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TekstSvag}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="kant" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource Tekst}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ EN KASSE OM ÉT FELT ============
         Et maerkat og den kontrol, der hoerer til det. Kassen er der, fordi
         fire felter ved siden af hinanden uden afgraensning floed sammen -
         man kunne ikke se, hvor det ene spoergsmaal slap, og det naeste
         begyndte. Set paa opstartdialogen 28-08-2026. -->
    <Style x:Key="Feltkasse" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelKant}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style x:Key="Fare" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Optager}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Optager}" />
      <Setter Property="Foreground" Value="{DynamicResource PaaOptager}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Sidebjælkens navigation. RadioButton frem for Button, fordi valget
         er gensidigt udelukkende og skal SES — man skal kunne aflæse, hvor
         man er, uden at gætte.

         ============ DEN HENTER IKKE SINE FARVER I «Tekst» ============

         Sidebjælken er mørkeblå i BEGGE temaer. I det lyse er «Tekst» næsten
         sort, og et menupunkt i den farve ville være usynligt på bjælken.
         Derfor PaaNavigation og PaaNavigationSvag, som hører til fladen og
         ikke til appen udenom.

         Det er den samme fælde som Ikonglyf længere oppe: ikonet står i
         Tag og tegnes af skabelonen, så den arver Foreground herfra — men
         Content er almindelig tekst, og dér ville den implicitte
         TextBlock-stil have vundet, hvis den satte Foreground. Den gør den,
         så Content-teksten sættes af ContentPresenter'ens TextElement. -->
    <Style x:Key="NavKnap" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource PaaNavigationSvag}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <!-- IKON OG TEKST HVER FOR SIG.
                 Naar menuen klappes ind, forsvinder teksten, og ikonet bliver
                 tilbage. Skulle de to vaere eet stykke indhold, kunne det ikke
                 lade sig goere - og saa ville et sammenklappet punkt enten
                 vaere tomt eller vise afkortet tekst.

                 Ikonet staar i Tag. Det er ikke elegant, men det holder
                 Content til dét, punktet HEDDER - og det er den streng, der
                 oversaettes, og som bliver til hjaelpeteksten, naar der kun er
                 et ikon at se paa. -->
            <Border x:Name="kant" CornerRadius="6" Background="Transparent" Padding="12,9">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Foreground SKAL staa her. Uden den vandt den implicitte
                     TextBlock-stils «Tekst» - og den er naesten sort i det
                     lyse tema. Maalt: alle otte ikoner stod paa #101828 paa
                     den natblaa bjaelke, altsaa 1,1:1. I det MOERKE tema er
                     «Tekst» lys, saa dér saa det rigtigt ud - og fejlen
                     kunne ligge og gemme sig. -->
                <TextBlock x:Name="ikon" Grid.Column="0" Text="{TemplateBinding Tag}"
                           Foreground="{TemplateBinding Foreground}"
                           FontFamily="Segoe MDL2 Assets" FontSize="15" Width="20"
                           VerticalAlignment="Center" TextAlignment="Center" />

                <!-- ============ TREDJE GANG, SAMME FAELDE ============

                     Her stod TextElement.Foreground paa selve
                     ContentPresenteren, og det virkede ikke. Grunden er den
                     samme som ved Ikonglyf oevre i filen og ved FontFamily i
                     TranscribeView: TextElement.Foreground er en NEDARVET
                     vaerdi, og den implicitte TextBlock-stils Foreground-
                     setter vinder over nedarvning.

                     Foelgen kunne maales: syv af de otte menupunkter stod i
                     «Tekst» - altsaa #101828, naesten sort, paa en natblaa
                     bjaelke. 1,05:1. Kun «AI-modeller» saa rigtigt ud, fordi
                     dens tekst er en TextBlock skrevet i haanden med en lokal
                     Foreground, og en lokal vaerdi slaar en stil. Derfor saa
                     netop DEN forkert ud: den var den eneste rigtige.

                     En implicit stil HER i ContentPresenterens egne resurser
                     findes foer den i Application.Resources - opslaget gaar
                     opad fra den TextBlock, ContentPresenteren selv laver.
                     Saa nu gaelder den for baade de almindelige punkter og
                     for indholdet i «AI-modeller». Eet sted, een regel. -->
                <ContentPresenter x:Name="tekst" Grid.Column="1" VerticalAlignment="Center"
                                  Margin="12,0,0,0">
                  <ContentPresenter.Resources>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground"
                              Value="{Binding Foreground,
                                RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" />
                      <Setter Property="FontFamily" Value="Segoe UI" />
                      <!-- Et menupunkt maa ikke ombrydes. Den globale stil
                           saetter Wrap, og «Indstillinger» ville knaekke, naar
                           menuen klappes. -->
                      <Setter Property="TextWrapping" Value="NoWrap" />
                    </Style>
                  </ContentPresenter.Resources>
                </ContentPresenter>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="kant" Property="Background" Value="{DynamicResource NavigationKant}" />
                <Setter Property="Foreground" Value="{DynamicResource PaaNavigation}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="kant" Property="Background" Value="{DynamicResource NavigationValgt}" />
                <Setter Property="Foreground" Value="{DynamicResource PaaNavigation}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>

              <!-- Sammenklappet: teksten ud, og ikonet ind paa midten. -->
              <DataTrigger Value="True"
                           Binding="{Binding MenuSammenklappet,
                                     RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}">
                <Setter TargetName="tekst" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="kant" Property="Padding" Value="6,9" />

                <!-- IKONET SKAL OVER PAA MIDTEN, ikke bare blive staaende.
                     Tekstkolonnen fylder sin plads, ogsaa naar teksten er
                     skjult - og saa sad ikonet i venstre side og flugtede
                     ikke med Pia-ikonet ovenover. Med ColumnSpan 2 daekker
                     det hele knappen og kan centreres i den. -->
                <Setter TargetName="ikon" Property="Grid.ColumnSpan" Value="2" />
                <Setter TargetName="ikon" Property="HorizontalAlignment" Value="Center" />
                <Setter TargetName="ikon" Property="Width" Value="NaN" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Fanevalg: to eller tre grupper ved siden af hinanden inde på en
         skærm. Mindre og fladere end menuen i venstre side, så det er
         tydeligt, at man skifter udsnit og ikke skifter skærm. -->
    <Style x:Key="Fanevalg" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource TekstMeget}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="kant" CornerRadius="14" Background="Transparent" Padding="14,6"
                    BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="kant" Property="Background" Value="{DynamicResource Svaev}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="kant" Property="Background" Value="{DynamicResource Valgt}" />
                <Setter TargetName="kant" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource Tekst}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Tooltips: WPF's standard er en smal, lys strimmel med én linje, der
         bliver klippet. Når et kort er for lille til hele teksten, er det
         tooltippen, der skal bære den — så den skal kunne rumme et afsnit og
         være til at læse på en mørk flade. -->
    <Style TargetType="ToolTip">
      <Setter Property="Foreground" Value="{DynamicResource Tekst}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="MaxWidth" Value="430" />
      <Setter Property="HasDropShadow" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="{DynamicResource Svaev}" BorderBrush="{DynamicResource Accent}"
                    BorderThickness="1" CornerRadius="8" Padding="16,13">
              <ContentPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ ET FELT I HVILE SKAL VAERE STILLE ============

         Kanten var «FeltKant» - en maettet blaa - og den stod paa ALLE
         felter HELE tiden. Paa en skaerm med ti felter var der altsaa ti
         blaa rammer, ogsaa naar man ikke skrev i nogen af dem, og feltet med
         markoeren i saa ud praecis som de ni andre.

         Nu: graablaa i hvile (3:1, saa den stadig kan FINDES), og den klare
         blaa kun paa det felt, der skrives i. To trin i stedet for eet.

         IsKeyboardFocusWithin og ikke IsFocused. TextBox faar selv fokus, men
         RichTextBox laegger det paa sin indre rude - og saa ville kanten
         aldrig skifte dér. -->
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource Trykket}" />
      <Setter Property="Foreground" Value="{DynamicResource Tekst}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputKant}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CaretBrush" Value="{DynamicResource Tekst}" />
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource InputFokusKant}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ============ RichTextBox SKAL LIGNE EN TextBox ============

         Der var ingen stil, saa den arvede systemets: hvid flade, egen skrift
         og en anden stoerrelse. Paa moedetyperne, hvor de to store felter er
         RichTextBox for at kunne strege linjer over, betoed det, at skriften
         pludselig var stor og fed. Set 04-09-2026.

         Setterne er de samme som paa TextBox ovenfor. Skriften saettes ogsaa
         paa selve FlowDocument - se SaetTekst i TemplatesView: et dokument
         arver IKKE stoerrelse og skrift fra den rude, det ligger i. -->
    <Style TargetType="RichTextBox">
      <Setter Property="Background" Value="{DynamicResource Trykket}" />
      <Setter Property="Foreground" Value="{DynamicResource Tekst}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputKant}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="CaretBrush" Value="{DynamicResource Tekst}" />
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource InputFokusKant}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- DATOVAELGEREN ARVER HELLER IKKE TEMAET.
         Uden den her staar den som en HVID kasse midt i en moerk skaerm - og
         vaerst naar den er laast, hvor WPF's standardchrome slaar helt
         igennem. Feltet inde i den er en DatePickerTextBox, som skal saettes
         for sig; den arver ikke den almindelige TextBox-stil. -->
    <Style TargetType="DatePickerTextBox">
      <Setter Property="Background" Value="{DynamicResource Trykket}" />
      <Setter Property="Foreground" Value="{DynamicResource Tekst}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CaretBrush" Value="{DynamicResource Tekst}" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DatePickerTextBox">
            <Border x:Name="flade" Background="{TemplateBinding Background}"
                    BorderThickness="0" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
            </Border>

            <!-- LAAST SKAL VAERE MOERKT, IKKE GRAAT.
                 WPF's egen skabelon maler en lys flade, naar feltet er slaaet
                 fra, og resultatet var en graa kasse midt i en moerk skaerm -
                 den lignede noget, der var gaaet i stykker, ikke noget, der
                 var laast. Set to steder, foer aarsagen stod klar. -->
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="flade" Property="Background" Value="{DynamicResource Trykket}" />
                <Setter Property="Foreground" Value="{DynamicResource TekstMeget}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= DATOVÆLGERENS KALENDER =========================

         POPUP'EN ARVEDE IKKE TEMAET, OG EN IMPLICIT STIL KUNNE IKKE REDDE DEN.

         Klikkede man på kalenderikonet i «Ny aftale», kom der en HVID kasse
         frem med lys skrift i det mørke tema — datoerne var der, man kunne
         bare ikke se dem. Stilarterne for DatePicker og DatePickerTextBox
         ovenfor rammer kun feltet, ikke det, der folder sig ud.

         DatePicker laver sin egen Calendar og styrer dens Style i KODE:

             _calendar.SetBinding(StyleProperty,
                 GetDatePickerBinding(CalendarStyleProperty));

         En binding er en lokal værdi. Så længe CalendarStyle er tom, står der
         altså Style = null på kalenderen — og en kontrol med en lokal Style
         slår ALDRIG en implicit stil op. Derfor virkede det ikke bare at
         skrive «Style TargetType="Calendar"» her i filen; den vej findes ikke
         for en datovælger. Det er CalendarStyle på datovælgeren, der er
         indgangen, og den sættes nedenfor.

         Hele skabelonen skrives ud — samme grund som ved ComboBox og menuerne:
         WPF's standardchrome er hvid og lytter ikke til Background.

         RÆKKEFØLGEN ER IKKE TILFÆLDIG. StaticResource kan kun se opad i
         filen, så dagen og måneden skal stå før kassen, kassen før kalenderen
         og kalenderen før datovælgeren. -->

    <!-- EN DAG I MÅNEDEN.
         I DAG har en kant, den VALGTE har en flade. To forskellige ting, der
         ikke må ligne hinanden — ellers kan man ikke se, om man har valgt
         noget, den dag man åbner kalenderen på dagens dato. -->
    <Style x:Key="Kalenderdag" TargetType="CalendarDayButton">
      <Setter Property="Foreground" Value="{DynamicResource Tekst}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinWidth" Value="32" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CalendarDayButton">
            <Border x:Name="flade" Margin="1" CornerRadius="5"
                    Background="Transparent"
                    BorderBrush="Transparent" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <!-- Dagene fra nabomaanederne. De kan vaelges, men de er ikke
                   den maaned, man kigger paa. -->
              <Trigger Property="IsInactive" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Slukket}" />
              </Trigger>

              <Trigger Property="IsToday" Value="True">
                <Setter TargetName="flade" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>

              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="flade" Property="Background" Value="{DynamicResource Svaev}" />
              </Trigger>

              <!-- MARKERINGEN STAAR EFTER MUSEN, saa den vinder. Stod den
                   foer, ville den valgte dag skifte til svaevefarven, saa
                   snart musen kom hen over den - og saa saa det ud, som om
                   valget forsvandt. -->
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="flade" Property="Background" Value="{DynamicResource Accent}" />
                <Setter TargetName="flade" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource PaaAccent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>

              <Trigger Property="IsBlackedOut" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Slukket}" />
              </Trigger>

              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Slukket}" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- EN MAANED ELLER ET AARSTAL. Den vises, naar man trykker paa
         overskriften og springer et helt aar frem. Samme udseende som dagen,
         bare bredere - felterne er «jan», «feb» og firecifrede aarstal. -->
    <Style x:Key="Kalendermaaned" TargetType="CalendarButton">
      <Setter Property="Foreground" Value="{DynamicResource Tekst}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinWidth" Value="56" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CalendarButton">
            <Border x:Name="flade" Margin="2" CornerRadius="5"
                    Background="Transparent"
                    BorderBrush="Transparent" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsInactive" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Slukket}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="flade" Property="Background" Value="{DynamicResource Svaev}" />
              </Trigger>
              <!-- HER HEDDER DEN IKKE «IsSelected».
                   CalendarButton er ikke en dag, men en hel maaned eller et
                   helt aar, og den kan ikke selv vaere valgt - den svarer paa,
                   om der ligger en valgt dag INDE i den. Egenskaben findes
                   ikke, og oversaetteren siger fra:
                   «Cannot find the Template Property 'IsSelected'». -->
              <Trigger Property="HasSelectedDays" Value="True">
                <Setter TargetName="flade" Property="Background" Value="{DynamicResource Accent}" />
                <Setter TargetName="flade" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource PaaAccent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Slukket}" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- SELVE KASSEN: overskriften med pilene, ugedagene og gitteret.
         Det er HER, det hvide kom fra - CalendarItem er den del, WPF tegner
         med sin egen chrome. -->
    <Style x:Key="Kalenderkassen" TargetType="CalendarItem">
      <Setter Property="Background" Value="{DynamicResource Panel}" />
      <Setter Property="Foreground" Value="{DynamicResource Tekst}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelKant}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CalendarItem">
            <ControlTemplate.Resources>
              <!-- UGEDAGENES FORBOGSTAVER.
                   Teksten kommer fra Windows' kultur og ikke fra
                   sprogfilerne - det er den samme kalender, resten af
                   systemet viser, og en app, der oversaetter ugedagene selv,
                   ville kunne komme til at sige noget andet end uret nede i
                   hjoernet.

                   SKABELONEN SKAL LIGGE PRAECIS HER. CalendarItem henter den
                   i sin egen Template.Resources og ingen andre steder -
                   flyttes den ud i filen, staar raekken med ugedage tom. -->
              <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                <TextBlock Text="{Binding}" FontSize="10.5" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,4,0,6"
                           Foreground="{DynamicResource TekstMeget}" />
              </DataTemplate>
            </ControlTemplate.Resources>

            <Grid x:Name="PART_Root">
              <Border Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="8" Padding="8,6,8,8">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>

                  <!-- ============ OVERSKRIFTEN ============
                       Pilene faar deres egen skabelon. Uden den ville appens
                       almindelige knap-stil slaa igennem, og saa stod der to
                       kasser med kant og polstring, hvor der skulle have
                       vaeret to smaa pile - samme fejl som rullelisten havde,
                       da Fluent-temaet kom til. -->
                  <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="PART_PreviousButton" Grid.Column="0"
                            Focusable="False" Width="28" Height="26" Cursor="Hand">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="kant" Background="Transparent" CornerRadius="5">
                            <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 6,0 L 6,10 L 0,5 Z"
                                  Fill="{DynamicResource TekstSvag}" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="kant" Property="Background"
                                      Value="{DynamicResource Svaev}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>

                    <!-- MAANED OG AAR. Teksten saettes af WPF ud fra kulturen,
                         saa der er ingen noegle fra sprogfilerne at binde. -->
                    <Button x:Name="PART_HeaderButton" Grid.Column="1"
                            Focusable="False" Cursor="Hand"
                            FontSize="13" FontWeight="SemiBold"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="kant" Background="Transparent"
                                  CornerRadius="5" Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="kant" Property="Background"
                                      Value="{DynamicResource Svaev}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>

                    <Button x:Name="PART_NextButton" Grid.Column="2"
                            Focusable="False" Width="28" Height="26" Cursor="Hand">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="kant" Background="Transparent" CornerRadius="5">
                            <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 0,0 L 6,5 L 0,10 Z"
                                  Fill="{DynamicResource TekstSvag}" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="kant" Property="Background"
                                      Value="{DynamicResource Svaev}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>
                  </Grid>

                  <!-- ============ DAGENE ============
                       Syv spalter og syv raekker: én til ugedagenes navne og
                       seks til de uger, en maaned kan strække sig over.
                       Tallene er ikke til at vaelge - CalendarItem fylder
                       gitteret med Grid.Row og Grid.Column i kode og regner
                       med praecis den stoerrelse. -->
                  <Grid x:Name="PART_MonthView" Grid.Row="1" Margin="0,2,0,0"
                        HorizontalAlignment="Center" Visibility="Visible">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                  </Grid>

                  <!-- ============ MAANEDER OG AARSTAL ============
                       Fire spalter og tre raekker - tolv felter, som er tolv
                       maaneder eller ti aarstal med et paa hver side. -->
                  <Grid x:Name="PART_YearView" Grid.Row="1" Margin="0,2,0,0"
                        HorizontalAlignment="Center" Visibility="Hidden">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                  </Grid>
                </Grid>
              </Border>
            </Grid>

            <ControlTemplate.Triggers>
              <!-- HVILKEN AF DE TO VISNINGER, DER STAAR FREM, AFGOERES AF
                   KALENDEREN OVENOVER. CalendarItem har ikke selv en
                   DisplayMode - den spoerger sin Calendar. -->
              <DataTrigger Value="Year"
                           Binding="{Binding DisplayMode,
                                     RelativeSource={RelativeSource AncestorType={x:Type Calendar}}}">
                <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
              </DataTrigger>
              <DataTrigger Value="Decade"
                           Binding="{Binding DisplayMode,
                                     RelativeSource={RelativeSource AncestorType={x:Type Calendar}}}">
                <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
              </DataTrigger>

              <!-- Laast betyder daempet, ikke hvid - samme regel som paa
                   datovaelgeren selv. -->
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PART_Root" Property="Opacity" Value="0.6" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Kalenderstil" TargetType="Calendar">
      <Setter Property="Background" Value="{DynamicResource Panel}" />
      <Setter Property="Foreground" Value="{DynamicResource Tekst}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelKant}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="CalendarItemStyle" Value="{StaticResource Kalenderkassen}" />
      <Setter Property="CalendarDayButtonStyle" Value="{StaticResource Kalenderdag}" />
      <Setter Property="CalendarButtonStyle" Value="{StaticResource Kalendermaaned}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Calendar">
            <StackPanel x:Name="PART_Root" HorizontalAlignment="Center">
              <CalendarItem x:Name="PART_CalendarItem"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Style="{TemplateBinding CalendarItemStyle}" />
            </StackPanel>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- En kalender, der staar direkte i et skaermbillede, kan naas af en
         implicit stil. Datovaelgerens kan ikke - se forklaringen ovenfor. -->
    <Style TargetType="Calendar" BasedOn="{StaticResource Kalenderstil}" />

    <Style TargetType="DatePicker">
      <!-- DEN HER LINJE ER SVARET PAA DEN HVIDE POPUP.
           CalendarStyle er den eneste vej ind til den kalender, datovaelgeren
           selv laver - se den lange forklaring ovenfor. -->
      <Setter Property="CalendarStyle" Value="{StaticResource Kalenderstil}" />
      <Setter Property="Background" Value="{DynamicResource Trykket}" />
      <Setter Property="Foreground" Value="{DynamicResource Tekst}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputKant}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="VerticalContentAlignment" Value="Center" />

      <!-- OGSAA SELVE FELTET FIK EN SKABELON.
           Farverne ovenfor naaede aldrig kalenderikonet til hoejre: WPF tegner
           knappen med sin egen chrome og en hardkodet hvid glyf, saa der stod
           en lille HVID kasse midt i det moerke felt. Og laast blev hele
           feltet lysegraat - «gaaet i stykker», ikke «laast».

           Delenes navne er ikke til at vaelge. DatePicker slaar PART_TextBox,
           PART_Button og PART_Popup op ved navn og goer ingenting, hvis en af
           dem mangler. Popup'ens indhold saettes af DatePicker selv - det er
           dén kalender, CalendarStyle ovenfor rammer. -->
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DatePicker">
            <Border x:Name="kant" CornerRadius="4"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <Grid x:Name="PART_Root">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                   Focusable="{TemplateBinding Focusable}"
                                   VerticalContentAlignment="Center" />

                <Button x:Name="PART_Button" Grid.Column="1" Focusable="False"
                        Width="30" Cursor="Hand">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="knap" Background="Transparent" CornerRadius="4">
                        <!-- Glyffen «Calendar» fra Segoe MDL2 Assets. Skriften
                             foelger med Windows, saa der er ingen billedfil at
                             holde styr paa. -->
                        <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TekstSvag}" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="knap" Property="Background"
                                  Value="{DynamicResource Svaev}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>

                <Popup x:Name="PART_Popup" AllowsTransparency="True"
                       Placement="Bottom" StaysOpen="False"
                       PlacementTarget="{Binding ElementName=PART_TextBox}" />
              </Grid>
            </Border>

            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="kant" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>

              <!-- SKRIVES DER I DET, ER KANTEN BLAA. Samme regel som paa
                   TextBox: graablaa i hvile, klar blaa hvor markoeren er. -->
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="kant" Property="BorderBrush" Value="{DynamicResource InputFokusKant}" />
              </Trigger>

              <!-- LAAST BETYDER DAEMPET, IKKE HVID. Et felt, man ikke kan
                   rette, skal se ud som noget, der er laast - ikke som noget,
                   der er gaaet i stykker. -->
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="kant" Property="BorderBrush" Value="{DynamicResource PanelKant}" />
                <Setter Property="Foreground" Value="{DynamicResource Slukket}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ComboBox og DataGrid arver ikke temaet af sig selv: uden disse to
         står dropdowns hvide og gitterets overskrifter mørke på mørk bund. -->
    <!-- Hele skabelonen skrives ud, fordi WPF's standardchrome er hvid og
         ignorerer Background. Kombineret med den globale TextBlock-stil, der
         gør tekst lys, blev resultatet lys tekst på hvid bund — altså en
         dropdown der så tom ud. -->
    <Style TargetType="ComboBox">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Background" Value="{DynamicResource Trykket}" />
      <Setter Property="Foreground" Value="{DynamicResource Tekst}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputKant}" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <!-- Style="{x:Null}" FJERNER TEMAETS EGEN TOGGLEBUTTON-STIL.
                   Da ThemeMode blev slaaet til, kom Fluent-temaet med en
                   implicit stil for ToggleButton, og den satte stoerrelse og
                   placering. Knappen skrumpede til pilen og lagde sig til
                   venstre - saa stod der «▾Vaelg en mappe» uden nogen kasse,
                   og intet lignede noget, man kunne klikke paa.
                   Set 28-08-2026 paa opstartdialogen.

                   Skabelonen er vores; saa skal temaets stil ikke ogsaa
                   vaere med. -->
              <ToggleButton x:Name="knap" Style="{x:Null}" Focusable="False" ClickMode="Press"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Padding="0" BorderThickness="0" Background="Transparent"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="kant" CornerRadius="4"
                            Background="{DynamicResource Trykket}"
                            BorderBrush="{DynamicResource InputKant}" BorderThickness="1">
                      <Path x:Name="pil" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,10,0" Data="M 0 0 L 4 4 L 8 0 Z"
                            Fill="{DynamicResource TekstSvag}" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="kant" Property="BorderBrush" Value="{DynamicResource Accent}" />
                      </Trigger>
                      <!-- Listen er foldet ud: dét er rullelistens «her
                           skriver jeg». Samme blaa som feltkanten faar. -->
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="kant" Property="BorderBrush" Value="{DynamicResource InputFokusKant}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>

              <ContentPresenter x:Name="valgt" IsHitTestVisible="False"
                                Margin="10,0,26,0" VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />

              <Popup x:Name="liste" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
                <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource PanelKant}"
                        BorderThickness="1" CornerRadius="4" MinWidth="{TemplateBinding ActualWidth}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Tekst}" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="kant" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="kant" Property="Background" Value="{DynamicResource Valgt}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource Svaev}" />
      <Setter Property="Foreground" Value="{DynamicResource Tekst}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelKant}" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style TargetType="DataGridCell">
      <Setter Property="Foreground" Value="{DynamicResource Tekst}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,6" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource Valgt}" />
          <Setter Property="Foreground" Value="{DynamicResource Tekst}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="DataGridRow">
      <Setter Property="Foreground" Value="{DynamicResource Tekst}" />
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Tekst}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
    </Style>

  </Application.Resources>
</Application>
