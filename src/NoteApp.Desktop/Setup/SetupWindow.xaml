<Window x:Class="NoteApp.Desktop.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Velkommen til NoteApp" Height="680" Width="780"
        Background="{StaticResource Baggrund}" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Icon="../app.ico">

  <Grid Margin="32,26,32,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
      <Image Source="../app.png" Width="52" Height="52" VerticalAlignment="Top" Margin="0,2,16,0"
             RenderOptions.BitmapScalingMode="HighQuality" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="TrinTitel" Text="Velkommen" FontSize="24" FontWeight="SemiBold" />
        <TextBlock x:Name="TrinUnder" Style="{StaticResource Underskrift}" Margin="0,4,0,0" FontSize="13" />
      </StackPanel>
    </StackPanel>

    <!-- ===================== Trin 1: hvad appen er ====================== -->
    <StackPanel x:Name="Trin1" Grid.Row="1">
      <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="20"
              BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Alt bliver på denne pc" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
          <TextBlock FontSize="13" LineHeight="22" Foreground="{StaticResource TekstSvag}"
                     Text="NoteApp optager dine møder, skriver dem ud og lærer dine fagord. Optagelser, noter og ordbog forlader aldrig maskinen — der er ingen sky, ingen konto og ingen telemetri." />
          <TextBlock FontSize="13" LineHeight="22" Margin="0,12,0,0" Foreground="{StaticResource TekstSvag}"
                     Text="Selve transskriptionen laves af Whisper, som kører lokalt. Motoren og sprogmodellen skal hentes én gang — det er det eneste, appen bruger internettet til, og du bliver spurgt først." />

          <Border Background="#334CBE72" BorderBrush="{StaticResource Godkendt}" BorderThickness="1"
                  CornerRadius="6" Padding="14,10" Margin="0,16,0,0">
            <TextBlock FontSize="12" Foreground="{StaticResource Tekst}" LineHeight="19"
                       Text="Retningen er det afgørende: der hentes NED til maskinen, og der sendes aldrig noget OP. Appen har ingen kode, der kan sende en optagelse nogen steder hen." />
          </Border>
        </StackPanel>
      </Border>

      <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="20" Margin="0,14,0,0"
              BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Dine filer ligger her" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock x:Name="DataSti" FontSize="12" FontFamily="Consolas"
                       Foreground="{StaticResource TekstSvag}" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource Underskrift}" Margin="0,6,0,0"
                       Text="Optagelser, ordbog og noter. Vælg en anden mappe, hvis du fx vil have dem på en krypteret disk." />
          </StackPanel>
          <Button Grid.Column="1" Content="Skift…" Click="SkiftMappe_Click" VerticalAlignment="Top"
                  Margin="12,0,0,0" />
        </Grid>
      </Border>
    </StackPanel>

    <!-- ===================== Trin 2: fagområde ========================== -->
    <StackPanel x:Name="Trin2" Grid.Row="1" Visibility="Collapsed">
      <TextBlock FontSize="13" Foreground="{StaticResource TekstSvag}" Margin="0,0,0,14" LineHeight="20"
                 Text="Whisper staver fagord forkert, indtil den får dem at vide. Vælg det område, der ligner dine møder mest — så starter ordbogen med de termer i stedet for tom. Du kan rette i den bagefter." />
      <ItemsControl x:Name="Brancher">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <RadioButton GroupName="branche" Tag="{Binding Id}" Checked="Branche_Valgt"
                         Margin="0,0,0,8" Foreground="{StaticResource Tekst}">
              <RadioButton.Template>
                <ControlTemplate TargetType="RadioButton">
                  <Border x:Name="kant" CornerRadius="8" Padding="16,13" Background="{StaticResource Panel}"
                          BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource Tekst}" />
                        <TextBlock Text="{Binding AntalTekst}" Style="{StaticResource Underskrift}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,4,0,0"
                                 Foreground="{StaticResource TekstSvag}" />
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="kant" Property="Background" Value="#FF2C323D" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="kant" Property="BorderBrush" Value="{StaticResource Accent}" />
                      <Setter TargetName="kant" Property="Background" Value="#FF33405A" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </RadioButton.Template>
            </RadioButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- ===================== Trin 3: navne ============================== -->
    <Grid x:Name="Trin3" Grid.Row="1" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" FontSize="13" Foreground="{StaticResource TekstSvag}" Margin="0,0,0,14" LineHeight="20"
                 Text="Navne er dem, Whisper oftest staver forkert — og de eneste, ingen skabelon kan gætte. Skriv ét navn pr. linje i begge felter." />

      <!-- To ens felter. Foerste udgave havde et flerlinjefelt og et
           enkeltlinjefelt side om side, uden at sige hvad de ville have —
           saa gaettede man paa komma i det ene og linjeskift i det andet.
           Samme kontrol, samme regel, og reglen staaende i feltet. -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,8,0">
          <TextBlock Text="Personer" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,2" />
          <TextBlock Text="Kollegaer og mødedeltagere" Style="{StaticResource Underskrift}" Margin="0,0,0,8" />
          <Grid Height="270">
            <TextBox x:Name="Navne" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontSize="14" Padding="12,10"
                     VerticalContentAlignment="Top" TextChanged="Felt_Changed" />
            <TextBlock x:Name="NavnePladsholder" IsHitTestVisible="False" FontSize="14"
                       Margin="15,12,0,0" LineHeight="24" Foreground="{StaticResource TekstMeget}"
                       VerticalAlignment="Top">
              Anders Jensen<LineBreak />Malene Holm<LineBreak />Thomas Bech<LineBreak /><LineBreak />ét navn pr. linje
            </TextBlock>
          </Grid>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="8,0,0,0">
          <TextBlock Text="Firmaer og kunder" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,2" />
          <TextBlock Text="Organisationer, I taler om" Style="{StaticResource Underskrift}" Margin="0,0,0,8" />
          <Grid Height="270">
            <TextBox x:Name="Firmaer" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontSize="14" Padding="12,10"
                     VerticalContentAlignment="Top" TextChanged="Felt_Changed" />
            <TextBlock x:Name="FirmaerPladsholder" IsHitTestVisible="False" FontSize="14"
                       Margin="15,12,0,0" LineHeight="24" Foreground="{StaticResource TekstMeget}"
                       VerticalAlignment="Top">
              Nordby Kommune<LineBreak />Kernesys<LineBreak /><LineBreak />ét navn pr. linje
            </TextBlock>
          </Grid>
        </StackPanel>
      </Grid>

      <TextBlock Grid.Row="2" Style="{StaticResource Underskrift}" Margin="0,12,0,0"
                 Text="Begge felter må stå tomme — du kan altid tilføje flere senere under Ordbog. Navnene bliver på maskinen." />
    </Grid>

    <!-- ============================ Knapper ============================ -->
    <Grid Grid.Row="2" Margin="0,20,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0" x:Name="TrinTaeller" Style="{StaticResource Underskrift}"
                 VerticalAlignment="Center" />

      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button x:Name="TilbageKnap" Content="Tilbage" Click="Tilbage_Click" Margin="0,0,8,0"
                Visibility="Collapsed" />
        <Button x:Name="NaesteKnap" Content="Kom i gang" Click="Naeste_Click"
                Style="{StaticResource Primaer}" MinWidth="140" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
