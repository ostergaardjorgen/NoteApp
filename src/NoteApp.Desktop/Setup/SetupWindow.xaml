<Window x:Class="NoteApp.Desktop.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:NoteApp.Desktop"
        Title="Velkommen til NoteApp" Height="680" Width="780" MinHeight="520" MinWidth="640"
        Background="{DynamicResource Baggrund}" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" Icon="../app.ico">
  <!-- Kan ændres i størrelse. Det er det første, en ny bruger ser, og et
       vindue, hvor «Næste» ligger uden for skærmen, er ikke til at komme
       videre fra. -->

  <Grid Margin="32,26,32,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
      <Image Source="../app.png" Width="52" Height="52" VerticalAlignment="Top" Margin="0,2,16,0"
             RenderOptions.BitmapScalingMode="HighQuality" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="TrinTitel" Text="{i18n:Oversat setupwindow.velkommen}" FontSize="24" FontWeight="SemiBold" />
        <TextBlock x:Name="TrinUnder" Style="{StaticResource Underskrift}" Margin="0,4,0,0" FontSize="13" />
      </StackPanel>
    </StackPanel>

    <!-- ===================== Trin 1: hvad appen er ====================== -->
    <StackPanel x:Name="Trin1" Grid.Row="1">
      <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="20"
              BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="{i18n:Oversat setupwindow.lyden_bliver_her_teksten_bliver_i_europa}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
          <TextBlock FontSize="13" LineHeight="22" Foreground="{DynamicResource TekstSvag}"
                     Text="{i18n:Oversat setupwindow.noteapp_optager_dine_moeder_og_skriver_dem}" />
          <TextBlock FontSize="13" LineHeight="22" Margin="0,12,0,0" Foreground="{DynamicResource TekstSvag}"
                     Text="{i18n:Oversat setupwindow.selve_transskriptionen_laves_af_whisper_so}" />

          <Border Background="#334CBE72" BorderBrush="{DynamicResource Godkendt}" BorderThickness="1"
                  CornerRadius="6" Padding="14,10" Margin="0,16,0,0">
            <TextBlock FontSize="12" Foreground="{DynamicResource Tekst}" LineHeight="19"
                       Text="{i18n:Oversat setupwindow.optagelsen_kan_ikke_sendes_nogen_steder_he}" />
          </Border>
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="20" Margin="0,14,0,0"
              BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="{i18n:Oversat setupwindow.dine_filer_ligger_her}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock x:Name="DataSti" FontSize="12" FontFamily="Consolas"
                       Foreground="{DynamicResource TekstSvag}" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource Underskrift}" Margin="0,6,0,0"
                       Text="{i18n:Oversat setupwindow.optagelser_transkriptioner_noter_og_dokume}" />
          </StackPanel>
          <Button Grid.Column="1" Content="{i18n:Oversat setupwindow.skift}" Click="SkiftMappe_Click" VerticalAlignment="Top"
                  Margin="12,0,0,0" />
        </Grid>
      </Border>
    </StackPanel>

    <!-- ===================== Trin 2: motor og model =====================
         Her stod to trin mere: fagområde og navne. De fyldte en ordbog op,
         som blev sendt med til Whisper som ledetråd — målt til NUL forskel.
         To skærme spørgsmål, før man havde set appen, for ingenting. -->
    <Grid x:Name="Trin4" Grid.Row="1" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- HER STOD "det eneste, appen bruger internettet til - der sendes
           intet fra din pc". Det var sandt, da alt kunne koere lokalt. Nu
           skrives dokumenter hos Mistral, og saa er saetningen forkert - to
           skaerme foer staar det rigtige, og de maa ikke modsige hinanden. -->
      <TextBlock Grid.Row="0" FontSize="13" Foreground="{DynamicResource TekstSvag}" Margin="0,0,0,16" LineHeight="20"
                 Text="{i18n:Oversat setupwindow.transskriptionen_laves_af_whisper_som_koer}" />

      <Border Grid.Row="1" Background="{DynamicResource Panel}" CornerRadius="10" Padding="18,15"
              BorderBrush="{DynamicResource PanelKant}" BorderThickness="1" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock x:Name="MotorOverskrift" Text="{i18n:Oversat faelles.motor}" FontSize="15" FontWeight="SemiBold" />
          <TextBlock x:Name="MotorValg" FontSize="13" Margin="0,6,0,0"
                     Foreground="{DynamicResource TekstSvag}" />
          <TextBlock x:Name="MotorBegrundelse" Style="{StaticResource Underskrift}" Margin="0,6,0,0" />
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Background="{DynamicResource Panel}" CornerRadius="10" Padding="18,15"
              BorderBrush="{DynamicResource PanelKant}" BorderThickness="1" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="{i18n:Oversat faelles.sprogmodel}" FontSize="15" FontWeight="SemiBold" />
          <TextBlock x:Name="ModelValg" FontSize="13" Margin="0,6,0,0"
                     Foreground="{DynamicResource TekstSvag}" />
          <TextBlock x:Name="ModelBegrundelse" Style="{StaticResource Underskrift}" Margin="0,6,0,0" />

          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <TextBlock Text="{i18n:Oversat setupwindow.i_alt_at_hente}" Style="{StaticResource Underskrift}" VerticalAlignment="Center" />
            <TextBlock x:Name="SamletStoerrelse" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0"
                       VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>

      <StackPanel Grid.Row="3" Margin="0,14,0,0">
        <ProgressBar x:Name="HentFremdrift" Height="6" Minimum="0" Maximum="100" Visibility="Collapsed"
                     Background="{DynamicResource Svaev}" Foreground="{DynamicResource Accent}" BorderThickness="0" />
        <TextBlock x:Name="HentStatus" Style="{StaticResource Underskrift}" Margin="0,8,0,0" />
      </StackPanel>
    </Grid>

    <!-- ============================ Knapper ============================ -->
    <Grid Grid.Row="2" Margin="0,20,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0" x:Name="TrinTaeller" Style="{StaticResource Underskrift}"
                 VerticalAlignment="Center" />

      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button x:Name="TilbageKnap" Content="{i18n:Oversat setupwindow.tilbage}" Click="Tilbage_Click" Margin="0,0,8,0"
                Visibility="Collapsed" />
        <Button x:Name="NaesteKnap" Content="{i18n:Oversat setupwindow.kom_i_gang}" Click="Naeste_Click"
                Style="{StaticResource Primaer}" MinWidth="140" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
