<Window x:Class="NoteApp.Desktop.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Velkommen til NoteApp" Height="680" Width="780" MinHeight="520" MinWidth="640"
        Background="{StaticResource Baggrund}" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" Icon="../app.ico">
  <!-- Kan ændres i størrelse. Det er det første, en ny bruger ser, og et
       vindue, hvor «Næste» ligger uden for skærmen, er ikke til at komme
       videre fra. -->

  <Grid Margin="32,26,32,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
      <Image Source="../app.png" Width="52" Height="52" VerticalAlignment="Top" Margin="0,2,16,0"
             RenderOptions.BitmapScalingMode="HighQuality" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="TrinTitel" Text="Velkommen" FontSize="24" FontWeight="SemiBold" />
        <TextBlock x:Name="TrinUnder" Style="{StaticResource Underskrift}" Margin="0,4,0,0" FontSize="13" />
      </StackPanel>
    </StackPanel>

    <!-- ===================== Trin 1: hvad appen er ====================== -->
    <StackPanel x:Name="Trin1" Grid.Row="1">
      <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="20"
              BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Lyden bliver her. Teksten bliver i Europa." FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
          <TextBlock FontSize="13" LineHeight="22" Foreground="{StaticResource TekstSvag}"
                     Text="NoteApp optager dine møder og skriver dem ud her på maskinen. Skal der laves et referat eller et andet dokument ud af teksten, sker det hos Mistral AI i Frankrig — og det er kun teksten, der sendes." />
          <TextBlock FontSize="13" LineHeight="22" Margin="0,12,0,0" Foreground="{StaticResource TekstSvag}"
                     Text="Selve transskriptionen laves af Whisper, som kører lokalt. Lydfilerne forlader aldrig maskinen — heller ikke når der laves et dokument. Motoren og modellen skal hentes én gang, og du bliver spurgt først." />

          <Border Background="#334CBE72" BorderBrush="{StaticResource Godkendt}" BorderThickness="1"
                  CornerRadius="6" Padding="14,10" Margin="0,16,0,0">
            <TextBlock FontSize="12" Foreground="{StaticResource Tekst}" LineHeight="19"
                       Text="Optagelsen kan ikke sendes nogen steder hen. Appen har ingen kode, der kan det — kun den færdige tekst kan sendes, og kun til det europæiske endepunkt. Du sætter det selv op om lidt, og du kan lade være." />
          </Border>
        </StackPanel>
      </Border>

      <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="20" Margin="0,14,0,0"
              BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Dine filer ligger her" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock x:Name="DataSti" FontSize="12" FontFamily="Consolas"
                       Foreground="{StaticResource TekstSvag}" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource Underskrift}" Margin="0,6,0,0"
                       Text="Optagelser, udskrifter, noter og dokumenter. Vælg en anden mappe, hvis du fx vil have dem på en krypteret disk." />
          </StackPanel>
          <Button Grid.Column="1" Content="Skift…" Click="SkiftMappe_Click" VerticalAlignment="Top"
                  Margin="12,0,0,0" />
        </Grid>
      </Border>
    </StackPanel>

    <!-- ===================== Trin 2: motor og model =====================
         Her stod to trin mere: fagområde og navne. De fyldte en ordbog op,
         som blev sendt med til Whisper som ledetråd — målt til NUL forskel.
         To skærme spørgsmål, før man havde set appen, for ingenting. -->
    <Grid x:Name="Trin4" Grid.Row="1" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- HER STOD "det eneste, appen bruger internettet til - der sendes
           intet fra din pc". Det var sandt, da alt kunne koere lokalt. Nu
           skrives dokumenter hos Mistral, og saa er saetningen forkert - to
           skaerme foer staar det rigtige, og de maa ikke modsige hinanden. -->
      <TextBlock Grid.Row="0" FontSize="13" Foreground="{StaticResource TekstSvag}" Margin="0,0,0,16" LineHeight="20"
                 Text="Transskriptionen laves af Whisper, som kører på din egen maskine. Motoren og en sprogmodel skal hentes én gang. Selve hentningen henter kun ned — der sendes intet fra din pc undervejs." />

      <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="10" Padding="18,15"
              BorderBrush="{StaticResource PanelKant}" BorderThickness="1" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock x:Name="MotorOverskrift" Text="Motor" FontSize="15" FontWeight="SemiBold" />
          <TextBlock x:Name="MotorValg" FontSize="13" Margin="0,6,0,0"
                     Foreground="{StaticResource TekstSvag}" />
          <TextBlock x:Name="MotorBegrundelse" Style="{StaticResource Underskrift}" Margin="0,6,0,0" />
        </StackPanel>
      </Border>

      <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="10" Padding="18,15"
              BorderBrush="{StaticResource PanelKant}" BorderThickness="1" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="Sprogmodel" FontSize="15" FontWeight="SemiBold" />
          <TextBlock x:Name="ModelValg" FontSize="13" Margin="0,6,0,0"
                     Foreground="{StaticResource TekstSvag}" />
          <TextBlock x:Name="ModelBegrundelse" Style="{StaticResource Underskrift}" Margin="0,6,0,0" />

          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <TextBlock Text="I alt at hente:" Style="{StaticResource Underskrift}" VerticalAlignment="Center" />
            <TextBlock x:Name="SamletStoerrelse" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0"
                       VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>

      <StackPanel Grid.Row="3" Margin="0,14,0,0">
        <ProgressBar x:Name="HentFremdrift" Height="6" Minimum="0" Maximum="100" Visibility="Collapsed"
                     Background="#FF2C323D" Foreground="{StaticResource Accent}" BorderThickness="0" />
        <TextBlock x:Name="HentStatus" Style="{StaticResource Underskrift}" Margin="0,8,0,0" />
      </StackPanel>
    </Grid>

    <!-- ============================ Knapper ============================ -->
    <Grid Grid.Row="2" Margin="0,20,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0" x:Name="TrinTaeller" Style="{StaticResource Underskrift}"
                 VerticalAlignment="Center" />

      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button x:Name="TilbageKnap" Content="Tilbage" Click="Tilbage_Click" Margin="0,0,8,0"
                Visibility="Collapsed" />
        <Button x:Name="NaesteKnap" Content="Kom i gang" Click="Naeste_Click"
                Style="{StaticResource Primaer}" MinWidth="140" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
