<UserControl x:Class="NoteApp.Desktop.Preferences.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:NoteApp.Desktop"
             Background="{DynamicResource Baggrund}">

  <!-- ALT DET, MAN STILLER IND, EET STED.
       «Filer og backup» laa som sit eget menupunkt. Det er ikke noget, man
       gaar til - det er en indstilling, man aabner den dag, man skal flytte
       datamappen eller gendanne noget. Menuen blev en linje laengere for
       noget, der bruges to gange om aaret.

       Fire faner i den raekkefoelge, man moeder dem: opstart foerst, fordi
       den gaelder appen som helhed; saa lyden, som er det, man vender
       tilbage til; og til sidst filer og sikkerhedskopi. -->

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="{i18n:Oversat faelles.indstillinger}" Style="{StaticResource Overskrift}" />
      <TextBlock Style="{StaticResource Underskrift}" TextWrapping="Wrap" MaxWidth="820"
                 HorizontalAlignment="Left"
                 Text="{i18n:Oversat settingsview.opstart_lyd_hvor_dine_filer_ligger_og_sikk}" />
    </StackPanel>

    <TabControl Grid.Row="1" Style="{StaticResource Fanerude}">

      <TabItem Header="{i18n:Oversat settingsview.opstart}" Style="{StaticResource Fane}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
        <!-- ========================= Udseende ===============================
             Står øverst, fordi det er det eneste her, man kan se virke med
             det samme. Alt andet på fanen er noget, der først viser sig ved
             næste møde. -->
        <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="20"
                BorderBrush="{DynamicResource PanelKant}" BorderThickness="1" Margin="0,0,0,14"
                VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Text="{i18n:Oversat settingsview.udseende}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"
                       Foreground="{DynamicResource TekstMeget}"
                       Text="{i18n:Oversat settingsview.udseende_forklaring}" />

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
              <RadioButton x:Name="TemaFoelg" GroupName="Tema" Style="{StaticResource Fanevalg}"
                           Content="{i18n:Oversat settingsview.tema_foelg}" Checked="Tema_Valgt" />
              <RadioButton x:Name="TemaLyst" GroupName="Tema" Style="{StaticResource Fanevalg}"
                           Content="{i18n:Oversat settingsview.tema_lyst}" Checked="Tema_Valgt" />
              <RadioButton x:Name="TemaMoerkt" GroupName="Tema" Style="{StaticResource Fanevalg}"
                           Content="{i18n:Oversat settingsview.tema_moerkt}" Checked="Tema_Valgt" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ===================== Klar til næste møde ======================== -->
        <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="20"
                BorderBrush="{DynamicResource PanelKant}" BorderThickness="1" Margin="0,0,0,14"
                VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Text="{i18n:Oversat settingsview.klar_til_naeste_moede}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"
                       Foreground="{DynamicResource TekstMeget}"
                       Text="{i18n:Oversat settingsview.genvejstasten_kan_kun_starte_en_optagelse}" />

            <!-- HVORFOR DET STAAR HER OG IKKE KUN VED HAKKET PAA AFTALEN.
                 Betingelsen gaelder tre funktioner, ikke én, og den er den
                 samme hver gang: et program, der ikke koerer, kan ikke starte
                 en optagelse. Staar det kun i en enkelt dialog, opdager man
                 det foerste gang et moede IKKE blev optaget - og dér er det
                 for sent. -->
            <Border Background="{DynamicResource Trykket}" BorderBrush="{DynamicResource Accent}"
                    BorderThickness="3,0,0,0" CornerRadius="4" Padding="14,11" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="{i18n:Oversat settingsview.heypia_virker_bedst_naar_den_altid_koerer}"
                           FontSize="12.5" FontWeight="SemiBold" />
                <TextBlock FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="19"
                           Foreground="{DynamicResource Tekst}"
                           Text="{i18n:Oversat settingsview.tre_ting_kan_kun_ske_mens_appen_er_aaben_g}" />
                <TextBlock FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="19"
                           Foreground="{DynamicResource Tekst}"
                           Text="{i18n:Oversat settingsview.det_er_ikke_en_begraensning_der_kan_laves}" />
                <TextBlock FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="19"
                           Foreground="{DynamicResource TekstMeget}"
                           Text="{i18n:Oversat settingsview.appen_fylder_ingenting_naar_der_ikke_optag}" />
              </StackPanel>
            </Border>

            <CheckBox x:Name="StartMedWindows" Margin="0,14,0,0" Click="Autostart_Klik"
                      Content="{i18n:Oversat settingsview.start_heypia_naar_jeg_logger_paa_windows}" />
            <TextBlock x:Name="AutostartStatus" FontSize="12" Margin="24,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TekstMeget}" />

            <!-- ============ VELKOMSTFORLØBET IGEN ============

                 Det kører én gang og forsvinder. Det er rigtigt for den, der
                 er kommet i gang — og forkert den dag maskinen skiftes, et
                 headset kommer til, eller indstillingerne af en eller anden
                 grund er væk.

                 Alt i forløbet kan også sættes hver for sig herinde. Men skal
                 man vide, HVAD der skal sættes, er en liste at gå igennem
                 bedre end en fane at lede i. -->
            <Border Background="{DynamicResource Trykket}" BorderBrush="{DynamicResource PanelKant}" BorderThickness="1"
                    CornerRadius="8" Padding="14,11" Margin="0,14,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock FontSize="13" FontWeight="SemiBold"
                             Text="{i18n:Oversat settingsview.forloeb_overskrift}" />
                  <TextBlock FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"
                             Foreground="{DynamicResource TekstSvag}"
                             Text="{i18n:Oversat settingsview.forloeb_under}" />
                </StackPanel>
                <Button Grid.Column="1" Click="Forloeb_Klik" VerticalAlignment="Center" Padding="16,9"
                        Margin="14,0,0,0" Content="{i18n:Oversat settingsview.forloeb_knap}" />
              </Grid>
            </Border>

            <Border Background="{DynamicResource Trykket}" BorderBrush="{DynamicResource PanelKant}" BorderThickness="1"
                    CornerRadius="8" Padding="14,11" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock x:Name="GenvejOverskrift" FontSize="13" FontWeight="SemiBold"
                           Text="{i18n:Oversat settingsview.lynstart_af_optagelse}" />
                <TextBlock FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"
                           Foreground="{DynamicResource TekstSvag}"
                           Text="{i18n:Oversat settingsview.tryk_kombinationen_hvor_som_helst_i_window}" />

                <!-- ============ DEN TRYKKES, DEN VAELGES IKKE ============

                     En liste kan ikke skelne mellem to taster, der hedder det
                     samme. Kommaet ved siden af M og kommaet paa
                     taltastaturet staar begge som «komma»; talraekkens 1 og
                     taltastaturets 1 staar begge som «1».

                     Det kostede en formiddag 28-08-2026: appen lyttede efter
                     den ene, brugeren trykkede paa den anden, og alt saa
                     rigtigt ud i begge ender. Trykker man den i stedet, findes
                     forskellen ikke laengere. -->
                <Border Background="{DynamicResource Trykket}" CornerRadius="8" Padding="16"
                        BorderBrush="{DynamicResource PanelKant}" BorderThickness="1"
                        Margin="0,12,0,0">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="GenvejNu" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="GenvejStatus" FontSize="12" Margin="0,4,0,0"
                                   TextWrapping="Wrap" LineHeight="19"
                                   Foreground="{DynamicResource TekstMeget}" />
                      </StackPanel>

                      <Button x:Name="GenvejVaelg" Grid.Column="1" Click="GenvejVaelg_Klik"
                              Content="{i18n:Oversat settingsview.vaelg_genvej}"
                              Style="{StaticResource Primaer}" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock x:Name="GenvejFanger" FontSize="13.5" Margin="0,14,0,0"
                               TextWrapping="Wrap" LineHeight="21" Visibility="Collapsed" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- ===================== Mødevagten ======================== -->
        <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="20"
                BorderBrush="{DynamicResource PanelKant}" BorderThickness="1" Margin="0,0,0,14"
                VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Text="{i18n:Oversat settingsview.spoerg_naar_der_starter_et_moede}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"
                       Foreground="{DynamicResource TekstMeget}"
                       Text="{i18n:Oversat settingsview.appen_kan_holde_oeje_med_om_et_andet_progr}" />

            <CheckBox x:Name="MoedevagtTil" Margin="0,14,0,0" Click="Moedevagt_Klik"
                      Content="{i18n:Oversat settingsview.spoerg_mig_naar_et_program_bruger_mikrofon}" />

            <Border Background="{DynamicResource Trykket}" BorderBrush="{DynamicResource PanelKant}" BorderThickness="1"
                    CornerRadius="8" Padding="14,11" Margin="24,10,0,0">
              <StackPanel>
                <TextBlock Text="{i18n:Oversat settingsview.hvad_appen_kigger_paa}" FontSize="12.5" FontWeight="SemiBold" />
                <TextBlock FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="19"
                           Foreground="{DynamicResource TekstSvag}"
                           Text="{i18n:Oversat settingsview.kun_windows_egen_liste_over_hvilke_program}" />
                <TextBlock FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="19"
                           Foreground="{DynamicResource TekstSvag}"
                           Text="{i18n:Oversat settingsview.der_spoerges_foerst_naar_mikrofonen_har_va}" />
              </StackPanel>
            </Border>

            <!-- ============ DE FRAVALGTE PROGRAMMER ============
                 Listen SKAL kunne rettes. Et fravalg tages med ét klik i en
                 besked, der kommer, mens man er på vej ind til et møde — og
                 så er det også dér, man kommer til at trykke forkert. Uden en
                 vej tilbage ville appen holde op med at spørge om det
                 program, man rent faktisk holder sine møder i, uden at man
                 kunne finde ud af hvorfor. -->
            <StackPanel x:Name="FravalgtPanel" Margin="24,14,0,0" Visibility="Collapsed">
              <TextBlock Text="{i18n:Oversat settingsview.der_spoerges_ikke_om_disse_programmer}" FontSize="12.5"
                         FontWeight="SemiBold" />
              <TextBlock FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" LineHeight="19"
                         Foreground="{DynamicResource TekstMeget}"
                         Text="{i18n:Oversat settingsview.fjern_et_program_fra_listen_hvis_du_kom_ti}" />

              <ItemsControl x:Name="Fravalgte" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource Trykket}" BorderBrush="{DynamicResource PanelKant}"
                            BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                      <Grid>
                        <StackPanel Margin="0,0,90,0">
                          <TextBlock Text="{Binding Navn}" FontSize="12.5" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Sti}" FontSize="10.5" Margin="0,2,0,0"
                                     TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource TekstMeget}" />
                        </StackPanel>
                        <Button Content="{i18n:Oversat settingsview.spoerg_igen}" Tag="{Binding Noegle}" Click="Fravalg_Fjern"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Padding="12,5" FontSize="11.5" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ==================== KRAV TIL MASKINEN ====================

           EN LISTE OVER ANBEFALEDE SPECIFIKATIONER LAESES ÉN GANG OG GLEMMES.
           Spoergsmaalet, folk faktisk har, er «virker det paa MIN maskine» -
           og det kan appen svare paa, fordi den koerer paa den.

           DER KONKLUDERES IKKE «FOR LANGSOM». Appen kan optage og skrive ud
           paa naesten hvad som helst; forskellen er, hvor laenge man venter.
           Et roedt kryds ville sige, at noget ikke virker, og det ville vaere
           forkert. -->
      <TabItem Header="{i18n:Oversat settingsview.krav_til_maskinen}" Style="{StaticResource Fane}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>

            <!-- ==================== HVAD DEN BRUGER LIGE NU ====================

                 DEN STAAR ØVERST, OG DET ER MED VILJE.

                 Appen starter andre programmer: whisper-cli skriver møderne
                 ud, whisper-command lytter efter vågeordet. De kan hver især
                 tage flere gigabyte og et helt grafikkort, og de kører uden
                 for appens eget vindue.

                 Målt 29-08-2026 stod der tre whisper-command tilbage fra
                 tidligere kørsler — 2,4 GB og 94 % af grafikkortet, mens
                 vågeordet var slået fra. Maskinen var mærkbart langsom, og der
                 var intet sted i appen, hvor man kunne se det. I Jobliste
                 hedder de ikke HeyPia.

                 Tallene er MÅLT på processerne, ikke skønnet. -->
            <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="20"
                    BorderBrush="{DynamicResource PanelKant}" BorderThickness="1" Margin="0,0,0,14">
              <StackPanel>
                <Grid>
                  <TextBlock Text="{i18n:Oversat settingsview.forbrug_nu}" FontSize="15" FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                  <Button x:Name="ForbrugKnap" Click="Forbrug_Klik" HorizontalAlignment="Right"
                          Padding="14,7" Content="{i18n:Oversat settingsview.forbrug_maal}" />
                </Grid>
                <TextBlock FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"
                           Foreground="{DynamicResource TekstMeget}"
                           Text="{i18n:Oversat settingsview.forbrug_under}" />

                <ItemsControl x:Name="Forbrugsliste" Margin="0,14,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource Trykket}" BorderBrush="{Binding Kant}"
                              BorderThickness="3,0,0,0" CornerRadius="6"
                              Padding="14,11" Margin="0,0,0,8">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Navn}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Hvad}" FontSize="11.5" Margin="0,4,0,0"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TekstSvag}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Cpu}" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" Foreground="{Binding Kant}" />
                            <TextBlock Text="{Binding Hukommelse}" FontSize="11.5"
                                       HorizontalAlignment="Right" Foreground="{DynamicResource TekstSvag}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="ForbrugSum" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"
                           FontWeight="SemiBold" />
                <TextBlock FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="18"
                           Foreground="{DynamicResource TekstMeget}"
                           Text="{i18n:Oversat settingsview.forbrug_hvordan}" />
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="20"
                    BorderBrush="{DynamicResource PanelKant}" BorderThickness="1" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="{i18n:Oversat settingsview.anbefalet_minimum}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"
                           Foreground="{DynamicResource TekstMeget}"
                           Text="{i18n:Oversat settingsview.alt_arbejdet_sker_paa_din_egen_maskine_uds}" />

                <ItemsControl x:Name="Kravliste" Margin="0,14,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource Trykket}" BorderBrush="{Binding Kant}"
                              BorderThickness="3,0,0,0" CornerRadius="6"
                              Padding="14,11" Margin="0,0,0,8">
                        <StackPanel>
                          <Grid>
                            <TextBlock Text="{Binding Hvad}" FontSize="13" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,0,120,0" />
                            <TextBlock Text="{Binding Har}" FontSize="11.5"
                                       HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Foreground="{Binding Kant}" />
                          </Grid>
                          <TextBlock Text="{Binding Hvorfor}" FontSize="12" Margin="0,6,0,0"
                                     TextWrapping="Wrap" LineHeight="19"
                                     Foreground="{DynamicResource TekstSvag}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- FORBEHOLDENE. De staar her og ikke i en fodnote: det er dem,
                 der afgoer, om appen passer til den, der laeser. -->
            <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="20"
                    BorderBrush="{DynamicResource Advarsel}" BorderThickness="1" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="{i18n:Oversat settingsview.forbehold}" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource Advarsel}" Margin="0,0,0,10" />

                <TextBlock FontSize="12.5" Margin="0,0,0,0" TextWrapping="Wrap" LineHeight="21"
                           Foreground="{DynamicResource TekstSvag}"
                           Text="{i18n:Oversat settingsview.kun_windows_appen_bygger_paa_windows_egen}" />

                <TextBlock FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="21"
                           Foreground="{DynamicResource TekstSvag}"
                           Text="{i18n:Oversat settingsview.appen_skal_koere_for_at_tre_ting_virker_ge}" />

                <TextBlock FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="21"
                           Foreground="{DynamicResource TekstSvag}"
                           Text="{i18n:Oversat settingsview.uden_nvidia_kort_koerer_udskriften_paa_pro}" />

                <TextBlock FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="21"
                           Foreground="{DynamicResource TekstSvag}"
                           Text="{i18n:Oversat settingsview.lyden_fylder_en_times_moede_med_to_spor_er}" />

                <TextBlock FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="21"
                           Foreground="{DynamicResource TekstSvag}"
                           Text="{i18n:Oversat settingsview.noejagtigheden_er_ikke_100_maalt_92_3_paa}" />

                <TextBlock FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="21"
                           Foreground="{DynamicResource TekstSvag}"
                           Text="{i18n:Oversat settingsview.appen_kan_skille_de_to_sider_af_et_onlinem}" />

                <TextBlock FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="21"
                           Foreground="{DynamicResource TekstSvag}"
                           Text="{i18n:Oversat settingsview.et_fysisk_moede_i_et_lokale_optages_gennem}" />
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{i18n:Oversat settingsview.lyd}" Style="{StaticResource Fane}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Grid Margin="0,0,0,14">
              <TextBlock Style="{StaticResource Underskrift}" TextWrapping="Wrap" MaxWidth="700"
                         HorizontalAlignment="Left" VerticalAlignment="Center"
                         Text="{i18n:Oversat settingsview.vaelg_mikrofon_og_hoejttaler_appen_lytter}" />
                    <!-- Måleren kræver, at mikrofonen åbnes. Det skal være et valg: en app,
                         der lytter, fordi man kigger på en indstillingsskærm, holder ikke
                         det løfte, resten af appen giver. -->
                    <Button x:Name="ProeveKnap" Content="{i18n:Oversat settingsview.proev_mikrofon_og_hoejttaler}" Click="Proeve_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="16,9"
                            Background="{DynamicResource Accent}" Foreground="{DynamicResource PaaAccent}" BorderThickness="0"
                            FontWeight="SemiBold" />
            </Grid>
        <!-- ============================ Mikrofon ============================ -->
        <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="20" Margin="0,0,0,14"
                BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="{i18n:Oversat settingsview.mikrofon}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Underskrift}" Margin="0,3,0,10"
                       Text="{i18n:Oversat settingsview.dig_optages_paa_alle_moeder_baade_fysiske}" />

            <!-- ItemTemplate frem for DisplayMemberPath: med en egen ComboBox-
                 skabelon slaar DisplayMemberPath ikke igennem paa den lukkede
                 boks, og saa staar hele objektet der i staedet for navnet. -->
            <ComboBox x:Name="Mikrofoner" SelectionChanged="Mikrofon_Valgt">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{i18n:Oversat faelles.niveau}" Style="{StaticResource Underskrift}"
                         VerticalAlignment="Center" Width="52" />
              <Border Grid.Column="1" Height="10" Background="{DynamicResource Svaev}" CornerRadius="5"
                      VerticalAlignment="Center">
                <Border x:Name="MikNiveau" HorizontalAlignment="Left" Width="0" Height="10"
                        CornerRadius="5" Background="{DynamicResource Godkendt}" />
              </Border>
              <TextBlock Grid.Column="2" x:Name="MikStatus" Style="{StaticResource Underskrift}"
                         Margin="12,0,0,0" VerticalAlignment="Center" MinWidth="150" />
            </Grid>

            <TextBlock x:Name="MikAdvarsel" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Advarsel}" Visibility="Collapsed" />

            <!-- HER LAA TO RULLELISTER MED SPROG: dit og modpartens.
                 De er fjernet 19-08-2026. En global indstilling ville vaere
                 rigtig for ét moede og forkert for det naeste - man holder
                 moeder paa dansk, paa engelsk, og med gaester der taler et
                 tredje sprog.

                 Der spoerges nu ved knappen «Opret transskription», hvor man
                 staar med det konkrete moede og VED det. Valget huskes pr.
                 moede, saa en gentagen udskrivning ikke spoerger forfra.
                 Se Transcribe\SprogvalgWindow. -->
          </StackPanel>
        </Border>

        <!-- =========================== Højttaler ============================ -->
        <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="20"
                BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="{i18n:Oversat settingsview.hoejttaler}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Underskrift}" Margin="0,3,0,10"
                       Text="{i18n:Oversat settingsview.de_andre_deltagere_vaelges_den_forkerte_bl}" />

            <ComboBox x:Name="Hoejttalere" SelectionChanged="Hoejttaler_Valgt">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{i18n:Oversat faelles.niveau}" Style="{StaticResource Underskrift}"
                         VerticalAlignment="Center" Width="52" />
              <Border Grid.Column="1" Height="10" Background="{DynamicResource Svaev}" CornerRadius="5"
                      VerticalAlignment="Center">
                <Border x:Name="HoejtNiveau" HorizontalAlignment="Left" Width="0" Height="10"
                        CornerRadius="5" Background="{DynamicResource Godkendt}" />
              </Border>
              <TextBlock Grid.Column="2" x:Name="HoejtStatus" Style="{StaticResource Underskrift}"
                         Margin="12,0,0,0" VerticalAlignment="Center" MinWidth="150" />
            </Grid>

            <TextBlock x:Name="HoejtAdvarsel" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource Advarsel}" Visibility="Collapsed" />
          </StackPanel>
        </Border>

        <!-- ====================== Er mikrofonen god nok? ====================
             Måleren ovenfor siger, at mikrofonen VIRKER. Den siger ingenting om,
             hvor godt den kan HØRES — og det er dét, hele appen står og falder
             med. Her læses en tekst, appen kender i forvejen, op i en halv
             minut, og udskriften sammenlignes ord for ord. Ét tal.

             Testen er det eneste, der er beholdt fra træningen, som blev fjernet
             18-08-2026. Resten målte nul; det her svarer på et spørgsmål, man
             ellers først får svar på efter et møde på en time. -->
        <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="20" Margin="0,0,0,14"
                BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
          <StackPanel>
            <Grid>
              <StackPanel>
                <TextBlock Text="{i18n:Oversat settingsview.er_mikrofonen_god_nok}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Underskrift}" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="620"
                           HorizontalAlignment="Left"
                           Text="{i18n:Oversat settingsview.laes_en_fast_tekst_op_i_cirka_tredive_seku}" />
              </StackPanel>
              <Button x:Name="TestKnap" Content="{i18n:Oversat settingsview.start_test}" Click="Test_Click"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Padding="16,9" MinWidth="150"
                      Background="{DynamicResource Accent}" Foreground="{DynamicResource PaaAccent}" BorderThickness="0"
                      FontWeight="SemiBold" />
            </Grid>

            <!-- Selve oplæsningen. Teksten skal fylde, mens den læses — man skal
                 kunne se den uden at læne sig frem. -->
            <Border x:Name="TestRude" Background="{DynamicResource Trykket}" BorderBrush="{DynamicResource PanelKant}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,14,0,0"
                    Visibility="Collapsed">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <TextBlock x:Name="TestTrin" FontSize="13" FontWeight="SemiBold"
                             Foreground="{DynamicResource Accent}" Text="{i18n:Oversat settingsview.laes_hoejt_i_almindeligt_tempo}" />
                  <TextBlock x:Name="TestUr" FontSize="13" HorizontalAlignment="Right"
                             Foreground="{DynamicResource TekstSvag}" FontFamily="Consolas" />
                </Grid>

                <TextBlock x:Name="TestTekst" FontSize="15.5" LineHeight="30" TextWrapping="Wrap"
                           Foreground="{DynamicResource Tekst}" />

                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{i18n:Oversat faelles.niveau}" Style="{StaticResource Underskrift}"
                             VerticalAlignment="Center" Width="52" />
                  <Border Grid.Column="1" Height="10" Background="{DynamicResource Svaev}" CornerRadius="5"
                          VerticalAlignment="Center">
                    <Border x:Name="TestNiveau" HorizontalAlignment="Left" Width="0" Height="10"
                            CornerRadius="5" Background="{DynamicResource Godkendt}" />
                  </Border>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Resultatet. Tallet står stort, fordi det er det, man kom efter;
                 rådet står under, fordi et tal uden en vej videre er ubrugeligt. -->
            <Border x:Name="TestSvar" Background="{DynamicResource Trykket}" BorderBrush="{DynamicResource PanelKant}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,14,0,0"
                    Visibility="Collapsed">
              <StackPanel>
                <Grid>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TestTal" FontSize="30" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="TestDom" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TekstSvag}" />
                  </StackPanel>
                </Grid>

                <TextBlock x:Name="TestRaad" FontSize="12.5" LineHeight="21" TextWrapping="Wrap"
                           Margin="0,10,0,0" Foreground="{DynamicResource TekstSvag}" MaxWidth="640"
                           HorizontalAlignment="Left" />

                <Expander x:Name="TestDetalje" Header="{i18n:Oversat settingsview.saadan_hoerte_appen_det}" Margin="0,12,0,0"
                          Foreground="{DynamicResource TekstMeget}" FontSize="12">
                  <StackPanel Margin="0,10,0,0">
                    <TextBlock x:Name="TestFejl" FontSize="12.5" TextWrapping="Wrap" LineHeight="21"
                               Foreground="{DynamicResource TekstSvag}" Margin="0,0,0,10" />
                    <TextBlock x:Name="TestUdskrift" FontSize="12.5" TextWrapping="Wrap" LineHeight="21"
                               FontFamily="Consolas" Foreground="{DynamicResource TekstMeget}" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>

            <TextBlock x:Name="TestStatus" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TekstMeget}" />
          </StackPanel>
        </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ==================== DIKTERING ====================

           HER SENDES DIN EGEN STEMME UD AF HUSET, og det staar oeverst paa
           fanen frem for nede ved kontakten. Moedernes lyd bliver paa
           maskinen; det gaelder ikke det, du selv dikterer, og forskellen
           skal vaere til at se, foer man slaar noget til.

           Fanen ligger mellem «Lyd» og «Integrationer»: den bruger
           mikrofonen, men den er en del af appen og ikke en forbindelse til
           en anden leverandoer. -->
      <TabItem Header="{i18n:Oversat settingsview.diktering}" Style="{StaticResource Fane}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>

            <TextBlock Style="{StaticResource Underskrift}" TextWrapping="Wrap" MaxWidth="700"
                       HorizontalAlignment="Left" Margin="0,0,0,14"
                       Text="{i18n:Oversat settingsview.diktering_intro}" />

            <!-- Graensen for lyden. Staar med accentkant, fordi den er
                 forskellen paa det, der bliver, og det, der sendes. -->
            <Border Background="{DynamicResource AccentFlade}" CornerRadius="10" Padding="20"
                    Margin="0,0,0,14" BorderBrush="{DynamicResource Accent}" BorderThickness="1">
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Tekst}"
                         Text="{i18n:Oversat settingsview.diktering_lyd}" />
            </Border>

            <!-- ============================ Til eller fra ============================ -->
            <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="20" Margin="0,0,0,14"
                    BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
              <StackPanel>
                <CheckBox x:Name="DikteringTil" Click="DikteringTil_Klik"
                          Content="{i18n:Oversat settingsview.diktering_til}" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Underskrift}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="{i18n:Oversat settingsview.diktering_til_under}" />
                <TextBlock Style="{StaticResource Underskrift}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="{i18n:Oversat settingsview.diktering_til_pris}" />

                <TextBlock x:Name="DikteringNoegle" Margin="0,10,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource Advarsel}" Visibility="Collapsed"
                           Text="{i18n:Oversat settingsview.diktering_kraever_noegle}" />
              </StackPanel>
            </Border>

            <!-- ======================== Sproget, DU taler ========================

                 DET SKAL VÆLGES, OG DET SKAL STÅ HØJT PÅ SIDEN.

                 Uden et sprog gætter modellen. På et kort klip er der næsten
                 intet at gætte ud fra, og gætter den forkert, er hvert eneste
                 ord forkert — ikke bare et enkelt.

                 Målt 30-08-2026: «hallo, hallo, hallo» sagt på dansk kom
                 tilbage som «Alors, alors, alors ?». Fransk.

                 Og man VED altid, hvilket sprog man selv dikterer på. Det er
                 ens egen stemme; der er ikke noget at gætte om. -->
            <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="20" Margin="0,0,0,14"
                    BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="{i18n:Oversat settingsview.diktering_sprog}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Underskrift}" Margin="0,3,0,10" TextWrapping="Wrap"
                           Text="{i18n:Oversat settingsview.diktering_sprog_under}" />

                <ComboBox x:Name="DikteringSprog" Width="240" HorizontalAlignment="Left"
                          SelectionChanged="DikteringSprog_Valgt">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Navn}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Style="{StaticResource Underskrift}" Margin="0,12,0,0" TextWrapping="Wrap"
                           Text="{i18n:Oversat settingsview.diktering_sprog_hvorfor}" />
              </StackPanel>
            </Border>

            <!-- ============================ Laengste diktering ============================ -->
            <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="20" Margin="0,0,0,14"
                    BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="{i18n:Oversat settingsview.diktering_loft}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Underskrift}" Margin="0,3,0,10" TextWrapping="Wrap"
                           Text="{i18n:Oversat settingsview.diktering_loft_under}" />

                <StackPanel Orientation="Horizontal">
                  <ComboBox x:Name="DikteringLoft" Width="90" SelectionChanged="DikteringLoft_Valgt" />
                  <TextBlock Text="{i18n:Oversat settingsview.diktering_minutter}" VerticalAlignment="Center"
                             Margin="10,0,0,0" Foreground="{DynamicResource TekstSvag}" />
                </StackPanel>

                <TextBlock Style="{StaticResource Underskrift}" Margin="0,12,0,0" TextWrapping="Wrap"
                           Text="{i18n:Oversat settingsview.diktering_loft_hvorfor}" />
              </StackPanel>
            </Border>

            <!-- ============================ Formen ============================ -->
            <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="20" Margin="0,0,0,14"
                    BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="{i18n:Oversat settingsview.diktering_formaal}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Underskrift}" Margin="0,3,0,10" TextWrapping="Wrap"
                           Text="{i18n:Oversat settingsview.diktering_formaal_under}" />

                <ComboBox x:Name="DikteringFormaal" SelectionChanged="DikteringFormaal_Valgt">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Navn}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Border>

            <!-- ============================ Hvor teksten lander ============================ -->
            <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="20" Margin="0,0,0,14"
                    BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
              <StackPanel>
                <CheckBox x:Name="DikteringIndsaet" Click="DikteringIndsaet_Klik"
                          Content="{i18n:Oversat settingsview.diktering_indsaet}" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Underskrift}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="{i18n:Oversat settingsview.diktering_indsaet_under}" />
                <TextBlock Style="{StaticResource Underskrift}" Margin="0,8,0,16" TextWrapping="Wrap"
                           Text="{i18n:Oversat settingsview.diktering_indsaet_hvorfor}" />

                <CheckBox x:Name="DikteringEfterProgram" Click="DikteringEfterProgram_Klik"
                          Content="{i18n:Oversat settingsview.diktering_efter_program}" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Underskrift}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="{i18n:Oversat settingsview.diktering_efter_program_under}" />
              </StackPanel>
            </Border>

            <!-- ============================ Oprydning og ordliste ============================ -->
            <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="20" Margin="0,0,0,14"
                    BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
              <StackPanel>
                <CheckBox x:Name="DikteringPuds" Click="DikteringPuds_Klik"
                          Content="{i18n:Oversat settingsview.diktering_puds}" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Underskrift}" Margin="0,6,0,16" TextWrapping="Wrap"
                           Text="{i18n:Oversat settingsview.diktering_puds_under}" />

                <CheckBox x:Name="DikteringFagord" Click="DikteringFagord_Klik"
                          Content="{i18n:Oversat settingsview.diktering_fagord}" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Underskrift}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="{i18n:Oversat settingsview.diktering_fagord_under}" />
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ==================== INTEGRATIONER ====================

           EGEN FANE, FORDI DER KOMMER FLERE. Google er den første, Microsoft
           365 den næste, og forskellen på dem er kun, hvor man henter en
           nøgle. Lå Google under «Opstart» eller «Filer», ville den næste
           skulle lægges et tredje sted.

           DET, DER GØR DEN HER FANE ANDERLEDES END RESTEN AF APPEN, SKAL
           STÅ ØVERST. Alt andet bliver på maskinen; her taler appen med en
           amerikansk leverandør. Det er i orden — men det skal siges, og det
           skal siges før knapperne, ikke under dem. -->
      <TabItem Header="{i18n:Oversat settingsview.integrationer}" Style="{StaticResource Fane}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>

            <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="20"
                    BorderBrush="{DynamicResource PanelKant}" BorderThickness="1" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="{i18n:Oversat settingsview.kalendere_fra_andre_tjenester}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"
                           Foreground="{DynamicResource TekstMeget}"
                           Text="{i18n:Oversat settingsview.appen_kan_laese_dine_aftaler_ind_i_kalende}" />

                <Border Background="{DynamicResource Trykket}" BorderBrush="{DynamicResource Accent}"
                        BorderThickness="3,0,0,0" CornerRadius="4" Padding="14,11" Margin="0,14,0,0">
                  <StackPanel>
                    <TextBlock Text="{i18n:Oversat settingsview.hvad_der_bliver_sendt_og_hvad_der_ikke_goe}"
                               FontSize="12.5" FontWeight="SemiBold" />
                    <TextBlock FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="19"
                               Foreground="{DynamicResource Tekst}"
                               Text="{i18n:Oversat settingsview.aftaler_hentes_ned_den_anden_vej_sker_kun}" />
                    <TextBlock FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="19"
                               Foreground="{DynamicResource Tekst}"
                               Text="{i18n:Oversat settingsview.lyden_transkriptionerne_dine_noter_og_doku}" />
                    <TextBlock FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="19"
                               Foreground="{DynamicResource TekstMeget}"
                               Text="{i18n:Oversat settingsview.google_og_microsoft_er_amerikanske_bruger}" />
                  </StackPanel>
                </Border>

                <!-- KVITTERINGEN LAASER KNAPPERNE OP.
                     En knap, man kan trykke paa uden at have laest noget, goer
                     teksten ovenover til pynt. Der spoerges ÉN gang og huskes;
                     et spoergsmaal, der kommer igen hver gang, laeses ikke
                     anden gang. -->
                <CheckBox x:Name="IntegrationerLaest" Margin="0,14,0,0"
                          Click="IntegrationerLaest_Klik"
                          Content="{i18n:Oversat settingsview.dette_er_laest_og_forstaaet}" />

                <TextBlock x:Name="LaestNote" FontSize="11.5" Margin="24,5,0,0"
                           TextWrapping="Wrap" LineHeight="18"
                           Foreground="{DynamicResource TekstMeget}"
                           Text="{i18n:Oversat settingsview.saet_hakket_for_at_kunne_aktivere_en_integ}" />
              </StackPanel>
            </Border>

            <!-- ============ NOTEN I MOEDEINDKALDELSEN ============

                 DEN STAAR HER OG IKKE I AFTALEVINDUET. Den er en indstilling,
                 man saetter én gang - ikke et valg, man traeffer for hvert
                 moede. Laa den i aftalevinduet, skulle den laeses igennem hver
                 gang, man lavede en aftale.

                 DEN KAN RETTES, MEN IKKE FJERNES. Appen opfordrer ALTID til at
                 fortaelle deltagerne, at der optages; et tomt felt er ikke et
                 valg om at lade vaere, det er et felt, ingen har udfyldt - og
                 saa bruges standarden. -->
            <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="20"
                    BorderBrush="{DynamicResource PanelKant}" BorderThickness="1" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="{i18n:Oversat settingsview.teksten_i_moedeindkaldelsen}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"
                           Foreground="{DynamicResource TekstMeget}"
                           Text="{i18n:Oversat settingsview.er_en_aftale_markeret_til_at_blive_optaget}" />

                <!-- TO SPROG, FORDI EN INDKALDELSE PAA DANSK TIL EN, DER IKKE
                     LAESER DANSK, IKKE ER EN OPLYSNING. Retten til at sige fra
                     er kun vaerd at have, hvis den kan laeses - og et moede,
                     hvor sproget er sat til engelsk, har med sikkerhed
                     deltagere, der ikke laeser dansk.

                     Sproget vaelges IKKE her. Det tages fra aftalen: er moedet
                     sat til engelsk, er indkaldelsen det ogsaa. -->
                <TabControl Margin="0,14,0,0" Style="{StaticResource Fanerude}">

                  <TabItem Header="{i18n:Oversat faelles.dansk}" Style="{StaticResource Fane}">
                    <TextBox x:Name="Optagenote" FontSize="12"
                             MinHeight="220" MaxHeight="320" Padding="12,10"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             TextChanged="Optagenote_Aendret" />
                  </TabItem>

                  <TabItem Header="{i18n:Oversat settingsview.english}" Style="{StaticResource Fane}">
                    <TextBox x:Name="OptagenoteEn" FontSize="12"
                             MinHeight="220" MaxHeight="320" Padding="12,10"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             TextChanged="Optagenote_Aendret" />
                  </TabItem>
                </TabControl>

                <TextBlock FontSize="11.5" Margin="2,7,0,0" TextWrapping="Wrap" LineHeight="18"
                           Foreground="{DynamicResource TekstMeget}"
                           Text="{i18n:Oversat settingsview.sproget_vaelges_ikke_her_det_tages_fra_aft}" />

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <Button Content="{i18n:Oversat settingsview.gem_teksten}" Click="GemNote_Klik" Padding="18,8"
                          Style="{StaticResource Primaer}" />
                  <Button Content="{i18n:Oversat settingsview.nulstil_til_standard}" Click="NulstilNote_Klik"
                          Padding="14,8" Margin="10,0,0,0" />
                  <TextBlock x:Name="Notestatus" FontSize="11.5" Margin="14,0,0,0"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TekstMeget}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <ItemsControl x:Name="Integrationsliste">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="20"
                          BorderBrush="{DynamicResource PanelKant}" BorderThickness="1"
                          Margin="0,0,0,14">
                    <StackPanel>

                      <Grid>
                        <StackPanel Margin="0,0,120,0">
                          <TextBlock Text="{Binding Navn}" FontSize="15" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Under}" FontSize="12" Margin="0,4,0,0"
                                     TextWrapping="Wrap" Foreground="{DynamicResource TekstMeget}" />
                        </StackPanel>

                        <Border CornerRadius="4" Padding="9,3" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Background="{DynamicResource Svaev}">
                          <TextBlock Text="{Binding Tilstand}" FontSize="10.5"
                                     FontWeight="SemiBold" Foreground="{Binding Tilstandsfarve}" />
                        </Border>
                      </Grid>

                      <TextBlock Text="{Binding Hvad}" FontSize="12.5" Margin="0,12,0,0"
                                 TextWrapping="Wrap" LineHeight="20"
                                 Foreground="{DynamicResource TekstSvag}" />

                      <TextBlock Text="{Binding Hvordan}" FontSize="12" Margin="0,7,0,0"
                                 TextWrapping="Wrap" LineHeight="19"
                                 Foreground="{DynamicResource TekstMeget}" />

                      <!-- ÉN KNAP. Der er intet at udfylde.

                           Her stod to felter til et klient-id, brugeren selv
                           skulle hente i Google Cloud Console. Det virker
                           teknisk og er forkert som produkt: den, der skal
                           optage et møde om fem minutter, opretter ikke et
                           cloud-projekt først. Appen har sit eget id nu. -->
                      <StackPanel Visibility="{Binding Opsaetningsvis}" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                          <Button Content="{i18n:Oversat settingsview.aktiver}" Tag="{Binding Id}" Click="Forbind_Klik"
                                  Style="{StaticResource Primaer}" Padding="20,8"
                                  Visibility="{Binding Forbindvis}"
                                  IsEnabled="{Binding MaaAktivere}"
                                  ToolTip="{Binding Aktivertip}" />
                          <Button Content="{i18n:Oversat settingsview.hent_aftaler_nu}" Tag="{Binding Id}" Click="Hent_Klik"
                                  Padding="14,8" Visibility="{Binding Forbundetvis}" />
                          <Button Content="{i18n:Oversat settingsview.afbryd_forbindelsen}" Tag="{Binding Id}" Click="Afbryd_Klik"
                                  Padding="14,8" Margin="8,0,0,0"
                                  Visibility="{Binding Forbundetvis}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Sidst}" FontSize="11.5" Margin="0,12,0,0"
                                   TextWrapping="Wrap" LineHeight="18"
                                   Foreground="{DynamicResource TekstMeget}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{i18n:Oversat settingsview.filer}" Style="{StaticResource Fane}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
        <!-- ===================== Plads og lydfiler =========================

             HVORFOR DEN HER SEKTION FINDES

             En times moede fylder 220 MB som lyd og 56 KB som tekst. Efter et
             aars brug er lyden titusind gange saa meget som det, man faktisk
             slaar op i - og det er maalt, at lyden IKKE kan komprimeres uden
             at oedelaegge udskriften af moeder med flere sprog (findings 9.2).
             Saa er sletning det eneste haandtag, der er tilbage.

             TALLENE STAAR FOERST OG VALGET BAGEFTER. Man kan ikke tage
             stilling til, hvor laenge lyden skal blive liggende, uden at vide
             hvad den fylder. -->
        <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="20" Margin="0,0,0,14"
                BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="{i18n:Oversat settingsview.plads_og_lydfiler}" FontSize="15" FontWeight="SemiBold" />
            <TextBlock FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"
                       Foreground="{DynamicResource TekstMeget}"
                       Text="{i18n:Oversat settingsview.lyden_er_det_eneste_i_appen_der_fylder_nog}" />

            <!-- BJAELKEN. Den siger paa ét blik, hvad disken gaar til:
                 blaat er appens lyd, graat er alt det andet, moerkt er
                 ledigt. -->
            <Border CornerRadius="4" Height="26" Margin="0,16,0,0" Background="{DynamicResource Trykket}"
                    BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition x:Name="SoejleLyd" Width="0*" />
                  <ColumnDefinition x:Name="SoejleAndet" Width="0*" />
                  <ColumnDefinition x:Name="SoejleFri" Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource Accent}" />
                <Border Grid.Column="1" Background="{DynamicResource PanelKant}" />
              </Grid>
            </Border>

            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                  <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Accent}"
                          VerticalAlignment="Center" Margin="0,0,7,0" />
                  <TextBlock Text="{i18n:Oversat settingsview.lydfiler}" FontSize="10.5" FontWeight="SemiBold"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TekstMeget}" />
                </StackPanel>
                <TextBlock x:Name="PladsLyd" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0" />
                <TextBlock x:Name="PladsLydUnder" FontSize="11" Margin="0,2,0,0"
                           TextWrapping="Wrap" Foreground="{DynamicResource TekstMeget}" />
              </StackPanel>

              <StackPanel Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                  <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource PanelKant}"
                          VerticalAlignment="Center" Margin="0,0,7,0" />
                  <TextBlock Text="{i18n:Oversat settingsview.alt_det_andet}" FontSize="10.5" FontWeight="SemiBold"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TekstMeget}" />
                </StackPanel>
                <TextBlock x:Name="PladsBrugt" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0" />
                <TextBlock x:Name="PladsBrugtUnder" FontSize="11" Margin="0,2,0,0"
                           TextWrapping="Wrap" Foreground="{DynamicResource TekstMeget}" />
              </StackPanel>

              <StackPanel Grid.Column="2">
                <TextBlock Text="{i18n:Oversat settingsview.ledigt}" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TekstMeget}" />
                <TextBlock x:Name="PladsFri" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0" />
                <TextBlock x:Name="PladsFriUnder" FontSize="11" Margin="0,2,0,0"
                           TextWrapping="Wrap" Foreground="{DynamicResource TekstMeget}" />
              </StackPanel>
            </Grid>

            <!-- ============ HVOR LAENGE LYDEN BLIVER LIGGENDE ============ -->
            <Border Background="{DynamicResource Trykket}" BorderBrush="{DynamicResource PanelKant}" BorderThickness="1"
                    CornerRadius="8" Padding="14,12" Margin="0,18,0,0">
              <StackPanel>
                <TextBlock Text="{i18n:Oversat settingsview.hvor_laenge_lyden_bliver_liggende}" FontSize="13" FontWeight="SemiBold" />
                <TextBlock FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="19"
                           Foreground="{DynamicResource TekstSvag}"
                           Text="{i18n:Oversat settingsview.naar_en_optagelse_er_skrevet_ud_er_det_tek}" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <ComboBox x:Name="Lydfrist" Width="230" FontSize="12.5" Padding="8,5"
                            SelectionChanged="Lydfrist_Valgt">
                    <ComboBox.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding Navn}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <Button x:Name="RydNuKnap" Content="{i18n:Oversat settingsview.ryd_nu}" Click="RydLyd_Klik"
                          Margin="10,0,0,0" Padding="14,6" FontSize="12"
                          ToolTip="{i18n:Oversat settingsview.rydder_lyden_paa_de_optagelser_der_allered}" />
                </StackPanel>

                <TextBlock x:Name="Lydfriststatus" FontSize="11.5" Margin="2,9,0,0"
                           TextWrapping="Wrap" LineHeight="18"
                           Foreground="{DynamicResource TekstMeget}" />

                <!-- SPOERGSMAALET EFTER ET LANGT MOEDE.
                     Et almindeligt moede fylder ikke nok til at vaere vaerd at
                     tage stilling til. Et heldagsseminar fylder en halv
                     gigabyte, og det er dét, man opdager en dag, disken er
                     fuld. Der spoerges KUN én gang, lige efter udskriften -
                     dér, hvor man netop har set teksten. -->
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <TextBlock Text="{i18n:Oversat settingsview.spoerg_efter_moeder_over}" FontSize="12.5"
                             VerticalAlignment="Center" Margin="0,0,10,0"
                             Foreground="{DynamicResource TekstSvag}" />

                  <ComboBox x:Name="Spoergegraense" Width="150" FontSize="12.5" Padding="8,5"
                            SelectionChanged="Spoergegraense_Valgt">
                    <ComboBox.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding Navn}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>

                <TextBlock FontSize="11.5" Margin="2,7,0,0" TextWrapping="Wrap" LineHeight="18"
                           Foreground="{DynamicResource TekstMeget}"
                           Text="{i18n:Oversat settingsview.saa_snart_et_langt_moede_er_skrevet_ud_spo}" />
              </StackPanel>
            </Border>

            <!-- ============ HVAD DER GAAR TABT ============
                 Den staar som en advarsel og ikke som en fodnote. En
                 sletning, man fortryder om et aar, kan ikke goeres om. -->
            <Border Background="{DynamicResource Trykket}" BorderBrush="{DynamicResource Advarsel}"
                    BorderThickness="3,0,0,0" CornerRadius="4" Padding="14,11" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="{i18n:Oversat settingsview.det_du_ikke_kan_bagefter}" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource Advarsel}" />

                <TextBlock FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="19"
                           Foreground="{DynamicResource Tekst}"
                           Text="{i18n:Oversat settingsview.skrive_optagelsen_ud_igen_med_en_bedre_mod}" />

                <TextBlock FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="19"
                           Foreground="{DynamicResource TekstMeget}"
                           Text="{i18n:Oversat settingsview.at_klikke_paa_en_saetning_og_hoere_den_er}" />

                <TextBlock FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="19"
                           Foreground="{DynamicResource TekstMeget}"
                           Text="{i18n:Oversat settingsview.teksten_dine_noter_opgaverne_og_dokumenter}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- ====================== Overvaagede mapper ======================

             HVORFOR DEN LIGGER UNDER FILER OG IKKE UNDER INTEGRATIONER

             Fordi det ikke ER en integration. Der er ingen konto, ingen
             noegle og ingen tjeneste - appen kigger i en mappe paa disken.
             Laa den under Integrationer, ville den love noget, den ikke
             goer, og staa paa Compliance-siden uden at hoere til der. -->
        <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="20" Margin="0,0,0,14"
                BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="{i18n:Oversat settingsview.overvaagede_mapper}" FontSize="15" FontWeight="SemiBold" />

            <TextBlock Style="{StaticResource Underskrift}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TekstMeget}"
                       Text="{i18n:Oversat settingsview.peg_appen_paa_en_mappe_dukker_der_en_lydfi}" />

            <!-- METODEN, KORT. Den lange udgave staar i
                 doc/overvaagede-mapper.md, men det, der har betydning for, om
                 man tror paa funktionen, skal staa HER, hvor den slaas til. -->
            <Border Background="{DynamicResource Baggrund}" CornerRadius="8" Padding="14,12"
                    Margin="0,14,0,0" BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="{i18n:Oversat settingsview.saadan_kigger_den}" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TekstMeget}" Margin="0,0,0,8" />

                <TextBlock FontSize="12" LineHeight="19" TextWrapping="Wrap"
                           Foreground="{DynamicResource TekstSvag}"
                           Text="{i18n:Oversat settingsview.hvert_minut_saa_laenge_appen_er_aaben_der}" />
                <TextBlock FontSize="12" LineHeight="19" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource TekstSvag}"
                           Text="{i18n:Oversat settingsview.der_laeses_aldrig_i_en_fil_kun_navn_stoerr}" />
                <TextBlock FontSize="12" LineHeight="19" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource TekstSvag}"
                           Text="{i18n:Oversat settingsview.en_fil_skal_have_ligget_stille_i_tyve_seku}" />
                <TextBlock FontSize="12" LineHeight="19" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource TekstSvag}"
                           Text="{i18n:Oversat settingsview.hver_fil_tilbydes_en_gang_siger_du_nej_kom}" />
              </StackPanel>
            </Border>

            <ItemsControl x:Name="Overvaagede" Margin="0,16,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource Baggrund}" CornerRadius="8" Padding="14,12"
                          Margin="0,0,0,8" BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <TextBlock Text="{Binding Sti}" FontSize="12.5" FontFamily="Consolas"
                                   TextWrapping="Wrap" Foreground="{DynamicResource Tekst}" />
                        <TextBlock Text="{Binding Linje}" FontSize="11.5" Margin="0,4,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TekstMeget}" />
                      </StackPanel>

                      <CheckBox Grid.Column="1" IsChecked="{Binding Automatisk, Mode=TwoWay}"
                                VerticalAlignment="Center" FontSize="12" Margin="0,0,14,0"
                                Content="{i18n:Oversat settingsview.laeg_ind_automatisk}"
                                ToolTip="{i18n:Oversat settingsview.uden_hak_bliver_filen_tilbudt_paa_optagels}" />

                      <Button Grid.Column="2" Content="{i18n:Oversat settingsview.fjern}" Click="FjernMappe_Click"
                              Tag="{Binding Sti}" Padding="14,6" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="IngenOvervaagede" FontSize="12.5" TextWrapping="Wrap"
                       Margin="0,16,0,0" Visibility="Collapsed"
                       Foreground="{DynamicResource TekstMeget}"
                       Text="{i18n:Oversat settingsview.ingen_mapper_overvaages_tilfoej_en_eller_o}" />

            <!-- SKYTJENESTERNE, DER ER FUNDET.
                 De findes ved at spoerge Windows selv om, hvor de
                 synkroniserer hen. At gaette paa stier under brugermappen
                 blev proevet og fejlede. -->
            <ItemsControl x:Name="Skytjenester" Margin="0,14,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,14,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Navn}" FontSize="12.5" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Sti}" FontSize="11" FontFamily="Consolas"
                                 TextWrapping="Wrap" Foreground="{DynamicResource TekstMeget}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding Knap}" Click="OpretSkymappe_Click"
                            Tag="{Binding Sti}" Padding="14,6" VerticalAlignment="Center"
                            IsEnabled="{Binding Kan}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock x:Name="Bogen" Grid.Column="0" FontSize="11.5" TextWrapping="Wrap"
                         VerticalAlignment="Center" Margin="0,0,14,0"
                         Foreground="{DynamicResource TekstMeget}" />

              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{i18n:Oversat settingsview.glem_hvad_der_er_set}" Click="GlemSete_Click" Padding="14,7"
                        Margin="0,0,10,0"
                        ToolTip="{i18n:Oversat settingsview.alle_filer_i_mapperne_bliver_tilbudt_igen}" />
                <Button Content="{i18n:Oversat settingsview.tilfoej_mappe}" Click="TilfoejMappe_Click" Padding="16,7"
                        Style="{StaticResource Primaer}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- ========================== Datamappen =========================== -->
        <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="20" Margin="0,0,0,14"
                BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
              <TextBlock Text="{i18n:Oversat settingsview.dine_filer}" FontSize="15" FontWeight="SemiBold" />
              <TextBlock x:Name="DataSti" FontSize="13" FontFamily="Consolas" Margin="0,6,0,0" TextWrapping="Wrap" />
              <TextBlock x:Name="DataIndhold" Style="{StaticResource Underskrift}" Margin="0,6,0,0" />
              <TextBlock Style="{StaticResource Underskrift}" Margin="0,8,0,0" Foreground="{DynamicResource TekstMeget}"
                         Text="{i18n:Oversat settingsview.optagelser_transkriptioner_noter_og_dokume}" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <Button Content="{i18n:Oversat faelles.skift_mappe}" Click="SkiftData_Click" MinWidth="130" />
              <Button Content="{i18n:Oversat faelles.aabn_mappen}" Click="AabnData_Click" Margin="0,8,0,0" MinWidth="130" />
            </StackPanel>
          </Grid>
        </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{i18n:Oversat faelles.sikkerhedskopi}" Style="{StaticResource Fane}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
        <!-- ======================== Sikkerhedskopi ========================= -->
        <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="20"
                BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
              <TextBlock Text="{i18n:Oversat faelles.sikkerhedskopi}" FontSize="15" FontWeight="SemiBold" />
              <TextBlock x:Name="BackupSti" FontSize="13" FontFamily="Consolas" Margin="0,6,0,0" TextWrapping="Wrap" />
              <TextBlock x:Name="BackupSenest" Style="{StaticResource Underskrift}" Margin="0,6,0,0" />
              <TextBlock x:Name="BackupAdvarsel" FontSize="12" Margin="0,8,0,0"
                         Foreground="{DynamicResource Advarsel}" Visibility="Collapsed" TextWrapping="Wrap" />

              <!-- Hvad kommer med. Lyd er fra som standard: den fylder alt, og
                   den er det, der er lettest at undvære — arbejdet ligger i
                   transskriptionen og de færdige dokumenter. -->
              <Border Background="{DynamicResource Trykket}" CornerRadius="6" Padding="12,10" Margin="0,12,0,0"
                      BorderThickness="1" BorderBrush="{DynamicResource PanelKant}">
                <StackPanel>
                  <TextBlock Text="{i18n:Oversat settingsview.hvad_kommer_med}" Style="{StaticResource Underskrift}" Margin="0,0,0,8" />

                  <TextBlock FontSize="12" Foreground="{DynamicResource TekstSvag}" Margin="0,0,0,8"
                             Text="{i18n:Oversat settingsview.altid_med_noter_transskriptioner_dokumente}" />

                  <CheckBox x:Name="TagLydMed" Content="{i18n:Oversat settingsview.tag_ogsaa_lydfilerne_med}" Click="Lyd_Klik" />
                  <TextBlock x:Name="LydStoerrelse" Style="{StaticResource Underskrift}" Margin="24,4,0,0"
                             Foreground="{DynamicResource TekstMeget}" />
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <Button Content="{i18n:Oversat faelles.skift_mappe}" Click="SkiftBackup_Click" MinWidth="130" />
              <Button x:Name="KoerKnap" Content="{i18n:Oversat settingsview.tag_backup_nu}" Click="Koer_Click"
                      Style="{StaticResource Primaer}" Margin="0,8,0,0" MinWidth="130" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- ========================== Arkiverne ============================ -->
        <Border Background="{DynamicResource Panel}" CornerRadius="10" Margin="0,14,0,0"
                BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="18,16,18,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="{i18n:Oversat settingsview.gemte_sikkerhedskopier}" FontSize="14" FontWeight="SemiBold" />
                <TextBlock x:Name="ValgtArkiv" Style="{StaticResource Underskrift}" Margin="0,3,0,0"
                           Text="{i18n:Oversat settingsview.vaelg_et_arkiv_for_at_se_hvad_det_indehold}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ProeveArkivKnap" Content="{i18n:Oversat settingsview.proevekoersel}" Click="ProeveArkiv_Click"
                        IsEnabled="False" Margin="0,0,8,0" />
                <Button x:Name="GendanKnap" Content="{i18n:Oversat settingsview.gendan}" Click="Gendan_Click" IsEnabled="False" />
              </StackPanel>
            </Grid>

            <ListBox x:Name="Arkiver" Grid.Row="1" Background="Transparent" BorderThickness="0"
                     Margin="10,0,10,12" Foreground="{DynamicResource Tekst}"
                     SelectionChanged="Arkiv_Valgt">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="6,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Navn}" FontSize="13" FontFamily="Consolas"
                               Margin="0,0,16,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Detaljer}" Style="{StaticResource Underskrift}"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>

    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock x:Name="Status" Style="{StaticResource Underskrift}" />
        <TextBlock x:Name="FilStatus" Style="{StaticResource Underskrift}" Margin="0,3,0,0" />

        <!-- BJÆLKEN VISER, HVOR LANGT DEN ER — IKKE BARE AT DEN KØRER.
             Her stod kun en tekst med sekunder. Den kunne fortælle, at der
             gik tid, men ikke om der var to sekunder eller to minutter igen —
             og en sikkerhedskopi med lyd er hundredvis af megabyte. Uden et
             tal at holde det op imod ligner en langsom kørsel en, der hænger,
             og så lukker man appen midt i den. -->
        <ProgressBar x:Name="BackupBjaelke" Height="5" Margin="0,7,0,0"
                     Visibility="Collapsed" Minimum="0" Maximum="100"
                     Background="{DynamicResource Svaev}" BorderThickness="0"
                     Foreground="{DynamicResource Accent}" />
      </StackPanel>
      <Button Grid.Column="1" Content="{i18n:Oversat settingsview.opdater_enhedslisten}" Click="Genindlaes_Click" />
    </Grid>
  </Grid>
</UserControl>
