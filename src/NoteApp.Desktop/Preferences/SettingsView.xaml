<UserControl x:Class="NoteApp.Desktop.Preferences.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Baggrund}">

  <!-- ALT DET, MAN STILLER IND, EET STED.
       «Filer og backup» laa som sit eget menupunkt. Det er ikke noget, man
       gaar til - det er en indstilling, man aabner den dag, man skal flytte
       datamappen eller gendanne noget. Menuen blev en linje laengere for
       noget, der bruges to gange om aaret.

       Fire faner i den raekkefoelge, man moeder dem: opstart foerst, fordi
       den gaelder appen som helhed; saa lyden, som er det, man vender
       tilbage til; og til sidst filer og sikkerhedskopi. -->

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="Indstillinger" Style="{StaticResource Overskrift}" />
      <TextBlock Style="{StaticResource Underskrift}" TextWrapping="Wrap" MaxWidth="820"
                 HorizontalAlignment="Left"
                 Text="Opstart, lyd, hvor dine filer ligger — og sikkerhedskopien." />
    </StackPanel>

    <TabControl Grid.Row="1" Style="{StaticResource Fanerude}">

      <TabItem Header="Opstart" Style="{StaticResource Fane}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
        <!-- ===================== Klar til næste møde ======================== -->
        <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="20"
                BorderBrush="{StaticResource PanelKant}" BorderThickness="1" Margin="0,0,0,14"
                VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Text="Klar til næste møde" FontSize="15" FontWeight="SemiBold" />
            <TextBlock FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"
                       Foreground="{StaticResource TekstMeget}"
                       Text="Genvejstasten kan kun starte en optagelse, hvis appen kører. Derfor hænger de to ting sammen." />

            <!-- HVORFOR DET STAAR HER OG IKKE KUN VED HAKKET PAA AFTALEN.
                 Betingelsen gaelder tre funktioner, ikke én, og den er den
                 samme hver gang: et program, der ikke koerer, kan ikke starte
                 en optagelse. Staar det kun i en enkelt dialog, opdager man
                 det foerste gang et moede IKKE blev optaget - og dér er det
                 for sent. -->
            <Border Background="#FF181B22" BorderBrush="{StaticResource Accent}"
                    BorderThickness="3,0,0,0" CornerRadius="4" Padding="14,11" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="NoteApp virker bedst, når den altid kører"
                           FontSize="12.5" FontWeight="SemiBold" />
                <TextBlock FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="19"
                           Foreground="{StaticResource Tekst}"
                           Text="Tre ting kan kun ske, mens appen er åben: genvejstasten kan starte en optagelse, mødevagten kan spørge, når et program bruger mikrofonen, og en aftale, du har markeret til automatisk optagelse, kan gå i gang af sig selv." />
                <TextBlock FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="19"
                           Foreground="{StaticResource Tekst}"
                           Text="Det er ikke en begrænsning, der kan laves om. En optagelse er noget, der skal være i gang, og et lukket program kan ikke starte den — heller ikke med en planlagt opgave i Windows, for de første sekunder ville gå med at hente programmet ind." />
                <TextBlock FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="19"
                           Foreground="{StaticResource TekstMeget}"
                           Text="Appen fylder ingenting, når der ikke optages. Derfor er «Start NoteApp, når jeg logger på Windows» slået til fra begyndelsen — og derfor kan du slå den fra." />
              </StackPanel>
            </Border>

            <CheckBox x:Name="StartMedWindows" Margin="0,14,0,0" Click="Autostart_Klik"
                      Content="Start NoteApp, når jeg logger på Windows" />
            <TextBlock x:Name="AutostartStatus" FontSize="12" Margin="24,6,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TekstMeget}" />

            <Border Background="#FF181B22" BorderBrush="{StaticResource PanelKant}" BorderThickness="1"
                    CornerRadius="8" Padding="14,11" Margin="0,14,0,0">
              <StackPanel>
                <TextBlock x:Name="GenvejOverskrift" FontSize="13" FontWeight="SemiBold"
                           Text="Lynstart af optagelse" />
                <TextBlock FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"
                           Foreground="{StaticResource TekstSvag}"
                           Text="Tryk kombinationen hvor som helst i Windows, så begynder optagelsen med det samme. Listen viser, hvad der er ledigt på netop din maskine — det er forskelligt fra pc til pc." />

                <ComboBox x:Name="Genveje" Margin="0,12,0,0" SelectionChanged="Genvej_Valgt">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Visning}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock x:Name="GenvejForklaring" FontSize="12" Margin="2,8,0,0" TextWrapping="Wrap"
                           LineHeight="19" Foreground="{StaticResource TekstMeget}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- ===================== Mødevagten ======================== -->
        <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="20"
                BorderBrush="{StaticResource PanelKant}" BorderThickness="1" Margin="0,0,0,14"
                VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Text="Spørg, når der starter et møde" FontSize="15" FontWeight="SemiBold" />
            <TextBlock FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"
                       Foreground="{StaticResource TekstMeget}"
                       Text="Appen kan holde øje med, om et andet program åbner din mikrofon — det gør et møde, og det gør et webinar, en video eller en streamingtjeneste ikke. Sker det, kommer der en besked nede ved uret med spørgsmålet, om mødet skal optages." />

            <CheckBox x:Name="MoedevagtTil" Margin="0,14,0,0" Click="Moedevagt_Klik"
                      Content="Spørg mig, når et program bruger mikrofonen" />

            <Border Background="#FF181B22" BorderBrush="{StaticResource PanelKant}" BorderThickness="1"
                    CornerRadius="8" Padding="14,11" Margin="24,10,0,0">
              <StackPanel>
                <TextBlock Text="Hvad appen kigger på" FontSize="12.5" FontWeight="SemiBold" />
                <TextBlock FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="19"
                           Foreground="{StaticResource TekstSvag}"
                           Text="Kun Windows' egen liste over, hvilke programmer der bruger mikrofonen — den samme, du selv kan se under Indstillinger i Windows. Der lyttes ikke med, der optages ingenting, og oplysningen bliver på maskinen." />
                <TextBlock FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="19"
                           Foreground="{StaticResource TekstSvag}"
                           Text="Der spørges først, når mikrofonen har været i brug i et halvt minut, så en diktering eller en mikrofonprøve ikke udløser noget. Og der optages aldrig af sig selv — der sker kun det, du trykker på." />
              </StackPanel>
            </Border>

            <!-- ============ DE FRAVALGTE PROGRAMMER ============
                 Listen SKAL kunne rettes. Et fravalg tages med ét klik i en
                 besked, der kommer, mens man er på vej ind til et møde — og
                 så er det også dér, man kommer til at trykke forkert. Uden en
                 vej tilbage ville appen holde op med at spørge om det
                 program, man rent faktisk holder sine møder i, uden at man
                 kunne finde ud af hvorfor. -->
            <StackPanel x:Name="FravalgtPanel" Margin="24,14,0,0" Visibility="Collapsed">
              <TextBlock Text="Der spørges ikke om disse programmer" FontSize="12.5"
                         FontWeight="SemiBold" />
              <TextBlock FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" LineHeight="19"
                         Foreground="{StaticResource TekstMeget}"
                         Text="Fjern et program fra listen, hvis du kom til at frabede dig det — så spørges der igen næste gang." />

              <ItemsControl x:Name="Fravalgte" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#FF181B22" BorderBrush="{StaticResource PanelKant}"
                            BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                      <Grid>
                        <StackPanel Margin="0,0,90,0">
                          <TextBlock Text="{Binding Navn}" FontSize="12.5" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Sti}" FontSize="10.5" Margin="0,2,0,0"
                                     TextTrimming="CharacterEllipsis"
                                     Foreground="{StaticResource TekstMeget}" />
                        </StackPanel>
                        <Button Content="Spørg igen" Tag="{Binding Noegle}" Click="Fravalg_Fjern"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Padding="12,5" FontSize="11.5" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ==================== KRAV TIL MASKINEN ====================

           EN LISTE OVER ANBEFALEDE SPECIFIKATIONER LAESES ÉN GANG OG GLEMMES.
           Spoergsmaalet, folk faktisk har, er «virker det paa MIN maskine» -
           og det kan appen svare paa, fordi den koerer paa den.

           DER KONKLUDERES IKKE «FOR LANGSOM». Appen kan optage og skrive ud
           paa naesten hvad som helst; forskellen er, hvor laenge man venter.
           Et roedt kryds ville sige, at noget ikke virker, og det ville vaere
           forkert. -->
      <TabItem Header="Krav til maskinen" Style="{StaticResource Fane}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>

            <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="20"
                    BorderBrush="{StaticResource PanelKant}" BorderThickness="1" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Anbefalet minimum" FontSize="15" FontWeight="SemiBold" />
                <TextBlock FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"
                           Foreground="{StaticResource TekstMeget}"
                           Text="Alt arbejdet sker på din egen maskine — udskrift, søgning, talergenkendelse og den korte opsummering. Derfor betyder maskinen noget, og derfor står der, hvad DEN HER maskine har." />

                <ItemsControl x:Name="Kravliste" Margin="0,14,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#FF181B22" BorderBrush="{Binding Kant}"
                              BorderThickness="3,0,0,0" CornerRadius="6"
                              Padding="14,11" Margin="0,0,0,8">
                        <StackPanel>
                          <Grid>
                            <TextBlock Text="{Binding Hvad}" FontSize="13" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,0,120,0" />
                            <TextBlock Text="{Binding Har}" FontSize="11.5"
                                       HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Foreground="{Binding Kant}" />
                          </Grid>
                          <TextBlock Text="{Binding Hvorfor}" FontSize="12" Margin="0,6,0,0"
                                     TextWrapping="Wrap" LineHeight="19"
                                     Foreground="{StaticResource TekstSvag}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- FORBEHOLDENE. De staar her og ikke i en fodnote: det er dem,
                 der afgoer, om appen passer til den, der laeser. -->
            <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="20"
                    BorderBrush="{StaticResource Advarsel}" BorderThickness="1" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="FORBEHOLD" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{StaticResource Advarsel}" Margin="0,0,0,10" />

                <TextBlock FontSize="12.5" Margin="0,0,0,0" TextWrapping="Wrap" LineHeight="21"
                           Foreground="{StaticResource TekstSvag}"
                           Text="Kun Windows. Appen bygger på Windows' egen lydmotor og på Windows' liste over programmer, der bruger mikrofonen. Der findes ingen udgave til Mac eller Linux, og det er ikke en oversættelse væk." />

                <TextBlock FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="21"
                           Foreground="{StaticResource TekstSvag}"
                           Text="Appen skal køre, for at tre ting virker: genvejstasten, mødevagten og automatisk optagelse af en aftale. Et lukket program kan ikke starte en optagelse." />

                <TextBlock FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="21"
                           Foreground="{StaticResource TekstSvag}"
                           Text="Uden NVIDIA-kort kører udskriften på processoren. Den virker, men en times møde tager længere end mødet selv varede. Optagelsen er upåvirket." />

                <TextBlock FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="21"
                           Foreground="{StaticResource TekstSvag}"
                           Text="Lyden fylder. En times møde med to spor er 220 MB, fordi lyden gemmes ukomprimeret — det giver den bedste udskrift. Teksten fylder 56 KB, og lyden kan slettes, når den er skrevet ud." />

                <TextBlock FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="21"
                           Foreground="{StaticResource TekstSvag}"
                           Text="Nøjagtigheden er ikke 100 %. Målt: 92,3 % på dansk, 90,5 % på engelsk, 83,1 % når der skiftes mellem sprogene midt i en sætning. Navne og fagord er det, der oftest rammes forkert." />

                <TextBlock FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="21"
                           Foreground="{StaticResource TekstSvag}"
                           Text="Appen kan skille de to SIDER af et onlinemøde — din mikrofon og det, computeren afspiller. Den kan ikke kende de enkelte personer i den anden ende fra hinanden." />

                <TextBlock FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="21"
                           Foreground="{StaticResource TekstSvag}"
                           Text="Et fysisk møde i et lokale optages gennem din mikrofon alene. Det virker, men afstanden til den, der taler, afgør, hvor godt det bliver." />
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Lyd" Style="{StaticResource Fane}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Grid Margin="0,0,0,14">
              <TextBlock Style="{StaticResource Underskrift}" TextWrapping="Wrap" MaxWidth="700"
                         HorizontalAlignment="Left" VerticalAlignment="Center"
                         Text="Vælg mikrofon og højttaler. Appen lytter ikke, før du trykker prøv — eller trykker optag." />
                    <!-- Måleren kræver, at mikrofonen åbnes. Det skal være et valg: en app,
                         der lytter, fordi man kigger på en indstillingsskærm, holder ikke
                         det løfte, resten af appen giver. -->
                    <Button x:Name="ProeveKnap" Content="▶ Prøv mikrofon og højttaler" Click="Proeve_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="16,9"
                            Background="{StaticResource Accent}" Foreground="#FF0B1220" BorderThickness="0"
                            FontWeight="SemiBold" />
            </Grid>
        <!-- ============================ Mikrofon ============================ -->
        <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="20" Margin="0,0,0,14"
                BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="Mikrofon" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Underskrift}" Margin="0,3,0,10"
                       Text="Dig. Optages på alle møder, både fysiske og online." />

            <!-- ItemTemplate frem for DisplayMemberPath: med en egen ComboBox-
                 skabelon slaar DisplayMemberPath ikke igennem paa den lukkede
                 boks, og saa staar hele objektet der i staedet for navnet. -->
            <ComboBox x:Name="Mikrofoner" SelectionChanged="Mikrofon_Valgt">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Niveau" Style="{StaticResource Underskrift}"
                         VerticalAlignment="Center" Width="52" />
              <Border Grid.Column="1" Height="10" Background="#FF2C323D" CornerRadius="5"
                      VerticalAlignment="Center">
                <Border x:Name="MikNiveau" HorizontalAlignment="Left" Width="0" Height="10"
                        CornerRadius="5" Background="{StaticResource Godkendt}" />
              </Border>
              <TextBlock Grid.Column="2" x:Name="MikStatus" Style="{StaticResource Underskrift}"
                         Margin="12,0,0,0" VerticalAlignment="Center" MinWidth="150" />
            </Grid>

            <TextBlock x:Name="MikAdvarsel" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Advarsel}" Visibility="Collapsed" />

            <!-- HER LAA TO RULLELISTER MED SPROG: dit og modpartens.
                 De er fjernet 19-08-2026. En global indstilling ville vaere
                 rigtig for ét moede og forkert for det naeste - man holder
                 moeder paa dansk, paa engelsk, og med gaester der taler et
                 tredje sprog.

                 Der spoerges nu ved knappen «Opret transskription», hvor man
                 staar med det konkrete moede og VED det. Valget huskes pr.
                 moede, saa en gentagen udskrivning ikke spoerger forfra.
                 Se Transcribe\SprogvalgWindow. -->
          </StackPanel>
        </Border>

        <!-- =========================== Højttaler ============================ -->
        <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="20"
                BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="Højttaler" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Underskrift}" Margin="0,3,0,10"
                       Text="De andre deltagere. Vælges den forkerte, bliver deres spor tomt." />

            <ComboBox x:Name="Hoejttalere" SelectionChanged="Hoejttaler_Valgt">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Niveau" Style="{StaticResource Underskrift}"
                         VerticalAlignment="Center" Width="52" />
              <Border Grid.Column="1" Height="10" Background="#FF2C323D" CornerRadius="5"
                      VerticalAlignment="Center">
                <Border x:Name="HoejtNiveau" HorizontalAlignment="Left" Width="0" Height="10"
                        CornerRadius="5" Background="{StaticResource Godkendt}" />
              </Border>
              <TextBlock Grid.Column="2" x:Name="HoejtStatus" Style="{StaticResource Underskrift}"
                         Margin="12,0,0,0" VerticalAlignment="Center" MinWidth="150" />
            </Grid>

            <TextBlock x:Name="HoejtAdvarsel" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Advarsel}" Visibility="Collapsed" />
          </StackPanel>
        </Border>

        <!-- ====================== Er mikrofonen god nok? ====================
             Måleren ovenfor siger, at mikrofonen VIRKER. Den siger ingenting om,
             hvor godt den kan HØRES — og det er dét, hele appen står og falder
             med. Her læses en tekst, appen kender i forvejen, op i en halv
             minut, og udskriften sammenlignes ord for ord. Ét tal.

             Testen er det eneste, der er beholdt fra træningen, som blev fjernet
             18-08-2026. Resten målte nul; det her svarer på et spørgsmål, man
             ellers først får svar på efter et møde på en time. -->
        <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="20" Margin="0,0,0,14"
                BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
          <StackPanel>
            <Grid>
              <StackPanel>
                <TextBlock Text="Er mikrofonen god nok?" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Underskrift}" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="620"
                           HorizontalAlignment="Left"
                           Text="Læs en fast tekst op i cirka tredive sekunder. Appen kender teksten i forvejen og tæller, hvor mange ord den hørte rigtigt." />
              </StackPanel>
              <Button x:Name="TestKnap" Content="▶ Start test" Click="Test_Click"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Padding="16,9" MinWidth="150"
                      Background="{StaticResource Accent}" Foreground="#FF0B1220" BorderThickness="0"
                      FontWeight="SemiBold" />
            </Grid>

            <!-- Selve oplæsningen. Teksten skal fylde, mens den læses — man skal
                 kunne se den uden at læne sig frem. -->
            <Border x:Name="TestRude" Background="#FF181B22" BorderBrush="{StaticResource PanelKant}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,14,0,0"
                    Visibility="Collapsed">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <TextBlock x:Name="TestTrin" FontSize="13" FontWeight="SemiBold"
                             Foreground="{StaticResource Accent}" Text="Læs højt — i almindeligt tempo" />
                  <TextBlock x:Name="TestUr" FontSize="13" HorizontalAlignment="Right"
                             Foreground="{StaticResource TekstSvag}" FontFamily="Consolas" />
                </Grid>

                <TextBlock x:Name="TestTekst" FontSize="15.5" LineHeight="30" TextWrapping="Wrap"
                           Foreground="{StaticResource Tekst}" />

                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Niveau" Style="{StaticResource Underskrift}"
                             VerticalAlignment="Center" Width="52" />
                  <Border Grid.Column="1" Height="10" Background="#FF2C323D" CornerRadius="5"
                          VerticalAlignment="Center">
                    <Border x:Name="TestNiveau" HorizontalAlignment="Left" Width="0" Height="10"
                            CornerRadius="5" Background="{StaticResource Godkendt}" />
                  </Border>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Resultatet. Tallet står stort, fordi det er det, man kom efter;
                 rådet står under, fordi et tal uden en vej videre er ubrugeligt. -->
            <Border x:Name="TestSvar" Background="#FF181B22" BorderBrush="{StaticResource PanelKant}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,14,0,0"
                    Visibility="Collapsed">
              <StackPanel>
                <Grid>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TestTal" FontSize="30" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="TestDom" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TekstSvag}" />
                  </StackPanel>
                </Grid>

                <TextBlock x:Name="TestRaad" FontSize="12.5" LineHeight="21" TextWrapping="Wrap"
                           Margin="0,10,0,0" Foreground="{StaticResource TekstSvag}" MaxWidth="640"
                           HorizontalAlignment="Left" />

                <Expander x:Name="TestDetalje" Header="Sådan hørte appen det" Margin="0,12,0,0"
                          Foreground="{StaticResource TekstMeget}" FontSize="12">
                  <StackPanel Margin="0,10,0,0">
                    <TextBlock x:Name="TestFejl" FontSize="12.5" TextWrapping="Wrap" LineHeight="21"
                               Foreground="{StaticResource TekstSvag}" Margin="0,0,0,10" />
                    <TextBlock x:Name="TestUdskrift" FontSize="12.5" TextWrapping="Wrap" LineHeight="21"
                               FontFamily="Consolas" Foreground="{StaticResource TekstMeget}" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>

            <TextBlock x:Name="TestStatus" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TekstMeget}" />
          </StackPanel>
        </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ==================== INTEGRATIONER ====================

           EGEN FANE, FORDI DER KOMMER FLERE. Google er den første, Microsoft
           365 den næste, og forskellen på dem er kun, hvor man henter en
           nøgle. Lå Google under «Opstart» eller «Filer», ville den næste
           skulle lægges et tredje sted.

           DET, DER GØR DEN HER FANE ANDERLEDES END RESTEN AF APPEN, SKAL
           STÅ ØVERST. Alt andet bliver på maskinen; her taler appen med en
           amerikansk leverandør. Det er i orden — men det skal siges, og det
           skal siges før knapperne, ikke under dem. -->
      <TabItem Header="Integrationer" Style="{StaticResource Fane}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>

            <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="20"
                    BorderBrush="{StaticResource PanelKant}" BorderThickness="1" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Kalendere fra andre tjenester" FontSize="15" FontWeight="SemiBold" />
                <TextBlock FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"
                           Foreground="{StaticResource TekstMeget}"
                           Text="Appen kan læse dine aftaler ind i kalenderen, så du kan trykke optag direkte på et møde. Kalenderen virker også uden — du kan altid oprette aftaler her i appen." />

                <Border Background="#FF181B22" BorderBrush="{StaticResource Accent}"
                        BorderThickness="3,0,0,0" CornerRadius="4" Padding="14,11" Margin="0,14,0,0">
                  <StackPanel>
                    <TextBlock Text="Hvad der bliver sendt — og hvad der ikke gør"
                               FontSize="12.5" FontWeight="SemiBold" />
                    <TextBlock FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="19"
                               Foreground="{StaticResource Tekst}"
                               Text="Aftaler HENTES ned. Den anden vej sker kun, når du selv sætter hak ved «Opret også hos leverandøren» på en aftale — og så er det aftalens titel, tidspunkt og sted, intet andet. Lyd, transkriptioner, noter og dokumenter går aldrig den vej." />
                    <TextBlock FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="19"
                               Foreground="{StaticResource Tekst}"
                               Text="Lyden, transkriptionerne, dine noter og dokumenterne forlader aldrig maskinen ad denne vej. En kalenderintegration giver adgang til at læse en kalender." />
                    <TextBlock FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="19"
                               Foreground="{StaticResource TekstMeget}"
                               Text="Google og Microsoft er amerikanske. Bruger du deres kalender i forvejen, ligger dine mødetitler og deltagere der allerede — appen læser det, der er der." />
                  </StackPanel>
                </Border>

                <!-- KVITTERINGEN LAASER KNAPPERNE OP.
                     En knap, man kan trykke paa uden at have laest noget, goer
                     teksten ovenover til pynt. Der spoerges ÉN gang og huskes;
                     et spoergsmaal, der kommer igen hver gang, laeses ikke
                     anden gang. -->
                <CheckBox x:Name="IntegrationerLaest" Margin="0,14,0,0"
                          Click="IntegrationerLaest_Klik"
                          Content="Dette er læst og forstået" />

                <TextBlock x:Name="LaestNote" FontSize="11.5" Margin="24,5,0,0"
                           TextWrapping="Wrap" LineHeight="18"
                           Foreground="{StaticResource TekstMeget}"
                           Text="Sæt hakket for at kunne aktivere en integration. Du kan altid afbryde forbindelsen igen." />
              </StackPanel>
            </Border>

            <!-- ============ NOTEN I MOEDEINDKALDELSEN ============

                 DEN STAAR HER OG IKKE I AFTALEVINDUET. Den er en indstilling,
                 man saetter én gang - ikke et valg, man traeffer for hvert
                 moede. Laa den i aftalevinduet, skulle den laeses igennem hver
                 gang, man lavede en aftale.

                 DEN KAN RETTES, MEN IKKE FJERNES. Appen opfordrer ALTID til at
                 fortaelle deltagerne, at der optages; et tomt felt er ikke et
                 valg om at lade vaere, det er et felt, ingen har udfyldt - og
                 saa bruges standarden. -->
            <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="20"
                    BorderBrush="{StaticResource PanelKant}" BorderThickness="1" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Teksten i mødeindkaldelsen" FontSize="15" FontWeight="SemiBold" />
                <TextBlock FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"
                           Foreground="{StaticResource TekstMeget}"
                           Text="Er en aftale markeret til at blive optaget, skrives den her tekst i indkaldelsen sammen med mødelinket. Deltagerne får det at vide før mødet, hvor de kan nå at sige fra — ikke i det øjeblik optagelsen begynder. Et mødelink alene udløser den ikke: man holder også online-møder, der ikke skal optages. Læg mærke til de to ting i første linje: der står mødetransskription frem for optagelse, fordi det er formålet — og der står LYD og ikke video, fordi «mødet optages» i dag læses som «mødet filmes», og det er en langt større ting at sige ja til." />

                <!-- TO SPROG, FORDI EN INDKALDELSE PAA DANSK TIL EN, DER IKKE
                     LAESER DANSK, IKKE ER EN OPLYSNING. Retten til at sige fra
                     er kun vaerd at have, hvis den kan laeses - og et moede,
                     hvor sproget er sat til engelsk, har med sikkerhed
                     deltagere, der ikke laeser dansk.

                     Sproget vaelges IKKE her. Det tages fra aftalen: er moedet
                     sat til engelsk, er indkaldelsen det ogsaa. -->
                <TabControl Margin="0,14,0,0" Style="{StaticResource Fanerude}">

                  <TabItem Header="Dansk" Style="{StaticResource Fane}">
                    <TextBox x:Name="Optagenote" FontSize="12"
                             MinHeight="220" MaxHeight="320" Padding="12,10"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             TextChanged="Optagenote_Aendret" />
                  </TabItem>

                  <TabItem Header="English" Style="{StaticResource Fane}">
                    <TextBox x:Name="OptagenoteEn" FontSize="12"
                             MinHeight="220" MaxHeight="320" Padding="12,10"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             TextChanged="Optagenote_Aendret" />
                  </TabItem>
                </TabControl>

                <TextBlock FontSize="11.5" Margin="2,7,0,0" TextWrapping="Wrap" LineHeight="18"
                           Foreground="{StaticResource TekstMeget}"
                           Text="Sproget vælges ikke her — det tages fra aftalen. Er mødet sat til engelsk, bruges den engelske tekst. Ryd et felt for at komme tilbage til standardteksten; den kan ikke slås helt fra, for en optagelse, ingen har fået at vide, er ikke noget appen hjælper med." />

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <Button Content="Gem teksten" Click="GemNote_Klik" Padding="18,8"
                          Style="{StaticResource Primaer}" />
                  <Button Content="Nulstil til standard" Click="NulstilNote_Klik"
                          Padding="14,8" Margin="10,0,0,0" />
                  <TextBlock x:Name="Notestatus" FontSize="11.5" Margin="14,0,0,0"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource TekstMeget}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <ItemsControl x:Name="Integrationsliste">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="20"
                          BorderBrush="{StaticResource PanelKant}" BorderThickness="1"
                          Margin="0,0,0,14">
                    <StackPanel>

                      <Grid>
                        <StackPanel Margin="0,0,120,0">
                          <TextBlock Text="{Binding Navn}" FontSize="15" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Under}" FontSize="12" Margin="0,4,0,0"
                                     TextWrapping="Wrap" Foreground="{StaticResource TekstMeget}" />
                        </StackPanel>

                        <Border CornerRadius="4" Padding="9,3" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Background="#FF2C323D">
                          <TextBlock Text="{Binding Tilstand}" FontSize="10.5"
                                     FontWeight="SemiBold" Foreground="{Binding Tilstandsfarve}" />
                        </Border>
                      </Grid>

                      <TextBlock Text="{Binding Hvad}" FontSize="12.5" Margin="0,12,0,0"
                                 TextWrapping="Wrap" LineHeight="20"
                                 Foreground="{StaticResource TekstSvag}" />

                      <TextBlock Text="{Binding Hvordan}" FontSize="12" Margin="0,7,0,0"
                                 TextWrapping="Wrap" LineHeight="19"
                                 Foreground="{StaticResource TekstMeget}" />

                      <!-- ÉN KNAP. Der er intet at udfylde.

                           Her stod to felter til et klient-id, brugeren selv
                           skulle hente i Google Cloud Console. Det virker
                           teknisk og er forkert som produkt: den, der skal
                           optage et møde om fem minutter, opretter ikke et
                           cloud-projekt først. Appen har sit eget id nu. -->
                      <StackPanel Visibility="{Binding Opsaetningsvis}" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                          <Button Content="Aktiver" Tag="{Binding Id}" Click="Forbind_Klik"
                                  Style="{StaticResource Primaer}" Padding="20,8"
                                  Visibility="{Binding Forbindvis}"
                                  IsEnabled="{Binding MaaAktivere}"
                                  ToolTip="{Binding Aktivertip}" />
                          <Button Content="Hent aftaler nu" Tag="{Binding Id}" Click="Hent_Klik"
                                  Padding="14,8" Visibility="{Binding Forbundetvis}" />
                          <Button Content="Afbryd forbindelsen" Tag="{Binding Id}" Click="Afbryd_Klik"
                                  Padding="14,8" Margin="8,0,0,0"
                                  Visibility="{Binding Forbundetvis}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Sidst}" FontSize="11.5" Margin="0,12,0,0"
                                   TextWrapping="Wrap" LineHeight="18"
                                   Foreground="{StaticResource TekstMeget}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Filer" Style="{StaticResource Fane}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
        <!-- ========================== Datamappen =========================== -->
        <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="20" Margin="0,0,0,14"
                BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
              <TextBlock Text="Dine filer" FontSize="15" FontWeight="SemiBold" />
              <TextBlock x:Name="DataSti" FontSize="13" FontFamily="Consolas" Margin="0,6,0,0" TextWrapping="Wrap" />
              <TextBlock x:Name="DataIndhold" Style="{StaticResource Underskrift}" Margin="0,6,0,0" />
              <TextBlock Style="{StaticResource Underskrift}" Margin="0,8,0,0" Foreground="{StaticResource TekstMeget}"
                         Text="Optagelser, transkriptioner, noter og dokumenter. Skifter du mappe, flyttes alt med." />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <Button Content="Skift mappe…" Click="SkiftData_Click" MinWidth="130" />
              <Button Content=".bn mappen" Click="AabnData_Click" Margin="0,8,0,0" MinWidth="130" />
            </StackPanel>
          </Grid>
        </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Sikkerhedskopi" Style="{StaticResource Fane}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
        <!-- ======================== Sikkerhedskopi ========================= -->
        <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="20"
                BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
              <TextBlock Text="Sikkerhedskopi" FontSize="15" FontWeight="SemiBold" />
              <TextBlock x:Name="BackupSti" FontSize="13" FontFamily="Consolas" Margin="0,6,0,0" TextWrapping="Wrap" />
              <TextBlock x:Name="BackupSenest" Style="{StaticResource Underskrift}" Margin="0,6,0,0" />
              <TextBlock x:Name="BackupAdvarsel" FontSize="12" Margin="0,8,0,0"
                         Foreground="{StaticResource Advarsel}" Visibility="Collapsed" TextWrapping="Wrap" />

              <!-- Hvad kommer med. Lyd er fra som standard: den fylder alt, og
                   den er det, der er lettest at undvære — arbejdet ligger i
                   transskriptionen og de færdige dokumenter. -->
              <Border Background="#FF181B22" CornerRadius="6" Padding="12,10" Margin="0,12,0,0"
                      BorderThickness="1" BorderBrush="{StaticResource PanelKant}">
                <StackPanel>
                  <TextBlock Text="Hvad kommer med" Style="{StaticResource Underskrift}" Margin="0,0,0,8" />

                  <TextBlock FontSize="12" Foreground="{StaticResource TekstSvag}" Margin="0,0,0,8"
                             Text="Altid med: noter, transskriptioner, dokumenter, mødedata og indstillinger." />

                  <CheckBox x:Name="TagLydMed" Content="Tag også lydfilerne med" Click="Lyd_Klik" />
                  <TextBlock x:Name="LydStoerrelse" Style="{StaticResource Underskrift}" Margin="24,4,0,0"
                             Foreground="{StaticResource TekstMeget}" />
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <Button Content="Skift mappe…" Click="SkiftBackup_Click" MinWidth="130" />
              <Button x:Name="KoerKnap" Content="Tag backup nu" Click="Koer_Click"
                      Style="{StaticResource Primaer}" Margin="0,8,0,0" MinWidth="130" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- ========================== Arkiverne ============================ -->
        <Border Background="{StaticResource Panel}" CornerRadius="10" Margin="0,14,0,0"
                BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="18,16,18,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Gemte sikkerhedskopier" FontSize="14" FontWeight="SemiBold" />
                <TextBlock x:Name="ValgtArkiv" Style="{StaticResource Underskrift}" Margin="0,3,0,0"
                           Text="Vælg et arkiv for at se, hvad det indeholder." />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ProeveArkivKnap" Content="Prøvekørsel" Click="ProeveArkiv_Click"
                        IsEnabled="False" Margin="0,0,8,0" />
                <Button x:Name="GendanKnap" Content="Gendan…" Click="Gendan_Click" IsEnabled="False" />
              </StackPanel>
            </Grid>

            <ListBox x:Name="Arkiver" Grid.Row="1" Background="Transparent" BorderThickness="0"
                     Margin="10,0,10,12" Foreground="{StaticResource Tekst}"
                     SelectionChanged="Arkiv_Valgt">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="6,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Navn}" FontSize="13" FontFamily="Consolas"
                               Margin="0,0,16,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Detaljer}" Style="{StaticResource Underskrift}"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>

    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock x:Name="Status" Style="{StaticResource Underskrift}" />
        <TextBlock x:Name="FilStatus" Style="{StaticResource Underskrift}" Margin="0,3,0,0" />

        <!-- BJÆLKEN VISER, HVOR LANGT DEN ER — IKKE BARE AT DEN KØRER.
             Her stod kun en tekst med sekunder. Den kunne fortælle, at der
             gik tid, men ikke om der var to sekunder eller to minutter igen —
             og en sikkerhedskopi med lyd er hundredvis af megabyte. Uden et
             tal at holde det op imod ligner en langsom kørsel en, der hænger,
             og så lukker man appen midt i den. -->
        <ProgressBar x:Name="BackupBjaelke" Height="5" Margin="0,7,0,0"
                     Visibility="Collapsed" Minimum="0" Maximum="100"
                     Background="#FF232A35" BorderThickness="0"
                     Foreground="{StaticResource Accent}" />
      </StackPanel>
      <Button Grid.Column="1" Content="Opdatér enhedslisten" Click="Genindlaes_Click" />
    </Grid>
  </Grid>
</UserControl>
