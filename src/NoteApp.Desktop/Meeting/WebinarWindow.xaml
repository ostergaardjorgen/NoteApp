<Window x:Class="NoteApp.Desktop.Meeting.WebinarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Optag et webinar"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Baggrund}"
        WindowStyle="ToolWindow">

  <!-- ==================== OPTAG ET WEBINAR ====================

       Der spørges FØR optagelsen, ikke bagefter. Sproget skal bruges af
       udskrivningen, og et webinar begynder på slaget — der er ikke tid til at
       svare på noget, mens det går i gang.

       Forklaringen om ét spor står her, fordi det er det eneste sted, den
       bliver læst. Uden den trykker folk på den almindelige optageknap, som er
       den, de kender, og så optages deres egen mikrofon med til ingen nytte. -->

  <StackPanel Margin="24,20,24,20">

    <TextBlock Text="Optag et webinar" FontSize="19" FontWeight="SemiBold" />
    <TextBlock Style="{StaticResource Underskrift}" Margin="0,5,0,0" TextWrapping="Wrap"
               Text="Der optages kun det, du hører — ikke din mikrofon." />

    <!-- Hvorfor det er den rigtige knap -->
    <Border Background="#FF181B22" BorderBrush="{StaticResource PanelKant}" BorderThickness="1"
            CornerRadius="8" Padding="14,12" Margin="0,16,0,0">
      <StackPanel>
        <TextBlock Text="Hvorfor ikke bare den almindelige optageknap?" FontSize="13"
                   FontWeight="SemiBold" />
        <TextBlock FontSize="12.5" LineHeight="20" TextWrapping="Wrap" Margin="0,6,0,0"
                   Foreground="{StaticResource TekstSvag}"
                   Text="Et webinar er envejs: du lytter, du taler ikke. Tages din mikrofon med, optages der et helt spor uden indhold — og det skal skrives ud sammen med resten." />

        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="1" Text="MØDE" FontSize="9.5" FontWeight="SemiBold"
                     Margin="16,0,0,4" Foreground="{StaticResource TekstMeget}" />
          <TextBlock Grid.Row="0" Grid.Column="2" Text="WEBINAR" FontSize="9.5" FontWeight="SemiBold"
                     Margin="16,0,0,4" Foreground="{StaticResource Accent}" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Fylder" FontSize="12"
                     Foreground="{StaticResource TekstMeget}" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="220 MB/t" FontSize="12"
                     Margin="16,0,0,0" HorizontalAlignment="Right"
                     Foreground="{StaticResource TekstMeget}" />
          <TextBlock Grid.Row="1" Grid.Column="2" Text="110 MB/t" FontSize="12"
                     Margin="16,0,0,0" HorizontalAlignment="Right" FontWeight="SemiBold" />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Skrives ud på" FontSize="12" Margin="0,3,0,0"
                     Foreground="{StaticResource TekstMeget}" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="~9 min" FontSize="12" Margin="16,3,0,0"
                     HorizontalAlignment="Right" Foreground="{StaticResource TekstMeget}" />
          <TextBlock Grid.Row="2" Grid.Column="2" Text="~4½ min" FontSize="12" Margin="16,3,0,0"
                     HorizontalAlignment="Right" FontWeight="SemiBold" />
        </Grid>

        <TextBlock FontSize="12" LineHeight="19" TextWrapping="Wrap" Margin="0,10,0,0"
                   Foreground="{StaticResource TekstMeget}"
                   Text="Udskriften bliver desuden bedre: uden dit eget spor er der intet ekko, ingen overlappende tale og ingen tvivl om, hvem der talte." />
      </StackPanel>
    </Border>

    <!-- Sproget -->
    <TextBlock Text="HVILKET SPROG ER WEBINARET PÅ?" FontSize="9.5" FontWeight="SemiBold"
               Margin="2,18,0,0" Foreground="{StaticResource TekstMeget}" />
    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="2,5,0,0" LineHeight="18"
               Foreground="{StaticResource TekstSvag}"
               Text="Der spørges nu, fordi et webinar begynder på slaget — og fordi appen gætter forkert oftere, end man tror." />

    <ComboBox x:Name="Sprogvalg" Margin="0,8,0,0" FontSize="13" Padding="10,7">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Navn}" />
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>

    <!-- Linket -->
    <TextBlock Text="LINK TIL WEBINARET (kan stå tomt)" FontSize="9.5" FontWeight="SemiBold"
               Margin="2,18,0,0" Foreground="{StaticResource TekstMeget}" />
    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="2,5,0,0" LineHeight="18"
               Foreground="{StaticResource TekstSvag}"
               Text="Ligger webinaret online bagefter, er linket vejen tilbage til det, der blev VIST — og det er væk fra indbakken en måned senere. Sæt det ind nu, så følger det med optagelsen." />

    <TextBox x:Name="Link" Margin="0,8,0,0" FontSize="12.5" Padding="10,7" />

    <!-- Stopper selv -->
    <Border Background="#FF1D2530" BorderBrush="{StaticResource Accent}" BorderThickness="0,0,0,2"
            CornerRadius="7" Padding="13,11" Margin="0,18,0,0">
      <StackPanel>
        <TextBlock Text="Den stopper af sig selv" FontSize="12.5" FontWeight="SemiBold"
                   Foreground="{StaticResource Accent}" />
        <TextBlock FontSize="12" LineHeight="19" TextWrapping="Wrap" Margin="0,5,0,0"
                   Foreground="{StaticResource Tekst}"
                   Text="Kommer der ikke lyd i fem minutter, slutter optagelsen, og de fem minutters stilhed klippes af. Du behøver altså ikke blive siddende — sæt den i gang, og lav noget andet." />

        <!-- MÅLT 21-08-2026, ikke antaget.
             Tone afspillet, niveauet målt ved 50 %, ved 0 % og med mute:
             0,36621 i alle tre tilfælde, identisk til femte decimal. Windows
             tager sin kopi FØR endepunktets lydstyrke.

             Det er værd at sige, fordi ingen tør prøve det: man går ud fra, at
             en tavs computer optager tavshed. -->
        <TextBlock FontSize="12" LineHeight="19" TextWrapping="Wrap" Margin="0,8,0,0"
                   Foreground="{StaticResource Tekst}"
                   Text="Du kan roligt slå lyden fra eller skrue helt ned imens. Optagelsen tages, før lydstyrken sættes, så den bliver den samme — det er efterprøvet på denne maskine." />
      </StackPanel>
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="Fortryd" Click="Fortryd_Klik" Padding="16,8" Margin="0,0,10,0" />
      <Button x:Name="StartKnap" Content="Optag webinaret" Click="Start_Klik"
              Padding="20,8" Style="{StaticResource Primaer}" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
