<UserControl x:Class="NoteApp.Desktop.Meeting.MeetingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:NoteApp.Desktop"
             xmlns:local="clr-namespace:NoteApp.Desktop">

  <UserControl.Resources>
    <!-- Mødetypen som to knapper frem for en rulleliste: der er to valg, og de
         skal begge kunne ses uden at klikke. -->
    <Style x:Key="Typevalg" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Kant" CornerRadius="7" BorderThickness="1" Padding="13,7"
                    Background="{DynamicResource Trykket}" BorderBrush="{DynamicResource PanelKant}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Kant" Property="BorderBrush" Value="{DynamicResource TekstMeget}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Kant" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter TargetName="Kant" Property="Background" Value="{DynamicResource AccentFlade}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <!-- Optagebjælken. Den ligger fast øverst i vinduet og er den samme, uanset
       hvilken skærm man står på: at optage et møde er dét, appen er til, og
       det skal ikke være et sted, man først går hen. -->
  <Border Background="{DynamicResource Trykket}" BorderBrush="{DynamicResource PanelKant}" BorderThickness="0,0,0,1"
          Padding="24,12">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- ===================== Venstre: knappen ===================== -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <!-- KNAPPEN ER GJORT MINDRE.
             Den fyldte som en overskrift og trak blikket til sig hver gang,
             man aabnede appen - ogsaa naar man var der for at laese et
             referat. Den skal vaere det foerste, oejet finder, ikke det
             eneste det kan se. Farven goer arbejdet; stoerrelsen behoever
             ikke ogsaa.

             Prikken er en Ellipse og ikke tegnet «●». Tegnet ligger
             forskelligt paa linjen fra skrifttype til skrifttype og stod
             derfor ikke midt for. -->
        <Button x:Name="StartKnap" Click="Start_Click" Cursor="Hand"
                VerticalAlignment="Center">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="flade" CornerRadius="7" Padding="15,8"
                      Background="{DynamicResource Optager}">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="8" Height="8" Fill="{DynamicResource PaaOptager}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBlock Text="{i18n:Oversat topbar.optag}" FontSize="13" FontWeight="SemiBold"
                             Foreground="{DynamicResource PaaOptager}" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="flade" Property="Opacity" Value="0.87" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="flade" Property="Opacity" Value="0.72" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="flade" Property="Opacity" Value="0.42" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>

        <!-- ============ WEBINAR ER SIN EGEN KNAP ============

             Den kunne have været et valg i en dialog efter tryk på «Optag
             møde». Den er en knap for sig, fordi forskellen ikke er en
             indstilling — det er en anden slags optagelse: ét spor i stedet
             for to, sproget valgt på forhånd, og den stopper af sig selv.

             Den er mindre og mere afdæmpet end optageknappen. Møder er det
             almindelige; webinarer er det, man gør bevidst. -->
        <!-- ==================== GENVEJEN VED KNAPPEN ====================

             Den stod oeverst til hoejre, i den anden ende af bjaelken, med
             maerkatet «OPTAG MED» foran sig. Maerkatet fandtes kun for at
             forklare, hvad tasten hoerte til - og det behoever den ikke,
             naar den staar lige ved siden af knappen. Placeringen siger det,
             ordene sagde, og der blev en halv bjaelke fri.

             DEN LIGNER EN TASTEKAP, IKKE EN KNAP MERE. Foer var den formet
             som optageknappen - samme roede flade - fordi de to goer det
             samme. Ved siden af knappen ville to roede flader vaere et
             tastetryk, man ikke kan se hvor gaar hen. Nu er den daempet: en
             tone dybere end bjaelken, en kant om, og teksten i bjaelkens egen
             farve.

             TEKSTEN ER «Tekst», IKKE HVID. Den stod hvid engang. Det var
             rigtigt, saa laenge appen var moerk - og forsvandt den dag, det
             lyse tema kom. Bjaelkens egen skriftfarve er hvid i moerkt og
             moerk i lyst; det er dén, der virker begge steder. -->
        <Border x:Name="GenvejPanel" CornerRadius="7" Padding="13,8" Margin="10,0,0,0"
                VerticalAlignment="Center" Visibility="Collapsed"
                Background="{DynamicResource Trykket}"
                BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
          <TextBlock x:Name="GenvejTast" FontSize="13" FontWeight="SemiBold"
                     VerticalAlignment="Center" Foreground="{DynamicResource Tekst}" />
        </Border>

        <Button x:Name="WebinarKnap" Click="Webinar_Click" Cursor="Hand"
                VerticalAlignment="Center" Margin="10,0,0,0"
                ToolTip="{i18n:Oversat meetingview.optag_et_webinar_kun_det_du_hoerer_halv_st}">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="flade" CornerRadius="7" Padding="13,8"
                      Background="{DynamicResource Svaev}" BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                             VerticalAlignment="Center" Margin="0,0,7,0"
                             Foreground="{DynamicResource Accent}" />
                  <TextBlock Text="{i18n:Oversat topbar.webinar}" FontSize="13" FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="flade" Property="Background" Value="{DynamicResource PanelKant}" />
                  <Setter TargetName="flade" Property="BorderBrush" Value="{DynamicResource Accent}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="flade" Property="Opacity" Value="0.42" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>

        <!-- Under optagelse: uret og prikken i stedet for knappen -->
        <StackPanel x:Name="UrPanel" Orientation="Horizontal" VerticalAlignment="Center"
                    Visibility="Collapsed">
          <Ellipse x:Name="OptagerPrik" Width="12" Height="12" VerticalAlignment="Center"
                   Margin="0,0,12,0" Fill="{DynamicResource Optager}" />
          <StackPanel>
            <TextBlock x:Name="Ur" Text="00:00:00" FontSize="22" FontWeight="SemiBold"
                       FontFamily="Consolas" />
            <TextBlock x:Name="UrUnder" Style="{StaticResource Underskrift}" FontSize="11" />
          </StackPanel>
        </StackPanel>
      </StackPanel>

      <!-- ===================== Midten: felter ====================== -->
      <Grid Grid.Column="1" Margin="20,0,20,0" VerticalAlignment="Center">
        <!-- Før optagelsen står her INTET at udfylde.
             Titelfeltet lå her før, og det var det forkerte tidspunkt: et møde
             begynder om et øjeblik, man aner ikke hvad det kommer til at handle
             om, og feltet blev derfor stående tomt. Navnet spørges der om, når
             mødet er slut — dér ved man det.
             Fysisk/online-valget er væk af samme grund: det kunne ikke træffes
             rigtigt på forhånd. -->
        <Grid x:Name="KlarFelter">
          <TextBlock x:Name="KlarTekst" VerticalAlignment="Center" FontSize="13.5"
                     TextWrapping="Wrap" Foreground="{DynamicResource TekstMeget}"
                     Text="{i18n:Oversat topbar.hjaelp}" />
        </Grid>

        <!-- Under optagelsen: notefeltet -->
        <Grid x:Name="OptagFelter" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Etiketten er ikke pynt. Uden den var feltet bare en kasse i en
               bjælke, og man skulle gætte, at det var dér, noterne skulle. -->
          <TextBlock Grid.Column="0" Text="{i18n:Oversat meetingview.note}" FontSize="11" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="0,0,10,0"
                     Foreground="{DynamicResource Accent}" />

          <TextBox x:Name="FeltNote" Grid.Column="1" FontSize="13.5" Padding="10,8"
                   VerticalAlignment="Center" KeyDown="Note_KeyDown" TextChanged="Note_Changed"
                   ToolTip="{i18n:Oversat meetingview.skriv_en_note_og_tryk_enter_den_bliver_tid}" />
          <TextBlock x:Name="NotePladsholder" Grid.Column="1" IsHitTestVisible="False" FontSize="13.5"
                     Margin="13,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TekstMeget}"
                     Text="{i18n:Oversat meetingview.skriv_en_note_her_og_tryk_enter_den_bliver}" />

          <TextBlock x:Name="NoteTaeller" Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0"
                     FontSize="12" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" />
        </Grid>
      </Grid>

      <!-- ===================== Højre: handlinger ==================== -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">


        <!-- ==================== DIKTERINGENS GENVEJ ====================

             Den har ingen knap at staa ved siden af. Optagelsen har en; man
             holder ikke en diktering i gang med musen, og der er derfor
             ingen anden maade at laere den end at laese den.

             Den staar roed som optageknappen, fordi den goer det samme paa
             samme tast - kun holdt nede i stedet for trykket. Forskellen er
             ordet «hold», og det er hele saetningen der forklarer den.

             DEN VISES KUN, NAAR DEN VIRKER: dikteringen skal vaere slaaet
             til, og der skal vaere en noegle. En besked om en genvej, der
             ikke goer noget, er vaerre end ingen besked. -->
        <Border x:Name="DiktatPanel" CornerRadius="7" Padding="14,8" Margin="0,0,18,0"
                VerticalAlignment="Center" Visibility="Collapsed"
                Background="{DynamicResource Optager}">
          <TextBlock x:Name="DiktatTekst" FontSize="12.5" FontWeight="SemiBold"
                     VerticalAlignment="Center" Foreground="{DynamicResource PaaOptager}" />
        </Border>

        <TextBlock x:Name="Status" VerticalAlignment="Center" FontSize="11.5" MaxWidth="300"
                   TextWrapping="Wrap" Margin="0,0,14,0" Foreground="{DynamicResource TekstMeget}" />

        <Button x:Name="PauseKnap" Content="{i18n:Oversat topbar.pause}" Click="Pause_Click" Padding="15,9"
                Visibility="Collapsed" Margin="0,0,8,0" />
        <Button x:Name="StopKnap" Content="{i18n:Oversat topbar.stop}" Click="Stop_Click" Padding="18,9"
                Visibility="Collapsed" Background="{DynamicResource Optager}" Foreground="{DynamicResource PaaOptager}"
                BorderThickness="0" FontWeight="SemiBold" />

        <!-- ========================= Lyst og moerkt =========================

             DEN STAAR HERUDE OG IKKE KUN UNDER INDSTILLINGER, fordi det er
             det eneste valg i appen, man skifter FLERE GANGE OM DAGEN. Lyst
             ved skrivebordet om formiddagen, moerkt naar det bliver aften.
             Et valg, der ligger fire klik vaek, bliver truffet én gang og
             derefter ikke igen.

             IKONET VISER, HVAD MAN FAAR - ikke hvor man staar. Er appen lys,
             staar der en maane: tryk, og den bliver moerk. Begge glyffer er
             efterproevet mod skrifttypens cmap-tabel (U+E706 og U+E708) og
             ikke gaettet; et manglende tegn bliver til en tom firkant, og det
             ser man ikke ved at laese koden.

             Hjaelpeteksten siger det med ord. Et ikon alene kan laeses begge
             veje, og det er ikke vaerd at gaette paa. -->
        <Button x:Name="TemaKnap" Click="Tema_Click" Margin="14,0,0,0"
                Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="flade" CornerRadius="8" Background="Transparent" Padding="9,7">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="flade" Property="Background" Value="{DynamicResource Svaev}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>

          <TextBlock x:Name="TemaIkon" FontFamily="Segoe MDL2 Assets" FontSize="16"
                     VerticalAlignment="Center" Foreground="{DynamicResource TekstSvag}" />
        </Button>

        <!-- ========================= Sproget =========================

             DEN STAAR VED SIDEN AF KLOKKEN, fordi de to er af samme slags:
             ting, der gaelder hele appen og derfor skal kunne naas fra
             enhver skaerm.

             FLAGET ALENE, UDEN TEKST. Knappen skal fylde saa lidt som
             muligt - den bruges sjaeldent - og et flag er det eneste ikon,
             der siger "sprog" uden at skulle laeses. Navnet paa sproget
             staar i menuen, der aabner. -->
        <Button x:Name="SprogKnap" Click="Sprog_Click" Margin="14,0,0,0"
                Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                AutomationProperties.Name="{i18n:Oversat topbar.sprog}"
                ToolTip="{i18n:Oversat topbar.vaelgsprog}">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="flade" CornerRadius="8" Background="Transparent" Padding="9,7">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="flade" Property="Background" Value="{DynamicResource Svaev}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>

          <local:Flagikon x:Name="SprogFlag" />
        </Button>

        <!-- ======================== Hjaelpen ========================

             SPOERGSMAALSTEGNET STAAR TIL HOEJRE FOR FLAGET, fordi de tre
             knapper herude er af samme slags: de gaelder hele appen og skal
             kunne naas fra enhver skaerm.

             Hjaelpen ligger I APPEN og ikke paa en hjemmeside. Den virker
             uden net, den kan ikke komme ud af trit med den udgave, man har
             installeret, og den sender ingenting - heller ikke hvad man
             soegte efter. -->
        <Button x:Name="HjaelpKnap" Click="Hjaelp_Click" Margin="4,0,0,0"
                Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                AutomationProperties.Name="{i18n:Oversat hjaelp.titel}"
                ToolTip="{i18n:Oversat hjaelp.hjaelpetekst}">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="flade" CornerRadius="8" Background="Transparent" Padding="9,7">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="flade" Property="Background" Value="{DynamicResource Svaev}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>

          <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                     VerticalAlignment="Center" Foreground="{DynamicResource TekstSvag}" />
        </Button>

        <!-- ========================= Klokken =========================
             Den ligger i topbjælken, fordi den er det ENESTE sted i appen, der
             altid er fremme. Et referat af et langt møde tager fyrre minutter,
             og uden en besked skal man selv huske at kigge efter — så opdager
             man det dagen efter. -->
        <Button x:Name="KlokkeKnap" Click="Klokke_Click" Margin="14,0,0,0"
                Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                ToolTip="{i18n:Oversat topbar.beskeder}">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="flade" CornerRadius="8" Background="Transparent" Padding="9,7">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="flade" Property="Background" Value="{DynamicResource Svaev}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>

          <Grid>
            <TextBlock Text="🔔" FontSize="17" VerticalAlignment="Center" />

            <!-- Tallet sidder PÅ klokken. En klokke uden tal siger, at der
                 findes beskeder; en med tal siger, at der er nye — og det er
                 forskellen på at kigge og at lade være. -->
            <Border x:Name="KlokkeBadge" Background="{DynamicResource Optager}" CornerRadius="8"
                    MinWidth="16" Height="16" Padding="4,0" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-7,0">
              <TextBlock x:Name="KlokkeTal" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource PaaOptager}" HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
          </Grid>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
