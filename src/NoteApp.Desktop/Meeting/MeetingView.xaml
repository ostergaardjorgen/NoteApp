<UserControl x:Class="NoteApp.Desktop.Meeting.MeetingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <UserControl.Resources>
    <!-- Mødetypen som to knapper frem for en rulleliste: der er to valg, og de
         skal begge kunne ses uden at klikke. -->
    <Style x:Key="Typevalg" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Kant" CornerRadius="7" BorderThickness="1" Padding="13,7"
                    Background="#FF181B22" BorderBrush="{StaticResource PanelKant}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Kant" Property="BorderBrush" Value="{StaticResource TekstMeget}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Kant" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="Kant" Property="Background" Value="#FF1D2530" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <!-- Optagebjælken. Den ligger fast øverst i vinduet og er den samme, uanset
       hvilken skærm man står på: at optage et møde er dét, appen er til, og
       det skal ikke være et sted, man først går hen. -->
  <Border Background="#FF1B2029" BorderBrush="{StaticResource PanelKant}" BorderThickness="0,0,0,1"
          Padding="24,12">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- ===================== Venstre: knappen ===================== -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <!-- KNAPPEN ER GJORT MINDRE.
             Den fyldte som en overskrift og trak blikket til sig hver gang,
             man aabnede appen - ogsaa naar man var der for at laese et
             referat. Den skal vaere det foerste, oejet finder, ikke det
             eneste det kan se. Farven goer arbejdet; stoerrelsen behoever
             ikke ogsaa.

             Prikken er en Ellipse og ikke tegnet «●». Tegnet ligger
             forskelligt paa linjen fra skrifttype til skrifttype og stod
             derfor ikke midt for. -->
        <Button x:Name="StartKnap" Click="Start_Click" Cursor="Hand"
                VerticalAlignment="Center">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="flade" CornerRadius="7" Padding="15,8"
                      Background="{StaticResource Optager}">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="8" Height="8" Fill="#FFFFFFFF"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBlock Text="Optag møde" FontSize="13" FontWeight="SemiBold"
                             Foreground="#FFFFFFFF" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="flade" Property="Opacity" Value="0.87" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="flade" Property="Opacity" Value="0.72" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="flade" Property="Opacity" Value="0.42" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>

        <!-- ============ WEBINAR ER SIN EGEN KNAP ============

             Den kunne have været et valg i en dialog efter tryk på «Optag
             møde». Den er en knap for sig, fordi forskellen ikke er en
             indstilling — det er en anden slags optagelse: ét spor i stedet
             for to, sproget valgt på forhånd, og den stopper af sig selv.

             Den er mindre og mere afdæmpet end optageknappen. Møder er det
             almindelige; webinarer er det, man gør bevidst. -->
        <Button x:Name="WebinarKnap" Click="Webinar_Click" Cursor="Hand"
                VerticalAlignment="Center" Margin="10,0,0,0"
                ToolTip="Optag et webinar — kun det, du hører. Halv størrelse, halv tid, og den stopper selv.">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="flade" CornerRadius="7" Padding="13,8"
                      Background="#FF262D3A" BorderBrush="#FF3A4453" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                             VerticalAlignment="Center" Margin="0,0,7,0"
                             Foreground="{StaticResource Accent}" />
                  <TextBlock Text="Webinar" FontSize="13" FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="flade" Property="Background" Value="#FF303949" />
                  <Setter TargetName="flade" Property="BorderBrush" Value="{StaticResource Accent}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="flade" Property="Opacity" Value="0.42" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>

        <!-- Under optagelse: uret og prikken i stedet for knappen -->
        <StackPanel x:Name="UrPanel" Orientation="Horizontal" VerticalAlignment="Center"
                    Visibility="Collapsed">
          <Ellipse x:Name="OptagerPrik" Width="12" Height="12" VerticalAlignment="Center"
                   Margin="0,0,12,0" Fill="{StaticResource Optager}" />
          <StackPanel>
            <TextBlock x:Name="Ur" Text="00:00:00" FontSize="22" FontWeight="SemiBold"
                       FontFamily="Consolas" />
            <TextBlock x:Name="UrUnder" Style="{StaticResource Underskrift}" FontSize="11" />
          </StackPanel>
        </StackPanel>
      </StackPanel>

      <!-- ===================== Midten: felter ====================== -->
      <Grid Grid.Column="1" Margin="20,0,20,0" VerticalAlignment="Center">
        <!-- Før optagelsen står her INTET at udfylde.
             Titelfeltet lå her før, og det var det forkerte tidspunkt: et møde
             begynder om et øjeblik, man aner ikke hvad det kommer til at handle
             om, og feltet blev derfor stående tomt. Navnet spørges der om, når
             mødet er slut — dér ved man det.
             Fysisk/online-valget er væk af samme grund: det kunne ikke træffes
             rigtigt på forhånd. -->
        <Grid x:Name="KlarFelter">
          <TextBlock x:Name="KlarTekst" VerticalAlignment="Center" FontSize="13.5"
                     TextWrapping="Wrap" Foreground="{StaticResource TekstMeget}"
                     Text="Tryk optag, når mødet begynder. Du navngiver det bagefter — og du kan skrive noter undervejs." />
        </Grid>

        <!-- Under optagelsen: notefeltet -->
        <Grid x:Name="OptagFelter" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Etiketten er ikke pynt. Uden den var feltet bare en kasse i en
               bjælke, og man skulle gætte, at det var dér, noterne skulle. -->
          <TextBlock Grid.Column="0" Text="NOTE" FontSize="11" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="0,0,10,0"
                     Foreground="{StaticResource Accent}" />

          <TextBox x:Name="FeltNote" Grid.Column="1" FontSize="13.5" Padding="10,8"
                   VerticalAlignment="Center" KeyDown="Note_KeyDown" TextChanged="Note_Changed"
                   ToolTip="Skriv en note og tryk Enter. Den bliver tidsstemplet, så den kan flettes ind i udskriften det rigtige sted. Ctrl+B sætter et bogmærke uden tekst." />
          <TextBlock x:Name="NotePladsholder" Grid.Column="1" IsHitTestVisible="False" FontSize="13.5"
                     Margin="13,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TekstMeget}"
                     Text="Skriv en note her og tryk Enter — den bliver tidsstemplet" />

          <TextBlock x:Name="NoteTaeller" Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0"
                     FontSize="12" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
        </Grid>
      </Grid>

      <!-- ===================== Højre: handlinger ==================== -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

        <!-- ==================== Genvejstasten =======================
             DEN STAAR FREMME, IKKE KUN SOM TOOLTIP PAA KNAPPEN.

             Et moede begynder, mens man staar i et andet program. Genvejen er
             lavet til netop dét - den virker, ogsaa naar appen er skjult - men
             et tooltip paa en knap, man ikke kan se, kan ingen laere den af.
             Saa fandt man appen frem og trykkede, og de foerste minutter var
             vaek.

             Den staar oeverst til hoejre, hvor der er plads, og den forsvinder
             under optagelsen: dér er den brugt, og Pause og Stop skal have
             pladsen. -->
        <!-- Den er formet som selve knappen: samme hjoernerunding, samme
             hoejde. De to hoerer sammen - det er den samme handling, ad to
             veje - og naar de ligner hinanden, laeses genvejen som «det her
             er den anden maade», ikke som en note ved siden af.

             Tasten staar som en tastekap: lysere flade, en kant, og en tone
             dybere i bunden. Det er nok til, at oejet laeser den som noget,
             man trykker paa, uden at den fylder mere end teksten i den. -->
        <StackPanel x:Name="GenvejPanel" Orientation="Horizontal" VerticalAlignment="Center"
                    Margin="0,0,18,0" Visibility="Collapsed">
          <TextBlock x:Name="GenvejMaerkat" Text="OPTAG MED" FontSize="10" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="0,1,9,0"
                     Foreground="{StaticResource TekstMeget}" />
          <Border CornerRadius="7" Padding="12,7" Background="#FF2F3644"
                  BorderBrush="#FF454E5E" BorderThickness="1,1,1,2">
            <TextBlock x:Name="GenvejTast" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="#FFEDF0F5" VerticalAlignment="Center" />
          </Border>
        </StackPanel>

        <TextBlock x:Name="Status" VerticalAlignment="Center" FontSize="11.5" MaxWidth="300"
                   TextWrapping="Wrap" Margin="0,0,14,0" Foreground="{StaticResource TekstMeget}" />

        <Button x:Name="PauseKnap" Content="❚❚ Pause" Click="Pause_Click" Padding="15,9"
                Visibility="Collapsed" Margin="0,0,8,0" />
        <Button x:Name="StopKnap" Content="■ Stop og gem" Click="Stop_Click" Padding="18,9"
                Visibility="Collapsed" Background="{StaticResource Optager}" Foreground="#FFFFFFFF"
                BorderThickness="0" FontWeight="SemiBold" />

        <!-- ========================= Klokken =========================
             Den ligger i topbjælken, fordi den er det ENESTE sted i appen, der
             altid er fremme. Et referat af et langt møde tager fyrre minutter,
             og uden en besked skal man selv huske at kigge efter — så opdager
             man det dagen efter. -->
        <Button x:Name="KlokkeKnap" Click="Klokke_Click" Margin="14,0,0,0"
                Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                ToolTip="Beskeder om det, appen har lavet færdigt">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="flade" CornerRadius="8" Background="Transparent" Padding="9,7">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="flade" Property="Background" Value="#FF2C323D" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>

          <Grid>
            <TextBlock Text="🔔" FontSize="17" VerticalAlignment="Center" />

            <!-- Tallet sidder PÅ klokken. En klokke uden tal siger, at der
                 findes beskeder; en med tal siger, at der er nye — og det er
                 forskellen på at kigge og at lade være. -->
            <Border x:Name="KlokkeBadge" Background="{StaticResource Optager}" CornerRadius="8"
                    MinWidth="16" Height="16" Padding="4,0" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-7,0">
              <TextBlock x:Name="KlokkeTal" FontSize="10" FontWeight="SemiBold"
                         Foreground="#FFFFFFFF" HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
          </Grid>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
