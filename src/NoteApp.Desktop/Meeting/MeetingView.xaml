<UserControl x:Class="NoteApp.Desktop.Meeting.MeetingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <UserControl.Resources>
    <!-- Mødetypen som to knapper frem for en rulleliste: der er to valg, og de
         skal begge kunne ses uden at klikke. -->
    <Style x:Key="Typevalg" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Kant" CornerRadius="7" BorderThickness="1" Padding="13,7"
                    Background="#FF181B22" BorderBrush="{StaticResource PanelKant}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Kant" Property="BorderBrush" Value="{StaticResource TekstMeget}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Kant" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="Kant" Property="Background" Value="#FF1D2530" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <!-- Optagebjælken. Den ligger fast øverst i vinduet og er den samme, uanset
       hvilken skærm man står på: at optage et møde er dét, appen er til, og
       det skal ikke være et sted, man først går hen. -->
  <Border Background="#FF1B2029" BorderBrush="{StaticResource PanelKant}" BorderThickness="0,0,0,1"
          Padding="24,12">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- ===================== Venstre: knappen ===================== -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="StartKnap" Click="Start_Click" Cursor="Hand" Padding="0"
                BorderThickness="0" Background="Transparent">
          <Border CornerRadius="9" Background="{StaticResource Optager}" Padding="22,11">
            <TextBlock Text="● Optag møde" FontSize="15.5" FontWeight="SemiBold"
                       Foreground="#FFFFFFFF" />
          </Border>
        </Button>

        <!-- Under optagelse: uret og prikken i stedet for knappen -->
        <StackPanel x:Name="UrPanel" Orientation="Horizontal" VerticalAlignment="Center"
                    Visibility="Collapsed">
          <Ellipse x:Name="OptagerPrik" Width="12" Height="12" VerticalAlignment="Center"
                   Margin="0,0,12,0" Fill="{StaticResource Optager}" />
          <StackPanel>
            <TextBlock x:Name="Ur" Text="00:00:00" FontSize="22" FontWeight="SemiBold"
                       FontFamily="Consolas" />
            <TextBlock x:Name="UrUnder" Style="{StaticResource Underskrift}" FontSize="11" />
          </StackPanel>
        </StackPanel>
      </StackPanel>

      <!-- ===================== Midten: felter ====================== -->
      <Grid Grid.Column="1" Margin="20,0,20,0" VerticalAlignment="Center">
        <!-- Før optagelsen: titel og mødetype -->
        <Grid x:Name="KlarFelter">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBox x:Name="FeltTitel" Grid.Column="0" FontSize="13.5" Padding="10,8"
                   VerticalAlignment="Center" Margin="0,0,14,0" TextChanged="Titel_Changed"
                   ToolTip="Kan også udfyldes, mens mødet kører — eller bagefter." />
          <TextBlock x:Name="TitelPladsholder" Grid.Column="0" IsHitTestVisible="False" FontSize="13.5"
                     Margin="13,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TekstMeget}"
                     Text="Hvad handler mødet om? (kan vente)" />

          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <RadioButton x:Name="TypeFysisk" GroupName="type" IsChecked="True" Content="Fysisk"
                         Style="{StaticResource Typevalg}" Checked="Type_Valgt" />
            <RadioButton x:Name="TypeOnline" GroupName="type" Content="Online" Margin="8,0,0,0"
                         Style="{StaticResource Typevalg}" Checked="Type_Valgt" />
          </StackPanel>
        </Grid>

        <!-- Under optagelsen: notefeltet -->
        <Grid x:Name="OptagFelter" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBox x:Name="FeltNote" Grid.Column="0" FontSize="13.5" Padding="10,8"
                   VerticalAlignment="Center" KeyDown="Note_KeyDown"
                   ToolTip="Skriv en note og tryk Enter. Den bliver tidsstemplet. Ctrl+B sætter et bogmærke uden tekst." />
          <TextBlock x:Name="NotePladsholder" Grid.Column="0" IsHitTestVisible="False" FontSize="13.5"
                     Margin="13,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TekstMeget}"
                     Text="Note + Enter · Ctrl+B for bogmærke" />

          <TextBlock x:Name="NoteTaeller" Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0"
                     FontSize="12" Foreground="{StaticResource TekstMeget}" />
        </Grid>
      </Grid>

      <!-- ===================== Højre: handlinger ==================== -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="Status" VerticalAlignment="Center" FontSize="11.5" MaxWidth="300"
                   TextWrapping="Wrap" Margin="0,0,14,0" Foreground="{StaticResource TekstMeget}" />

        <Button x:Name="PauseKnap" Content="❚❚ Pause" Click="Pause_Click" Padding="15,9"
                Visibility="Collapsed" Margin="0,0,8,0" />
        <Button x:Name="StopKnap" Content="■ Stop og gem" Click="Stop_Click" Padding="18,9"
                Visibility="Collapsed" Background="{StaticResource Optager}" Foreground="#FFFFFFFF"
                BorderThickness="0" FontWeight="SemiBold" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
