<Window x:Class="NoteApp.Desktop.Meeting.OptageBaand"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:NoteApp.Desktop"
        Title="NoteApp optager"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Topmost="True" ShowInTaskbar="True">

  <!-- ======================= OPTAGEBÅNDET =======================

       Mens der optages, er appen ikke det, man kigger på. Man kigger på
       mødet: et videoopkald, en dagsorden, en anden persons skærm. Et helt
       programvindue i vejen er ikke bare i vejen — det gør, at man skjuler
       det, og så kan man ikke se, om der stadig optages.

       Båndet er derfor det eneste, der bliver stående. Det viser, at der
       optages, hvor længe, og det har de to udveje: gem eller kassér.

       DET LIGGER ØVERST OVER ALT ANDET.
       Topmost. Et bånd, der forsvinder bag et browservindue, svarer til ikke
       at have det.

       DET STÅR I PROCESLINJEN.
       Mens der optages, er hovedvinduet skjult, og båndet er dermed det
       eneste, der er tilbage af appen. Uden en knap i proceslinjen ville en
       skærm, der bliver koblet fra — eller et andet program, der også vil
       ligge øverst — kunne efterlade en igang­værende optagelse uden nogen vej
       tilbage til den.

       DET KAN FLYTTES.
       Hele fladen trækker vinduet — undtagen felterne og knapperne, som selv
       tager imod klikket. Placeringen huskes til næste møde, fordi den med to
       skærme aldrig er tilfældig. -->

  <Border x:Name="Flade" CornerRadius="12" Background="{DynamicResource Trykket}"
          BorderBrush="{DynamicResource PanelKant}" BorderThickness="1" Padding="14,9"
          MouseLeftButtonDown="Flade_Traek" Cursor="SizeAll">
    <Border.Effect>
      <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.55" Color="#FF000000" />
    </Border.Effect>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

      <!-- Greb. Det siger, at båndet kan flyttes — uden en linje tekst,
           der skal læses hver gang. -->
      <TextBlock Text="⠿" FontSize="16" VerticalAlignment="Center"
                 Margin="0,0,12,0" Foreground="{DynamicResource Slukket}" />

      <!-- Prikken blinker, så længe der optages. Står den stille, er der
           pause — og det skal kunne ses på tværs af et lokale. -->
      <Ellipse x:Name="Prik" Width="11" Height="11" VerticalAlignment="Center"
               Margin="0,0,10,0" Fill="{DynamicResource Optager}" />

      <TextBlock x:Name="Ur" Text="00:00:00" FontSize="19" FontWeight="SemiBold"
                 FontFamily="Consolas" VerticalAlignment="Center"
                 Foreground="{DynamicResource Tekst}" Margin="0,0,4,0" />

      <TextBlock x:Name="Tilstand" FontSize="11" VerticalAlignment="Center"
                 Margin="10,2,0,0" Foreground="{DynamicResource TekstMeget}" />

      <Rectangle Width="1" Height="26" Fill="{DynamicResource PanelKant}" Margin="14,0,14,0" />

      <!-- ÉN KONTAKT, DER SKIFTER BEGGE VEJE.
           Appen skal kunne rulles ud og foldes sammen igen midt i en
           optagelse, fx naar den vises frem for andre. Teksten SKIFTER, saa
           man kan se, hvad et klik goer nu; en kontakt, hvor man ikke kan se,
           hvilken vej den staar, bliver gaettet paa.

           Den ligger her til venstre og ikke ude ved Stop og Kassér. Et
           fejlklik paa en knap, der bare viser et vindue, koster ingenting -
           et fejlklik paa naboen koster optagelsen.

           Det er en KNAP og ikke hele fladen: hele fladen traekker vinduet,
           og et traek maa ikke ogsaa taelle som et klik. En Button tager selv
           imod museklikket, saa traek-handleren paa Border aldrig ser det. -->
      <Button x:Name="VisAppKnap" Click="VisApp_Klik" Cursor="Hand"
              Content="{i18n:Oversat optagebaand.vis_appen}" Padding="14,7" FontSize="12.5"
              ToolTip="{i18n:Oversat optagebaand.vis_hele_appen_frem_optagelsen_fortsaetter}" />

      <Rectangle Width="1" Height="26" Fill="{DynamicResource PanelKant}" Margin="14,0,14,0" />

      <!-- Noterne skal kunne skrives HER.
           Kunne de kun skrives i appen, og appen er væk, ville funktionen
           reelt være væk under mødet — som er det eneste tidspunkt, den er
           noget værd. -->
      <Grid Width="240" VerticalAlignment="Center">
        <TextBox x:Name="Note" FontSize="12.5" Padding="9,6" Cursor="IBeam"
                 Background="{DynamicResource AccentFlade}" BorderBrush="{DynamicResource PanelKant}" BorderThickness="1"
                 Foreground="{DynamicResource Tekst}" CaretBrush="{DynamicResource Tekst}"
                 KeyDown="Note_Tast"
                 ToolTip="{i18n:Oversat optagebaand.skriv_en_note_og_tryk_enter_den_bliver_tid}" />
        <TextBlock x:Name="NotePladsholder" IsHitTestVisible="False" FontSize="12.5"
                   Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Slukket}"
                   Text="{i18n:Oversat optagebaand.note_tryk_enter}" />
      </Grid>

      <TextBlock x:Name="NoteTaeller" FontSize="11.5" FontWeight="SemiBold"
                 VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource Accent}" />

      <Rectangle Width="1" Height="26" Fill="{DynamicResource PanelKant}" Margin="14,0,14,0" />

      <Button x:Name="PauseKnap" Click="Pause_Klik" Content="❚❚" Cursor="Hand"
              Padding="11,7" FontSize="12" Margin="0,0,7,0"
              ToolTip="{i18n:Oversat optagebaand.hold_pause_der_optages_intet_foer_du_forts}" />

      <Button x:Name="StopKnap" Click="Stop_Klik" Content="{i18n:Oversat faelles.stop_og_gem}" Cursor="Hand"
              Padding="14,7" FontSize="12.5" FontWeight="SemiBold"
              Background="{DynamicResource Optager}" Foreground="{DynamicResource PaaOptager}" BorderThickness="0"
              ToolTip="{i18n:Oversat optagebaand.afslut_optagelsen_og_gem_den_du_navngiver}" />

      <Button x:Name="AnnullerKnap" Click="Annuller_Klik" Content="✕" Cursor="Hand"
              Padding="11,7" FontSize="12" Margin="7,0,0,0"
              ToolTip="{i18n:Oversat optagebaand.kasser_optagelsen_uden_at_gemme_lyden_bliv}" />
    </StackPanel>
  </Border>
</Window>
