<UserControl x:Class="NoteApp.Desktop.Meeting.MeetingLiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:NoteApp.Desktop"
             Background="{StaticResource Baggrund}">

  <Grid Margin="28,22,28,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ============================ Toppen ============================== -->
    <Grid Grid.Row="0" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock x:Name="Titel" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="Undertitel" Style="{StaticResource Underskrift}" Margin="0,4,0,0" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Ellipse x:Name="Prik" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,14,0"
                 Fill="{StaticResource Optager}" />
        <StackPanel HorizontalAlignment="Right">
          <TextBlock x:Name="Ur" Text="00:00:00" FontSize="34" FontWeight="SemiBold"
                     FontFamily="Consolas" HorizontalAlignment="Right" />
          <TextBlock x:Name="UrUnder" Style="{StaticResource Underskrift}" HorizontalAlignment="Right" />
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- ============================ Noterne ============================= -->
    <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="12"
            BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,18,24,0">
          <TextBlock Text="{i18n:Oversat meetingliveview.noter_undervejs}" FontSize="15" FontWeight="SemiBold" />
          <TextBlock x:Name="NoteAntal" HorizontalAlignment="Right" FontSize="12.5"
                     Foreground="{StaticResource TekstMeget}" VerticalAlignment="Center" />
        </Grid>

        <!-- Noterne fylder resten. Det er hele pointen med skærmen: der skal
             være plads til at skrive, mens mødet kører. -->
        <ScrollViewer Grid.Row="1" Margin="24,14,24,0" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock x:Name="TomTekst" FontSize="13.5" LineHeight="22" TextWrapping="Wrap"
                       Foreground="{StaticResource TekstMeget}" Margin="0,10,0,0"
                       Text="{i18n:Oversat meetingliveview.ingen_noter_endnu_skriv_det_der_skal_huske}" />

            <ItemsControl x:Name="Noter">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Tid}" FontFamily="Consolas" FontSize="12.5"
                               FontWeight="SemiBold"
                               Margin="0,1,18,0" Foreground="{StaticResource Accent}" />
                    <TextBlock Grid.Column="1" Text="{Binding Tekst}" FontSize="14" LineHeight="22"
                               TextWrapping="Wrap" Foreground="{StaticResource Tekst}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- Skrivefeltet nederst, stort. -->
        <Grid Grid.Row="2" Margin="24,16,24,20">
          <TextBox x:Name="Felt" FontSize="15" Padding="14,12" TextChanged="Felt_Changed"
                   KeyDown="Felt_KeyDown" />
          <TextBlock x:Name="Pladsholder" IsHitTestVisible="False" FontSize="15" Margin="17,0,0,0"
                     VerticalAlignment="Center" Foreground="{StaticResource TekstMeget}"
                     Text="{i18n:Oversat meetingliveview.skriv_en_note_og_tryk_enter_ctrl_b_saetter}" />
        </Grid>
      </Grid>
    </Border>

    <!-- ============================ Bunden ============================== -->
    <Grid Grid.Row="2" Margin="0,18,0,0">
      <TextBlock x:Name="Status" VerticalAlignment="Center" FontSize="12.5" TextWrapping="Wrap"
                 Foreground="{StaticResource TekstMeget}" MaxWidth="620" HorizontalAlignment="Left" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="PauseKnap" Content="{i18n:Oversat meetingliveview.pause}" Click="Pause_Click" Padding="22,12"
                FontSize="14" Margin="0,0,12,0" />
        <Button Content="{i18n:Oversat faelles.stop_og_gem}" Click="Stop_Click" Padding="26,12" FontSize="14"
                Background="{StaticResource Optager}" Foreground="{StaticResource PaaOptager}"
                BorderThickness="0" FontWeight="SemiBold" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
