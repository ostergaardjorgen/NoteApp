<Window x:Class="NoteApp.Desktop.Meeting.AftaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:NoteApp.Desktop"
        Title="Aftale"
        Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Baggrund}"
        WindowStyle="ToolWindow">

  <!-- ==================== EN AFTALE I KALENDEREN ====================

       DEN FINDES, FORDI KALENDEREN SKAL VIRKE UDEN EN INTEGRATION.

       Målgruppen er studerende og mindre selvstændige, og en del af dem har
       hverken Google Workspace eller Microsoft 365. En kalender, der kræver
       en konto hos Google for at virke, er ubrugelig for dem — og så er den
       ikke en kalender, den er en integration med en forside.

       DE SAMME TRE VALG SOM VED EN OPTAGELSE. Mappe, mødetype og sprog står
       her og ikke i opstartsdialogen, fordi de kan besvares i ro, når aftalen
       lægges ind — og så skal der ikke svares på noget, mens mødet går i
       gang. Trykker man optag på aftalen, følger de tre med. -->

  <StackPanel Margin="24,20,24,20">

    <TextBlock x:Name="Overskrift" FontSize="19" FontWeight="SemiBold" />
    <TextBlock x:Name="Underskrift" Style="{StaticResource Underskrift}"
               Margin="0,4,0,0" TextWrapping="Wrap" />

    <TextBlock Text="{i18n:Oversat aftalewindow.hvad_er_det}" FontSize="9.5" FontWeight="SemiBold"
               Margin="2,18,0,6" Foreground="{StaticResource TekstMeget}" />
    <TextBox x:Name="Titel" FontSize="13.5" Padding="10,7" />

    <!-- ARRANGOEREN. Kun paa en hentet aftale - en, man selv har lavet, har
         ikke nogen. «Catch-up - Relation» siger ingenting om, hvem man skal
         tale med; det goer navnet. -->
    <StackPanel x:Name="Arrangoerrude" Margin="0,14,0,0" Visibility="Collapsed">
      <TextBlock Text="{i18n:Oversat aftalewindow.indkaldt_af}" FontSize="9.5" FontWeight="SemiBold" Margin="2,0,0,6"
                 Foreground="{StaticResource TekstMeget}" />
      <TextBlock x:Name="Arrangoer" FontSize="14" TextWrapping="Wrap"
                 Foreground="{StaticResource Tekst}" />
      <TextBlock x:Name="Arrangoernote" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                 Visibility="Collapsed"
                 Foreground="{StaticResource Advarsel}"
                 Text="{i18n:Oversat aftalewindow.du_er_selv_arrangoer_saa_er_det_dig_der_sk}" />
    </StackPanel>

    <!-- EN HENTET AFTALE VISER TIDEN SOM TEKST.
         Felterne var laaste alligevel, og en laast datovaelger er tre
         kontroller, der ser ud som noget, der er gaaet i stykker. Her staar
         der bare, hvornaar moedet er. -->
    <StackPanel x:Name="Laasttid" Margin="0,14,0,0" Visibility="Collapsed">
      <TextBlock Text="{i18n:Oversat aftalewindow.hvornaar}" FontSize="9.5" FontWeight="SemiBold" Margin="2,0,0,6"
                 Foreground="{StaticResource TekstMeget}" />
      <TextBlock x:Name="Tidslinje" FontSize="14" TextWrapping="Wrap"
                 Foreground="{StaticResource Tekst}" />
    </StackPanel>

    <Grid x:Name="Tidsfelter" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="{i18n:Oversat aftalewindow.dato}" FontSize="9.5" FontWeight="SemiBold" Margin="2,0,0,6"
                   Foreground="{StaticResource TekstMeget}" />
        <DatePicker x:Name="Dato" FontSize="13" />
      </StackPanel>

      <StackPanel Grid.Column="2">
        <TextBlock Text="{i18n:Oversat aftalewindow.fra}" FontSize="9.5" FontWeight="SemiBold" Margin="2,0,0,6"
                   Foreground="{StaticResource TekstMeget}" />
        <ComboBox x:Name="Fra" Width="92" FontSize="13" Padding="8,6" IsEditable="True" />
      </StackPanel>

      <StackPanel Grid.Column="4">
        <TextBlock Text="{i18n:Oversat aftalewindow.til}" FontSize="9.5" FontWeight="SemiBold" Margin="2,0,0,6"
                   Foreground="{StaticResource TekstMeget}" />
        <ComboBox x:Name="Til" Width="92" FontSize="13" Padding="8,6" IsEditable="True" />
      </StackPanel>
    </Grid>

    <TextBlock Text="{i18n:Oversat aftalewindow.link_eller_sted_kan_staa_tomt}" FontSize="9.5" FontWeight="SemiBold"
               Margin="2,14,0,6" Foreground="{StaticResource TekstMeget}" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBox x:Name="Link" Grid.Column="0" FontSize="12.5" Padding="10,7" />

      <!-- MOEDET SKAL KUNNE AABNES HERFRA.
           Uden knappen skulle man over i Google Kalender for at trykke paa
           det samme link - og saa er kalenderen her en visning, man alligevel
           forlader. Knappen staar kun, naar der ER et link. -->
      <Button x:Name="AabnLinkKnap" Grid.Column="1" Content="{i18n:Oversat aftalewindow.aabn_moedet}"
              Click="AabnLink_Klik" Margin="8,0,0,0" Padding="14,7" FontSize="12"
              Visibility="Collapsed"
              ToolTip="{i18n:Oversat aftalewindow.aabner_moedelinket_i_din_browser}" />
    </Grid>

    <!-- ============ DE TRE, DER FØLGER MED TIL OPTAGELSEN ============ -->
    <Border Background="#FF181B22" BorderBrush="{StaticResource PanelKant}" BorderThickness="1"
            CornerRadius="8" Padding="14,12" Margin="0,18,0,0">
      <StackPanel>
        <TextBlock Text="{i18n:Oversat aftalewindow.naar_du_trykker_optag_paa_aftalen}" FontSize="12.5" FontWeight="SemiBold" />
        <TextBlock FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" LineHeight="19"
                   Foreground="{StaticResource TekstSvag}"
                   Text="{i18n:Oversat aftalewindow.de_her_tre_foelger_med_saa_der_ikke_skal_s}" />

        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock Text="{i18n:Oversat faelles.mappe}" FontSize="9" FontWeight="SemiBold" Margin="2,0,0,5"
                       Foreground="{StaticResource TekstMeget}" />
            <ComboBox x:Name="Mappevalg" FontSize="12" Padding="8,5">
              <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Navn}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock Text="{i18n:Oversat faelles.moedetype}" FontSize="9" FontWeight="SemiBold" Margin="2,0,0,5"
                       Foreground="{StaticResource TekstMeget}" />
            <ComboBox x:Name="Typevalg" FontSize="12" Padding="8,5">
              <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Navn}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <StackPanel Grid.Column="4">
            <TextBlock Text="{i18n:Oversat aftalewindow.sprog}" FontSize="9" FontWeight="SemiBold" Margin="2,0,0,5"
                       Foreground="{StaticResource TekstMeget}" />
            <ComboBox x:Name="Sprogvalg" FontSize="12" Padding="8,5">
              <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Navn}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Grid>

        <CheckBox x:Name="ErWebinar" Margin="0,12,0,0" FontSize="12"
                  Content="{i18n:Oversat aftalewindow.optag_som_webinar_kun_det_computeren_afspi}" />

        <!-- OGSAA PAA EN HENTET AFTALE. Feltet er appens eget og findes ikke
             hos Google, saa det kan saettes paa hvad som helst i kalenderen. -->
        <CheckBox x:Name="OptagAutomatisk" Margin="0,10,0,0" FontSize="12"
                  Checked="Automatisk_Skiftet" Unchecked="Automatisk_Skiftet"
                  Content="{i18n:Oversat aftalewindow.start_optagelsen_automatisk_naar_moedet_be}" />

        <TextBlock x:Name="AutomatiskNote" Margin="24,3,0,0" FontSize="11"
                   TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{StaticResource Advarsel}"
                   Text="{i18n:Oversat aftalewindow.optagelsen_begynder_to_minutter_foer_det_k}" />

        <!-- MEET PAA EN HENTET AFTALE.
             Den staar kun paa en Google-aftale uden link. Er der allerede et
             moedelink, er der ikke noget at tilfoeje - og en knap, der laver
             et moederum nummer to, er en fejl, ikke en mulighed. -->
        <Button x:Name="TilfoejMeetKnap" Content="{i18n:Oversat faelles.tilfoej_et_google_meet_link}"
                Click="TilfoejMeet_Klik" HorizontalAlignment="Left"
                Margin="0,12,0,0" Padding="12,6" FontSize="12"
                Visibility="Collapsed"
                ToolTip="{i18n:Oversat aftalewindow.opretter_et_moedelokale_hos_google_og_laeg}" />

        <!-- Hakket vises kun, naar der ER en forbindelse. Et afkrydsningsfelt,
             der ikke kan bruges, er et spoergsmaal om hvorfor. -->
        <CheckBox x:Name="OpretHosGoogle" Margin="0,10,0,0" FontSize="12"
                  Visibility="Collapsed"
                  Checked="Google_Skiftet" Unchecked="Google_Skiftet"
                  Content="{i18n:Oversat aftalewindow.opret_ogsaa_i_google_kalender}" />

        <TextBlock x:Name="GoogleForklaring" Margin="24,3,0,0" FontSize="11"
                   TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{StaticResource TekstMeget}"
                   Text="{i18n:Oversat aftalewindow.titel_tidspunkt_og_sted_sendes_op_moedetyp}" />

        <!-- DE TO UNDERVALG VISES FOERST, NAAR DER ER SAT HAK OVENFOR.
             De giver ingen mening uden, og to doede felter er to
             spoergsmaal om hvorfor. -->
        <StackPanel x:Name="Googlevalg" Margin="24,8,0,0" Visibility="Collapsed">

          <CheckBox x:Name="MedMeet" FontSize="12" IsChecked="True"
                    Content="{i18n:Oversat faelles.tilfoej_et_google_meet_link}" />
          <TextBlock Margin="24,2,0,0" FontSize="11" TextWrapping="Wrap"
                     Foreground="{StaticResource TekstMeget}"
                     Text="{i18n:Oversat aftalewindow.linket_kommer_med_tilbage_saa_moedet_kan_s}" />

          <CheckBox x:Name="InviterGaester" FontSize="12" Margin="0,9,0,0"
                    Content="{i18n:Oversat aftalewindow.jeg_vil_invitere_gaester}" />
          <TextBlock Margin="24,2,0,0" FontSize="11" TextWrapping="Wrap"
                     Foreground="{StaticResource TekstMeget}"
                     Text="{i18n:Oversat aftalewindow.aftalen_aabnes_i_google_kalender_naar_den}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <TextBlock x:Name="Fejl" FontSize="12" Margin="2,12,0,0" TextWrapping="Wrap"
               Foreground="{StaticResource Advarsel}" />

    <Grid Margin="0,18,0,0">
      <Button x:Name="SletKnap" Content="{i18n:Oversat aftalewindow.slet_aftalen}" Click="Slet_Klik"
              HorizontalAlignment="Left" Padding="14,8" Visibility="Collapsed" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <!-- OPTAGELSEN STARTES HERFRA.
             «Optag»-knappen sad paa kortet i kalenderen og er flyttet ind.
             Her kan man se, hvad der bliver optaget SOM - mappe, moedetype og
             sprog staar lige ovenover - foer man trykker. Paa kortet var det
             en knap, der startede tyve minutters optagelse uden at vise, hvad
             den ville goere.

             Den gemmer aftalen foerst. Har man rettet mappen og saa trykket
             optag, skal optagelsen bruge den nye mappe. -->
        <Button x:Name="OptagKnap" Content="{i18n:Oversat faelles.optag_moedet}" Click="Optag_Klik"
                Padding="16,8" Margin="0,0,10,0" Visibility="Collapsed" />
        <Button Content="{i18n:Oversat faelles.fortryd}" Click="Fortryd_Klik" Padding="16,8" Margin="0,0,10,0" />
        <Button x:Name="GemKnap" Content="{i18n:Oversat aftalewindow.gem_aftalen}" Click="Gem_Klik"
                Padding="20,8" Style="{StaticResource Primaer}" IsDefault="True" />
      </StackPanel>
    </Grid>
  </StackPanel>
</Window>
