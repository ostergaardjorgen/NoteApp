<Window x:Class="NoteApp.Desktop.Meeting.MoedevagtPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:NoteApp.Desktop"
        Title="Er der startet et møde?"
        Width="360" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False">

  <!-- ==================== ER DER STARTET ET MØDE? ====================

       DEN SPØRGER, DEN GØR IKKE NOGET.

       Appen optager aldrig af sig selv. Det er ikke et teknisk forbehold —
       det er hele grundlaget for at turde have den kørende: en optagelse
       begynder, fordi et menneske trykkede på noget.

       DEN STJÆLER IKKE FOKUS.

       ShowActivated="False" og ingen modal dialog. Beskeden kommer, mens man
       er ved at logge ind på et møde, og et vindue, der tager tastaturet midt
       i en adgangskode eller et «unmute», ville være det, der fik folk til at
       slå vagten fra.

       Den lægger sig nede ved uret, hvor Windows' egne beskeder kommer. -->

  <Border Background="{DynamicResource Trykket}" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
          CornerRadius="10" Padding="16,14">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.55" Color="#FF000000" />
    </Border.Effect>

    <StackPanel>

      <Grid>
        <TextBlock x:Name="Overskrift" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                   Margin="0,0,24,0" Foreground="{DynamicResource Tekst}" />

        <Button Content="✕" Click="Luk_Klik" HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="Transparent" BorderThickness="0" Padding="6,0" FontSize="12"
                Foreground="{DynamicResource TekstMeget}" Cursor="Hand"
                ToolTip="{i18n:Oversat moedevagtpopup.luk_der_spoerges_igen_naeste_gang_et_moede}" />
      </Grid>

      <TextBlock x:Name="Broedtekst" FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,6,0,0"
                 Foreground="{DynamicResource TekstSvag}"
                 Text="{i18n:Oversat moedevagtpopup.skal_moedet_optages_appen_optager_aldrig_a}" />

      <!-- DEN HER LINJE SKAL STÅ.
           Optagelsen bliver på maskinen, og netop derfor kan man se de andre i
           øjnene og sige, hvor den ender. Teksten skal hjælpe med at give den
           besked — aldrig med at lade være. -->
      <TextBlock x:Name="Sigtil" FontSize="11.5" LineHeight="17" TextWrapping="Wrap" Margin="0,8,0,0"
                 Foreground="{DynamicResource TekstMeget}"
                 Text="{i18n:Oversat moedevagtpopup.sig_til_de_andre_at_du_optager_lyden_blive}" />

      <!-- ============ OPTAGES DEN ANDEN HALVDEL OGSAA? ============

           Windows har TO standardhoejttalere: en til musik og en til opkald.
           Optager appen fra den forkerte, optages din egen stemme fint - og
           modparten findes ikke. Udskriften ser hel ud.

           Ruden staar KUN, naar de to peger hvert sit sted. Se
           AudioDevices.Opkaldsafvigelse. -->
      <Border x:Name="Enhedsadvarsel" Visibility="Collapsed" Margin="0,10,0,0"
              Background="{DynamicResource AdvarselFlade}" BorderBrush="{DynamicResource Advarsel}"
              BorderThickness="1" CornerRadius="8" Padding="10,8">
        <TextBlock x:Name="Enhedsadvarseltekst" FontSize="11.5" LineHeight="17"
                   TextWrapping="Wrap" Foreground="{DynamicResource Tekst}" />
      </Border>

      <!-- ============ SPROGET - KUN VED ET OPKALD ============

           Et moede faar sine spoergsmaal bagefter, oven paa den koerende
           optagelse. Et opkald faar ingen: det skal bare optages. Men sproget
           kan ikke gaettes uden at koste hele udskriften, saa det ene
           spoergsmaal staar her - besvaret paa forhaand med dansk. -->
      <StackPanel x:Name="Sprogpanel" Visibility="Collapsed" Margin="0,12,0,0">
        <TextBlock FontSize="11.5" Foreground="{DynamicResource TekstMeget}" Margin="0,0,0,6"
                   Text="{i18n:Oversat moedevagtpopup.opkald_sprog}" />
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="Dansk" GroupName="Opkaldssprog" IsChecked="True" Style="{StaticResource Fanevalg}"
                       Content="{i18n:Oversat moedevagtpopup.dansk}" />
          <RadioButton x:Name="Engelsk" GroupName="Opkaldssprog" Style="{StaticResource Fanevalg}" Margin="6,0,0,0"
                       Content="{i18n:Oversat moedevagtpopup.engelsk}" />
        </StackPanel>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
        <Button x:Name="OptagKnap" Content="{i18n:Oversat faelles.optag_moedet}" Click="Optag_Klik" Padding="16,7" FontSize="12.5"
                Style="{StaticResource Primaer}" />
        <Button Content="{i18n:Oversat moedevagtpopup.ikke_nu}" Click="Luk_Klik" Padding="14,7" Margin="8,0,0,0" FontSize="12.5" />
      </StackPanel>

      <Button x:Name="AldrigKnap" Click="Aldrig_Klik" Margin="0,10,0,0" Padding="0"
              HorizontalAlignment="Left" Background="Transparent" BorderThickness="0"
              FontSize="11.5" Cursor="Hand" Foreground="{DynamicResource TekstMeget}" />
    </StackPanel>
  </Border>
</Window>
