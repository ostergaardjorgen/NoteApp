<Window x:Class="NoteApp.Desktop.Meeting.OpstartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Optag"
        Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Baggrund}"
        WindowStyle="ToolWindow">

  <!-- ==================== FØR DER OPTAGES ====================

       ÉN dialog til både møde og webinar. To dialoger, der spørger om næsten
       det samme, holder op med at ligne hinanden, og så bliver det en
       tilfældighed, hvad man kan svare hvor.

       De tre spørgsmål stilles FØR og ikke bagefter, fordi de kun kan
       besvares nu:

       Mappen: bagefter er der ingen, der rydder op. Vælges den her, hvor man
       ved, hvad mødet handler om, ligger materialet rigtigt fra begyndelsen —
       og det er dét, der gør en søgning på tværs af to års møder til et
       opslagsværk frem for en bunke.

       Mødetypen: den er kendt før mødet. Bagefter skal man oversætte sit møde
       til en skabelon, og det er dér, folk står af.

       Sproget: appen gætter det ud fra de første tredive sekunder. Målt
       19-08-2026 blev begge spor på et dansk-norsk møde gættet til engelsk, og
       hele udskriften blev vrøvl. Brugeren ved det. Det er det billigste
       rigtige svar, der findes.

       ALLE TRE MÅ STÅ TOMME. Dialogen må aldrig blive det, der forsinker en
       optagelse — og genvejstasten går helt uden om den: dér starter
       optagelsen først, og dialogen kommer ovenpå. -->

  <StackPanel Margin="24,20,24,20">

    <TextBlock x:Name="Overskrift" FontSize="19" FontWeight="SemiBold" />
    <TextBlock x:Name="Underskrift" Style="{StaticResource Underskrift}"
               Margin="0,5,0,0" TextWrapping="Wrap" />

    <!-- ============ HVORFOR WEBINARET HAR SIN EGEN KNAP ============
         Står kun ved et webinar. Uden den trykker folk på den almindelige
         optageknap, som er den, de kender, og så optages deres egen mikrofon
         med til ingen nytte. -->
    <Border x:Name="WebinarForklaring" Visibility="Collapsed"
            Background="#FF181B22" BorderBrush="{StaticResource PanelKant}" BorderThickness="1"
            CornerRadius="8" Padding="14,12" Margin="0,16,0,0">
      <StackPanel>
        <TextBlock Text="Der optages kun det, du hører — ikke din mikrofon." FontSize="13"
                   FontWeight="SemiBold" />
        <TextBlock FontSize="12.5" LineHeight="20" TextWrapping="Wrap" Margin="0,6,0,0"
                   Foreground="{StaticResource TekstSvag}"
                   Text="Et webinar er envejs: du lytter, du taler ikke. Tages din mikrofon med, optages der et helt spor uden indhold — og det skal skrives ud sammen med resten." />

        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="1" Text="MØDE" FontSize="9.5" FontWeight="SemiBold"
                     Margin="16,0,0,4" Foreground="{StaticResource TekstMeget}" />
          <TextBlock Grid.Row="0" Grid.Column="2" Text="WEBINAR" FontSize="9.5" FontWeight="SemiBold"
                     Margin="16,0,0,4" Foreground="{StaticResource Accent}" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Fylder" FontSize="12"
                     Foreground="{StaticResource TekstMeget}" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="220 MB/t" FontSize="12"
                     Margin="16,0,0,0" HorizontalAlignment="Right"
                     Foreground="{StaticResource TekstMeget}" />
          <TextBlock Grid.Row="1" Grid.Column="2" Text="110 MB/t" FontSize="12"
                     Margin="16,0,0,0" HorizontalAlignment="Right" FontWeight="SemiBold" />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Skrives ud på" FontSize="12" Margin="0,3,0,0"
                     Foreground="{StaticResource TekstMeget}" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="~9 min" FontSize="12" Margin="16,3,0,0"
                     HorizontalAlignment="Right" Foreground="{StaticResource TekstMeget}" />
          <TextBlock Grid.Row="2" Grid.Column="2" Text="~4½ min" FontSize="12" Margin="16,3,0,0"
                     HorizontalAlignment="Right" FontWeight="SemiBold" />
        </Grid>

        <TextBlock FontSize="12" LineHeight="19" TextWrapping="Wrap" Margin="0,10,0,0"
                   Foreground="{StaticResource TekstMeget}"
                   Text="Udskriften bliver desuden bedre: uden dit eget spor er der intet ekko, ingen overlappende tale og ingen tvivl om, hvem der talte." />
      </StackPanel>
    </Border>

    <!-- ============ MAPPEN ============ -->
    <TextBlock Text="MAPPE" FontSize="9.5" FontWeight="SemiBold"
               Margin="2,18,0,0" Foreground="{StaticResource TekstMeget}" />
    <TextBlock x:Name="MappeHjaelp" FontSize="12" TextWrapping="Wrap" Margin="2,5,0,0" LineHeight="18"
               Foreground="{StaticResource TekstSvag}" />

    <Grid Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- MAPPEN VISES MED EN SKABELON, IKKE MED DisplayMemberPath.
           DisplayMemberPath slog ikke igennem her, og resultatet var, at
           rullelisten viste typen skrevet ud — «Punkt { Navn = Webinarer,
           Under = , Vaerdi = Webinarer }». En skabelon binder til det felt,
           der skal vises, og kan ikke falde tilbage til noget andet. -->
      <ComboBox x:Name="Mappevalg" Grid.Column="0" FontSize="13" Padding="10,7">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Navn}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Grid.Column="1" Content="Ny mappe…" Click="NyMappe_Klik"
              Margin="8,0,0,0" Padding="14,7" FontSize="12.5" />
    </Grid>

    <!-- ============ MØDETYPEN ============ -->
    <TextBlock Text="MØDETYPE" FontSize="9.5" FontWeight="SemiBold"
               Margin="2,18,0,0" Foreground="{StaticResource TekstMeget}" />
    <TextBlock x:Name="TypeHjaelp" FontSize="12" TextWrapping="Wrap" Margin="2,5,0,0" LineHeight="18"
               Foreground="{StaticResource TekstSvag}" />

    <ComboBox x:Name="Typevalg" Margin="0,8,0,0" FontSize="13" Padding="10,7">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <StackPanel>
            <TextBlock Text="{Binding Navn}" />
            <TextBlock Text="{Binding Under}" FontSize="11"
                       Foreground="{StaticResource TekstMeget}"
                       TextTrimming="CharacterEllipsis" MaxWidth="480" />
          </StackPanel>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>

    <!-- ============ SPROGET ============ -->
    <TextBlock x:Name="SprogOverskrift" FontSize="9.5" FontWeight="SemiBold"
               Margin="2,18,0,0" Foreground="{StaticResource TekstMeget}" />
    <TextBlock x:Name="SprogHjaelp" FontSize="12" TextWrapping="Wrap" Margin="2,5,0,0" LineHeight="18"
               Foreground="{StaticResource TekstSvag}" />

    <ComboBox x:Name="Sprogvalg" Margin="0,8,0,0" FontSize="13" Padding="10,7">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Navn}" />
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>

    <!-- ============ LINKET — KUN VED WEBINAR ============ -->
    <StackPanel x:Name="Linkfelt" Visibility="Collapsed">
      <TextBlock Text="LINK TIL WEBINARET (kan stå tomt)" FontSize="9.5" FontWeight="SemiBold"
                 Margin="2,18,0,0" Foreground="{StaticResource TekstMeget}" />
      <TextBlock FontSize="12" TextWrapping="Wrap" Margin="2,5,0,0" LineHeight="18"
                 Foreground="{StaticResource TekstSvag}"
                 Text="Ligger webinaret online bagefter, er linket vejen tilbage til det, der blev VIST — og det er væk fra indbakken en måned senere. Sæt det ind nu, så følger det med optagelsen." />

      <TextBox x:Name="Link" Margin="0,8,0,0" FontSize="12.5" Padding="10,7" />
    </StackPanel>

    <!-- ============ DEN STOPPER SELV — KUN VED WEBINAR ============ -->
    <Border x:Name="Stopperselv" Visibility="Collapsed"
            Background="#FF1D2530" BorderBrush="{StaticResource Accent}" BorderThickness="0,0,0,2"
            CornerRadius="7" Padding="13,11" Margin="0,18,0,0">
      <StackPanel>
        <TextBlock Text="Den stopper af sig selv" FontSize="12.5" FontWeight="SemiBold"
                   Foreground="{StaticResource Accent}" />
        <TextBlock FontSize="12" LineHeight="19" TextWrapping="Wrap" Margin="0,5,0,0"
                   Foreground="{StaticResource Tekst}"
                   Text="Kommer der ikke lyd i fem minutter, slutter optagelsen, og de fem minutters stilhed klippes af. Du behøver altså ikke blive siddende — sæt den i gang, og lav noget andet." />

        <!-- ==================== DE TO SLAGS MUTE ====================

             MÅLT 21-08-2026: en tone afspillet, niveauet målt ved 50 %, ved
             0 % og med mute på højttaleren. 0,36621 i alle tre tilfælde,
             identisk til femte decimal. Windows tager sin kopi FØR
             endepunktets lydstyrke.

             DEN MÅLING BLEV FØRST SKREVET FOR BREDT — «du kan roligt slå
             lyden fra». Det kostede to minutter af et rigtigt webinar samme
             dag: brugeren mutede AFSPILLEREN, og så afleverer programmet
             ingen lyd overhovedet. Der er intet at kopiere, båndet meldte
             stilhed, og optagelsen var på vej til at stoppe af sig selv.

             Kopien tages efter programmet og før højttaleren. Derfor gælder
             målingen kun det ene af de to steder, man kan slå lyden fra, og
             teksten skal sige hvilket. -->
        <TextBlock Text="Vil du selv slippe for at høre med" FontSize="12.5" FontWeight="SemiBold"
                   Margin="0,12,0,0" Foreground="{StaticResource Accent}" />
        <TextBlock FontSize="12" LineHeight="19" TextWrapping="Wrap" Margin="0,5,0,0"
                   Foreground="{StaticResource Tekst}"
                   Text="Brug Windows' lydstyrke nede ved uret — skru den til nul, eller tryk mute på højttaleren. Optagelsen tages, før lydstyrken sættes, så den bliver præcis den samme. Det er efterprøvet." />
        <TextBlock FontSize="12" LineHeight="19" TextWrapping="Wrap" Margin="0,7,0,0"
                   Foreground="{StaticResource Tekst}"
                   Text="Men slå IKKE lyden fra inde i webinaret selv — hverken på afspillerens egen knap eller på programmet i Lydmixeren. Så afspilles der ingen lyd, og så er der heller ingen at optage." />
      </StackPanel>
    </Border>

    <TextBlock x:Name="Bundtekst" FontSize="11.5" TextWrapping="Wrap" Margin="2,18,0,0"
               LineHeight="17" Foreground="{StaticResource TekstMeget}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="FortrydKnap" Content="Fortryd" Click="Fortryd_Klik"
              Padding="16,8" Margin="0,0,10,0" />
      <Button x:Name="StartKnap" Click="Start_Klik"
              Padding="20,8" Style="{StaticResource Primaer}" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
