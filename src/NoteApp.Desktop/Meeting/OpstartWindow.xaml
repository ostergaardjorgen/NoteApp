<Window x:Class="NoteApp.Desktop.Meeting.OpstartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:NoteApp.Desktop"
        Title="Optag"
        Width="720" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Baggrund}"
        WindowStyle="ToolWindow">

  <!-- ==================== FØR DER OPTAGES ====================

       ÉN dialog til både møde og webinar. To dialoger, der spørger om næsten
       det samme, holder op med at ligne hinanden, og så bliver det en
       tilfældighed, hvad man kan svare hvor.

       DEN FYLDER HALVT SÅ MEGET SOM FØRSTE UDGAVE, OG DET ER MED VILJE.

       Første udgave forklarede sig selv i tre kasser: hvorfor et webinar har
       sin egen knap, hvor mange megabyte i timen det fylder, og hvor længe det
       tager at skrive ud. Alt sammen rigtigt, og intet af det kan man handle
       på — man har allerede trykket på webinarknappen, når man læser det, og
       man vælger ikke sit webinar fra, fordi det fylder 110 MB.

       En dialog, der skal besvares FØR et webinar begynder på slaget, må ikke
       være noget, man skal læse. Den skal være noget, man udfylder. Derfor:
       fire felter ved siden af hinanden i stedet for under hinanden, og
       forklaringerne flyttet til værktøjstips, hvor de kan hentes af den, der
       vil have dem, uden at koste plads for alle andre.

       DET, DER BLEV STÅENDE, ER DET, MAN KAN HANDLE PÅ: at den stopper af sig
       selv, og hvordan man slår lyden fra uden at miste optagelsen. Det sidste
       kostede to minutter af et rigtigt webinar 21-08-2026.

       ALLE FELTER MÅ STÅ TOMME. Dialogen må aldrig blive det, der forsinker en
       optagelse — og genvejstasten går helt uden om den: dér starter
       optagelsen først, og dialogen kommer ovenpå. -->

  <StackPanel Margin="26,22,26,22">

    <TextBlock x:Name="Overskrift" FontSize="19" FontWeight="SemiBold" />
    <TextBlock x:Name="Underskrift" Style="{StaticResource Underskrift}"
               Margin="0,4,0,0" TextWrapping="Wrap" />

    <!-- ============ DE FIRE VALG, TO OG TO ============ -->
    <Grid Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="22" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="16" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Mappen -->
      <StackPanel x:Name="Mappefelt" Grid.Row="0" Grid.Column="0">
        <TextBlock Text="{i18n:Oversat faelles.mappe}" FontSize="10.5" FontWeight="SemiBold" Margin="2,0,0,6"
                   Foreground="{StaticResource TekstMeget}" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Mappen vises med en skabelon og ikke med DisplayMemberPath.
               DisplayMemberPath slog ikke igennem her, og rullelisten viste
               typen skrevet ud: «Punkt { Navn = Webinarer, Under = … }». -->
          <ComboBox x:Name="Mappevalg" Grid.Column="0" FontSize="13" Padding="10,7">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Navn}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <Button Grid.Column="1" Content="{i18n:Oversat opstartwindow.ny}" Click="NyMappe_Klik"
                  Margin="7,0,0,0" Padding="13,7" FontSize="12.5"
                  ToolTip="{i18n:Oversat opstartwindow.opret_en_ny_mappe_uden_at_forlade_dialogen}" />
        </Grid>
      </StackPanel>

      <!-- Mødetypen -->
      <StackPanel x:Name="Typefelt" Grid.Row="0" Grid.Column="2">
        <TextBlock Text="{i18n:Oversat faelles.moedetype}" FontSize="10.5" FontWeight="SemiBold" Margin="2,0,0,6"
                   Foreground="{StaticResource TekstMeget}" />
        <ComboBox x:Name="Typevalg" FontSize="13" Padding="10,7">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Navn}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <!-- Sproget -->
      <StackPanel Grid.Row="2" Grid.Column="0">
        <TextBlock x:Name="SprogMaerkat" FontSize="10.5" FontWeight="SemiBold" Margin="2,0,0,6"
                   Foreground="{StaticResource TekstMeget}" />
        <ComboBox x:Name="Sprogvalg" FontSize="13" Padding="10,7">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Navn}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <!-- Linket — kun ved webinar -->
      <StackPanel x:Name="Linkfelt" Grid.Row="2" Grid.Column="2" Visibility="Collapsed">
        <TextBlock Text="{i18n:Oversat opstartwindow.link_til_webinaret_kan_staa_tomt}" FontSize="10.5" FontWeight="SemiBold"
                   Margin="2,0,0,6" Foreground="{StaticResource TekstMeget}" />
        <TextBox x:Name="Link" FontSize="12.5" Padding="10,7" />
      </StackPanel>
    </Grid>

    <!-- ============ DET, MAN KAN HANDLE PÅ ============
         Kun ved webinar. To linjer, og begge er noget, brugeren gør noget
         forskelligt på baggrund af — modsat de tal, der stod her før. -->
    <Border x:Name="Stopperselv" Visibility="Collapsed"
            Background="#FF1D2530" BorderBrush="{StaticResource Accent}" BorderThickness="3,0,0,0"
            CornerRadius="4" Padding="13,10" Margin="0,18,0,0">
      <StackPanel>
        <TextBlock FontSize="12" LineHeight="18" TextWrapping="Wrap"
                   Foreground="{StaticResource Tekst}"
                   Text="{i18n:Oversat opstartwindow.optagelsen_stopper_af_sig_selv_efter_fem_m}" />

        <!-- MÅLT 21-08-2026: en tone afspillet, niveauet målt ved 50 %, ved
             0 % og med mute paa hoejttaleren — 0,36621 i alle tre tilfaelde,
             identisk til femte decimal. Windows tager sin kopi FOER
             endepunktets lydstyrke.

             Skrevet for bredt her foerste gang: «du kan roligt slaa lyden
             fra». Brugeren mutede AFSPILLEREN, og saa afleverer programmet
             ingen lyd overhovedet. To minutter af et rigtigt webinar gik tabt.
             Derfor staar begge halvdele nu i én saetning. -->
        <TextBlock FontSize="12" LineHeight="18" TextWrapping="Wrap" Margin="0,6,0,0"
                   Foreground="{StaticResource Tekst}"
                   Text="{i18n:Oversat opstartwindow.vil_du_slippe_for_at_hoere_med_saa_skru_ne}" />
      </StackPanel>
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="FortrydKnap" Content="{i18n:Oversat faelles.fortryd}" Click="Fortryd_Klik"
              Padding="16,8" Margin="0,0,10,0" />
      <Button x:Name="StartKnap" Click="Start_Klik"
              Padding="22,8" Style="{StaticResource Primaer}" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
