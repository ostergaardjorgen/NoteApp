<Window x:Class="NoteApp.Desktop.Lytteboble"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:NoteApp.Desktop"
        Title="HeyPia lytter"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False">

  <!-- ======================= LYTTEBOBLEN =======================

       Vågeordet bruges, mens man står i et ANDET program. Bjælken nederst i
       appens eget vindue kunne derfor ikke ses af den, der brugte den — man
       sagde «Hej Pia» og havde ingen måde at vide, om den hørte efter.

       Boblen er lille, ligger nederst i midten og over alt andet. Den dukker
       op, når der bliver lyttet, og forsvinder igen bagefter.

       DEN TAGER IKKE FOKUS. ShowActivated=False, og der klikkes ikke i den
       for at bruge den. Tog den fokus, ville markøren forlade det felt, man
       netop skal diktere ind i — og så ville teksten lande et andet sted.

       DEN STÅR IKKE I PROCESLINJEN. Optagebåndet gør, fordi det er det
       eneste, der er tilbage af appen under et møde. Boblen er kortvarig og
       ville kun larme dernede. -->

  <Border Background="{DynamicResource Panel}" CornerRadius="22" Padding="16,10"
          BorderBrush="{DynamicResource Accent}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" Color="#FF000000" />
    </Border.Effect>

    <StackPanel Orientation="Horizontal">

      <!-- Prikken puster, mens der lyttes. Et stillestående ikon siger ikke,
           om noget er i gang. -->
      <Ellipse x:Name="Prik" Width="11" Height="11" VerticalAlignment="Center"
               Margin="0,0,12,0" Fill="{DynamicResource Optager}" />

      <TextBlock x:Name="Besked" FontSize="13.5" VerticalAlignment="Center"
                 Foreground="{DynamicResource Tekst}" MaxWidth="420" TextTrimming="CharacterEllipsis" />

      <!-- ============ PAUSE OG START ============

           Herfra kan lytningen slaas fra uden at finde appen frem. Det er dét,
           man har brug for, naar man skal sige noget, appen ikke skal blande
           sig i - og at skulle aabne et program for at faa ro er for meget
           besvaer til, at nogen goer det.

           IKONET ER TEGNET OG IKKE SAT MED EN SKRIFTTYPE. Der stod to
           kodepunkter fra Segoe MDL2 (E769 og E768), og paa skaermen kom der
           to TOMME FIRKANTER. En glyf, der ikke findes, siger ingenting - og
           knappen er den eneste maade at faa ro paa.

           En tegnet figur kan ikke mangle. To bjaelker er en pause, og en
           trekant er afspil, uanset hvilke skrifttyper der er installeret.

           KRYDSET LUKKER BOKSEN - IKKE LYTNINGEN. Her stod foer en «skjul» med
           en glyf, der heller ikke fandtes. Forskellen er ikke kosmetisk:
           boblen ER tegnet paa, at mikrofonen staar aaben, og et signal, der
           kan slukkes, mens lytningen fortsaetter, er ingen signal.

           Derfor er den bundet op: krydset tager KUN boblen vaek. Den
           groenne bjaelke nederst i appen bliver staaende og lytter med, og
           derfra kan boblen hentes tilbage. Skal lytningen stoppe, er svaret
           pause - og saa stopper den ogsaa rigtigt. -->
      <Button x:Name="PauseKnap" Click="Pause_Klik" Margin="14,0,0,0"
              Width="30" Height="30" Padding="0" BorderThickness="0"
              Background="Transparent"
              ToolTip="{i18n:Oversat lytteboble.pause}"
              AutomationProperties.Name="{i18n:Oversat lytteboble.pause}">
        <Grid Width="14" Height="14">
          <!-- To bjaelker: pause. Vises, mens der lyttes. -->
          <StackPanel x:Name="Pausetegn" Orientation="Horizontal"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
            <Rectangle Width="4" Height="13" RadiusX="1.5" RadiusY="1.5"
                       Fill="{DynamicResource Tekst}" />
            <Rectangle Width="4" Height="13" RadiusX="1.5" RadiusY="1.5"
                       Margin="4,0,0,0" Fill="{DynamicResource Tekst}" />
          </StackPanel>

          <!-- Trekant: start igen. Vises, mens der er sat paa pause. -->
          <Path x:Name="Starttegn" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Data="M 0,0 L 12,6.5 L 0,13 Z" Fill="{DynamicResource Tekst}" />
        </Grid>
      </Button>

      <!-- Krydset er to streger og ikke en glyf. Samme grund som pausen. -->
      <Button x:Name="LukKnap" Click="Luk_Klik" Margin="2,0,0,0"
              Width="30" Height="30" Padding="0" BorderThickness="0"
              Background="Transparent"
              ToolTip="{i18n:Oversat lytteboble.luk}"
              AutomationProperties.Name="{i18n:Oversat lytteboble.luk}">
        <Grid Width="11" Height="11">
          <Path Data="M 0,0 L 11,11" Stroke="{DynamicResource TekstMeget}"
                StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          <Path Data="M 11,0 L 0,11" Stroke="{DynamicResource TekstMeget}"
                StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Grid>
      </Button>
    </StackPanel>
  </Border>
</Window>

