<Window x:Class="NoteApp.Desktop.Documents.NewDocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Opret dokument" Height="720" Width="680" MinHeight="520" MinWidth="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource Baggrund}">
  <!-- Vinduet kan ændres i størrelse. Med NoResize og en fast højde er der
       ingen vej ud, hvis indholdet ikke passer — og det gør det ikke ved en
       anden skriftstørrelse eller skalering end den, det blev prøvet på. -->

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="Opret dokument" FontSize="20" FontWeight="SemiBold" />
      <TextBlock x:Name="Kilde" Style="{StaticResource Underskrift}" Margin="0,4,0,0" TextWrapping="Wrap" />
    </StackPanel>

    <!-- Skabelonvalget fylder mest: det er dét, der afgør, hvad der kommer ud.
         Beskrivelsen af hver står under den, så valget ikke er et gæt.

         TRE TING VAR GALT, OG DE BLIVER VAERRE MED FLERE SKABELONER:

         1. Uden HorizontalScrollBarVisibility="Disabled" maaler ListBox sit
            indhold med UENDELIG bredde. TextWrapping slaar derfor aldrig
            igennem, beskrivelsen bliver klippet, og der kommer en vandret
            rullebjaelke i stedet. Samme fejl som ScrollViewer havde to andre
            steder i appen.
         2. WPF's egen markeringsfarve er naesten usynlig i det moerke tema.
            Man kunne ikke se, hvad der var valgt.
         3. Raekkerne stod klods op ad hinanden. Med tre skabeloner kan man
            taelle dem; med ti skal de ligne kort, man vaelger imellem. -->
    <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="10"
            BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Hvad skal der laves?" Margin="18,15,18,4"
                   FontSize="13" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" Margin="18,0,18,10" FontSize="11.5" TextWrapping="Wrap"
                   Foreground="{StaticResource TekstMeget}"
                   Text="Skabelonen bestemmer, hvilke afsnit dokumentet får, og hvor langt det bliver." />

        <ListBox x:Name="Skabeloner" Margin="10,0,10,10" BorderThickness="0"
                 Background="Transparent" SelectionChanged="Skabelon_Valgt"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 HorizontalContentAlignment="Stretch">

          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,0,0,6" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="kort" CornerRadius="8" Padding="14,11"
                            Background="#FF181B22" BorderThickness="1"
                            BorderBrush="{StaticResource PanelKant}">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="kort" Property="Background" Value="#FF2C323D" />
                      </Trigger>
                      <!-- Det VALGTE skal kunne ses paa afstand. Baade fladen
                           og kanten skifter, saa det ogsaa virker for den,
                           der ikke skelner farverne skarpt. -->
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="kort" Property="Background" Value="#FF33405A" />
                        <Setter TargetName="kort" Property="BorderBrush" Value="{StaticResource Accent}" />
                        <Setter TargetName="kort" Property="BorderThickness" Value="2" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>

          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding Description}" FontSize="12.5" TextWrapping="Wrap"
                           LineHeight="19" Foreground="{StaticResource TekstSvag}"
                           Margin="0,4,0,0" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <StackPanel Grid.Row="2" Margin="0,14,0,0">
      <TextBlock Text="Titel på dokumentet" Style="{StaticResource Underskrift}" />
      <TextBox x:Name="FeltTitel" Margin="0,4,0,0" FontSize="14" Padding="9,7" />

      <TextBlock Text="Beskrivelse (valgfri — står øverst i dokumentet)"
                 Style="{StaticResource Underskrift}" Margin="0,12,0,0" />
      <TextBox x:Name="FeltBeskrivelse" Margin="0,4,0,0" FontSize="13" Padding="9,7"
               AcceptsReturn="True" TextWrapping="Wrap" Height="46"
               VerticalScrollBarVisibility="Auto" />

      <TextBlock x:Name="ModelTekst" FontSize="12" Margin="2,12,0,0" TextWrapping="Wrap"
                 LineHeight="19" Foreground="{StaticResource TekstMeget}" />

    </StackPanel>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Annullér" Click="Annuller_Click" Padding="18,9" Margin="0,0,10,0" />
      <Button x:Name="OpretKnap" Content="Opret dokument" Click="Opret_Click" Padding="20,9"
              Background="{StaticResource Accent}" Foreground="#FF0B1220" BorderThickness="0"
              FontWeight="SemiBold" IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>
