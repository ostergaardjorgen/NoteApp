<Window x:Class="NoteApp.Desktop.Documents.NewDocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:NoteApp.Desktop"
        Title="Opret dokument" Height="780" Width="1060" MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource Baggrund}">
  <!-- Vinduet kan ændres i størrelse. Med NoResize og en fast højde er der
       ingen vej ud, hvis indholdet ikke passer — og det gør det ikke ved en
       anden skriftstørrelse eller skalering end den, det blev prøvet på.

       ============ TO SPALTER, IKKE ÉN ============

       Alt stod før i én søjle: overskrift, mødetyper, titel, beskrivelse,
       sprog, knapper. Mødetyperne fik det, der var tilovers — og det var
       plads til TO. Med fem mødetyper kunne man ikke se, hvad man valgte
       imellem, uden at rulle i en kasse på tre centimeter.

       Valget af mødetype er det, der afgør, hvad der kommer ud af det hele.
       Det skal fylde mest og ses på én gang. Felterne til højre er dem, man
       udfylder BAGEFTER, og de fylder kun det, de skal.

       Vinduet er derfor bredt frem for højt: bredden er billig på en skærm,
       højden er ikke. -->

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid.ColumnDefinitions>
      <!-- Moedetyperne faar det meste. Hoejre spalte er saa bred, som
           felterne har brug for, og ikke bredere. -->
      <ColumnDefinition Width="*" MinWidth="380" />
      <ColumnDefinition Width="22" />
      <ColumnDefinition Width="360" />
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,16">
      <!-- SPØRGSMÅLET STILLES RENT, OG DET SIGER HVAD DET KOSTER.
           «Opret dokument» sagde hverken, hvad man fik, eller at det bliver
           lavet ude i verden. Begge dele hoerer i overskriften: det er dét,
           der skiller den her knap fra den korte lokale opsummering, og det
           er dét, brugeren skal kunne traeffe sit valg paa. -->
      <TextBlock Text="{i18n:Oversat newdocumentwindow.vil_du_have_et_komplet_word_dokument}" FontSize="20" FontWeight="SemiBold"
                 TextWrapping="Wrap" />
      <TextBlock x:Name="Kilde" Style="{StaticResource Underskrift}" Margin="0,4,0,0" TextWrapping="Wrap" />
    </StackPanel>

    <!-- Skabelonvalget fylder mest: det er dét, der afgør, hvad der kommer ud.
         Beskrivelsen af hver står under den, så valget ikke er et gæt.

         TRE TING VAR GALT, OG DE BLIVER VAERRE MED FLERE SKABELONER:

         1. Uden HorizontalScrollBarVisibility="Disabled" maaler ListBox sit
            indhold med UENDELIG bredde. TextWrapping slaar derfor aldrig
            igennem, beskrivelsen bliver klippet, og der kommer en vandret
            rullebjaelke i stedet. Samme fejl som ScrollViewer havde to andre
            steder i appen.
         2. WPF's egen markeringsfarve er naesten usynlig i det moerke tema.
            Man kunne ikke se, hvad der var valgt.
         3. Raekkerne stod klods op ad hinanden. Med tre skabeloner kan man
            taelle dem; med ti skal de ligne kort, man vaelger imellem. -->
    <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="10"
            BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{i18n:Oversat newdocumentwindow.hvilken_moedetype}" Margin="18,15,18,4"
                   FontSize="13" FontWeight="SemiBold" />
        <TextBlock x:Name="Typehjaelp" DockPanel.Dock="Top" Margin="18,0,18,10" FontSize="11.5"
                   TextWrapping="Wrap" Foreground="{StaticResource TekstMeget}"
                   Text="{i18n:Oversat newdocumentwindow.moedetypen_bestemmer_hvilke_afsnit_dokumen}" />

        <ListBox x:Name="Skabeloner" Margin="10,0,10,10" BorderThickness="0"
                 Background="Transparent" SelectionChanged="Skabelon_Valgt"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 HorizontalContentAlignment="Stretch">

          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,0,0,6" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="kort" CornerRadius="8" Padding="14,11"
                            Background="{StaticResource Trykket}" BorderThickness="1"
                            BorderBrush="{StaticResource PanelKant}">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="kort" Property="Background" Value="{StaticResource Svaev}" />
                      </Trigger>
                      <!-- Det VALGTE skal kunne ses paa afstand. Baade fladen
                           og kanten skifter, saa det ogsaa virker for den,
                           der ikke skelner farverne skarpt. -->
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="kort" Property="Background" Value="{StaticResource Valgt}" />
                        <Setter TargetName="kort" Property="BorderBrush" Value="{StaticResource Accent}" />
                        <Setter TargetName="kort" Property="BorderThickness" Value="2" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>

          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding Description}" FontSize="12.5" TextWrapping="Wrap"
                           LineHeight="19" Foreground="{StaticResource TekstSvag}"
                           Margin="0,4,0,0" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Hoejre spalte: det, man udfylder, EFTER at typen er valgt. Den ruller
         for sig selv, saa et lille vindue ikke klemmer moedetyperne. -->
    <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="{i18n:Oversat newdocumentwindow.titel_paa_dokumentet}" Style="{StaticResource Underskrift}" />
        <TextBox x:Name="FeltTitel" Margin="0,4,0,0" FontSize="14" Padding="9,7"
                 TextWrapping="Wrap" AcceptsReturn="False" />

        <TextBlock Text="{i18n:Oversat newdocumentwindow.beskrivelse_valgfri_staar_oeverst_i_dokume}"
                   Style="{StaticResource Underskrift}" Margin="0,14,0,0" TextWrapping="Wrap" />
        <TextBox x:Name="FeltBeskrivelse" Margin="0,4,0,0" FontSize="13" Padding="9,7"
                 AcceptsReturn="True" TextWrapping="Wrap" Height="88"
                 VerticalScrollBarVisibility="Auto" />

        <!-- ============ SPROGET VÆLGES PR. DOKUMENT ============
             Det lå før fast i hver mødetype: alt blev dansk, uanset hvad mødet
             var på. Behovet er ikke det samme hver gang — et referat til en
             selv er dansk, et resumé af et engelsk webinar, der skal videre,
             er det ikke nødvendigvis. -->
        <TextBlock Text="{i18n:Oversat newdocumentwindow.dokumentets_sprog}" Style="{StaticResource Underskrift}" Margin="0,16,0,0" />

        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <RadioButton x:Name="SprogDansk" GroupName="doksprog" Content="{i18n:Oversat faelles.dansk}"
                       IsChecked="True" FontSize="13" Margin="0,0,20,0"
                       VerticalContentAlignment="Center" />
          <RadioButton x:Name="SprogEngelsk" GroupName="doksprog" Content="{i18n:Oversat newdocumentwindow.engelsk}"
                       FontSize="13" VerticalContentAlignment="Center" />
        </StackPanel>

        <TextBlock x:Name="Sproghjaelp" FontSize="11.5" Margin="2,6,0,0" TextWrapping="Wrap"
                   LineHeight="17" Foreground="{StaticResource TekstMeget}" />

        <TextBlock x:Name="ModelTekst" FontSize="12" Margin="2,16,0,0" TextWrapping="Wrap"
                   LineHeight="19" Foreground="{StaticResource TekstMeget}" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="{i18n:Oversat faelles.annuller}" Click="Annuller_Click" Padding="18,9" Margin="0,0,10,0" />
      <Button x:Name="OpretKnap" Content="{i18n:Oversat faelles.opret_dokument}" Click="Opret_Click" Padding="20,9"
              Background="{StaticResource Accent}" Foreground="{StaticResource PaaAccent}" BorderThickness="0"
              FontWeight="SemiBold" IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>
