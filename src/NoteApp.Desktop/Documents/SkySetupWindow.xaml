<Window x:Class="NoteApp.Desktop.Documents.SkySetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:NoteApp.Desktop"
        Title="Tilslut europæisk bearbejdning" Height="700" Width="660"
        MinHeight="560" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Baggrund}" Foreground="{StaticResource Tekst}">

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="{i18n:Oversat skysetupwindow.tilslut_europaeisk_bearbejdning}" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"
                 Foreground="{StaticResource TekstSvag}"
                 Text="{i18n:Oversat skysetupwindow.optagelse_og_transskription_bliver_paa_din}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <!-- 1: det appen selv sikrer -->
        <Border Padding="14,12" CornerRadius="6" Margin="0,0,0,12"
                Background="{StaticResource Panel}"
                BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="{i18n:Oversat skysetupwindow.det_soerger_appen_for}" FontWeight="SemiBold" FontSize="14" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="20"
                       x:Name="EndepunktTekst" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="20"
                       Foreground="{StaticResource TekstMeget}" FontSize="12"
                       Text="{i18n:Oversat skysetupwindow.mistral_har_ogsaa_et_globalt_endepunkt_hvo}" />
          </StackPanel>
        </Border>

        <!-- 2: det brugeren selv skal sikre -->
        <Border Padding="14,12" CornerRadius="6" Margin="0,0,0,12"
                Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Advarsel}" BorderThickness="2">
          <StackPanel>
            <TextBlock Text="{i18n:Oversat skysetupwindow.det_skal_du_selv_soerge_for}" FontWeight="SemiBold" FontSize="14"
                       Foreground="{StaticResource Advarsel}" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="20"
                       Text="{i18n:Oversat skysetupwindow.mistrals_aftale_tillader_at_dine_data_brug}" />
            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="20" FontSize="13"
                       Foreground="{StaticResource TekstSvag}"
                       Text="{i18n:Oversat skysetupwindow.saadan_log_ind_paa_console_mistral_ai_work}" />
            <Button Content="{i18n:Oversat faelles.aabn_console_mistral_ai}" Click="AabnKonsol_Click"
                    HorizontalAlignment="Left" Margin="0,10,0,0" Padding="14,7" />
          </StackPanel>
        </Border>

        <!-- 3: det appen ikke kan love -->
        <Expander Header="{i18n:Oversat skysetupwindow.hvem_roerer_data_undervejs}" Margin="0,0,0,12" Foreground="{StaticResource Tekst}">
          <TextBlock Margin="8,8,0,0" TextWrapping="Wrap" LineHeight="20" FontSize="12"
                     Foreground="{StaticResource TekstMeget}"
                     Text="{i18n:Oversat skysetupwindow.mistral_er_fransk_og_hoster_i_europa_men_b}" />
        </Expander>

        <!-- 4: noeglen -->
        <TextBlock Text="{i18n:Oversat skysetupwindow.din_api_noegle_fra_mistral}" Style="{StaticResource Underskrift}" Margin="0,6,0,0" />
        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" FontSize="12"
                   Foreground="{StaticResource TekstMeget}"
                   Text="{i18n:Oversat skysetupwindow.hentes_paa_console_mistral_ai_under_api_ke}" />
        <PasswordBox x:Name="FeltNoegle" Margin="0,6,0,0" FontSize="14" Padding="9,7" />

        <CheckBox x:Name="HakTraening" Margin="0,16,0,0">
          <TextBlock TextWrapping="Wrap" LineHeight="19"
                     Text="{i18n:Oversat skysetupwindow.jeg_har_slaaet_fra_paa_min_mistral_konto_a}" />
        </CheckBox>

        <TextBlock x:Name="Fejl" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource FejlTekst}" Visibility="Collapsed" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="FjernKnap" Content="{i18n:Oversat skysetupwindow.fjern_noeglen}" Click="Fjern_Click"
              Padding="14,9" Margin="0,0,10,0" Visibility="Collapsed" />
      <Button Content="{i18n:Oversat faelles.annuller}" Click="Annuller_Click" Padding="18,9" Margin="0,0,10,0" />
      <Button Content="{i18n:Oversat skysetupwindow.gem_og_afproev}" Click="Gem_Click" Padding="20,9"
              Background="{StaticResource Accent}" Foreground="{StaticResource PaaAccent}" BorderThickness="0"
              FontWeight="SemiBold" IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>
