<UserControl x:Class="NoteApp.Desktop.Documents.DocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Baggrund}">

  <!-- Samme opbygning som «Optagelser»: vaerktoejslinje med ikoner oeverst,
       bibliotekstrae til venstre, indhold til hoejre. Se TranscribeView.xaml
       for begrundelserne - de gaelder ordret her.

       Der er eet bibliotek, ikke to. Dokumenter har ikke et arkiv: et
       dokument er faerdigt i det oejeblik, det er lavet. -->

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="Dokumenter" Style="{StaticResource Overskrift}" />
      <TextBlock Style="{StaticResource Underskrift}"
                 Text="De færdige tekster. Gemt som Word-dokumenter (.docx)." />
    </StackPanel>

    <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="8"
            BorderBrush="{StaticResource PanelKant}" BorderThickness="1" Padding="8,6">
      <DockPanel>
        <Button DockPanel.Dock="Right" x:Name="AabnKnap" Click="Aabn_Click" IsEnabled="False"
                Style="{StaticResource Primaer}" MinWidth="150" Content="Åbn dokumentet"
                ToolTip="Åbn dokumentet i Word" />

        <Button DockPanel.Dock="Right" x:Name="GemKnap" Content="Gem beskrivelse" Click="Gem_Click"
                IsEnabled="False" Margin="0,0,10,0" Padding="14,7"
                ToolTip="Gem den beskrivelse, du har skrevet. Den står øverst i selve dokumentet" />

        <Border DockPanel.Dock="Right" Width="1" Margin="10,4,14,4"
                Background="{StaticResource PanelKant}" />

        <Button DockPanel.Dock="Left" x:Name="NyMappeKnap" Style="{StaticResource IkonKnap}"
                Click="NyMappe_Click" AutomationProperties.Name="Ny mappe"
                ToolTip="Ny mappe — til fx en kunde eller et projekt">
          <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets" />
        </Button>

        <Border DockPanel.Dock="Left" Width="1" Margin="6,4,8,4"
                Background="{StaticResource PanelKant}" />

        <Button DockPanel.Dock="Left" x:Name="FlytKnap" Style="{StaticResource IkonKnap}"
                Click="Flyt_Click" IsEnabled="False" AutomationProperties.Name="Flyt til mappe"
                ToolTip="Flyt til mappe — eller træk dokumentet hen på en mappe i træet">
          <TextBlock Text="&#xE8DE;" FontFamily="Segoe MDL2 Assets" />
        </Button>

        <Button DockPanel.Dock="Left" x:Name="OmdoebKnap" Style="{StaticResource IkonKnap}"
                Click="Omdoeb_Click" IsEnabled="False" AutomationProperties.Name="Omdøb"
                ToolTip="Omdøb dokumentet">
          <TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" />
        </Button>

        <Button DockPanel.Dock="Left" x:Name="MappeKnap" Style="{StaticResource IkonKnap}"
                Click="Mappe_Click" AutomationProperties.Name="Åbn mappen"
                ToolTip="Åbn dokumentmappen på disken">
          <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" />
        </Button>

        <Border DockPanel.Dock="Left" Width="1" Margin="6,4,8,4"
                Background="{StaticResource PanelKant}" />

        <Button DockPanel.Dock="Left" x:Name="SletKnap" Style="{StaticResource IkonKnapFare}"
                Click="Slet_Click" IsEnabled="False" AutomationProperties.Name="Slet dokument"
                ToolTip="Slet dokumentet. Kan ikke fortrydes">
          <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" />
        </Button>

        <Grid />
      </DockPanel>
    </Border>

    <Grid Grid.Row="2" Margin="2,8,2,10">
      <TextBlock x:Name="Status" Style="{StaticResource Underskrift}" VerticalAlignment="Bottom" />
    </Grid>

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <!-- Samme bredde som paa Optagelser og Moedetyper. Se TranscribeView. -->
        <ColumnDefinition Width="225" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="10"
              BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="BIBLIOTEKER" FontSize="10.5" FontWeight="SemiBold"
                     Margin="16,14,16,8" Foreground="{StaticResource TekstMeget}" />

          <TextBlock DockPanel.Dock="Bottom" Margin="16,8,16,12" FontSize="11" TextWrapping="Wrap"
                     LineHeight="17" Foreground="{StaticResource TekstMeget}"
                     Text="Træk et dokument hen på en mappe for at flytte det." />

          <TreeView x:Name="Trae" Background="Transparent" BorderThickness="0"
                    Margin="6,0,6,0" SelectedItemChanged="Trae_Valgt"
                    AllowDrop="True" DragOver="Trae_TraekOver" DragLeave="Trae_TraekForlod"
                    Drop="Trae_Slip"
                    PreviewMouseLeftButtonDown="Trae_MusNed"
                    PreviewMouseMove="Trae_MusBevaeget"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <TreeView.ItemContainerStyle>
              <Style TargetType="TreeViewItem">
                <Style.Resources>
                  <!-- WPF tegner sin EGEN markering under vores skabelon, med
                       systemets fremhaevningsfarve og hvid tekst. Paa et
                       moerkt tema bliver navnet dermed usynligt, naar man
                       vaelger det. De tre noegler slukker den, saa det er
                       DataTriggeren paa ErValgt nedenfor, der tegner
                       markeringen - i temaets egne farver. -->
                  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFF4F6FA" />
                </Style.Resources>
                <Setter Property="Padding" Value="2,1" />
                <Setter Property="AllowDrop" Value="True" />
                <Setter Property="Foreground" Value="{StaticResource TekstSvag}" />
                <Setter Property="IsExpanded" Value="{Binding ErUdfoldet, Mode=TwoWay}" />
                <Setter Property="IsSelected" Value="{Binding ErValgt, Mode=TwoWay}" />
              </Style>
            </TreeView.ItemContainerStyle>

            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate ItemsSource="{Binding Boern}">
                <Border x:Name="rk" CornerRadius="5" Padding="6,4" Background="Transparent"
                        AutomationProperties.Name="{Binding Visning}"
                        BorderThickness="1" BorderBrush="Transparent">
                  <Border.ToolTip>
                    <StackPanel MaxWidth="360">
                      <TextBlock Text="{Binding Navn}" FontWeight="SemiBold" FontSize="13"
                                 TextWrapping="Wrap" Margin="0,0,0,6" />
                      <TextBlock Text="{Binding Linje1}" FontSize="12.5" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Linje2}" FontSize="12.5" Margin="0,3,0,0"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Border.ToolTip>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Glyf}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,9,0"
                               Foreground="{StaticResource Accent}" />
                    <TextBlock Text="{Binding Visning}" FontSize="12.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Border>
                <HierarchicalDataTemplate.Triggers>
                  <DataTrigger Binding="{Binding ErValgt}" Value="True">
                    <Setter TargetName="rk" Property="Background" Value="#FF33405A" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding ErBeholder}" Value="True">
                    <Setter TargetName="rk" Property="ToolTipService.IsEnabled" Value="False" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding ErDropmaal}" Value="True">
                    <Setter TargetName="rk" Property="Background" Value="#FF33405A" />
                    <Setter TargetName="rk" Property="BorderBrush" Value="{StaticResource Accent}" />
                  </DataTrigger>
                </HierarchicalDataTemplate.Triggers>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch"
                    Background="Transparent" />

      <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="10"
              BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- FREMDRIFTEN SAMME STED SOM PAA OPTAGELSER.
               Et dokument saettes i gang fra en anden skaerm, og koerslen
               lander her. Uden en bjaelke var der ingenting at se, naar man
               kom herover - og saa tror man, det gik i staa. -->
          <Border x:Name="Fremdriftsrude" Grid.Row="1" Visibility="Collapsed"
                  Background="#FF1A2230" BorderBrush="{StaticResource Accent}"
                  BorderThickness="0,1,0,0" CornerRadius="0,0,10,10" Padding="20,12">
            <StackPanel>
              <Grid>
                <TextBlock x:Name="JobTekst" FontSize="12.5" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" Margin="0,0,60,0" />
                <TextBlock x:Name="JobTal" FontSize="12.5" HorizontalAlignment="Right"
                           Foreground="{StaticResource Accent}" FontFamily="Consolas" />
              </Grid>
              <TextBlock x:Name="JobDetaljer" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"
                         Foreground="{StaticResource TekstMeget}" />
              <ProgressBar x:Name="Fremdrift" Height="5" Minimum="0" Maximum="100" Margin="0,9,0,0"
                           Background="#FF2C323D" Foreground="{StaticResource Accent}"
                           BorderThickness="0" />
            </StackPanel>
          </Border>

          <StackPanel Grid.Row="0" x:Name="TomPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                      MaxWidth="440">
            <TextBlock Text="Der er ingen dokumenter endnu" FontSize="17" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="21"
                       TextAlignment="Center" Foreground="{StaticResource TekstSvag}"
                       Text="Gå til «Optagelser», vælg en optagelse der er skrevet ud til tekst, og tryk «Opret dokument». Så bekræfter du mødetypen — referat, opgaveliste eller hvad du selv har lavet." />
          </StackPanel>

          <!-- ================== FORKLARINGEN ==========================
               SAMME OPBYGNING SOM PAA OPTAGELSER, OG DET ER MED VILJE.

               Ruden stod helt tom, saa snart der fandtes ét dokument, men
               ingen var valgt: TomPanel gaelder kun, naar der slet ikke er
               nogen. Det er ogsaa dér, man staar foerste gang - man har lige
               lavet ét dokument, gaar herover, og skaermen siger ingenting.

               Trinnene er ikke pynt. De to ting, folk faktisk spoerger om -
               hvorfor dokumentet ser ud, som det goer, og hvad der forlader
               maskinen - staar som trin 1 og 2. -->
          <ScrollViewer x:Name="Forklaring" Grid.Row="0" Padding="26,20,26,18"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Stretch">

              <TextBlock FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"
                         Text="Fra tekst til dokument" />
              <TextBlock FontSize="13.5" LineHeight="22" Margin="0,10,0,0"
                         TextWrapping="Wrap" Foreground="{StaticResource TekstSvag}"
                         Text="Vælg et dokument i træet til venstre for at se det. Nye dokumenter laves under «Optagelser» — vælg en optagelse, der er skrevet ud til tekst, og tryk «Opret dokument»." />

              <StackPanel Margin="0,22,0,0">
                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="1" FontSize="15" FontWeight="SemiBold"
                             Foreground="{StaticResource Accent}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Mødetypen bestemmer indholdet" FontSize="13.5" FontWeight="SemiBold" />
                    <TextBlock FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,3,0,0"
                               Foreground="{StaticResource TekstMeget}"
                               Text="Mødetypen afgør, hvilke afsnit dokumentet får, hvor langt det bliver, og hvad der ikke må stå i det. Er den valgt, da optagelsen blev startet, er den valgt på forhånd. Mødetyperne kan rettes under «Mødetyper»." />
                  </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="2" FontSize="15" FontWeight="SemiBold"
                             Foreground="{StaticResource Accent}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Teksten sendes til sprogmodellen" FontSize="13.5" FontWeight="SemiBold" />
                    <TextBlock FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,3,0,0"
                               Foreground="{StaticResource TekstMeget}"
                               Text="Til forskel fra udskriften sker det her ikke på maskinen. Udskriften sendes til Mistrals europæiske endepunkt. Lyden bliver liggende. Hvad det betyder, står under «Compliance»." />
                  </StackPanel>
                </Grid>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="3" FontSize="15" FontWeight="SemiBold"
                             Foreground="{StaticResource Accent}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Dokumentet står her" FontSize="13.5" FontWeight="SemiBold" />
                    <TextBlock FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,3,0,0"
                               Foreground="{StaticResource TekstMeget}"
                               Text="Det gemmes som et Word-dokument (.docx). Vælg det i træet, så kan du åbne det, omdøbe det eller flytte det ned i en mappe." />
                  </StackPanel>
                </Grid>
              </StackPanel>

              <Border Background="#334CBE72" BorderBrush="{StaticResource Godkendt}" BorderThickness="1"
                      CornerRadius="10" Padding="16,13" Margin="0,22,0,0">
                <StackPanel>
                  <TextBlock Text="Du kan lave dokumentet om" FontSize="13"
                             FontWeight="SemiBold" Foreground="{StaticResource Tekst}" />
                  <TextBlock FontSize="12.5" LineHeight="20" Margin="0,6,0,0" TextWrapping="Wrap"
                             Foreground="{StaticResource Tekst}"
                             Text="Udskriften bliver liggende ved optagelsen, og den kan bruges igen. Blev referatet ikke, som du ville have det, laver du et nyt fra den samme udskrift med en anden mødetype — så mange gange du vil. Det gamle dokument bliver stående, indtil du selv sletter det." />
                </StackPanel>
              </Border>

              <TextBlock FontSize="12.5" LineHeight="20" Margin="2,18,0,0" TextWrapping="Wrap"
                         Foreground="{StaticResource TekstMeget}"
                         Text="Læs dokumentet igennem, før du sender det videre. Modellen kan tage fejl af, hvem der sagde hvad — især hvis navnene aldrig blev sagt højt på mødet — og den har tidligere føjet en deltager til, som ikke var med." />
            </StackPanel>
          </ScrollViewer>

          <!-- Se TranscribeView: uden Disabled maales indholdet med uendelig
               bredde, og teksten ombrydes ikke. -->
          <ScrollViewer x:Name="Detaljer" Grid.Row="0" Padding="24,20" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="Titel" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />

              <!-- Proveniensen. Et referat, ingen kan finde tilbage fra, er en
                   tekst, ingen tør bruge til noget. -->
              <Border Background="#FF181B22" BorderBrush="{StaticResource PanelKant}" BorderThickness="1"
                      CornerRadius="8" Padding="16,13" Margin="0,14,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Lavet" Margin="0,0,24,0"
                             FontSize="12.5" Foreground="{StaticResource TekstMeget}" />
                  <TextBlock Grid.Row="0" Grid.Column="1" x:Name="Lavet" FontSize="12.5" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Fra optagelse" Margin="0,7,24,0"
                             FontSize="12.5" Foreground="{StaticResource TekstMeget}" />
                  <TextBlock Grid.Row="1" Grid.Column="1" x:Name="FraOptagelse" FontSize="12.5"
                             Margin="0,7,0,0" TextWrapping="Wrap" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Mødetype" Margin="0,7,24,0"
                             FontSize="12.5" Foreground="{StaticResource TekstMeget}" />
                  <TextBlock Grid.Row="2" Grid.Column="1" x:Name="Skabelon" FontSize="12.5" Margin="0,7,0,0" />

                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Sprogmodel" Margin="0,7,24,0"
                             FontSize="12.5" Foreground="{StaticResource TekstMeget}" />
                  <TextBlock Grid.Row="3" Grid.Column="1" x:Name="Model" FontSize="12.5" Margin="0,7,0,0" />

                  <TextBlock Grid.Row="4" Grid.Column="0" Text="Fil" Margin="0,7,24,0"
                             FontSize="12.5" Foreground="{StaticResource TekstMeget}" />
                  <TextBlock Grid.Row="4" Grid.Column="1" x:Name="Filnavn" FontSize="12.5" Margin="0,7,0,0"
                             TextWrapping="Wrap" Foreground="{StaticResource TekstMeget}" />

                  <TextBlock Grid.Row="5" Grid.Column="0" Text="Mappe" Margin="0,7,24,0"
                             FontSize="12.5" Foreground="{StaticResource TekstMeget}" />
                  <TextBlock Grid.Row="5" Grid.Column="1" x:Name="MappeNavn" FontSize="12.5"
                             Margin="0,7,0,0" TextWrapping="Wrap" />
                </Grid>
              </Border>

              <TextBlock Text="Din beskrivelse" Style="{StaticResource Underskrift}" Margin="0,18,0,0" />
              <TextBox x:Name="FeltBeskrivelse" Margin="0,5,0,0" FontSize="13" Padding="9,7"
                       AcceptsReturn="True" TextWrapping="Wrap" Height="70"
                       VerticalScrollBarVisibility="Auto" TextChanged="Beskrivelse_Aendret" />
              <TextBlock FontSize="11.5" Margin="2,5,0,0" TextWrapping="Wrap"
                         Foreground="{StaticResource TekstMeget}"
                         Text="Beskrivelsen står øverst i selve dokumentet, ikke kun her — så den følger med, når du sender det videre." />

              <TextBlock Text="Indhold" Style="{StaticResource Underskrift}" Margin="0,18,0,0" />
              <Border Background="#FF181B22" BorderBrush="{StaticResource PanelKant}" BorderThickness="1"
                      CornerRadius="8" Padding="16,13" Margin="0,5,0,0">
                <!-- TextBox og ikke TextBlock. To grunde:
                     - Soegningen skal kunne springe hen til et bestemt sted,
                       og det kraever, at tegnene kan slaas op paa position.
                     - Man kan markere og kopiere et afsnit uden at aabne
                       dokumentet i Word. -->
                <TextBox x:Name="Indhold" FontSize="12.5" TextWrapping="Wrap"
                         IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         Padding="0" Foreground="{StaticResource TekstSvag}"
                         IsInactiveSelectionHighlightEnabled="True"
                         VerticalScrollBarVisibility="Disabled"
                         HorizontalScrollBarVisibility="Disabled" />
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
