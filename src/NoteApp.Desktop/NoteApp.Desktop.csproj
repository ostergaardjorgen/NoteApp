<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NoteApp.Desktop</RootNamespace>
    <!-- Filen hedder HeyPia.exe. Navnerummene hedder stadig HeyPia.* -
         det er kodens egne navne, og de koster kun stoej at skifte.
         Datamappen hedder ogsaa stadig C:\AppNoter: den rummer
         optagelser og indstillinger, og et navneskift maa aldrig
         koste data. -->
    <AssemblyName>HeyPia</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- Versionen følger repoets vX.YY. Den vises i sidebjælken, så en
         skærmbillede fra en fejlmelding siger hvilken build det var. -->
    <Version>1.2.22</Version>

    <!-- Ikonet i exe-filen: proceslinje, Stifinder og Alt-Tab. Uden det får
         appen Windows' generiske programikon. Genskabes fra AppIkon.jpg med
         scripts\lav-ikon.ps1. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\agenda.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Samme billede som ressource, så vinduerne og sidebjælken kan vise
         det. app.ico bærer alle størrelser; app.png bruges, hvor der skal
         skaleres frit. -->
    <Resource Include="app.ico" />
    <Resource Include="app.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NoteApp.Core\NoteApp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Oplæsningsteksten indlejres, så appen virker på en maskine uden
         repo-mappen. Findes repo-kopien, vinder den ved kørsel: så slår
         dine rettelser i teksten igennem uden at bygge appen om. -->
    <EmbeddedResource Include="..\..\fase0\oplaesning\testtekst.md"
                      LogicalName="NoteApp.Desktop.testtekst.md" />
    <EmbeddedResource Include="..\..\fase0\oplaesning\testtekst-blandet.md"
                      LogicalName="NoteApp.Desktop.testtekst-blandet.md" />
    <EmbeddedResource Include="..\..\fase0\oplaesning\testtekst-engelsk.md"
                      LogicalName="NoteApp.Desktop.testtekst-engelsk.md" />
  </ItemGroup>

</Project>
