<UserControl x:Class="NoteApp.Desktop.Dictionary.DictionaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Baggrund}">

  <Grid Margin="24,20,24,20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="360" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ============================ Overskrift ========================== -->
    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,14">
      <TextBlock Text="Din ordbog" Style="{StaticResource Overskrift}" />
      <TextBlock Style="{StaticResource Underskrift}"
                 Text="Dine navne og fagord. De retter teksten bagefter og staver rigtigt i dine dokumenter." />

      <!-- Teksten her stod tidligere som «ordene sendes til Whisper, så den
           ved hvad den skal lytte efter». Det var forkert, og det var målt
           forkert: samme lyd med og uden ordlisten gav byte-identisk resultat.
           En forklaring, der lover noget, der ikke sker, er værre end ingen. -->
      <Border Background="#FF181B22" BorderBrush="{StaticResource PanelKant}" BorderThickness="1"
              CornerRadius="10" Padding="20,16" Margin="0,12,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Margin="0,0,18,0">
            <TextBlock Text="HVAD ORDBOGEN GØR" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource Godkendt}" />
            <TextBlock FontSize="12.5" LineHeight="20" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TekstSvag}"
                       Text="Retter kendte hørefejl i udskriften, efter den er lavet. Har du én gang rettet «søv» til «syv», sker det af sig selv hver gang derefter." />
            <TextBlock FontSize="12.5" LineHeight="20" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TekstSvag}"
                       Text="Følger med til sprogmodellen, når der laves et dokument, så navne og fagord staves rigtigt i referatet." />
          </StackPanel>

          <StackPanel Grid.Column="1" Margin="18,0,0,0">
            <TextBlock Text="HVAD DEN IKKE GØR" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource Advarsel}" />
            <TextBlock FontSize="12.5" LineHeight="20" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TekstSvag}"
                       Text="Den gør ikke Whisper bedre til at høre efter. Det blev prøvet: samme optagelse med og uden ordbogen gav nøjagtig samme tekst — og ved én indstilling fik den Whisper til at gentage sig selv i en time." />
            <TextBlock x:Name="HvorforIkke" FontSize="12.5" LineHeight="20" Margin="0,8,0,0"
                       TextWrapping="Wrap" Foreground="{StaticResource TekstMeget}"
                       Cursor="Help"
                       Text="Whisper kan ikke læres noget — hold musen her for at se hvorfor.">
              <TextBlock.ToolTip>
                <TextBlock MaxWidth="460" TextWrapping="Wrap" LineHeight="21">Whisper er en færdigtrænet model. Den kan i princippet efteruddannes, men ikke her, og af fire grunde:<LineBreak /><LineBreak />
                  <Run FontWeight="SemiBold">1. Det kræver materiale.</Run> Timer af din tale med en kontrolleret udskrift til hver. Du har halvanden time i alt; der skal typisk titalls timer til.<LineBreak /><LineBreak />
                  <Run FontWeight="SemiBold">2. Det kræver et større grafikkort.</Run> Modellen har 1,5 milliarder parametre. Selv den lette metode kræver 16–24 GB; dit kort har 6.<LineBreak /><LineBreak />
                  <Run FontWeight="SemiBold">3. Den eneste overkommelige vej går udenom maskinen.</Run> Skulle det ske i skyen, skulle dine møder sendes derop — og det er præcis dét, hele løsningen er bygget for at undgå.<LineBreak /><LineBreak />
                  <Run FontWeight="SemiBold">4. Det ville ikke løse de fejl, vi har.</Run> Fejlene er navne og tal. Dem retter en regel med det samme, gratis, og den kan fortrydes. En efteruddannet model kan ingen af delene.</TextBlock>
              </TextBlock.ToolTip>
            </TextBlock>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>

    <!-- ============================ Listen ============================== -->
    <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,18,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
        <TextBox x:Name="Soeg" Width="220" TextChanged="Soeg_Changed" />
        <TextBlock Text="Søg" Style="{StaticResource Underskrift}" Margin="-212,0,0,0"
                   VerticalAlignment="Center" IsHitTestVisible="False"
                   x:Name="SoegPladsholder" Foreground="{StaticResource TekstMeget}" />
        <TextBlock x:Name="Antal" Style="{StaticResource Underskrift}" Margin="14,0,0,0"
                   VerticalAlignment="Center" />
      </StackPanel>

      <DataGrid x:Name="Gitter" Grid.Row="1"
                AutoGenerateColumns="False" IsReadOnly="True"
                HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                Background="{StaticResource Panel}" Foreground="{StaticResource Tekst}"
                RowBackground="{StaticResource Panel}" AlternatingRowBackground="#FF262B34"
                HorizontalGridLinesBrush="#FF343B48" BorderBrush="{StaticResource PanelKant}"
                BorderThickness="1" SelectionMode="Single"
                SelectionChanged="Gitter_SelectionChanged"
                RowHeaderWidth="0" FontSize="13">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Ord" Binding="{Binding Canonical}" Width="*" />
          <DataGridTextColumn Header="Kunde" Binding="{Binding Scope}" Width="110" />
          <DataGridTextColumn Header="Hørt som" Binding="{Binding AliasCount}" Width="80" />
          <DataGridTextColumn Header="Aktiv" Binding="{Binding AktivTekst}" Width="55" />
        </DataGrid.Columns>
      </DataGrid>

      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
        <Button Content="Importér fra ordliste.txt" Click="Import_Click" Margin="0,0,8,0" />
        <Button x:Name="SletKnap" Content="Slet valgte" Click="Slet_Click" IsEnabled="False" Margin="0,0,8,0" />
        <Button Content="Slå dubletter sammen" Click="Dubletter_Click" />
      </StackPanel>
    </Grid>

    <!-- ============================ Redigering ========================== -->
    <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="10"
            BorderBrush="{StaticResource PanelKant}" BorderThickness="1" Padding="18">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

          <TextBlock x:Name="FormTitel" Text="Nyt ord" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" />

          <TextBlock Text="Ord" Style="{StaticResource Underskrift}" />
          <TextBox x:Name="FeltOrd" Margin="0,4,0,0" TextChanged="Ord_Changed" />

          <!-- Forslag mens man skriver. Ordbogen havde tre ord stående to
               gange, fordi man ikke kunne se, at de var der i forvejen. Et
               opslag, der først sker ved «Gem», er for sent. -->
          <ItemsControl x:Name="Forslag" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding}" Click="Forslag_Click" HorizontalContentAlignment="Left"
                        Padding="10,6" Margin="0,0,0,3" Cursor="Hand" FontSize="12.5"
                        Background="#FF1D2530" BorderBrush="{StaticResource PanelKant}"
                        BorderThickness="1" HorizontalAlignment="Stretch" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock x:Name="ForslagTekst" FontSize="12" Margin="2,6,0,0" TextWrapping="Wrap"
                     Foreground="{StaticResource Advarsel}" Visibility="Collapsed" />

          <!-- KATEGORIEN ER FJERNET.
               Den havde én funktion: at bestemme rækkefølgen, når ordlisten
               skulle skæres til for at være i et budget. Listen går ikke
               længere til Whisper, og til sprogmodellen er budgettet 2000
               tokens mod under hundrede ord — den skæres aldrig til.
               Til gengæld skabte den dubletter: det samme ord kunne oprettes
               én gang som fagterm og én gang som produkt.
               Feltet står stadig i databasen, fordi «person» kan blive brugbar
               igen, når talere skal navngives. Det er bare ikke noget, brugeren
               skal forholde sig til nu. -->

          <TextBlock Text="Udtale (valgfri), fx: udtales 'skim'" Style="{StaticResource Underskrift}"
                     Margin="0,14,0,0" />
          <TextBox x:Name="FeltUdtale" Margin="0,4,0,12" />

          <TextBlock Text="Kunde (valgfri) — ordet vælges kun til møder om dem" Style="{StaticResource Underskrift}" />
          <TextBox x:Name="FeltKunde" Margin="0,4,0,12" />

          <CheckBox x:Name="FeltAktiv" Content="Aktiv" IsChecked="True" Foreground="{StaticResource Tekst}"
                    Margin="0,0,0,16" />

          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Gem" Click="Gem_Click" Style="{StaticResource Primaer}" Margin="0,0,8,0" />
            <Button Content="Ryd" Click="Ryd_Click" />
          </StackPanel>

          <!-- Taler man ordet ind, finder appen SELV ud af, hvordan Whisper
               hører det forkert. Den del kan man ikke gætte, og før måtte man
               opdage den ved at læse en transskription igennem. -->
          <Button Content="🎤  Tal ordet ind — så finder appen fejlen" Click="Tal_Click"
                  Padding="12,10" Margin="0,0,0,18" HorizontalContentAlignment="Left"
                  Background="#FF1D2530" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                  Cursor="Hand" FontSize="12.5" />

          <!-- Prompten er den eneste måde at se, om ordbogen faktisk virker.
               Whisper har ~224 tokens; overfyldes den, skriver modellen
               prompten ind i transskriptionen. Derfor står tallet her. -->
          <Border Background="#FF181B22" CornerRadius="6" Padding="12" BorderThickness="1"
                  BorderBrush="{StaticResource PanelKant}">
            <StackPanel>
              <TextBlock Text="Sådan ser ordlisten ud til sprogmodellen" FontSize="13" FontWeight="SemiBold"
                         Margin="0,0,0,8" />
              <TextBlock x:Name="PromptTekst" FontSize="12" Foreground="{StaticResource TekstSvag}"
                         LineHeight="18" MaxHeight="150" />
              <TextBlock x:Name="PromptTal" Style="{StaticResource Underskrift}" Margin="0,10,0,0" />
              <Button Content="Gem ordlisten til Whisper" Click="Eksport_Click" Margin="0,12,0,0" />
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
