<UserControl x:Class="NoteApp.Desktop.Dictionary.DictionaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Baggrund}">

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="Dine rettelser" Style="{StaticResource Overskrift}" />
      <TextBlock Style="{StaticResource Underskrift}" TextWrapping="Wrap" MaxWidth="900"
                 HorizontalAlignment="Left"
                 Text="Hører appen et ord forkert, retter du det én gang — så bliver det rettet af sig selv i alle senere udskrifter." />
    </StackPanel>

    <!-- HVAD DETTE ER, OG HVAD DET IKKE ER.
         Skærmen hed før «Din ordbog» og havde en ordliste, man kunne skrive
         i. Den blev sendt med til Whisper som ledetråd, og det blev målt til
         nul forskel. Teksten her siger, hvad der faktisk sker, frem for at
         lade brugeren tro, at flere ord giver bedre genkendelse. -->
    <Border Grid.Row="1" Background="#FF1D2530" BorderBrush="{StaticResource PanelKant}"
            BorderThickness="1" CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,20,0">
          <TextBlock Text="Hvad en rettelse gør" FontSize="13.5" FontWeight="SemiBold"
                     Foreground="{StaticResource Godkendt}" />
          <TextBlock FontSize="12.5" LineHeight="20" Margin="0,6,0,0" TextWrapping="Wrap"
                     Foreground="{StaticResource TekstSvag}"
                     Text="Den retter teksten BAGEFTER. Skrev Whisper «cybernummer», hvor der skulle stå «cpr-nummer», bliver det byttet om i udskriften — hver gang, uden at du skal gøre noget. Det virker på tværs af møder, og det bliver ved med at virke, selvom du skifter til en nyere model." />
        </StackPanel>

        <StackPanel Grid.Column="1">
          <TextBlock Text="Hvad den ikke gør" FontSize="13.5" FontWeight="SemiBold"
                     Foreground="{StaticResource Advarsel}" />
          <TextBlock FontSize="12.5" LineHeight="20" Margin="0,6,0,0" TextWrapping="Wrap"
                     Foreground="{StaticResource TekstSvag}"
                     Text="Den lærer ikke Whisper at HØRE bedre. Modellen kan ikke trænes — dens vægte ligger fast i den fil, du har hentet, og at træne dem kræver tusindvis af timers lyd og et regnecenter. Appen hører altså det samme næste gang; den skriver bare det rigtige." />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="10"
            BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,14,16,10">
          <TextBox x:Name="Soeg" Width="280" HorizontalAlignment="Left" Padding="10,7"
                   TextChanged="Soeg_Changed" />
          <TextBlock x:Name="SoegPladsholder" Text="Søg …" IsHitTestVisible="False"
                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                     Foreground="{StaticResource TekstMeget}" />
          <TextBlock x:Name="Antal" HorizontalAlignment="Right" VerticalAlignment="Center"
                     Style="{StaticResource Underskrift}" />
        </Grid>

        <DataGrid x:Name="Gitter" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" RowBackground="Transparent"
                  AlternatingRowBackground="#FF242A33" Margin="8,0,8,10"
                  HorizontalGridLinesBrush="#FF2C323D">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Appen hørte" Binding="{Binding Hørt}" Width="*" />
            <DataGridTextColumn Header="Rettes til" Binding="{Binding Rigtigt}" Width="*" />
            <DataGridTextColumn Header="Set" Binding="{Binding Gange}" Width="70" />
            <DataGridTextColumn Header="Sidst" Binding="{Binding Sidst}" Width="120" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>

    <Grid Grid.Row="3" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0" x:Name="Status" Style="{StaticResource Underskrift}"
                 VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="SletKnap" Content="Slet rettelse" Click="Slet_Click" IsEnabled="False"
                Margin="0,0,8,0" />
        <Button Content="🎤 Tal en rettelse ind" Click="Tal_Click" Style="{StaticResource Primaer}"
                MinWidth="180" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
