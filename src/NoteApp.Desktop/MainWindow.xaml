<Window x:Class="NoteApp.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NoteApp" Height="820" Width="1280" MinHeight="640" MinWidth="1040"
        Background="{StaticResource Baggrund}"
        WindowStartupLocation="CenterScreen"
        Icon="app.ico">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="196" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Sidebjælke. To punkter, fordi appen kan to ting — og fordi det er
         nemmere at tilføje et tredje senere end at fjerne fem, der ikke
         bruges. -->
    <Border Grid.Column="0" Background="{StaticResource Panel}"
            BorderBrush="{StaticResource PanelKant}" BorderThickness="0,0,1,0">
      <!-- To omraader: navigationen oeverst, oplysningen om datamappen
           nederst. Laa den lige under menupunkterne, saa den ud som endnu et
           punkt man kunne klikke paa. -->
      <DockPanel Margin="14,22,14,16" LastChildFill="False">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,2">
          <Image Source="app.png" Width="30" Height="30" VerticalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality" />
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="NoteApp" FontSize="19" FontWeight="SemiBold" />
            <TextBlock x:Name="Version" Style="{StaticResource Underskrift}" />
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,26,0,0">
          <!-- «Optag møde» er øverst og er det, appen er til. Alt det andet —
               oplæsning, ordbog, skabeloner — findes for at gøre DEN bedre. -->
          <RadioButton x:Name="NavMoede" GroupName="nav" Content="Optag møde"
                       Checked="Nav_Changed" IsChecked="True"
                       Style="{StaticResource NavKnap}" />
          <RadioButton x:Name="NavOplaesning" GroupName="nav" Content="Start her"
                       Checked="Nav_Changed"
                       Style="{StaticResource NavKnap}" />
          <!-- «Din ordbog» ligger nr. 2, lige under «Start her»: det er den, der
               tilpasser appen til dine ord, og dermed det næste skridt efter
               den første indtaling — ikke noget, der hører til langt nede blandt
               indstillingerne. -->
          <RadioButton x:Name="NavOrdbog" GroupName="nav" Content="Din ordbog"
                       Checked="Nav_Changed"
                       Style="{StaticResource NavKnap}" />
          <!-- «Optagelser» frem for «Transskribér»: menupunktet siger, hvad man
               finder derinde. Handlingen står på selve skærmen, ved den
               optagelse den hører til. -->
          <RadioButton x:Name="NavTransskriber" GroupName="nav" Content="Optagelser"
                       Checked="Nav_Changed"
                       Style="{StaticResource NavKnap}" />
          <RadioButton x:Name="NavDokumenter" GroupName="nav" Content="Dokumenter"
                       Checked="Nav_Changed"
                       Style="{StaticResource NavKnap}" />
          <RadioButton x:Name="NavSkabeloner" GroupName="nav" Content="Skabeloner"
                       Checked="Nav_Changed"
                       Style="{StaticResource NavKnap}" />
          <RadioButton x:Name="NavMotor" GroupName="nav" Content="AI-modeller"
                       Checked="Nav_Changed"
                       Style="{StaticResource NavKnap}" />
          <RadioButton x:Name="NavFiler" GroupName="nav" Content="Filer og backup"
                       Checked="Nav_Changed"
                       Style="{StaticResource NavKnap}" />
          <RadioButton x:Name="NavIndstillinger" GroupName="nav" Content="Indstillinger"
                       Checked="Nav_Changed"
                       Style="{StaticResource NavKnap}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
          <Border Height="1" Background="{StaticResource PanelKant}" Margin="6,0,6,14" />
          <TextBlock Text="Dine data" Style="{StaticResource Underskrift}" Margin="6,0,0,3" />
          <TextBlock x:Name="DataSti" Style="{StaticResource Underskrift}"
                     Foreground="{StaticResource TekstMeget}" Margin="6,0,0,10" FontSize="11" />
          <TextBlock Style="{StaticResource Underskrift}" Foreground="{StaticResource TekstMeget}"
                     FontSize="11" Margin="6,0,0,0"
                     Text="Intet forlader denne pc. Appen har ingen netværkskald." />
        </StackPanel>
      </DockPanel>
    </Border>

    <ContentControl x:Name="Indhold" Grid.Column="1" />
  </Grid>
</Window>
