<Window x:Class="NoteApp.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:NoteApp.Desktop"
        Title="HeyPia" Height="820" Width="1280" MinHeight="640" MinWidth="1040"
        Background="{DynamicResource Baggrund}"
        WindowStartupLocation="CenterScreen"
        Icon="app.ico">

  <!-- Tre bånd: optagebjælken øverst, appen i midten, kørselsbjælken nederst.
       De to bjælker hører ikke til nogen skærm — den ene fordi optagelse er
       kernefunktionen og skal kunne nås fra hvor som helst, den anden fordi en
       kørsel på fire minutter skal kunne følges, mens man laver noget andet. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ContentControl x:Name="OptagBjaelke" Grid.Row="0" />

    <Grid Grid.Row="1">
    <Grid.ColumnDefinitions>
      <!-- Bredden saettes i koden, naar menuen klappes. 196 er den udfoldede;
           den sammenklappede er lige praecis et ikon plus luft. -->
      <ColumnDefinition x:Name="Menubredde" Width="196" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Sidebjælke. To punkter, fordi appen kan to ting — og fordi det er
         nemmere at tilføje et tredje senere end at fjerne fem, der ikke
         bruges. -->
    <!-- ============ BJAELKEN ER MOERKEBLAA I BEGGE TEMAER ============

         Den hentede sin flade i «Panel» - altsaa hvid i det lyse tema. Saa
         var skaermen hvide paneler paa en lysegraa flade med lyseblaa
         kanter: paent, og til forveksling som enhver anden Windows-app.
         Der var ingenting, der sagde HeyPia.

         Nu staar navigationen paa maerkets egen moerkeblaa, og resten af
         fladen er lys og rolig. Det er eet greb, og det er dét, der giver
         appen et ansigt.

         Alt herinde skal hente sin tekstfarve i PaaNavigation eller
         PaaNavigationSvag. «Tekst» er naesten sort i det lyse tema og ville
         forsvinde paa bjaelken. -->
    <Border Grid.Column="0" Background="{DynamicResource NavigationFlade}"
            BorderBrush="{DynamicResource NavigationKant}" BorderThickness="0,0,1,0">
     <Grid>
      <!-- To omraader: navigationen oeverst, oplysningen om datamappen
           nederst. Laa den lige under menupunkterne, saa den ud som endnu et
           punkt man kunne klikke paa. -->
      <DockPanel x:Name="Menuindhold" Margin="14,22,14,16" LastChildFill="False">

        <!-- PIA-IKONET BLIVER, NAVNET GAAR. Sammenklappet er ikonet det
             eneste, der siger, hvilket program man er i - og det er nok, naar
             det er dét, der staar paa proceslinjen. -->
        <StackPanel x:Name="Logolinje" DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,2">
          <Image Source="app.png" Width="30" Height="30" VerticalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality" />
          <StackPanel x:Name="Logotekst" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="HeyPia" FontSize="19" FontWeight="SemiBold"
                       Foreground="{DynamicResource PaaNavigation}" />
            <TextBlock x:Name="Version" Style="{StaticResource Underskrift}"
                       Foreground="{DynamicResource PaaNavigationSvag}" />
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,26,0,0">
          <!-- «Optag møde» står IKKE i menuen. Det er kernefunktionen, og den
               skal ikke være et sted, man går hen — den ligger som en fast
               bjælke øverst, der er der uanset hvilken skærm man står på.

               HER LÅ «START HER» OG «DINE RETTELSER».
               Begge hørte til oplæsning og træning, som er fjernet 18-08-2026.
               Grunden var målt: hverken ordlisten til Whisper, sprogmodellen
               over udskriften eller ordbogen til sprogmodellen kunne påvises at
               flytte noget. Tre håndtag, tre nuller — se doc/maaling-sky.md.

               Menuen begynder nu ved «Optagelser», som er det, appen er til.
               Mikrofonens kvalitet kan stadig måles; det står under
               «Indstillinger», hvor man er, når man vælger mikrofon. -->
          <!-- «Optagelser» frem for «Transskribér»: menupunktet siger, hvad man
               finder derinde. Handlingen står på selve skærmen, ved den
               optagelse den hører til. -->
          <!-- ============ COCKPIT STÅR ØVERST ============
               Det er skærmen, man begynder på, og den bærer søgningen.

               HVORFOR SØGNINGEN FLYTTEDE HERTIL

               Den lå mellem «Dokumenter» og «Skabeloner», fordi den dækker dem
               begge. Det var rigtigt, så længe den var én funktion blandt
               flere. Men appens værdi vokser med arkivet: efter to hundrede
               møder er det ENESTE sted, man kan finde ud af, hvad der faktisk
               blev sagt — og så er søgningen ikke en funktion, den er indgangen.

               Et menupunkt nummer tre siger, at den er noget, man går hen til.
               Øverst siger den, at den er dér, man starter. -->
          <RadioButton x:Name="NavCockpit" Tag="&#xE80F;" GroupName="nav" Content="{i18n:Oversat nav.cockpit}"
                       Checked="Nav_Changed" IsChecked="True"
                       Style="{StaticResource NavKnap}" />

          <!-- DIKTERING LIGGER LIGE UNDER COCKPITTET.
               Cockpittet er det, man kigger i; dikteringen er det, man taler
               ind i. De to er de to maader, man bruger appen paa til daglig.

               Derinde ligger de tre ting, man goer, naar en diktering ikke
               rammer: proeverummet, hvor man ser resultatet med det samme,
               teksttyperne, hvor formen rettes, og ordbogen, hvor et navn
               laeres. Laa de paa hver sin skaerm, var det tre opgaver i
               stedet for een - og saa bliver de ikke lavet. -->
          <RadioButton x:Name="NavDiktering" Tag="&#xE720;" GroupName="nav" Content="{i18n:Oversat nav.diktering}"
                       Checked="Nav_Changed"
                       Style="{StaticResource NavKnap}" />

          <!-- «Optagelser» frem for «Transskribér»: menupunktet siger, hvad man
               finder derinde. Handlingen står på selve skærmen, ved den
               optagelse den hører til. -->
          <RadioButton x:Name="NavTransskriber" Tag="&#xE8F1;" GroupName="nav" Content="{i18n:Oversat nav.optagelser}"
                       Checked="Nav_Changed"
                       Style="{StaticResource NavKnap}" />
          <!-- ============ HER LÅ «DOKUMENTER» ============

               Optagelsen og dokumentet er den samme sag set fra to sider, og
               de havde hvert sit menupunkt. Sammenhaengen var der i data -
               hvert dokument baerer optagelsens id - men den var ikke noget,
               man kunne SE. Ville man vide, hvad der var lavet ud af et moede,
               skulle man gaa til «Dokumenter» og laese «Fra optagelse» paa
               hver enkelt.

               Dokumenterne staar nu som en FANE inde paa optagelsen, ved
               siden af udskriften. Samme moede, to faner.

               KNAPPEN STOD HER SKJULT I EN MELLEMPERIODE, saa de fire steder,
               der peger paa dokumentarkivet, kunne blive ved at saette
               IsChecked. Det virkede, og det var alligevel forkert: en knap i
               menuen, der ikke er i menuen, er noget den naeste laeser skal
               regne ud. Arkivet er nu en skaerm UDEN et menupunkt - se
               MainWindow.GaaTilDokumenter, som saetter indholdet direkte og
               rydder markeringen i menuen, saa intet punkt staar valgt paa en
               skaerm, der ikke hoerer til det. -->
          <!-- MØDETYPER, IKKE SKABELONER.
               «Skabelon» er et ord fra tekstbehandling. Det tvinger læseren
               til at tænke i dokumenter på et tidspunkt, hvor der ikke er
               noget dokument. Et statusmøde, en 1:1, et kundemøde: dét kan
               man svare på, FØR mødet går i gang.

               Menupunktet hed kortvarigt «Skabeloner», mens teksttyperne lå
               her. De ligger nu under Diktering, hvor de hører til, og så er
               mødetyperne det eneste tilbage — og så er «Mødetyper» igen det
               præcise ord.

               Filerne bag hedder stadig skabeloner. Det er med vilje: de er
               skabeloner, når man skriver dem, og mødetyper, når man vælger
               dem. -->
          <RadioButton x:Name="NavSkabeloner" Tag="&#xE8EC;" GroupName="nav" Content="{i18n:Oversat nav.skabeloner}"
                       Checked="Nav_Changed"
                       Style="{StaticResource NavKnap}" />
          <!-- AI-modeller er det eneste menupunkt med et mærkat. Grunden er,
               at det er det eneste sted, hvor noget kan MANGLE, uden at man
               opdager det: appen optager og skriver ud som den skal, og først
               den dag man vil have et referat, viser det sig, at nøglen aldrig
               blev sat. Tallet står, indtil den er sat, og forsvinder så. -->
          <!-- AutomationProperties.Name skal saettes i haanden her.
               Content var teksten "AI-modeller", og saa gav WPF menupunktet
               det navn af sig selv. Nu er Content et Grid, og saa har punktet
               ikke laengere et navn - hverken for en skaermlaeser eller for
               den, der proever skaermene af med UI-automatik. -->
          <RadioButton x:Name="NavMotor" Tag="&#xE9F5;" GroupName="nav"
                       Checked="Nav_Changed"
                       AutomationProperties.Name="{i18n:Oversat faelles.ai_modeller}"
                       Style="{StaticResource NavKnap}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <!-- INGEN Foreground HER.
                   Den bandt til RadioButtonens egen Foreground, og den staar
                   paa den svage tekstfarve, indtil punktet er valgt. De andre
                   menupunkter har almindelig tekst som Content, og dér vinder
                   den globale TextBlock-stil med den normale tekstfarve. Saa
                   stod AI-modeller graat, mens resten stod hvidt - det lignede
                   en deaktiveret knap. Nu foelger den samme stil som resten. -->
              <TextBlock Grid.Column="0" Text="{i18n:Oversat nav.modeller}" VerticalAlignment="Center"
                         Foreground="{Binding Foreground,
                           RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}" />
              <Border Grid.Column="1" x:Name="MotorMaerkat" Visibility="Collapsed"
                      MinWidth="18" Height="18" CornerRadius="9" Margin="8,0,0,0"
                      Background="{DynamicResource Advarsel}" VerticalAlignment="Center"
                      ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="30000">
                <Border.ToolTip>
                  <TextBlock MaxWidth="280" TextWrapping="Wrap" LineHeight="19"
                             Text="{i18n:Oversat mainwindow.api_noeglen_til_den_europaeiske_sprogmodel}" />
                </Border.ToolTip>
                <TextBlock Text="1" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PaaAccent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0" />
              </Border>
            </Grid>
          </RadioButton>
          <RadioButton x:Name="NavCompliance" Tag="&#xE7EE;" GroupName="nav" Content="{i18n:Oversat nav.compliance}"
                       Checked="Nav_Changed"
                       Style="{StaticResource NavKnap}" />
          <RadioButton x:Name="NavHistorik" Tag="&#xE81C;" GroupName="nav" Content="{i18n:Oversat nav.historik}"
                       Checked="Nav_Changed"
                       Style="{StaticResource NavKnap}" />
          <!-- HER LAA «Filer og backup». Det er ikke et sted, man gaar hen
               - det er indstillinger, man aabner den dag, man skal flytte
               datamappen eller gendanne noget. Nu to faner under
               «Indstillinger». Fjernet 19-08-2026. -->
          <RadioButton x:Name="NavIndstillinger" Tag="&#xE713;" GroupName="nav" Content="{i18n:Oversat nav.indstillinger}"
                       Checked="Nav_Changed"
                       Style="{StaticResource NavKnap}" />
        </StackPanel>

        <StackPanel x:Name="Datafod" DockPanel.Dock="Bottom">
          <Border Height="1" Background="{DynamicResource NavigationKant}" Margin="6,0,6,14" />
          <TextBlock Text="{i18n:Oversat nav.dinedata}" Style="{StaticResource Underskrift}" Margin="6,0,0,3"
                     Foreground="{DynamicResource PaaNavigationSvag}" />
          <TextBlock x:Name="DataSti" Style="{StaticResource Underskrift}"
                     Foreground="{DynamicResource PaaNavigationSvag}" Margin="6,0,0,10" FontSize="11" />
          <!-- HER STOD EN LINJE OM, AT OPTAGELSER BLIVER PAA PC'EN, OG
               REFERATER BEARBEJDES I EU.
               Den var sand, men overfloedig: det staar under AI-modeller,
               hvor man vaelger det, og under Compliance, hvor det hoerer
               juridisk hjemme. En paastand, der gentages tre steder, bliver
               ikke tre gange saa troevaerdig - den bliver bare til noget,
               man laeser forbi. Fjernet 19-08-2026. -->
        </StackPanel>
      </DockPanel>

      <!-- ==================== KLAPPEN ====================

           DEN SIDDER PAA KANTEN, MIDT PAA SIDEN. Det er dér, oejet leder
           efter den: en menu, der kan klappes, klapper mod indholdet, og
           haandtaget hoerer til paa graensen mellem de to.

           Den skal kunne SES uden at raabe. Derfor en rund flade i panelets
           egen farve med en kant om - samme kant som sidebjaelkens egen, saa
           den laeses som en del af kanten frem for som noget, der ligger
           oven paa. Pilen peger den vej, den goer noget: ind, naar menuen er
           ude, og ud, naar den er inde. -->
      <Button x:Name="Klap" Click="Klap_Klik" Cursor="Hand" Width="22" Height="46"
              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-11,0"
              Background="Transparent" BorderThickness="0" Padding="0">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="flade" CornerRadius="11" Background="{DynamicResource NavigationFlade}"
                    BorderBrush="{DynamicResource NavigationKant}" BorderThickness="1">
              <TextBlock x:Name="pil" FontFamily="Segoe MDL2 Assets" FontSize="10"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource PaaNavigationSvag}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="flade" Property="Background" Value="{DynamicResource NavigationValgt}" />
                <Setter TargetName="flade" Property="BorderBrush" Value="{DynamicResource NavigationValgt}" />
                <Setter TargetName="pil" Property="Foreground" Value="{DynamicResource PaaNavigation}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>
     </Grid>
    </Border>

    <!-- ============ VEJEN TILBAGE TIL SOEGNINGEN ============
         Man rammer sjaeldent det rigtige sted foerste gang. Uden en vej
         tilbage skal man til Soeg, skrive ordet igen og finde stedet i
         listen forfra - for hvert eneste sted, man vil kontrollere.

         Linjen ligger HER og ikke inde i de enkelte skaerme: den skal se ens
         ud og opfoere sig ens, uanset om man landede i en udskrift eller i
         et dokument. Den forsvinder, saa snart man selv vaelger et menupunkt.
         -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border x:Name="TilbageLinje" Grid.Row="0" Visibility="Collapsed"
              Background="{DynamicResource Valgt}" BorderBrush="{DynamicResource Accent}"
              BorderThickness="0,0,0,2" Padding="24,12">
        <Button x:Name="TilbageKnap" Click="Tilbage_Click" Cursor="Hand"
                HorizontalAlignment="Left" Padding="0" BorderThickness="0"
                Background="Transparent" ToolTip="{i18n:Oversat mainwindow.tilbage_til_listen_over_steder}">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <!-- Den skal ligne en knap, ikke en oplysning. Foerst var den en
                   tynd linje med lille tekst i accentfarve, og den blev laest
                   som en overskrift - ikke som noget, man kunne trykke paa. -->
              <Border x:Name="flade" CornerRadius="7" Padding="14,8"
                      Background="{DynamicResource Accent}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                             VerticalAlignment="Center" Margin="0,0,10,0"
                             Foreground="{DynamicResource PaaAccent}" FontWeight="Bold" />
                  <TextBlock Text="{TemplateBinding Content}" FontSize="13.5"
                             VerticalAlignment="Center" Foreground="{DynamicResource PaaAccent}"
                             FontWeight="SemiBold" />
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="flade" Property="Background" Value="{DynamicResource Accent}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </Border>

      <ContentControl x:Name="Indhold" Grid.Row="1" />
    </Grid>
    </Grid>

    <!-- Kørslen, der ikke hører til nogen skærm. Den ligger nederst i vinduet,
         fordi den skal kunne ses, uanset hvor man går hen — et dokument tager
         minutter, og i den tid vil man gerne kigge på noget andet. -->
      <Border x:Name="JobBjaelke" Grid.Row="2" Background="{DynamicResource Valgt}" Visibility="Collapsed"
              BorderBrush="{DynamicResource Accent}" BorderThickness="0,1,0,0" Padding="24,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Ellipse x:Name="JobPrik" Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                   Margin="0,0,12,0" Fill="{DynamicResource Accent}" />

          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
            <TextBlock x:Name="JobHvad" FontSize="12.5" FontWeight="SemiBold" />
            <TextBlock x:Name="JobBesked" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TekstSvag}" />

            <!-- Hvad der laves, hvornår det begyndte, og hvor det lander.
                 Det står fast, mens beskeden ovenover skifter — og
                 starttidspunktet er dét, man leder efter, når man har kigget
                 væk et stykke tid og er i tvivl, om den stadig arbejder. -->
            <TextBlock x:Name="JobDetaljer" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TekstMeget}" />

            <!-- Bjælken er ord skrevet mod skabelonens loft. Den når sjældent
                 helt ud — modellen stopper af sig selv — og derfor står de
                 rigtige tal ovenover. Det, man vil vide, er om den stadig
                 rykker sig. -->
            <ProgressBar x:Name="JobBar" Height="5" Minimum="0" Maximum="100" Margin="0,7,0,0"
                         Background="{DynamicResource Svaev}" Foreground="{DynamicResource Accent}"
                         BorderThickness="0" Visibility="Collapsed" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="JobVisKnap" Content="{i18n:Oversat mainwindow.vis_dokumentet}" Click="JobVis_Click"
                    Visibility="Collapsed" Padding="12,6" Margin="0,0,8,0" />
            <Button x:Name="JobLukKnap" Content="{i18n:Oversat mainwindow.skjul}" Click="JobLuk_Click"
                    Visibility="Collapsed" Padding="12,6" Margin="0,0,8,0" />
            <Button x:Name="JobAfbrydKnap" Content="{i18n:Oversat faelles.afbryd}" Click="JobAfbryd_Click" Padding="12,6" />
          </StackPanel>
        </Grid>
      </Border>
    <!-- ==================== DIKTERING ====================

         EGEN RAEKKE, ikke JobBjaelkes. De to kan koere samtidig - man kan
         diktere, mens et referat bliver skrevet - og delte de samme felt,
         ville den ene slaa den anden ihjel.

         EN AABEN MIKROFON SKAL KUNNE SES. Resten af appen lover, at der ikke
         lyttes uden videre; saa maa det ogsaa staa paa skaermen, naar der
         goer. -->
    <Border x:Name="DiktatBjaelke" Grid.Row="3" Grid.ColumnSpan="2" Visibility="Collapsed"
            Background="{DynamicResource AccentFlade}" BorderBrush="{DynamicResource Accent}"
            BorderThickness="0,1,0,0" Padding="24,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Ellipse x:Name="DiktatPrik" Width="9" Height="9" VerticalAlignment="Center"
                   Margin="0,0,12,0" Fill="{DynamicResource Optager}" />

          <!-- ============ LYDBOELGER, KUN MENS DER OPTAGES ============

               EN BESKED OM AT DER OPTAGES ER EN PAASTAND. En kurve, der
               foelger stemmen, er et bevis - og forskellen maerkes i det
               sekund, hvor man begynder at tale og ikke ved, om appen er med.

               Prikken lyste op efter niveauet foer. Det var for lidt til at
               ses i oejenkrogen, mens man kigger et andet sted hen.

               DE VISES KUN UNDER EN DIKTERING. En kurve, der bevaeger sig,
               mens appen bare lytter efter vaageordet, ville laeses som «den
               optager nu» - og det er praecis den forveksling, hele bjaelken
               er sat i verden for at undgaa. Lyttes der bare, staar prikken
               stille. -->
          <StackPanel x:Name="Lydboelger" Orientation="Horizontal" Visibility="Collapsed"
                      VerticalAlignment="Center" Height="18" Margin="0,0,12,0">
            <Rectangle x:Name="Boelge0" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5"
                       VerticalAlignment="Center" Fill="{DynamicResource Optager}" />
            <Rectangle x:Name="Boelge1" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5"
                       Margin="2,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource Optager}" />
            <Rectangle x:Name="Boelge2" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5"
                       Margin="2,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource Optager}" />
            <Rectangle x:Name="Boelge3" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5"
                       Margin="2,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource Optager}" />
            <Rectangle x:Name="Boelge4" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5"
                       Margin="2,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource Optager}" />
            <Rectangle x:Name="Boelge5" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5"
                       Margin="2,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource Optager}" />
            <Rectangle x:Name="Boelge6" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5"
                       Margin="2,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource Optager}" />
          </StackPanel>
          <TextBlock x:Name="DiktatBesked" FontSize="12.5" VerticalAlignment="Center"
                     TextWrapping="Wrap" Foreground="{DynamicResource Tekst}" />
        </StackPanel>

        <!-- ============ «GEM SOM NOTE» — OG IKKE EN DIALOG ============

             Der SKAL spørges, men ikke med et vindue. En diktering bruges,
             mens man står i et andet program, og teksten er lige landet dér.
             En dialog ville rive fokus væk fra netop det felt, i samme
             sekund man var færdig — og så ville svaret koste mere end
             spørgsmålet er værd.

             Knappen står her i stedet. Den venter, til man kigger. -->
        <StackPanel Grid.Column="1" Orientation="Horizontal">

          <!-- ============ BOBLEN HENTES TILBAGE HERFRA ============

               Krydset paa boblen lukker KUN boblen. Lytningen fortsaetter, og
               den her bjaelke bliver staaende og siger det - den er signalet,
               boblen er bekvemmeligheden.

               Derfor hoerer vejen tilbage til netop her: der, hvor man kan se,
               at der stadig lyttes. Knappen staar kun frem, naar boblen er
               lukket, og der faktisk er noget at hente tilbage. -->
          <Button x:Name="HentBobleKnap" Visibility="Collapsed"
                  Click="HentBoble_Klik" Padding="12,6" Margin="16,0,0,0"
                  Content="{i18n:Oversat lytteboble.hent}" />

          <Button x:Name="GemNoteKnap" Visibility="Collapsed"
