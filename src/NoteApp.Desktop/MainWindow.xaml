<Window x:Class="NoteApp.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NoteApp" Height="820" Width="1280" MinHeight="640" MinWidth="1040"
        Background="{StaticResource Baggrund}"
        WindowStartupLocation="CenterScreen"
        Icon="app.ico">

  <!-- Tre bånd: optagebjælken øverst, appen i midten, kørselsbjælken nederst.
       De to bjælker hører ikke til nogen skærm — den ene fordi optagelse er
       kernefunktionen og skal kunne nås fra hvor som helst, den anden fordi en
       kørsel på fire minutter skal kunne følges, mens man laver noget andet. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ContentControl x:Name="OptagBjaelke" Grid.Row="0" />

    <Grid Grid.Row="1">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="196" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Sidebjælke. To punkter, fordi appen kan to ting — og fordi det er
         nemmere at tilføje et tredje senere end at fjerne fem, der ikke
         bruges. -->
    <Border Grid.Column="0" Background="{StaticResource Panel}"
            BorderBrush="{StaticResource PanelKant}" BorderThickness="0,0,1,0">
      <!-- To omraader: navigationen oeverst, oplysningen om datamappen
           nederst. Laa den lige under menupunkterne, saa den ud som endnu et
           punkt man kunne klikke paa. -->
      <DockPanel Margin="14,22,14,16" LastChildFill="False">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,2">
          <Image Source="app.png" Width="30" Height="30" VerticalAlignment="Center"
                 RenderOptions.BitmapScalingMode="HighQuality" />
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="NoteApp" FontSize="19" FontWeight="SemiBold" />
            <TextBlock x:Name="Version" Style="{StaticResource Underskrift}" />
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,26,0,0">
          <!-- «Optag møde» står IKKE i menuen. Det er kernefunktionen, og den
               skal ikke være et sted, man går hen — den ligger som en fast
               bjælke øverst, der er der uanset hvilken skærm man står på.
               Dermed er «Start her» det første punkt, hvilket også er det,
               navnet lover. -->
          <RadioButton x:Name="NavOplaesning" GroupName="nav" Content="Start her"
                       Checked="Nav_Changed" IsChecked="True"
                       Style="{StaticResource NavKnap}" />
          <!-- «Dine rettelser» — ikke «Din ordbog». Navnet er ændret, fordi
               indholdet er: der var en ordliste, man kunne skrive i, og den
               gjorde målt ingen forskel. Tilbage er det, der virker. -->
          <RadioButton x:Name="NavOrdbog" GroupName="nav" Content="Dine rettelser"
                       Checked="Nav_Changed"
                       Style="{StaticResource NavKnap}" />
          <!-- Her lå «Træning» som eget punkt. Det viste resultatet af de tre
               oplæsninger — men de tre oplæsninger står på «Start her», så man
               skulle skifte skærm for at se, hvad ens egen oplæsning gav, og de
               to skærme kunne sige noget forskelligt om det samme. Resultatet
               ligger nu under den boks, det hører til. -->
          <!-- «Optagelser» frem for «Transskribér»: menupunktet siger, hvad man
               finder derinde. Handlingen står på selve skærmen, ved den
               optagelse den hører til. -->
          <RadioButton x:Name="NavTransskriber" GroupName="nav" Content="Optagelser"
                       Checked="Nav_Changed"
                       Style="{StaticResource NavKnap}" />
          <RadioButton x:Name="NavDokumenter" GroupName="nav" Content="Dokumenter"
                       Checked="Nav_Changed"
                       Style="{StaticResource NavKnap}" />
          <RadioButton x:Name="NavSkabeloner" GroupName="nav" Content="Skabeloner"
                       Checked="Nav_Changed"
                       Style="{StaticResource NavKnap}" />
          <RadioButton x:Name="NavMotor" GroupName="nav" Content="AI-modeller"
                       Checked="Nav_Changed"
                       Style="{StaticResource NavKnap}" />
          <RadioButton x:Name="NavHistorik" GroupName="nav" Content="Historik"
                       Checked="Nav_Changed"
                       Style="{StaticResource NavKnap}" />
          <RadioButton x:Name="NavFiler" GroupName="nav" Content="Filer og backup"
                       Checked="Nav_Changed"
                       Style="{StaticResource NavKnap}" />
          <RadioButton x:Name="NavIndstillinger" GroupName="nav" Content="Indstillinger"
                       Checked="Nav_Changed"
                       Style="{StaticResource NavKnap}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom">
          <Border Height="1" Background="{StaticResource PanelKant}" Margin="6,0,6,14" />
          <TextBlock Text="Dine data" Style="{StaticResource Underskrift}" Margin="6,0,0,3" />
          <TextBlock x:Name="DataSti" Style="{StaticResource Underskrift}"
                     Foreground="{StaticResource TekstMeget}" Margin="6,0,0,10" FontSize="11" />
          <TextBlock Style="{StaticResource Underskrift}" Foreground="{StaticResource TekstMeget}"
                     FontSize="11" Margin="6,0,0,0"
                     Text="Intet forlader denne pc. Appen har ingen netværkskald." />
        </StackPanel>
      </DockPanel>
    </Border>

    <ContentControl x:Name="Indhold" Grid.Column="1" />
    </Grid>

    <!-- Kørslen, der ikke hører til nogen skærm. Den ligger nederst i vinduet,
         fordi den skal kunne ses, uanset hvor man går hen — et dokument tager
         minutter, og i den tid vil man gerne kigge på noget andet. -->
      <Border x:Name="JobBjaelke" Grid.Row="2" Background="#FF1A2230" Visibility="Collapsed"
              BorderBrush="{StaticResource Accent}" BorderThickness="0,1,0,0" Padding="24,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Ellipse x:Name="JobPrik" Grid.Column="0" Width="9" Height="9" VerticalAlignment="Center"
                   Margin="0,0,12,0" Fill="{StaticResource Accent}" />

          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
            <TextBlock x:Name="JobHvad" FontSize="12.5" FontWeight="SemiBold" />
            <TextBlock x:Name="JobBesked" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TekstSvag}" />

            <!-- Bjælken er ord skrevet mod skabelonens loft. Den når sjældent
                 helt ud — modellen stopper af sig selv — og derfor står de
                 rigtige tal ovenover. Det, man vil vide, er om den stadig
                 rykker sig. -->
            <ProgressBar x:Name="JobBar" Height="5" Minimum="0" Maximum="100" Margin="0,7,0,0"
                         Background="#FF2C323D" Foreground="{StaticResource Accent}"
                         BorderThickness="0" Visibility="Collapsed" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="JobVisKnap" Content="Vis dokumentet" Click="JobVis_Click"
                    Visibility="Collapsed" Padding="12,6" Margin="0,0,8,0" />
            <Button x:Name="JobLukKnap" Content="Skjul" Click="JobLuk_Click"
                    Visibility="Collapsed" Padding="12,6" Margin="0,0,8,0" />
            <Button x:Name="JobAfbrydKnap" Content="Afbryd" Click="JobAfbryd_Click" Padding="12,6" />
          </StackPanel>
        </Grid>
      </Border>
  </Grid>
</Window>
