<UserControl x:Class="NoteApp.Desktop.Search.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ================== SØGNING PÅ TVÆRS ==================

       Skærmen findes, fordi et arkiv, man ikke kan søge i, holder op med at
       være et arkiv. Efter tredive møder åbner ingen dem ét ad gangen for at
       finde ud af, hvad der blev aftalt.

       Der er ingen søgeknap. Resultaterne kommer, mens man skriver — en
       søgning, der koster et ekstra klik, bliver til et opslag man overvejer
       frem for noget, man bare gør. -->

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ============ SØGEFELTET ER SKÆRMENS TYNGDEPUNKT ============

         Det er ikke pynt, at det står stort og midt på. Appens værdi vokser
         med arkivet: efter to hundrede møder er det her det eneste sted, man
         kan finde ud af, hvad der FAKTISK blev sagt. Alt andet på skærmen er
         arrangement omkring den ene ting.

         Et søgefelt i et hjørne siger, at søgning er en funktion. Et felt midt
         på siger, at det er dét, skærmen er til. -->
    <StackPanel Grid.Row="0" Margin="0,0,0,18" HorizontalAlignment="Center">
      <TextBlock Text="Cockpit" FontSize="26" FontWeight="SemiBold"
                 HorizontalAlignment="Center" />
      <TextBlock Style="{StaticResource Underskrift}" Margin="0,5,0,0"
                 TextAlignment="Center" MaxWidth="620" TextWrapping="Wrap"
                 Text="Alt, der er sagt og skrevet — transkriptioner, dine noter og de færdige dokumenter. Søgningen læser filerne på din maskine, og der sendes intet." />
    </StackPanel>

    <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="12"
            BorderBrush="{StaticResource Accent}" BorderThickness="1" Padding="8"
            MaxWidth="820" HorizontalAlignment="Stretch">
      <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35" Color="#FF000000" />
      </Border.Effect>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                   FontSize="17" VerticalAlignment="Center" Margin="12,0,4,0"
                   Foreground="{StaticResource Accent}" />

        <TextBox x:Name="Felt" Grid.Column="1" FontSize="18" Padding="10,12"
                 BorderThickness="0" Background="Transparent"
                 TextChanged="Felt_Aendret" KeyDown="Felt_Tast" />
        <TextBlock x:Name="Pladsholder" Grid.Column="1" IsHitTestVisible="False" FontSize="18"
                   Margin="13,0,0,0" VerticalAlignment="Center"
                   Foreground="{StaticResource TekstMeget}"
                   Text="Hvad leder du efter?" />

        <!-- Krydset rydder feltet i ét klik — samme som i udskriftens
             søgefelt, og af samme grund: et søgeord på tyve tegn skal ellers
             slettes tegn for tegn. Escape gør det samme.

             Det er STØRRE her end i udskriften, fordi feltet er større. Et
             kryds på 24 pixel i et felt med 18 punkts tekst ser ud som en
             fejl. -->
        <Button x:Name="Ryd" Grid.Column="2" Content="✕" Click="Ryd_Klik"
                Visibility="Collapsed" Cursor="Hand" FontSize="13"
                Padding="0" BorderThickness="0" Background="Transparent"
                Width="32" Height="32" Margin="0,0,10,0"
                Foreground="{StaticResource TekstMeget}"
                ToolTip="Ryd søgningen (Escape)">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="flade" CornerRadius="16" Background="Transparent">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="flade" Property="Background" Value="#FF2C323D" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </Grid>
    </Border>

    <!-- ============ AFGRÆNSNINGEN ============

         Tre felter, og de er alle tre valgt, FØR optagelsen begyndte — mappen,
         mødetypen og sproget vælges i opstartsdialogen. Det er dét, der gør
         dem brugbare fra dag ét: de er ikke noget, man skal gå tilbage og
         udfylde bagefter.

         De står UNDER søgefeltet og ikke ved siden af. Søgefeltet er skærmens
         tyngdepunkt; en række rullelister i samme højde ville gøre det til ét
         felt blandt fire. Her er de en indsnævring af det, man lige har
         skrevet — og de er små, fordi de sjældnere bruges. -->
    <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,12,0,0">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <TextBlock Text="Søg kun i" FontSize="11.5" VerticalAlignment="Center"
                 Margin="0,0,10,0" Foreground="{StaticResource TekstMeget}" />

      <!-- PERIODEN STÅR FØRST.
           Det er den afgrænsning, der bruges oftest — «hvad talte vi om i
           denne måned» er et almindeligt spørgsmål, «hvad står der på norsk»
           er det ikke. -->
      <ComboBox x:Name="Periodefilter" MinWidth="140" FontSize="12" Padding="8,5"
                Margin="0,0,8,0" SelectionChanged="Periode_Aendret"
                ToolTip="Kun optagelser fra denne periode">
        <ComboBox.ItemTemplate>
          <DataTemplate><TextBlock Text="{Binding Navn}" /></DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <ComboBox x:Name="Mappefilter" MinWidth="150" FontSize="12" Padding="8,5"
                SelectionChanged="Filter_Aendret" ToolTip="Kun optagelser i denne mappe">
        <ComboBox.ItemTemplate>
          <DataTemplate><TextBlock Text="{Binding Navn}" /></DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <ComboBox x:Name="Typefilter" MinWidth="150" FontSize="12" Padding="8,5" Margin="8,0,0,0"
                SelectionChanged="Filter_Aendret" ToolTip="Kun optagelser af denne mødetype">
        <ComboBox.ItemTemplate>
          <DataTemplate><TextBlock Text="{Binding Navn}" /></DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <ComboBox x:Name="Sprogfilter" MinWidth="130" FontSize="12" Padding="8,5" Margin="8,0,0,0"
                SelectionChanged="Filter_Aendret" ToolTip="Kun optagelser på dette sprog">
        <ComboBox.ItemTemplate>
          <DataTemplate><TextBlock Text="{Binding Navn}" /></DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <Button x:Name="RydFilter" Content="Ryd" Click="RydFilter_Klik" Margin="8,0,0,0"
              Padding="10,5" FontSize="11.5" Visibility="Collapsed"
              ToolTip="Søg i det hele igen" />
    </StackPanel>

    <!-- ============ DEN VALGTE PERIODE ============
         Kommer først frem, når man vælger «Fra og til» — to datovælgere, der
         altid står fremme, ville fylde en linje for en afgrænsning, der
         sjældent bruges. -->
    <StackPanel x:Name="Datoraekke" Orientation="Horizontal" HorizontalAlignment="Center"
                Margin="0,8,0,0" Visibility="Collapsed">
      <TextBlock Text="Fra" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,7,0"
                 Foreground="{StaticResource TekstMeget}" />
      <DatePicker x:Name="FraDato" Width="135" FontSize="12"
                  SelectedDateChanged="Dato_Aendret" />

      <TextBlock Text="til" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,7,0"
                 Foreground="{StaticResource TekstMeget}" />
      <DatePicker x:Name="TilDato" Width="135" FontSize="12"
                  SelectedDateChanged="Dato_Aendret" />

      <TextBlock x:Name="Datofejl" FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0"
                 Foreground="{StaticResource Advarsel}" />
    </StackPanel>
    </StackPanel>

    <TextBlock x:Name="Status" Grid.Row="3" Style="{StaticResource Underskrift}"
               Margin="2,10,2,10" HorizontalAlignment="Center" />

    <!-- ==================== TRE SPALTER ====================

         MIDTEN ER SOEGNINGEN, og det er hele skaermens grund til at vaere der.
         De to andre spalter er arrangement omkring den: til venstre det, der
         lige er sket, til hoejre det, der skal goeres.

         Soegefeltet staar OVEN OVER alle tre og ikke i midterspalten. Et
         soegefelt, der er en tredjedel bredt, er et felt blandt flere - og
         det er ikke, hvad det er.

         Soeger man, fylder resultaterne midten ud. Soeger man ikke, staar der
         en kort forklaring dér i stedet. Opgaverne til hoejre bliver staaende
         begge veje: de er ikke et svar paa en soegning, de er det, der venter.
    -->
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="*" MinWidth="380" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="340" />
      </Grid.ColumnDefinitions>

      <!-- ============ VENSTRE: DET, DER LIGE ER SKET ============
           En optagelse, der aldrig blev skrevet ud, er et hul i arkivet - og
           det opdager man ikke ved at lede efter det. Her staar de nyeste med
           deres tilstand, saa det kan ses uden at skifte skaerm. -->
      <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="10"
              BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="SENESTE OPTAGELSER" FontSize="10"
                     FontWeight="SemiBold" Margin="14,13,14,8"
                     Foreground="{StaticResource TekstMeget}" />

          <ScrollViewer Padding="7,0,7,10" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <ItemsControl x:Name="Senesterude">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Tag="{Binding}" Click="Seneste_Klik" Cursor="Hand"
                            HorizontalContentAlignment="Stretch" Margin="0,0,0,5"
                            BorderThickness="0" Padding="0" Background="Transparent">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="kort" Background="#FF181B22" CornerRadius="6"
                                  BorderBrush="{Binding Kant}" BorderThickness="3,0,0,0"
                                  Padding="11,8">
                            <ContentPresenter />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="kort" Property="Background" Value="#FF2C323D" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>

                      <StackPanel>
                        <TextBlock Text="{Binding Titel}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource Tekst}" />
                        <TextBlock Text="{Binding Under}" FontSize="10.5" Margin="0,3,0,0"
                                   TextWrapping="Wrap" Foreground="{StaticResource TekstMeget}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock x:Name="IngenOptagelser" FontSize="12" Margin="4,6,4,0"
                         TextWrapping="Wrap" LineHeight="18" Visibility="Collapsed"
                         Foreground="{StaticResource TekstSvag}"
                         Text="Der er ikke optaget noget endnu. Tryk «Optag møde» eller «Webinar» øverst." />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- ============ MIDTEN: SØGNINGEN ============ -->
      <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="10"
              BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
        <Grid>

          <!-- Staar der ingenting i soegefeltet, staar der her, hvad der
               bliver soegt i. Kort - det er en oplysning, ikke en skaerm. -->
          <StackPanel x:Name="TomPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                      MaxWidth="440" Margin="24">
            <TextBlock Text="Hvad leder du efter?" FontSize="16" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="20"
                       TextAlignment="Center" Foreground="{StaticResource TekstSvag}"
                       Text="Der søges i alle transkriptioner, i de noter du skrev undervejs, og i de dokumenter appen har lavet. Flere ord betyder, at de alle skal stå tæt på hinanden." />
            <TextBlock FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="19"
                       TextAlignment="Center" Foreground="{StaticResource TekstMeget}"
                       Text="Filerne læses på din maskine. Der sendes intet." />
          </StackPanel>

          <!-- ============ FANER OG SORTERING ============

               Faner efter TYPE, fordi de tre slags svarer paa hver sit
               spoergsmaal: transkriptionen er, hvad der blev SAGT, noten er,
               hvad DU skrev ned, og dokumentet er, hvad der blev skrevet
               bagefter. Blandet i én liste skal man laese maerkatet paa hver
               eneste raekke for at vide, hvad man kigger paa.

               Fanerne staar kun frem, naar der ER noget at vaelge imellem -
               en faneraekke med ét punkt er ikke et valg. -->
          <DockPanel x:Name="Resultatrude" Visibility="Collapsed">

            <Grid DockPanel.Dock="Top" Margin="10,8,10,6">
              <ItemsControl x:Name="Typefaner" HorizontalAlignment="Left">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Tag="{Binding}" Click="Fane_Klik" Cursor="Hand" Margin="0,0,6,0">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="f" CornerRadius="13" Padding="12,5"
                                  Background="{Binding Flade}" BorderThickness="1"
                                  BorderBrush="{Binding Kant}">
                            <TextBlock Text="{Binding Navn}" FontSize="12"
                                       Foreground="{Binding Skrift}" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="f" Property="BorderBrush"
                                      Value="{StaticResource Accent}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Sortér" FontSize="11.5" VerticalAlignment="Center"
                           Margin="0,0,8,0" Foreground="{StaticResource TekstMeget}" />
                <ComboBox x:Name="Sortering" MinWidth="150" FontSize="12" Padding="8,4"
                          SelectionChanged="Sortering_Aendret">
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Navn}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Grid>

          <ScrollViewer x:Name="Rude" Padding="8,0,8,12"
          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="Liste">
          <ItemsControl.ItemTemplate>
          <DataTemplate>
          <!-- KILDEN ER EN OVERSKRIFT, IKKE EN KNAP.
          Foer var hele kortet klikbart og aabnede filen. Det var
          ikke det, man ville: staar ordet tolv steder, er
          spoergsmaalet hvilket af dem - ikke om filen kan aabnes.
          Nu staar hvert sted som sin egen linje. -->
          <Border CornerRadius="10" Padding="0" Margin="0,0,0,10"
          Background="#FF181B22" BorderThickness="1"
          BorderBrush="{StaticResource PanelKant}">
          <StackPanel>
          <Grid Margin="14,12,14,8">
          <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" CornerRadius="4" Padding="7,2" Margin="0,0,10,0"
          Background="#FF2C323D" VerticalAlignment="Center">
          <TextBlock Text="{Binding Maerkat}" FontSize="10.5" FontWeight="SemiBold"
          Foreground="{Binding Maerkatfarve}" />
          </Border>

          <TextBlock Grid.Column="1" Text="{Binding Overskrift}" FontSize="13.5"
          FontWeight="SemiBold" VerticalAlignment="Center"
          TextTrimming="CharacterEllipsis" />

          <TextBlock Grid.Column="2" Text="{Binding Hoejre}" FontSize="11.5"
          VerticalAlignment="Center" Margin="12,0,0,0"
          Foreground="{StaticResource TekstMeget}" />
          </Grid>

          <!-- Hvert sted. Nummeret goer det muligt at tale om «det
          tredje sted» og finde tilbage til det. -->
          <ItemsControl ItemsSource="{Binding Steder}" Margin="10,0,10,10">
          <ItemsControl.ItemTemplate>
          <DataTemplate>
          <!-- AutomationProperties.Name skal saettes i haanden.
          Content er et Grid, og saa har knappen intet navn
          - hverken for en skaermlaeser eller for den, der
          proever skaermene af med UI-automatik. Samme
          fejl som menupunktet med maerkatet havde. -->
          <Button Tag="{Binding}" Click="Sted_Klik" Cursor="Hand"
          AutomationProperties.Name="{Binding Uddrag}"
          HorizontalContentAlignment="Stretch" Padding="0"
          BorderThickness="0" Background="Transparent" Margin="0,0,0,3"
          ToolTip="Gå til dette sted i teksten">
          <Button.Template>
          <ControlTemplate TargetType="Button">
          <Border x:Name="rk" CornerRadius="6" Padding="11,8"
          Background="#FF12151B" BorderThickness="1"
          BorderBrush="Transparent">
          <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="rk" Property="Background" Value="#FF2C323D" />
          <Setter TargetName="rk" Property="BorderBrush" Value="{StaticResource Accent}" />
          </Trigger>
          </ControlTemplate.Triggers>
          </ControlTemplate>
          </Button.Template>

          <Grid>
          <Grid.ColumnDefinitions>
          <ColumnDefinition Width="30" />
          <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding Nummer}" FontSize="11.5"
          Foreground="{StaticResource TekstMeget}"
          VerticalAlignment="Top" />
          <!-- Det soegte staar GULT, praecis som i
          udskriften. To skaerme, der goer det samme,
          skal se ens ud - ellers leder man efter det
          gule paa den ene og finder det ikke. -->
          <TextBlock Grid.Column="1" FontSize="12.5"
          LineHeight="19" TextWrapping="Wrap"
          Loaded="Uddrag_Ind"
          Foreground="{StaticResource TekstSvag}" />
          </Grid>
          </Button>
          </DataTemplate>
          </ItemsControl.ItemTemplate>
          </ItemsControl>
          </StackPanel>
          </Border>
          </DataTemplate>
          </ItemsControl.ItemTemplate>
          </ItemsControl>
          </ScrollViewer>
          </DockPanel>

          <StackPanel x:Name="IntetPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
          MaxWidth="520" Visibility="Collapsed">
          <TextBlock x:Name="IntetOverskrift" FontSize="17" FontWeight="SemiBold"
          HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
          <TextBlock x:Name="IntetTekst" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap"
          LineHeight="21" TextAlignment="Center" Foreground="{StaticResource TekstSvag}" />

          <!-- ============ HVERT ORD FOR SIG ============
          Naar der ikke er noget fund, er spoergsmaalet ikke «findes
          ordene», men HVILKET af dem der staar i vejen. Uden den her
          liste maa man selv proeve sig frem ét ord ad gangen — og det
          er praecis dét, appen kan goere paa fire millisekunder. -->
          <ItemsControl x:Name="Enkeltvis" Margin="0,16,0,0" HorizontalAlignment="Center">
          <ItemsControl.ItemTemplate>
          <DataTemplate>
          <Border Background="#FF181B22" BorderBrush="{StaticResource PanelKant}"
          BorderThickness="1" CornerRadius="6" Padding="12,7" Margin="0,0,0,6">
          <Grid MinWidth="360">
          <TextBlock Text="{Binding Ord}" FontSize="12.5" FontWeight="SemiBold"
          HorizontalAlignment="Left" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Hvor}" FontSize="12" Margin="0,0,80,0"
          HorizontalAlignment="Right" VerticalAlignment="Center"
          Foreground="{StaticResource TekstMeget}" />
          <Button Content="Søg kun her" Tag="{Binding Ord}" Click="KunDet_Klik"
          HorizontalAlignment="Right" VerticalAlignment="Center"
          Padding="9,3" FontSize="11" />
          </Grid>
          </Border>
          </DataTemplate>
          </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="19"
          TextAlignment="Center" Foreground="{StaticResource TekstMeget}"
          Text="Husk, at et møde først kan søges, når det er skrevet ud til tekst — en optagelse alene indeholder ingen ord at lede i." />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ============ HØJRE: DET, DER SKAL GØRES ============
           Opgaverne oeverst, kalenderen nedenunder naar den kommer. De to
           hoerer sammen: den ene er hvad, den anden er hvornaar. -->
      <Grid Grid.Column="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="12" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Panel}" CornerRadius="10"
                BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="14,13,14,8">
              <TextBlock x:Name="OpgaveOverskrift" FontSize="13" FontWeight="SemiBold"
                         VerticalAlignment="Center" />
              <TextBlock x:Name="OpgaveTal" FontSize="10.5" HorizontalAlignment="Right"
                         VerticalAlignment="Center" Foreground="{StaticResource TekstMeget}" />
            </Grid>

            <ScrollViewer Padding="7,0,7,10" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <ItemsControl x:Name="Opgaverude">
                <ItemsControl.ItemTemplate>
                <DataTemplate>
                <!-- FARVEN KOMMER FRA FRISTEN, IKKE FRA PRIORITETEN.
                En prioritet 1 om tre uger haster ikke i dag; en
                prioritet 3, der skulle have været lavet i mandags,
                gør. Kanten svarer på «hvad nu», tallet på «hvad er
                vigtigst, når jeg har tid til ét af dem». -->
                <Border Background="#FF181B22" BorderBrush="{Binding Farve}"
                BorderThickness="3,0,0,0" CornerRadius="6"
                Padding="13,10" Margin="0,0,0,6">
                <Grid>
                <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" IsChecked="{Binding Faerdig, Mode=TwoWay}"
                VerticalAlignment="Top" Margin="0,1,10,0"
                ToolTip="Sæt flueben, når den er gjort" />

                <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Tekst}" FontSize="12.5" TextWrapping="Wrap"
                LineHeight="19" />

                <!-- HERKOMSTEN ER ET LINK, IKKE EN OPLYSNING.
                En opgave uden vej tilbage til det, der blev sagt,
                er et notat. Med linket kan man høre sætningen
                igen og se, om den blev forstået rigtigt — og det
                er hele grunden til, at appen findes. -->
                <Button Content="{Binding Under}" Tag="{Binding}" Click="Opgave_Klik"
                HorizontalAlignment="Left" Margin="0,4,0,0" Padding="0"
                BorderThickness="0" Background="Transparent" Cursor="Hand"
                FontSize="11" Foreground="#FF5B9DF0"
                ToolTip="Gå til det sted i transkriptionen, opgaven kom fra">
                <Button.Template>
                <ControlTemplate TargetType="Button">
                <TextBlock Text="{TemplateBinding Content}" FontSize="11"
                Foreground="{TemplateBinding Foreground}"
                TextWrapping="Wrap" />
                </ControlTemplate>
                </Button.Template>
                </Button>
                </StackPanel>

                <Border Grid.Column="2" CornerRadius="4" Padding="7,2" Margin="10,0,0,0"
                VerticalAlignment="Top" Background="#FF2C323D"
                Visibility="{Binding Fristvis}">
                <TextBlock Text="{Binding Frist}" FontSize="11"
                Foreground="{Binding Farve}" />
                </Border>

                <ComboBox Grid.Column="3" x:Name="Pri" Width="62" Margin="8,0,0,0"
                FontSize="11" VerticalAlignment="Top"
                SelectedIndex="{Binding Prioritetsvalg, Mode=TwoWay}"
                ToolTip="Prioritet — 1 er vigtigst">
                <ComboBoxItem Content="–" />
                <ComboBoxItem Content="1" />
                <ComboBoxItem Content="2" />
                <ComboBoxItem Content="3" />
                </ComboBox>
                </Grid>
                </Border>
                </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="IngenOpgaver" FontSize="13" Margin="6,10,6,0" TextWrapping="Wrap"
                LineHeight="21" Foreground="{StaticResource TekstSvag}"
                Visibility="Collapsed"
                Text="Der er ingen åbne opgaver. De kommer fra fanen «Opgaver» på en optagelse, der er skrevet ud — dér foreslår appen dem ud fra det, der blev sagt, og du vælger, hvilke der bliver til noget." />
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- ============ KALENDEREN ============

             Den staar UNDER opgaverne og ikke over. Opgaverne er det, der
             skal goeres; kalenderen er det, der skal ske. Det foerste kan man
             handle paa lige nu, det andet venter paa et klokkeslaet.

             Aftalerne kommer fra appens egen kalender OG fra dem, der er
             hentet ind. De staar i én liste - hvem der har lagt dem ind, er
             ikke det, man leder efter, naar man skal optage om fem minutter. -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="10"
                BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
          <StackPanel>
            <Grid Margin="14,13,14,8">
              <TextBlock x:Name="Kalenderoverskrift" FontSize="13" FontWeight="SemiBold"
                         VerticalAlignment="Center" />
              <Button Content="Ny aftale" Click="NyAftale_Klik" HorizontalAlignment="Right"
                      VerticalAlignment="Center" Padding="10,3" FontSize="11" />
            </Grid>

            <ItemsControl x:Name="Kalenderrude" Margin="7,0,7,10">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#FF181B22" BorderBrush="{Binding Kant}"
                          BorderThickness="3,0,0,0" CornerRadius="6"
                          Padding="11,8" Margin="0,0,0,5">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <TextBlock Grid.Column="0" Text="{Binding Klokken}" FontSize="12"
                                 FontFamily="Consolas" VerticalAlignment="Top"
                                 Margin="0,1,10,0" Foreground="{Binding Kant}" />

                      <StackPanel Grid.Column="1">
                        <!-- Titlen aabner aftalen. En aftale, man ikke kan
                             rette, er en aftale, man sletter og laver om. -->
                        <Button Tag="{Binding}" Click="RetAftale_Klik" Cursor="Hand"
                                HorizontalAlignment="Left" Padding="0" BorderThickness="0"
                                Background="Transparent"
                                ToolTip="Ret aftalen">
                          <Button.Template>
                            <ControlTemplate TargetType="Button">
                              <TextBlock Text="{Binding Titel}" FontSize="12" TextWrapping="Wrap"
                                         Foreground="{StaticResource Tekst}" />
                            </ControlTemplate>
                          </Button.Template>
                        </Button>
                        <TextBlock Text="{Binding Under}" FontSize="10.5" Margin="0,3,0,0"
                                   TextWrapping="Wrap" Foreground="{StaticResource TekstMeget}" />
                      </StackPanel>

                      <Button Grid.Column="2" Content="{Binding Knap}" Tag="{Binding}"
                              Click="Aftale_Klik" VerticalAlignment="Top" Margin="8,0,0,0"
                              Padding="10,4" FontSize="11"
                              ToolTip="{Binding Knaptip}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="IngenAftaler" FontSize="11.5" Margin="14,0,14,14"
                       TextWrapping="Wrap" LineHeight="18" Visibility="Collapsed"
                       Foreground="{StaticResource TekstSvag}"
                       Text="Ingen aftaler i kalenderen. Opret en her — eller forbind Google Kalender under Indstillinger, så bliver de hentet ind af sig selv." />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
