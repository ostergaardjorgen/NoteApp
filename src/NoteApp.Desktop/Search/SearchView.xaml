<UserControl x:Class="NoteApp.Desktop.Search.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:NoteApp.Desktop"
             xmlns:local="clr-namespace:NoteApp.Desktop">

  <!-- ================== SØGNING PÅ TVÆRS ==================

       Skærmen findes, fordi et arkiv, man ikke kan søge i, holder op med at
       være et arkiv. Efter tredive møder åbner ingen dem ét ad gangen for at
       finde ud af, hvad der blev aftalt.

       Der er ingen søgeknap. Resultaterne kommer, mens man skriver — en
       søgning, der koster et ekstra klik, bliver til et opslag man overvejer
       frem for noget, man bare gør. -->

  <Grid x:Name="Rammen" Margin="24,20,24,20">

    <!-- ==================== TRE SPALTER ====================

         MIDTEN ER SOEGNINGEN, og det er hele skaermens grund til at vaere der.
         De to andre spalter er arrangement omkring den: til venstre det, der
         lige er sket, til hoejre det, der skal goeres.

         SOEGEFELTET STOD FOER OVEN OVER ALLE TRE. Det var en hel skaermbredde
         brugt paa ét felt, og til gengaeld begyndte kalenderen og opgaverne
         foerst en tredjedel nede - med tom plads til venstre og hoejre for
         soegefeltet, som ingen kunne bruge til noget.

         Nu bor soegningen i sin egen spalte sammen med sit resultat. De to
         hoerer sammen: man skriver og laeser svaret det samme sted. Og de to
         andre spalter faar hele hoejden, som de faar brug for, saa snart der
         er mere end fem aftaler i kalenderen.

         Soeger man, fylder resultaterne midten ud. Soeger man ikke, staar der
         en kort forklaring dér i stedet. Opgaverne til hoejre bliver staaende
         begge veje: de er ikke et svar paa en soegning, de er det, der venter.
    -->
    <Grid x:Name="Spalterne">
      <!-- SPALTERNE KAN TRAEKKES, OG BREDDEN HUSKES.
           En bredde, man selv har trukket paa plads, og som er vaek i morgen,
           er vaerre end en fast bredde: saa traekker man den samme spalte hver
           dag. Bredderne gemmes i indstillingerne, naar traekket slippes.

           De to yderspalter er lige brede fra begyndelsen. Kalenderen og
           opgaverne er lige meget vaerd - den ene er hvad, den anden er
           hvornaar - og en smallere kalender var det, der gjorde datoen
           ulaeselig. -->
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="Venstrespalte" Width="340" MinWidth="220" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition x:Name="Midterspalte" Width="*" MinWidth="300" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition x:Name="Hoejrespalte" Width="340" MinWidth="220" />
      </Grid.ColumnDefinitions>

      <!-- ============ VENSTRE: DET, DER SKAL SKE ============

           KALENDEREN STAAR TIL VENSTRE, fordi den laeses foerst. Dagen
           begynder med «hvad sker der i dag», ikke med «hvad lavede jeg
           sidst» - og en aftale er det eneste her, der har et klokkeslaet,
           man kan naa at komme for sent til.

           «Seneste optagelser» stod her og er flyttet til Optagelser-
           skaermen. Den hoerer hjemme dér, hvor man arbejder med optagelser,
           og den fyldte den plads, kalenderen har brug for.

           Aftalerne kommer fra appens egen kalender OG fra dem, der er hentet
           ind. De staar i én liste - hvem der har lagt dem ind, er ikke det,
           man leder efter, naar man skal optage om fem minutter. -->
        <Border x:Name="VenstreRude" Grid.Column="0" Background="{DynamicResource Panel}" CornerRadius="10"
                BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
          <DockPanel>
            <!-- ============ OVERSKRIFT MED SYNKRONISERING ============

                 IKONET FINDES, FORDI DER IKKE HENTES AF SIG SELV.

                 En aftale, der oprettes direkte i Google, er ikke i HeyPia,
                 foer nogen henter den. Det laa foer KUN under Indstillinger,
                 og en funktion, man skal gaa to skaerme vaek for at finde,
                 findes ikke i praksis. Nu staar den, hvor aftalerne staar.

                 Linjen under siger, hvornaar der sidst blev hentet. Uden den
                 er ikonet en knap, man trykker paa for en sikkerheds skyld. -->
            <StackPanel DockPanel.Dock="Top" Margin="14,13,14,8">
              <Grid>
                <TextBlock x:Name="Kalenderoverskrift" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <!-- SYNKRONISERINGEN STAAR YDERST TIL HOEJRE.
                     Samme plads som paa opgaverne. To paneler ved siden af
                     hinanden, hvor den samme knap sidder to forskellige
                     steder, laeses som to forskellige knapper. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                  <Button Content="{i18n:Oversat kalender.nyaftale}" Click="NyAftale_Klik"
                          VerticalAlignment="Center" Padding="10,3" FontSize="11"
                          Margin="0,0,6,0" />
                  <Button x:Name="Kalendersynk" Click="Kalendersynk_Klik"
                          Style="{StaticResource IkonKnap}"
                          Visibility="Collapsed"
                          AutomationProperties.Name="{i18n:Oversat kalender.hentaftaler}"
                          ToolTip="{i18n:Oversat kalender.hentaftalerhjaelp}">
                    <TextBlock x:Name="Kalendersynkglyf" Text="&#xE895;"
                               FontFamily="Segoe MDL2 Assets" FontSize="13" />
                  </Button>
                </StackPanel>
              </Grid>

              <TextBlock x:Name="Kalendersynklinje" FontSize="11" Margin="0,4,0,0"
                         Visibility="Collapsed" TextWrapping="Wrap"
                         Foreground="{DynamicResource TekstMeget}" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
            <ItemsControl x:Name="Kalenderrude" Margin="7,0,7,10">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel>

                  <!-- DAGSOVERSKRIFTEN.
                       Datoen stod foer inde i hver aftale, klemt sammen med
                       klokkeslaet, sted og kilde. Fire oplysninger paa én
                       linje i en smal spalte betyder, at ingen af dem kan
                       laeses - og datoen er dén, man leder efter foerst.

                       Nu staar den ét sted pr. dag, stort nok til at blive
                       set, og aftalerne under den behoever kun deres
                       klokkeslaet. «I DAG» er gult; resten er graat. -->
                  <StackPanel Visibility="{Binding Dagsvis}" Margin="2,10,0,6">
                    <TextBlock Text="{Binding Dagsnavn}" FontSize="11.5"
                               FontWeight="SemiBold" Foreground="{Binding Dagsfarve}" />
                    <TextBlock Text="{Binding Dagsdato}" FontSize="10.5" Margin="0,1,0,0"
                               Foreground="{DynamicResource TekstMeget}" />
                  </StackPanel>

                  <!-- Opacity og ikke en graa farve paa hvert element: den
                       daemper hele kortet paa én gang - kant, tekst og knap -
                       og kan ikke komme ud af trit med resten, den dag
                       farverne aendres. -->
                  <!-- HELE KORTET ER KLIKBART - samme som opgaverne.
                       Her sad titlen som en knap, og teksten var det ENESTE,
                       der kunne rammes. Paa en kort titel er det et maal paa
                       halvanden centimeter i en liste, man skimmer, og resten
                       af kortet gjorde ingenting.

                       «Optag»-knappen sad her ogsaa. Den er vaek: en knap, der
                       goer det, kortet lige saa godt kan aabne, er et led for
                       meget - og optagelsen startes nu inde i vinduet, hvor
                       man samtidig kan se, hvad der bliver optaget som. -->
                  <Border Background="{DynamicResource Trykket}" BorderBrush="{Binding Kant}"
                          BorderThickness="3,0,0,0" CornerRadius="6"
                          Padding="11,8" Margin="0,0,0,5"
                          Opacity="{Binding Daempning}"
                          Tag="{Binding}" MouseLeftButtonUp="RetAftale_Klik"
                          Cursor="Hand" ToolTip="{i18n:Oversat searchview.aabn_aftalen}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>

                      <TextBlock Grid.Column="0" Text="{Binding Klokken}" FontSize="13"
                                 FontFamily="Consolas" FontWeight="SemiBold"
                                 VerticalAlignment="Top"
                                 Margin="0,0,10,0" Foreground="{Binding Klokkefarve}" />

                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Titel}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Tekst}" />
                        <TextBlock Text="{Binding Under}" FontSize="10.5" Margin="0,3,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TekstMeget}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="IngenAftaler" FontSize="11.5" Margin="14,0,14,14"
                       TextWrapping="Wrap" LineHeight="18" Visibility="Collapsed"
                       Foreground="{DynamicResource TekstSvag}"
                       Text="{i18n:Oversat searchview.ingen_aftaler_i_kalenderen_opret_en_her_el}" />
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      <!-- Greb mellem kalenderen og soegningen. Bredden er 14 som foer -
           mellemrummet ER grebet, saa der ikke bliver bredere af at kunne
           traekke i det. -->
      <GridSplitter x:Name="VenstreSplitter" Grid.Column="1" Width="14" HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" Background="Transparent"
                    DragCompleted="Spalte_Trukket"
                    ToolTip="{i18n:Oversat faelles.traek_for_at_aendre_bredden}" />

      <!-- ============ MIDTEN: SØGNINGEN ============ -->
      <Border Grid.Column="2" Background="{DynamicResource Panel}" CornerRadius="10"
              BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
        <Grid Margin="18,16,18,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0">
    <!-- ============ SØGEFELTET ER SKÆRMENS TYNGDEPUNKT ============

         Det er ikke pynt, at det står stort og midt på. Appens værdi vokser
         med arkivet: efter to hundrede møder er det her det eneste sted, man
         kan finde ud af, hvad der FAKTISK blev sagt. Alt andet på skærmen er
         arrangement omkring den ene ting.

         Et søgefelt i et hjørne siger, at søgning er en funktion. Et felt midt
         på siger, at det er dét, skærmen er til. -->
    <StackPanel Margin="0,0,0,14" HorizontalAlignment="Center">
      <TextBlock Text="{i18n:Oversat searchview.cockpit}" FontSize="26" FontWeight="SemiBold"
                 HorizontalAlignment="Center" />
      <TextBlock Style="{StaticResource Underskrift}" Margin="0,5,0,0"
                 TextAlignment="Center" MaxWidth="620" TextWrapping="Wrap"
                 Text="{i18n:Oversat cockpit.under}" />
    </StackPanel>

    <Border Background="{DynamicResource Panel}" CornerRadius="12"
            BorderBrush="{DynamicResource Accent}" BorderThickness="1" Padding="8"
            MaxWidth="820" HorizontalAlignment="Stretch">
      <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35" Color="#FF000000" />
      </Border.Effect>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                   FontSize="17" VerticalAlignment="Center" Margin="12,0,4,0"
                   Foreground="{DynamicResource Accent}" />

        <TextBox x:Name="Felt" Grid.Column="1" FontSize="18" Padding="10,12"
                 BorderThickness="0" Background="Transparent"
                 TextChanged="Felt_Aendret" KeyDown="Felt_Tast" />
        <TextBlock x:Name="Pladsholder" Grid.Column="1" IsHitTestVisible="False" FontSize="18"
                   Margin="13,0,0,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource TekstMeget}"
                   Text="{i18n:Oversat cockpit.soeg}" />

        <!-- Krydset rydder feltet i ét klik — samme som i udskriftens
             søgefelt, og af samme grund: et søgeord på tyve tegn skal ellers
             slettes tegn for tegn. Escape gør det samme.

             Det er STØRRE her end i udskriften, fordi feltet er større. Et
             kryds på 24 pixel i et felt med 18 punkts tekst ser ud som en
             fejl. -->
        <Button x:Name="Ryd" Grid.Column="2" Content="✕" Click="Ryd_Klik"
                Visibility="Collapsed" Cursor="Hand" FontSize="13"
                Padding="0" BorderThickness="0" Background="Transparent"
                Width="32" Height="32" Margin="0,0,10,0"
                Foreground="{DynamicResource TekstMeget}"
                ToolTip="{i18n:Oversat faelles.ryd_soegningen_escape}">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="flade" CornerRadius="16" Background="Transparent">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="flade" Property="Background" Value="{DynamicResource Svaev}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </Grid>
    </Border>

    <!-- ============ AFGRÆNSNINGEN ============

         Tre felter, og de er alle tre valgt, FØR optagelsen begyndte — mappen,
         mødetypen og sproget vælges i opstartsdialogen. Det er dét, der gør
         dem brugbare fra dag ét: de er ikke noget, man skal gå tilbage og
         udfylde bagefter.

         De står UNDER søgefeltet og ikke ved siden af. Søgefeltet er skærmens
         tyngdepunkt; en række rullelister i samme højde ville gøre det til ét
         felt blandt fire. Her er de en indsnævring af det, man lige har
         skrevet — og de er små, fordi de sjældnere bruges. -->
    <StackPanel HorizontalAlignment="Center" Margin="0,12,0,0">
    <!-- ============ DEN SKAL KUNNE OMBRYDE ============

         Her stod en vandret StackPanel. Den tager sin NATURLIGE bredde og
         bliver ved med at goere det, ogsaa naar spalten er smallere: fire
         rullelister med MinWidth 140, 150, 150 og 130 plus etiket og
         mellemrum er godt 700 pixels, og midterspalten er omkring 570 i et
         vindue paa 1536. Resten laa uden for kortet og blev klippet - baade
         til venstre og til hoejre, saa kassen saa ud til at mangle sine
         kanter.

         En WrapPanel bryder i stedet ned paa en linje mere. Bundmargenen
         staar paa hvert barn og ikke paa panelet, saa den anden linje faar
         luft, uden at der kommer et hul, naar der kun er én. -->
    <WrapPanel HorizontalAlignment="Center">
      <TextBlock Text="{i18n:Oversat searchview.soeg_kun_i}" FontSize="11.5" VerticalAlignment="Center"
                 Margin="0,0,10,6" Foreground="{DynamicResource TekstMeget}" />

      <!-- PERIODEN STÅR FØRST.
           Det er den afgrænsning, der bruges oftest — «hvad talte vi om i
           denne måned» er et almindeligt spørgsmål, «hvad står der på norsk»
           er det ikke. -->
      <ComboBox x:Name="Periodefilter" MinWidth="140" FontSize="12" Padding="8,5"
                Margin="0,0,8,6" SelectionChanged="Periode_Aendret"
                ToolTip="{i18n:Oversat searchview.kun_optagelser_fra_denne_periode}">
        <ComboBox.ItemTemplate>
          <DataTemplate><TextBlock Text="{Binding Navn}" /></DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <ComboBox x:Name="Mappefilter" MinWidth="150" FontSize="12" Padding="8,5"
                Margin="0,0,0,6" SelectionChanged="Filter_Aendret" ToolTip="{i18n:Oversat searchview.kun_optagelser_i_denne_mappe}">
        <ComboBox.ItemTemplate>
          <DataTemplate><TextBlock Text="{Binding Navn}" /></DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <ComboBox x:Name="Typefilter" MinWidth="150" FontSize="12" Padding="8,5" Margin="8,0,0,6"
                SelectionChanged="Filter_Aendret" ToolTip="{i18n:Oversat searchview.kun_optagelser_af_denne_moedetype}">
        <ComboBox.ItemTemplate>
          <DataTemplate><TextBlock Text="{Binding Navn}" /></DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <ComboBox x:Name="Sprogfilter" MinWidth="130" FontSize="12" Padding="8,5" Margin="8,0,0,6"
                SelectionChanged="Filter_Aendret" ToolTip="{i18n:Oversat searchview.kun_optagelser_paa_dette_sprog}">
        <ComboBox.ItemTemplate>
          <DataTemplate><TextBlock Text="{Binding Navn}" /></DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <Button x:Name="RydFilter" Content="{i18n:Oversat searchview.ryd}" Click="RydFilter_Klik" Margin="8,0,0,6"
              Padding="10,5" FontSize="11.5" Visibility="Collapsed"
              ToolTip="{i18n:Oversat searchview.soeg_i_det_hele_igen}" />
    </WrapPanel>

    <!-- ============ DEN VALGTE PERIODE ============
         Kommer først frem, når man vælger «Fra og til» — to datovælgere, der
         altid står fremme, ville fylde en linje for en afgrænsning, der
         sjældent bruges. -->
    <StackPanel x:Name="Datoraekke" Orientation="Horizontal" HorizontalAlignment="Center"
                Margin="0,8,0,0" Visibility="Collapsed">
      <TextBlock Text="{i18n:Oversat searchview.fra}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,7,0"
                 Foreground="{DynamicResource TekstMeget}" />
      <DatePicker x:Name="FraDato" Width="135" FontSize="12"
                  SelectedDateChanged="Dato_Aendret" />

      <TextBlock Text="{i18n:Oversat searchview.til}" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,7,0"
                 Foreground="{DynamicResource TekstMeget}" />
      <DatePicker x:Name="TilDato" Width="135" FontSize="12"
                  SelectedDateChanged="Dato_Aendret" />

      <TextBlock x:Name="Datofejl" FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0"
                 Foreground="{DynamicResource Advarsel}" />
    </StackPanel>
    </StackPanel>

    <TextBlock x:Name="Status" Style="{StaticResource Underskrift}"
               Margin="2,10,2,4" HorizontalAlignment="Center" />
          </StackPanel>

        <Grid Grid.Row="1">

          <!-- Staar der ingenting i soegefeltet, staar der her, hvad der
               bliver soegt i. Kort - det er en oplysning, ikke en skaerm. -->
          <StackPanel x:Name="TomPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                      MaxWidth="440" Margin="24">
            <TextBlock Text="{i18n:Oversat cockpit.tomtitel}" FontSize="16" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="20"
                       TextAlignment="Center" Foreground="{DynamicResource TekstSvag}"
                       Text="{i18n:Oversat cockpit.tomtekst}" />
            <TextBlock FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="19"
                       TextAlignment="Center" Foreground="{DynamicResource TekstMeget}"
                       Text="{i18n:Oversat cockpit.tomfod}" />
          </StackPanel>

          <!-- ============ FANER OG SORTERING ============

               Faner efter TYPE, fordi de tre slags svarer paa hver sit
               spoergsmaal: transkriptionen er, hvad der blev SAGT, noten er,
               hvad DU skrev ned, og dokumentet er, hvad der blev skrevet
               bagefter. Blandet i én liste skal man laese maerkatet paa hver
               eneste raekke for at vide, hvad man kigger paa.

               Fanerne staar kun frem, naar der ER noget at vaelge imellem -
               en faneraekke med ét punkt er ikke et valg. -->
          <DockPanel x:Name="Resultatrude" Visibility="Collapsed">

            <Grid DockPanel.Dock="Top" Margin="10,8,10,6">
              <ItemsControl x:Name="Typefaner" HorizontalAlignment="Left">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Tag="{Binding}" Click="Fane_Klik" Cursor="Hand" Margin="0,0,6,0">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="f" CornerRadius="13" Padding="12,5"
                                  Background="{Binding Flade}" BorderThickness="1"
                                  BorderBrush="{Binding Kant}">
                            <TextBlock Text="{Binding Navn}" FontSize="12"
                                       Foreground="{Binding Skrift}" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="f" Property="BorderBrush"
                                      Value="{DynamicResource Accent}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{i18n:Oversat searchview.sorter}" FontSize="11.5" VerticalAlignment="Center"
                           Margin="0,0,8,0" Foreground="{DynamicResource TekstMeget}" />
                <ComboBox x:Name="Sortering" MinWidth="150" FontSize="12" Padding="8,4"
                          SelectionChanged="Sortering_Aendret">
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Navn}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Grid>

          <ScrollViewer x:Name="Rude" Padding="8,0,8,12"
          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="Liste">
          <ItemsControl.ItemTemplate>
          <DataTemplate>
          <!-- KILDEN ER EN OVERSKRIFT, IKKE EN KNAP.
          Foer var hele kortet klikbart og aabnede filen. Det var
          ikke det, man ville: staar ordet tolv steder, er
          spoergsmaalet hvilket af dem - ikke om filen kan aabnes.
          Nu staar hvert sted som sin egen linje. -->
          <Border CornerRadius="10" Padding="0" Margin="0,0,0,10"
          Background="{DynamicResource Trykket}" BorderThickness="1"
          BorderBrush="{DynamicResource PanelKant}">
          <StackPanel>
          <Grid Margin="14,12,14,8">
          <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" CornerRadius="4" Padding="7,2" Margin="0,0,10,0"
          Background="{DynamicResource Svaev}" VerticalAlignment="Center">
          <TextBlock Text="{Binding Maerkat}" FontSize="10.5" FontWeight="SemiBold"
          Foreground="{Binding Maerkatfarve}" />
          </Border>

          <TextBlock Grid.Column="1" Text="{Binding Overskrift}" FontSize="13.5"
          FontWeight="SemiBold" VerticalAlignment="Center"
          TextTrimming="CharacterEllipsis" />

          <TextBlock Grid.Column="2" Text="{Binding Hoejre}" FontSize="11.5"
          VerticalAlignment="Center" Margin="12,0,0,0"
          Foreground="{DynamicResource TekstMeget}" />
          </Grid>

          <!-- Hvert sted. Nummeret goer det muligt at tale om «det
          tredje sted» og finde tilbage til det. -->
          <ItemsControl ItemsSource="{Binding Steder}" Margin="10,0,10,10">
          <ItemsControl.ItemTemplate>
          <DataTemplate>
          <!-- AutomationProperties.Name skal saettes i haanden.
          Content er et Grid, og saa har knappen intet navn
          - hverken for en skaermlaeser eller for den, der
          proever skaermene af med UI-automatik. Samme
          fejl som menupunktet med maerkatet havde. -->
          <Button Tag="{Binding}" Click="Sted_Klik" Cursor="Hand"
          AutomationProperties.Name="{Binding Uddrag}"
          HorizontalContentAlignment="Stretch" Padding="0"
          BorderThickness="0" Background="Transparent" Margin="0,0,0,3"
          ToolTip="{i18n:Oversat searchview.gaa_til_dette_sted_i_teksten}">
          <Button.Template>
          <ControlTemplate TargetType="Button">
          <Border x:Name="rk" CornerRadius="6" Padding="11,8"
          Background="{DynamicResource Trykket}" BorderThickness="1"
          BorderBrush="Transparent">
          <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="rk" Property="Background" Value="{DynamicResource Svaev}" />
          <Setter TargetName="rk" Property="BorderBrush" Value="{DynamicResource Accent}" />
          </Trigger>
          </ControlTemplate.Triggers>
          </ControlTemplate>
          </Button.Template>

          <Grid>
          <Grid.ColumnDefinitions>
          <ColumnDefinition Width="30" />
          <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding Nummer}" FontSize="11.5"
          Foreground="{DynamicResource TekstMeget}"
          VerticalAlignment="Top" />
          <!-- Det soegte staar GULT, praecis som i
          udskriften. To skaerme, der goer det samme,
          skal se ens ud - ellers leder man efter det
          gule paa den ene og finder det ikke. -->
          <TextBlock Grid.Column="1" FontSize="12.5"
          LineHeight="19" TextWrapping="Wrap"
          Loaded="Uddrag_Ind"
          Foreground="{DynamicResource TekstSvag}" />
          </Grid>
          </Button>
          </DataTemplate>
          </ItemsControl.ItemTemplate>
          </ItemsControl>
          </StackPanel>
          </Border>
          </DataTemplate>
          </ItemsControl.ItemTemplate>
          </ItemsControl>
          </ScrollViewer>
          </DockPanel>

          <StackPanel x:Name="IntetPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
          MaxWidth="520" Visibility="Collapsed">
          <TextBlock x:Name="IntetOverskrift" FontSize="17" FontWeight="SemiBold"
          HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
          <TextBlock x:Name="IntetTekst" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap"
          LineHeight="21" TextAlignment="Center" Foreground="{DynamicResource TekstSvag}" />

          <!-- ============ HVERT ORD FOR SIG ============
          Naar der ikke er noget fund, er spoergsmaalet ikke «findes
          ordene», men HVILKET af dem der staar i vejen. Uden den her
          liste maa man selv proeve sig frem ét ord ad gangen — og det
          er praecis dét, appen kan goere paa fire millisekunder. -->
          <ItemsControl x:Name="Enkeltvis" Margin="0,16,0,0" HorizontalAlignment="Center">
          <ItemsControl.ItemTemplate>
          <DataTemplate>
          <Border Background="{DynamicResource Trykket}" BorderBrush="{DynamicResource PanelKant}"
          BorderThickness="1" CornerRadius="6" Padding="12,7" Margin="0,0,0,6">
          <Grid MinWidth="360">
          <TextBlock Text="{Binding Ord}" FontSize="12.5" FontWeight="SemiBold"
          HorizontalAlignment="Left" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Hvor}" FontSize="12" Margin="0,0,80,0"
          HorizontalAlignment="Right" VerticalAlignment="Center"
          Foreground="{DynamicResource TekstMeget}" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
          VerticalAlignment="Center">
          <!-- «RET ORDET» STAAR KUN VED DE ORD, DER IKKE FINDES.
          Et ord, der ikke staar ét eneste sted i alt, appen har skrevet
          ud, er som regel ikke et sjaeldent ord - det er et ord, der er
          hoert forkert. En knap ved HVERT ord ville vaere stoej; en knap
          ved dét ord, der staar i vejen, er et svar. -->
          <Button Content="{i18n:Oversat searchview.ret_ordet}" Tag="{Binding Ord}"
          Click="Ret_Klik" Visibility="{Binding RetVis}"
          Padding="9,3" FontSize="11" Margin="0,0,6,0" />
          <Button Content="{i18n:Oversat searchview.soeg_kun_her}" Tag="{Binding Ord}" Click="KunDet_Klik"
          Padding="9,3" FontSize="11" />
          </StackPanel>
          </Grid>
          </Border>
          </DataTemplate>
          </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- ============ LAER ORDBOGEN OP, HVOR FEJLEN SES ============
          Ordbogen kunne kun laeres op paa sin egen skaerm - man skulle huske
          stavemaaden, gaa derhen og skrive den ind. En rettelse, der kraever,
          at man forlader dét, man er i gang med, bliver ikke lavet. -->
          <Border x:Name="Retrude" Visibility="Collapsed" Margin="0,10,0,0"
          Background="{DynamicResource Panel}" CornerRadius="8" Padding="14,11"
          BorderBrush="{DynamicResource Accent}" BorderThickness="1">
          <StackPanel>
          <TextBlock x:Name="Rettitel" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
          <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="Retfelt" Padding="9,6" KeyDown="Retfelt_Tast" />
          <Button Grid.Column="1" Margin="8,0,0,0" Padding="14,6" Click="RetGem_Klik"
          Content="{i18n:Oversat searchview.ret_gem}" />
          </Grid>
          <TextBlock x:Name="Retsvar" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
          Foreground="{DynamicResource TekstSvag}" />
          </StackPanel>
          </Border>

          <TextBlock FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="19"
          TextAlignment="Center" Foreground="{DynamicResource TekstMeget}"
          Text="{i18n:Oversat searchview.husk_at_et_moede_foerst_kan_soeges_naar_de}" />
          </StackPanel>
        </Grid>
        </Grid>
      </Border>

      <GridSplitter x:Name="HoejreSplitter" Grid.Column="3" Width="14" HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" Background="Transparent"
                    DragCompleted="Spalte_Trukket"
                    ToolTip="{i18n:Oversat faelles.traek_for_at_aendre_bredden}" />

      <!-- ============ HØJRE: DET, DER SKAL GØRES ============

           Opgaverne har hele hoejden nu. Kalenderen laa nedenunder og er
           flyttet til venstre spalte: den ene er hvad, den anden er hvornaar,
           og de to laeses ikke i samme oejeblik. -->
      <Grid x:Name="HoejreRude" Grid.Column="4">
        <Border Background="{DynamicResource Panel}" CornerRadius="10"
                BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
          <DockPanel>
            <!-- Samme som kalenderen. Opgaverne fra Google henter sig
                 heller ikke selv, og de kommer fra en HELT anden godkendelse
                 - saa de skal kunne hentes hver for sig. -->
            <StackPanel DockPanel.Dock="Top" Margin="14,13,14,8">
              <Grid>
                <TextBlock x:Name="OpgaveOverskrift" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                  <!-- HER STOD «6 i alt fra 1 optagelser» MED SVAG SKRIFT.

                       Den er vaek 31-08-2026, og af to grunde.

                       Den var ulaeselig - saa svag, at man ikke kunne se, hvad
                       der stod, uden at gaa taet paa skaermen. Og den var
                       forkert: flere af opgaverne er skrevet i haanden eller
                       hentet fra Google Tasks og kommer slet ikke fra en
                       optagelse. «fra 1 optagelser» talte kun de moeder, der
                       tilfaeldigvis havde afsat en opgave.

                       Tallet staar nu i overskriften, praecis som kalenderen
                       goer det ved siden af: «Opgaver - 6». -->

                  <!-- «NY OPGAVE» STAAR, HVOR «NY AFTALE» STAAR.
                       Man kunne laegge en aftale ind i haanden, men ikke en
                       opgave - appen kunne kun vise dem, den selv havde fundet
                       i et moede, eller dem, Google havde. En opgave bliver
                       til paa vej hjem og midt i en mail, og saa skal der
                       vaere et sted at skrive den. -->
                  <Button Content="{i18n:Oversat opgaver.nyopgave}" Click="NyOpgave_Klik"
                          VerticalAlignment="Center" Padding="10,3" FontSize="11"
                          Margin="8,0,0,0" />

                  <Button x:Name="Opgavesynk" Click="Opgavesynk_Klik"
                          Style="{StaticResource IkonKnap}" Margin="6,0,0,0"
                          Visibility="Collapsed"
                          AutomationProperties.Name="{i18n:Oversat opgaver.hentopgaver}"
                          ToolTip="{i18n:Oversat opgaver.hentopgaverhjaelp}">
                    <TextBlock x:Name="Opgavesynkglyf" Text="&#xE895;"
                               FontFamily="Segoe MDL2 Assets" FontSize="13" />
                  </Button>
                </StackPanel>
              </Grid>

              <TextBlock x:Name="Opgavesynklinje" FontSize="11" Margin="0,4,0,0"
                         Visibility="Collapsed" TextWrapping="Wrap"
                         Foreground="{DynamicResource TekstMeget}" />
            </StackPanel>

            <ScrollViewer Padding="7,0,7,10" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <ItemsControl x:Name="Opgaverude">
                <ItemsControl.ItemTemplate>
                <DataTemplate>
                <!-- FARVEN KOMMER FRA FRISTEN, IKKE FRA PRIORITETEN.
                En prioritet 1 om tre uger haster ikke i dag; en
                prioritet 3, der skulle have været lavet i mandags,
                gør. Kanten svarer på «hvad nu», tallet på «hvad er
                vigtigst, når jeg har tid til ét af dem». -->
                <!-- HELE KORTET ER KLIKBART.
                     Her stod en «Mere»-knap. Den fyldte en linje i en smal
                     spalte for at goere det, kortet lige saa godt kan goere
                     selv - og en knap, der aabner det, man lige har trykket
                     paa, er et led for meget.

                     Fluebenet, prioriteten og herkomstlinket ligger inden i.
                     De haandterer selv deres klik og markerer dem som
                     behandlede, saa de naar aldrig herud. -->
                <Border Background="{DynamicResource Trykket}" BorderBrush="{Binding Farve}"
                BorderThickness="3,0,0,0" CornerRadius="6"
                Padding="13,10" Margin="0,0,0,6"
                Opacity="{Binding Daempning}"
                Tag="{Binding}" MouseLeftButtonUp="Opgave_Aabn"
                Cursor="Hand" ToolTip="{i18n:Oversat searchview.aabn_opgaven}">
                <Grid>
                <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" IsChecked="{Binding Faerdig, Mode=TwoWay}"
                VerticalAlignment="Top" Margin="0,1,10,0"
                ToolTip="{i18n:Oversat searchview.saet_flueben_naar_den_er_gjort}" />

                <StackPanel Grid.Column="1">

                <!-- HOEJST TO LINJER.
                     En liste, der viser alt, kan ikke skimmes: fem opgaver paa
                     fire linjer hver fylder en skaerm, og saa er overblikket
                     vaek - og overblikket er hele grunden til, at de staar i
                     Cockpittet.

                     WPF's TextBlock har ingen MaxLines. To linjer er derfor
                     LineHeight gange to som MaxHeight, og TextTrimming saetter
                     prikkerne paa den sidste. De to tal HAENGER SAMMEN -
                     aendrer man LineHeight, skal MaxHeight foelge med. -->
                <TextBlock Text="{Binding Navn}" FontSize="12.5" TextWrapping="Wrap"
                LineHeight="19" MaxHeight="38" TextTrimming="CharacterEllipsis" />


                <!-- HERKOMSTEN ER ET LINK, IKKE EN OPLYSNING.
                En opgave uden vej tilbage til det, der blev sagt,
                er et notat. Med linket kan man høre sætningen
                igen og se, om den blev forstået rigtigt — og det
                er hele grunden til, at appen findes. -->
                <!-- WrapPanel og ikke StackPanel. Spalten er smal, og
                     herkomsten kan vaere lang; med en vandret stak blev
                     «Mere» skubbet ud over kanten og var der bare ikke. -->
                <WrapPanel Margin="0,4,0,0">

                <!-- HERKOMSTEN ER ET LINK, NAAR DER ER NOGET AT GAA TILBAGE
                     TIL. En opgave, man selv har skrevet, har ingen replik at
                     hoere igen - saa staar den som en oplysning i graat. Et
                     blaat link, der aabner «findes ikke laengere», faar noget
                     helt normalt til at se ud som et tab. -->
                <Button Content="{Binding Under}" Tag="{Binding}" Click="Opgave_Klik"
                Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                FontSize="11" Foreground="{DynamicResource Accent}"
                Visibility="{Binding Linkvis}"
                ToolTip="{i18n:Oversat searchview.gaa_til_det_sted_i_transkriptionen_opgaven}">
                <Button.Template>
                <ControlTemplate TargetType="Button">
                <TextBlock Text="{TemplateBinding Content}" FontSize="11"
                Foreground="{TemplateBinding Foreground}"
                TextWrapping="Wrap" />
                </ControlTemplate>
                </Button.Template>
                </Button>

                <TextBlock Text="{Binding Under}" FontSize="11" TextWrapping="Wrap"
                Visibility="{Binding Kildevis}"
                Foreground="{DynamicResource TekstMeget}" />
                </WrapPanel>
                </StackPanel>

                <Border Grid.Column="2" CornerRadius="4" Padding="7,2" Margin="10,0,0,0"
                VerticalAlignment="Top" Background="{DynamicResource Svaev}"
                Visibility="{Binding Fristvis}">
                <TextBlock Text="{Binding Frist}" FontSize="11.5" FontWeight="SemiBold"
                Foreground="{Binding Fristfarve}" />
                </Border>

                <ComboBox Grid.Column="3" x:Name="Pri" Width="62" Margin="8,0,0,0"
                FontSize="11" VerticalAlignment="Top"
                SelectedIndex="{Binding Prioritetsvalg, Mode=TwoWay}"
                ToolTip="{i18n:Oversat searchview.prioritet_1_er_vigtigst}">
                <ComboBoxItem Content="–" />
                <ComboBoxItem Content="1" />
                <ComboBoxItem Content="2" />
                <ComboBoxItem Content="3" />
                </ComboBox>
                </Grid>
                </Border>
                </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="IngenOpgaver" FontSize="13" Margin="6,10,6,0" TextWrapping="Wrap"
                LineHeight="21" Foreground="{DynamicResource TekstSvag}"
                Visibility="Collapsed"
                Text="{i18n:Oversat searchview.der_er_ingen_aabne_opgaver_de_kommer_fra_f}" />
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

      </Grid>
    </Grid>
  </Grid>
</UserControl>
