<Window x:Class="NoteApp.Desktop.Search.OpgaveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:NoteApp.Desktop"
        Title="Opgave"
        Width="720" Height="620" MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Baggrund}"
        WindowStyle="ToolWindow">

  <!-- ======================== ÉN OPGAVE ========================

       DEN FINDES, FORDI LISTEN IKKE ER ET ARBEJDSBORD.

       I Cockpittet staar opgaven paa hoejst to linjer, saa tyve opgaver kan
       skimmes. Men en opgave fra en transkription er en hel saetning, som
       nogen sagde - og skal den rettes, skal der vaere plads til at laese den
       og skrive i den.

       DEN KAN AENDRE STOERRELSE, i modsaetning til de fleste andre vinduer i
       appen. Beskrivelsen er det eneste sted i programmet, hvor brugeren
       skriver fritekst af ukendt laengde, og et fast vindue ville enten vaere
       for stort til en linje eller for lille til ti. -->

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <!-- OVERSKRIFTEN HAR ET NAVN, fordi det samme vindue bruges til at
           OPRETTE en opgave. «Opgave» over et tomt felt ser ud som en opgave,
           der er gaaet tabt. -->
      <TextBlock x:Name="Overskrift" Text="{i18n:Oversat opgavewindow.opgave}"
                 FontSize="19" FontWeight="SemiBold" />
      <TextBlock x:Name="Herkomst" Style="{StaticResource Underskrift}"
                 Margin="0,4,0,0" TextWrapping="Wrap" />
    </StackPanel>

    <!-- NAVNET OEVERST. Det er dét, listen viser, og dét, man genkender
         opgaven paa. Staar det nederst, bliver det aldrig rettet. -->
    <StackPanel Grid.Row="1" Margin="0,18,0,0">
      <TextBlock Text="{i18n:Oversat opgavewindow.kort_navn}" FontSize="10.5" FontWeight="SemiBold"
                 Margin="2,0,0,6" Foreground="{DynamicResource TekstMeget}" />
      <TextBox x:Name="Navn" FontSize="14" Padding="10,8" />
      <TextBlock FontSize="11" Margin="2,5,0,0" TextWrapping="Wrap"
                 Foreground="{DynamicResource TekstMeget}"
                 Text="{i18n:Oversat opgavewindow.det_der_staar_paa_listen_i_cockpittet_hold}" />
    </StackPanel>

    <TextBlock Grid.Row="2" Text="{i18n:Oversat opgavewindow.beskrivelse}" FontSize="10.5" FontWeight="SemiBold"
               Margin="2,18,0,6" Foreground="{DynamicResource TekstMeget}" />

    <!-- HELE HOEJDEN. Det er den, vinduet er aabnet for. -->
    <TextBox x:Name="Beskrivelse" Grid.Row="3" FontSize="13.5" Padding="10,8"
             TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="False"
             VerticalScrollBarVisibility="Auto"
             VerticalContentAlignment="Top" />

    <!-- FRIST OG PRIORITET STAAR HER OGSAA.
         Har man foerst aabnet opgaven for at rette teksten, er det tit fordi
         noget har aendret sig - og saa er fristen som regel det naeste, der
         skal flyttes. At skulle lukke vinduet for at rette et tal ved siden af
         er en omvej uden grund. -->
    <Grid Grid.Row="4" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="{i18n:Oversat opgavewindow.frist}" FontSize="10.5" FontWeight="SemiBold"
                   Margin="2,0,0,6" Foreground="{DynamicResource TekstMeget}" />
        <DatePicker x:Name="Frist" Width="150" FontSize="12.5" />

        <!-- EN LAAST DATOVAELGER SER UD SOM NOGET, DER ER GAAET I STYKKER.
             Den staar som en graa kasse midt i en moerk skaerm - samme fejl
             som paa aftalen, og samme svar: naar den ikke kan rettes, staar
             datoen som tekst i stedet. -->
        <TextBlock x:Name="Fristtekst" FontSize="13.5" Width="150"
                   Visibility="Collapsed" Margin="0,6,0,0"
                   Foreground="{DynamicResource Tekst}" />
      </StackPanel>

      <StackPanel Grid.Column="2">
        <TextBlock Text="{i18n:Oversat opgavewindow.prioritet}" FontSize="10.5" FontWeight="SemiBold"
                   Margin="2,0,0,6" Foreground="{DynamicResource TekstMeget}" />
        <ComboBox x:Name="Prioritet" Width="130" FontSize="12.5" Padding="8,5"
                  ToolTip="{i18n:Oversat opgavewindow.1_er_vigtigst}">
          <ComboBoxItem Content="{i18n:Oversat opgavewindow.ikke_sat}" />
          <ComboBoxItem Content="{i18n:Oversat opgavewindow.1_vigtigst}" />
          <ComboBoxItem Content="2" />
          <ComboBoxItem Content="3" />
        </ComboBox>
      </StackPanel>

      <CheckBox x:Name="Faerdig" Grid.Column="4" VerticalAlignment="Bottom"
                Margin="0,0,0,7" FontSize="12.5"
                Content="{i18n:Oversat opgavewindow.opgaven_er_gjort}" />
    </Grid>

    <StackPanel Grid.Row="5" Margin="0,16,0,0">

      <!-- NOTET HAR SIN EGEN PLADS.
           Det laa i SAMME celle som knapperne, venstrestillet, og loeb ind
           under dem: «her kan du saette prioritet o…» og saa var resten vaek.
           En forklaring, man ikke kan laese til ende, er ikke en forklaring. -->
      <!-- ============ SKAL DEN OP I GOOGLE? ============
           Alt, appen finder i et møde, skal ikke ende i nogens telefon — de
           fleste opgaver fra et møde er noter til en selv. Derfor et hak på
           den enkelte opgave frem for en indstilling, der gælder alle. -->
      <CheckBox x:Name="TilGoogle" Margin="2,0,2,10" FontSize="13"
                VerticalContentAlignment="Center"
                Checked="TilGoogle_Skiftet" Unchecked="TilGoogle_Skiftet"
                Content="{i18n:Oversat opgavewindow.laeg_op_i_google_tasks}" />

      <TextBlock x:Name="Googlenote" FontSize="11.5" TextWrapping="Wrap"
                 LineHeight="18" Visibility="Collapsed" Margin="2,0,2,12"
                 Foreground="{DynamicResource TekstMeget}" />

      <!-- ============ HVILKEN AF LISTERNE? ============
           Google har mindst én liste og tit flere - «Mine opgaver» ved siden
           af én til studiet og én til huset. Ramte alt fra HeyPia altid den
           foerste, ville opgaverne herfra ligge et andet sted end dem, man
           skriver paa telefonen, og saa er der to lister igen.

           DEN STAAR INDRYKKET UNDER HAKKET og vises kun sammen med det:
           uden hakket er der ingen liste at vaelge imellem, og et doedt felt
           er et spoergsmaal om hvorfor. Samme moenster som undervalgene paa
           en aftale.

           Kan listerne ikke hentes, staar valget der slet ikke. Opgaven kan
           stadig laegges op - den havner saa i den liste, Google selv melder
           foerst - og et vindue, der naegter at gemme, fordi nettet er nede,
           er den forkerte afhaengighed. -->
      <StackPanel x:Name="Listerude" Margin="24,0,2,12" Visibility="Collapsed">
        <TextBlock Text="{i18n:Oversat opgavewindow.liste}" FontSize="10.5" FontWeight="SemiBold"
                   Margin="2,0,0,6" Foreground="{DynamicResource TekstMeget}" />
        <ComboBox x:Name="Listevalg" Width="260" HorizontalAlignment="Left"
                  FontSize="12.5" Padding="8,5"
                  ToolTip="{i18n:Oversat opgavewindow.hvilken_liste}">
          <ComboBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding Navn}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <!-- To spalter frem for et overlap. Med Left og Right i den samme celle
           er det bredden paa dagen, der afgoer, om teksten kan laeses. -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="Fejl" Grid.Column="0" FontSize="12" TextWrapping="Wrap"
                   VerticalAlignment="Center" Margin="2,0,14,0"
                   Foreground="{DynamicResource Advarsel}" />

        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <!-- SLET STAAR YDERST TIL VENSTRE, VAEK FRA «Gem og luk».
               De to er naboer i tid - man aabner opgaven, retter, og trykker
               - og en sletteknap ved siden af den, man altid trykker paa, er
               en fejl, der venter paa at ske. Den er roed, saa den heller
               ikke laeses forkert.

               Skjult paa en NY opgave. Der er ikke noget at slette endnu, og
               en knap, der ikke goer noget, er stoej. -->
          <Button x:Name="SletKnap" Content="{i18n:Oversat opgavewindow.slet}"
                  Click="Slet_Klik" Padding="18,8" Margin="0,0,24,0"
                  Style="{StaticResource Fare}"
                  ToolTip="{i18n:Oversat opgavewindow.slet_hjaelp}" />
          <Button Content="{i18n:Oversat opgavewindow.luk}" Click="Luk_Klik" Padding="18,8" Margin="0,0,10,0"
                  ToolTip="{i18n:Oversat opgavewindow.lukker_uden_at_gemme}" />
          <Button Content="{i18n:Oversat opgavewindow.gem_og_luk}" Click="Gem_Klik" Padding="20,8"
                  Style="{StaticResource Primaer}" IsDefault="True" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </Grid>
</Window>
