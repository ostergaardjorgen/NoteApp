<Window x:Class="NoteApp.Desktop.Search.Oversigtsvindue"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:NoteApp.Desktop"
        Width="760" Height="720" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Baggrund}"
        Title="{i18n:Oversat oversigt.alle_aftaler}">

  <!-- ==================== HELE LISTEN, ÉT STED ====================

       Kalenderen og opgaverne i Cockpittet er en PÅMINDELSE: det, der er lige
       om lidt, og det, der skal gøres. De skal kunne skimmes på et sekund, og
       derfor kan de ikke også være arkivet.

       Her er arkivet. Alt, grupperet efter måned, med et søgefelt over.

       ÉT VINDUE TIL BEGGE. Aftaler og opgaver er forskellige ting, men
       spørgsmålet er det samme — «hvad har jeg, og hvornår» — og et vindue,
       der ser ens ud begge steder, skal kun læres én gang. Kalderen fylder
       punkterne i; vinduet ved ikke, hvad de er.  -->

  <Grid Margin="22,18,22,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock x:Name="Overskrift" Style="{StaticResource Overskrift}" />
      <TextBlock x:Name="Underskrift" Style="{StaticResource Underskrift}" TextWrapping="Wrap" />
    </StackPanel>

    <!-- SØGEFELTET STÅR ØVERST OG HAR FOKUS FRA START. Man åbner vinduet for
         at finde noget bestemt; er der ikke noget bestemt, er der listen
         nedenunder. -->
    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBox x:Name="Felt" Grid.Column="0" Padding="10,8" FontSize="13"
               TextChanged="Felt_Aendret" />

      <TextBlock x:Name="Pladsholder" Grid.Column="0" IsHitTestVisible="False"
                 Margin="13,0,0,0" VerticalAlignment="Center" FontSize="13"
                 Foreground="{DynamicResource TekstMeget}"
                 Text="{i18n:Oversat oversigt.soeg}" />

      <TextBlock x:Name="Antal" Grid.Column="1" VerticalAlignment="Center"
                 Margin="14,0,0,0" FontSize="12"
                 Foreground="{DynamicResource TekstMeget}" />
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource Panel}" CornerRadius="10"
            BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
      <Grid>
        <TextBlock x:Name="IngenTraef" Margin="20" TextWrapping="Wrap" LineHeight="21"
                   Visibility="Collapsed" Foreground="{DynamicResource TekstSvag}"
                   Text="{i18n:Oversat oversigt.intet}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
          <ItemsControl x:Name="Rude" Margin="14,12,14,14">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel>

                  <!-- MÅNEDEN STÅR ÉN GANG. Samme greb som kalenderens
                       dagsoverskrift: fire oplysninger på hver linje kan ikke
                       skimmes, én overskrift pr. gruppe kan. -->
                  <TextBlock Text="{Binding Gruppe}" FontSize="12.5" FontWeight="SemiBold"
                             Margin="2,10,0,6" Visibility="{Binding Gruppevis}"
                             Foreground="{DynamicResource TekstMeget}" />

                  <Border Background="{DynamicResource Trykket}"
                          BorderBrush="{DynamicResource PanelKant}"
                          BorderThickness="1" CornerRadius="6" Margin="0,0,0,5"
                          Tag="{Binding}" MouseLeftButtonUp="Punkt_Klik"
                          Cursor="Hand" ToolTip="{Binding Boble}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>

                      <Border Grid.Column="0" Background="{Binding Farve}"
                              CornerRadius="5,0,0,5" />

                      <Grid Grid.Column="1" Margin="13,9,13,9">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="112" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Naar}" FontSize="12"
                                   FontFamily="Consolas" VerticalAlignment="Top"
                                   Margin="0,0,12,0"
                                   Foreground="{DynamicResource TekstSvag}" />

                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Titel}" FontSize="12.5"
                                     TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Under}" FontSize="11"
                                     Margin="0,3,0,0" TextWrapping="Wrap"
                                     Visibility="{Binding Undervis}"
                                     Foreground="{DynamicResource TekstMeget}" />
                        </StackPanel>
                      </Grid>
                    </Grid>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,14,0,0">
      <Button Content="{i18n:Oversat faelles.luk}" Click="Luk_Klik" Padding="20,8"
              IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
