<UserControl x:Class="NoteApp.Desktop.Diktering.ProeverumView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:NoteApp.Desktop"
             Background="{DynamicResource Baggrund}">

  <!-- PRØVERUMMET.

       Man kan laese sig til, hvad en teksttype goer. Man kan ikke laese sig
       til, hvordan éns EGEN maade at tale paa ser ud, naar den er skrevet
       ud og pudset af - og det er dét, der afgoer, om instruktionen skal
       rettes.

       Her taler man ind, ser begge tekster ved siden af hinanden, og skifter
       type uden at forlade skaermen. Er resultatet ikke det oenskede, er
       instruktionen een fane til hoejre.

       TEKSTEN LANDER HER OG INGEN ANDRE STEDER. Der saettes ikke ind i noget
       program, og udklipsholderen roeres ikke - se Dikteringsvagt.Proeve.
       Man proever netop, fordi man ikke er sikker paa, hvad der kommer ud. -->

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="{i18n:Oversat proeverum.titel}" Style="{StaticResource Overskrift}" />
      <TextBlock Style="{StaticResource Underskrift}" TextWrapping="Wrap" MaxWidth="860"
                 HorizontalAlignment="Left"
                 Text="{i18n:Oversat proeverum.under}" />
    </StackPanel>

    <!-- Typevalget staar OEVER felterne: man vaelger, hvad man proever, foer
         man taler - ikke bagefter. -->
    <Border Grid.Row="1" Background="{DynamicResource Panel}" CornerRadius="10" Padding="16,14"
            Margin="0,0,0,14" BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
      <StackPanel>
        <TextBlock Style="{StaticResource Underskrift}" Margin="0,0,0,8"
                   Text="{i18n:Oversat proeverum.vaelg_type}" />

        <ItemsControl x:Name="Typer">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <RadioButton GroupName="teksttype" Margin="0,0,22,0" Checked="Type_Valgt"
                           Tag="{Binding Vaerdi}" IsChecked="{Binding Valgt, Mode=OneTime}">
                <StackPanel>
                  <TextBlock Text="{Binding Navn}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Hvornaar}" FontSize="11.5" MaxWidth="240"
                             TextWrapping="Wrap" Foreground="{DynamicResource TekstMeget}" />
                </StackPanel>
              </RadioButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Background="{DynamicResource AccentFlade}" CornerRadius="10" Padding="16,12"
            Margin="0,0,0,14" BorderBrush="{DynamicResource Accent}" BorderThickness="1">
      <StackPanel Orientation="Horizontal">
        <Ellipse x:Name="Prik" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,12,0"
                 Fill="{DynamicResource Optager}" />
        <TextBlock x:Name="Besked" VerticalAlignment="Center" TextWrapping="Wrap"
                   Foreground="{DynamicResource Tekst}" />
      </StackPanel>
    </Border>

    <!-- BEGGE TEKSTER, SIDE OM SIDE. Den raa viser, hvad der blev HOERT; den
         pudsede, hvad instruktionen gjorde ved det. Er kun den ene der, ved
         man ikke, om en fejl kom fra mikrofonen eller fra sprogmodellen. -->
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Margin="0,0,8,0">
        <TextBlock Style="{StaticResource Underskrift}" Margin="0,0,0,4"
                   Text="{i18n:Oversat proeverum.raa}" />
      </StackPanel>

      <StackPanel Grid.Column="1" Margin="8,0,0,0">
        <TextBlock Style="{StaticResource Underskrift}" Margin="0,0,0,4"
                   Text="{i18n:Oversat proeverum.pudset}" />
      </StackPanel>

      <TextBox x:Name="Raa" Grid.Column="0" Margin="0,24,8,0" IsReadOnly="True"
               AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
               Padding="12,10" Background="{DynamicResource Panel}" />

      <TextBox x:Name="Pudset" Grid.Column="1" Margin="8,24,0,0" IsReadOnly="True"
               AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
               Padding="12,10" Background="{DynamicResource Panel}"
               FontWeight="Normal" />
    </Grid>
  </Grid>
</UserControl>
