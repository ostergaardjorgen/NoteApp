<UserControl x:Class="NoteApp.Desktop.Diktering.KommandoerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:NoteApp.Desktop"
             Background="{DynamicResource Baggrund}">

  <!-- KOMMANDOERNE ER EN HVIDLISTE, OG DEN ER BRUGERENS EGEN.

       Der kan ikke koere noget, som ikke staar paa listen. Det er ikke en
       foranstaltning mod ondskab - det er brugerens egen maskine og hans egne
       kommandoer - men mod FEJLHOERING: en saetning i et moede maa aldrig
       kunne blive til «aabn regnskabet».

       Derfor er tolken strengere end ordbogens retter: hele udtrykket skal
       genkendes, og passer to lige godt, sker der ingenting. Se
       Kommandotolk. -->

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="24,20,24,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="0,0,0,14">
        <TextBlock Text="{i18n:Oversat kommandoer.titel}" Style="{StaticResource Overskrift}" />
        <TextBlock Style="{StaticResource Underskrift}" TextWrapping="Wrap" MaxWidth="820"
                   HorizontalAlignment="Left" Text="{i18n:Oversat kommandoer.under}" />
      </StackPanel>

      <!-- ==================== VÅGEORDET ==================== -->
      <Border Grid.Row="1" Background="{DynamicResource Panel}" CornerRadius="10" Padding="20"
              Margin="0,0,0,14" BorderBrush="{DynamicResource PanelKant}" BorderThickness="1"
              HorizontalAlignment="Left" MaxWidth="900">
        <StackPanel>
          <CheckBox x:Name="VaageordTil" Click="VaageordTil_Klik"
                    Content="{i18n:Oversat kommandoer.vaageord_til}" FontWeight="SemiBold" />
          <TextBlock Style="{StaticResource Underskrift}" Margin="0,6,0,0" TextWrapping="Wrap"
                     Text="{i18n:Oversat kommandoer.vaageord_til_under}" />

          <TextBlock x:Name="IngenMotor" Margin="0,10,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource Advarsel}" Visibility="Collapsed"
                     Text="{i18n:Oversat kommandoer.vaageord_ingen_motor}" />

          <TextBlock Style="{StaticResource Underskrift}" Margin="0,16,0,4"
                     Text="{i18n:Oversat kommandoer.vaageord_ord}" />
          <TextBox x:Name="Ord" AcceptsReturn="True" MinHeight="52" Padding="10,8"
                   TextWrapping="NoWrap" LostFocus="Ord_Forladt" />
          <TextBlock Style="{StaticResource Underskrift}" Margin="0,4,0,0" TextWrapping="Wrap"
                     Text="{i18n:Oversat kommandoer.vaageord_ord_under}" />

          <!-- ============ SIG DET SELV ============

               Motoren sammenligner det, den hoerer, med de BOGSTAVER, der
               staar paa listen. Hoerer den din stemme som «hej bia», og staar
               der «hej pia», rammer den skaevt hver gang.

               Maalt 31-08-2026: en diktering landede som «Hej Bia», og
               brugerens «Hej Pia» blev bedoemt til 0,109 og 0,141 - under
               graensen, saa der skete ingenting.

               Herfra spoerges der i stedet: sig ordet tre gange, lad motoren
               skrive det ned, og laeg DEN stavemaade paa listen. Saa
               sammenligner den med sig selv.

               DET SKER PAA MASKINEN. Klippene skrives ud lokalt og slettes
               bagefter. En stemmeproeve er noget af det mest personlige, der
               findes. -->
          <Border Background="{DynamicResource Baggrund}" CornerRadius="8" Padding="16,12"
                  Margin="0,14,0,0" BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="{i18n:Oversat kommandoer.laer_overskrift}" FontWeight="SemiBold" />
              <TextBlock Style="{StaticResource Underskrift}" Margin="0,6,0,12" TextWrapping="Wrap"
                         Text="{i18n:Oversat kommandoer.laer_under}" />

              <StackPanel Orientation="Horizontal">
                <Button x:Name="LaerKnap" Click="Laer_Klik" Padding="14,7"
                        Content="{i18n:Oversat kommandoer.laer_knap}" />
                <TextBlock x:Name="LaerStatus" VerticalAlignment="Center" Margin="12,0,0,0"
                           FontSize="12.5" TextWrapping="Wrap" MaxWidth="480"
                           Foreground="{DynamicResource TekstSvag}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- ==================== HVORNÅR OG HVAD DET KOSTER ====================

               HER LAA ET VINDUE PAA TI MINUTTER OM HVER AFTALE. Det var en
               omvej: man siger «Hej Pia», naar man har brug for det, og det
               foelger ikke moedernes tidsplan.

               I stedet staar der nu, hvad der faktisk sker - og hvad det
               koster. Tallet er MAALT paa processen, ikke paastaaet. -->
          <Border Background="{DynamicResource Baggrund}" CornerRadius="8" Padding="16,12"
                  Margin="0,16,0,0" BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="{i18n:Oversat kommandoer.hvornaar}" FontWeight="SemiBold"
                         Margin="0,0,0,6" />
              <TextBlock Style="{StaticResource Underskrift}" TextWrapping="Wrap"
                         Text="{i18n:Oversat kommandoer.hvornaar_under}" />

              <TextBlock Text="{i18n:Oversat kommandoer.privatliv}" FontWeight="SemiBold"
                         Margin="0,14,0,6" />
              <TextBlock Style="{StaticResource Underskrift}" TextWrapping="Wrap"
                         Text="{i18n:Oversat kommandoer.privatliv_under}" />

              <TextBlock Text="{i18n:Oversat kommandoer.forbrug}" FontWeight="SemiBold"
                         Margin="0,14,0,6" />
              <TextBlock x:Name="Forbrug" TextWrapping="Wrap"
                         Foreground="{DynamicResource Godkendt}" FontWeight="SemiBold" />
              <TextBlock Style="{StaticResource Underskrift}" Margin="0,3,0,0" TextWrapping="Wrap"
                         Text="{i18n:Oversat kommandoer.forbrug_under}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- ==================== LISTEN ==================== -->
      <Border Grid.Row="2" Background="{DynamicResource Panel}" CornerRadius="10" Padding="20"
              Margin="0,0,0,14" BorderBrush="{DynamicResource PanelKant}" BorderThickness="1"
              HorizontalAlignment="Left" MaxWidth="900">
        <StackPanel>
          <Border Background="{DynamicResource AdvarselFlade}" CornerRadius="8" Padding="14,10"
                  Margin="0,0,0,14" BorderBrush="{DynamicResource Advarsel}" BorderThickness="1">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Tekst}"
                       Text="{i18n:Oversat kommandoer.advarsel}" />
          </Border>

          <ListBox x:Name="Liste" MaxHeight="240" Margin="0,0,0,12"
                   Background="{DynamicResource Baggrund}"
                   BorderBrush="{DynamicResource FeltKant}" BorderThickness="1">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="4,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding Udtryk}" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding Beskrivelse}" FontSize="12"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource TekstMeget}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="240" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Underskrift}"
                       Margin="0,0,0,4" Text="{i18n:Oversat kommandoer.udtryk}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Underskrift}"
                       Margin="10,0,0,4" Text="{i18n:Oversat kommandoer.type}" />

            <TextBox x:Name="NytUdtryk" Grid.Row="1" Grid.Column="0" Padding="10,8"
                     KeyDown="NytUdtryk_Tast" />
            <ComboBox x:Name="NyType" Grid.Row="1" Grid.Column="1" Margin="10,0,0,0"
                      SelectionChanged="NyType_Valgt">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Navn}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <StackPanel x:Name="Maalpanel" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
              <TextBlock Style="{StaticResource Underskrift}" Margin="0,0,0,4"
                         Text="{i18n:Oversat kommandoer.maal}" />
              <TextBox x:Name="NytMaal" Padding="10,8" />
              <TextBlock Style="{StaticResource Underskrift}" Margin="0,4,0,0" TextWrapping="Wrap"
                         Text="{i18n:Oversat kommandoer.maal_hjaelp}" />
            </StackPanel>
          </Grid>

          <StackPanel Orientation="Horizontal">
            <Button x:Name="Tilfoej" Click="Tilfoej_Klik" Padding="16,9" BorderThickness="0"
                    FontWeight="SemiBold" Margin="0,0,8,0"
                    Background="{DynamicResource Accent}" Foreground="{DynamicResource PaaAccent}"
                    Content="{i18n:Oversat kommandoer.tilfoej}" />

            <Button x:Name="Fjern" Click="Fjern_Klik" Padding="16,9" Margin="0,0,8,0"
                    Content="{i18n:Oversat kommandoer.fjern}" />

            <Button x:Name="Nulstil" Click="Nulstil_Klik" Padding="16,9"
                    Content="{i18n:Oversat kommandoer.nulstil}" />

            <TextBlock x:Name="Status" VerticalAlignment="Center" Margin="16,0,0,0"
                       Style="{StaticResource Underskrift}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
