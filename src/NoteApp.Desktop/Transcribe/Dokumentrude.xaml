<UserControl x:Class="NoteApp.Desktop.Transcribe.Dokumentrude"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:NoteApp.Desktop">

  <!-- ==================== HVORFOR RUDEN FINDES ====================

       Et dokument findes ikke uden en optagelse. Det er skrevet ud af et
       moede eller et webinar, og der er ingen anden vej til at lave et. Derfor
       er DET her den eneste indgang: dokumentarkivet som selvstaendig skaerm er
       fjernet 04-09-2026, og alt der foer pegede derhen - historikken,
       soegningen, beskeden om at et dokument er faerdigt - lander nu paa den
       optagelse, dokumentet er lavet af, med dokumentet valgt.

       DEN SER UD SOM UDSKRIFTSFANEN. Vaerktoejslinjen oeverst, soegefeltet
       yderst til venstre, og en raekke at vaelge i under den. To faner ved
       siden af hinanden med samme slags indhold skal ikke vaere bygget paa
       hver sin maade. -->

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ===================== Vaerktoejslinjen ===================== -->
    <Border x:Name="Hoved" Grid.Row="0" Background="{DynamicResource Trykket}"
            BorderBrush="{DynamicResource PanelKant}" BorderThickness="0,0,0,1"
            Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border x:Name="Soegefelt" Grid.Column="0" Background="{DynamicResource Trykket}" CornerRadius="6"
                BorderBrush="{DynamicResource PanelKant}" BorderThickness="1"
                Width="240" HorizontalAlignment="Left" Padding="4">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="Soeg" Grid.Column="0" FontSize="12.5" Padding="8,5"
                     BorderThickness="0" Background="Transparent"
                     TextChanged="Soeg_Aendret" KeyDown="Soeg_Tast" />
            <TextBlock x:Name="SoegPladsholder" Grid.Column="0" IsHitTestVisible="False"
                       FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TekstMeget}"
                       Text="{i18n:Oversat dokumentrude.soeg_i_dokumenterne}" />

            <!-- Krydset rydder feltet i eet klik - samme knap som i udskriften.
                 Escape goer det samme. -->
            <Button x:Name="SoegRyd" Grid.Column="1" Content="✕" Click="SoegRyd_Klik"
                    Visibility="Collapsed" Cursor="Hand" FontSize="11"
                    Padding="0" BorderThickness="0" Background="Transparent"
                    Width="24" Height="24" Margin="0,0,3,0"
                    ToolTip="{i18n:Oversat faelles.ryd_soegningen_escape}">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="flade" CornerRadius="12" Background="Transparent">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="flade" Property="Background" Value="{DynamicResource Svaev}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </Grid>
        </Border>

        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <!-- SLETNINGEN HAR IKKE ANDRE STEDER AT VAERE.
               Den laa i dokumentarkivet, og arkivet er vaek. Uden den her kunne
               et dokument aldrig fjernes igen. Den staar yderst til venstre i
               gruppen og er ikke standardknappen - se dialogen, hvor «Behold
               det» er forvalgt. -->
          <Button x:Name="SletKnap" Content="{i18n:Oversat faelles.slet}"
                  Click="Slet_Klik" Padding="12,6" FontSize="12.5"
                  ToolTip="{i18n:Oversat dokumentrude.sletter_det_valgte_dokument}" />

          <Button x:Name="AabnKnap" Content="{i18n:Oversat faelles.aabn}"
                  Click="Aabn_Klik" Padding="12,6" FontSize="12.5" Margin="8,0,0,0"
                  ToolTip="{i18n:Oversat dokumentrude.aabner_dokumentet_i_det_program_der_haandt}" />

          <Button x:Name="OpretKnap" Content="{i18n:Oversat faelles.opret_dokument}"
                  Click="OpretKlik" Padding="12,6" FontSize="12.5" Margin="8,0,0,0"
                  ToolTip="{i18n:Oversat dokumentrude.lav_et_referat_eller_et_andet_dokument_ud}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ ET VALG PR. DOKUMENT, NYESTE FOERST ============

         Dokumenterne laa under hinanden som kort, og med tre-fire af dem var
         teksten paa det foerste alt, man saa. Nu vaelger man eet ad gangen -
         samme greb som fanerne ovenfor, saa der ikke er en tredje maade at
         skifte indhold paa.

         Raekken bygges i kode og ikke i XAML: hvilke der er, og hvad de
         hedder, afhaenger af de dokumenter der findes. Se Byg_Raekke. -->
    <Border x:Name="Raekkeramme" Grid.Row="1" BorderBrush="{DynamicResource PanelKant}"
            BorderThickness="0,0,0,1" Padding="20,10" Visibility="Collapsed">
      <WrapPanel x:Name="Dokumentraekke" Orientation="Horizontal" />
    </Border>

    <ScrollViewer x:Name="Rulle" Grid.Row="2" Padding="26,20,26,20"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="Indre" HorizontalAlignment="Stretch">

        <TextBlock x:Name="Overskrift" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />

        <TextBlock x:Name="Underskrift" FontSize="13.5" LineHeight="22" Margin="0,10,0,0"
                   TextWrapping="Wrap" Foreground="{DynamicResource TekstSvag}" />

        <!-- MANGLER FILEN, SKAL DET STAA VED DOKUMENTET.
             En knap, der aabner ingenting, er vaerre end en, der ikke er der:
             man tror, noget gik galt lige nu. -->
        <TextBlock x:Name="Mangler" FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap"
                   Visibility="Collapsed" Foreground="{DynamicResource Advarsel}"
                   Text="{i18n:Oversat dokumentrude.filen_findes_ikke_laengere_paa_disken}" />

        <!-- ============ SELVE TEKSTEN, HER PAA SKAERMEN ============

             Foer stod der kun en titel og en dato. Ville man vide, hvad der
             stod i referatet, skulle Word aabnes - og saa igen for det naeste.

             TextBox og ikke TextBlock. To grunde, de samme som i det gamle
             arkiv: soegningen skal kunne springe hen til et bestemt sted, og
             det kraever at tegnene kan slaas op paa position - og man kan
             markere og kopiere et afsnit uden at aabne noget. -->
        <Border x:Name="Indholdsramme" Background="{DynamicResource Trykket}"
                BorderBrush="{DynamicResource PanelKant}" BorderThickness="1"
                CornerRadius="8" Padding="16,13" Margin="0,16,0,0" Visibility="Collapsed">
          <TextBox x:Name="Indhold" FontSize="12.5" TextWrapping="Wrap"
                   IsReadOnly="True" BorderThickness="0" Background="Transparent"
                   Padding="0" Foreground="{DynamicResource TekstSvag}"
                   IsInactiveSelectionHighlightEnabled="True"
                   VerticalScrollBarVisibility="Disabled"
                   HorizontalScrollBarVisibility="Disabled" />
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
