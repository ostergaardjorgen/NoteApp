<UserControl x:Class="NoteApp.Desktop.Transcribe.TranscribeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Baggrund}">

  <Grid Margin="24,20,24,20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="380" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,14">
      <TextBlock Text="Transskribér" Style="{StaticResource Overskrift}" />
      <TextBlock Style="{StaticResource Underskrift}"
                 Text="Kører optagelsen gennem Whisper på denne pc. Ingen lyd forlader maskinen." />
    </StackPanel>

    <!-- ========================= Optagelser ============================ -->
    <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="10"
            BorderBrush="{StaticResource PanelKant}" BorderThickness="1" Margin="0,0,16,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Dine optagelser" FontSize="15" FontWeight="SemiBold" Margin="16,14,16,8" />

        <ListBox x:Name="Optagelser" Grid.Row="1" Background="Transparent" BorderThickness="0"
                 Margin="8,0,8,10" SelectionChanged="Optagelse_Valgt"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="10,8" />
              <Setter Property="Margin" Value="0,0,0,2" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="kant" CornerRadius="6" Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="kant" Property="Background" Value="#FF2C323D" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="kant" Property="Background" Value="#FF33405A" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Titel}" FontSize="13" Foreground="{StaticResource Tekst}" />
                <TextBlock Text="{Binding Detaljer}" FontSize="11" Foreground="{StaticResource TekstSvag}"
                           Margin="0,2,0,0" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <!-- =========================== Resultat ============================ -->
    <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="10"
            BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Målingerne. RTF er det tal, hele Fase 0 handler om. -->
        <Grid x:Name="Maalinger" Grid.Row="0" Margin="18,16,18,8" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock x:Name="TalLyd" FontSize="22" FontWeight="SemiBold" FontFamily="Consolas" />
            <TextBlock Text="lyd" Style="{StaticResource Underskrift}" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock x:Name="TalTid" FontSize="22" FontWeight="SemiBold" FontFamily="Consolas" />
            <TextBlock Text="tid brugt" Style="{StaticResource Underskrift}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock x:Name="TalRtf" FontSize="22" FontWeight="SemiBold" FontFamily="Consolas" />
            <TextBlock Text="realtidsfaktor" Style="{StaticResource Underskrift}" />
          </StackPanel>
          <StackPanel Grid.Column="3">
            <TextBlock x:Name="TalOrd" FontSize="22" FontWeight="SemiBold" FontFamily="Consolas" />
            <TextBlock Text="ord" Style="{StaticResource Underskrift}" />
          </StackPanel>
        </Grid>

        <TextBlock x:Name="RtfForklaring" Grid.Row="0" VerticalAlignment="Bottom" Margin="18,0,18,4"
                   Style="{StaticResource Underskrift}" />

        <ScrollViewer Grid.Row="1" Padding="18,10,18,16" VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="Resultat" FontSize="13" LineHeight="22" Foreground="{StaticResource TekstSvag}"
                     Text="Vælg en optagelse til venstre, og tryk Transskribér." />
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- ========================== Bundbjælke =========================== -->
    <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
        <ProgressBar x:Name="Fremdrift" Height="6" Minimum="0" Maximum="100" Visibility="Collapsed"
                     Background="#FF2C323D" Foreground="{StaticResource Accent}" BorderThickness="0" />
        <TextBlock x:Name="Status" Style="{StaticResource Underskrift}" Margin="0,6,0,0" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="SletKnap" Content="Slet optagelse" Click="Slet_Click" IsEnabled="False"
                Margin="0,0,8,0" />
        <Button x:Name="AabnKnap" Content="Åbn mappen" Click="Aabn_Click" IsEnabled="False" Margin="0,0,8,0" />
        <Button x:Name="AfbrydKnap" Content="Afbryd" Click="Afbryd_Click" Visibility="Collapsed" Margin="0,0,8,0" />
        <Button x:Name="KoerKnap" Content="Transskribér" Click="Koer_Click" Style="{StaticResource Primaer}"
                MinWidth="150" IsEnabled="False" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
