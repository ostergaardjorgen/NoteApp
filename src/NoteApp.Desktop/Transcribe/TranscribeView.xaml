<UserControl x:Class="NoteApp.Desktop.Transcribe.TranscribeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Baggrund}">

  <Grid Margin="24,20,24,20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="380" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,14">
      <TextBlock Text="Optagelser" Style="{StaticResource Overskrift}" />
      <TextBlock Style="{StaticResource Underskrift}"
                 Text="Vælg en optagelse, og skriv den ud til tekst. Det sker på denne pc — ingen lyd forlader maskinen." />
    </StackPanel>

    <!-- ========================= Optagelser ============================ -->
    <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="10"
            BorderBrush="{StaticResource PanelKant}" BorderThickness="1" Margin="0,0,16,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- To grupper, ikke én lang liste. Møder, der stadig mangler noget,
             ligger fremme; det færdige ligger i arkivet. Uden opdelingen
             drukner det møde, der mangler et referat, mellem tres, der er
             helt færdige. Træningsoptagelser er ingen af stederne — de hører
             under «Træning». -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,14,16,10">
          <RadioButton x:Name="FaneMoeder" GroupName="gruppe" Content="Møder" IsChecked="True"
                       Click="Fane_Klik" Style="{StaticResource Fanevalg}" />
          <RadioButton x:Name="FaneArkiv" GroupName="gruppe" Content="Arkiv"
                       Click="Fane_Klik" Style="{StaticResource Fanevalg}" Margin="6,0,0,0" />
        </StackPanel>

        <TextBlock x:Name="TraeningsNote" Grid.Row="1" Margin="16,0,16,8" FontSize="11.5"
                   TextWrapping="Wrap" LineHeight="17" Visibility="Collapsed"
                   Foreground="{StaticResource TekstMeget}" />

        <!-- MAPPERNE NEDERST. Listen er det, man er kommet efter; mapperne er
             den maade, man indsnaevrer den paa. Fanerne oeverst (Moeder/Arkiv)
             siger, hvor langt et moede er; mappen siger, hvem det handler om.
             De to ting er uafhaengige og maa ikke slaas sammen. -->
        <Border Grid.Row="3" BorderBrush="{StaticResource PanelKant}"
                BorderThickness="0,1,0,0" Padding="10,8">
          <DockPanel>
            <Button DockPanel.Dock="Right" x:Name="NyMappe" Content="Ny mappe …"
                    Click="NyMappe_Click" Padding="10,5" Margin="6,0,0,0" FontSize="12" />
            <ComboBox x:Name="MappeFilter" SelectionChanged="MappeFilter_Changed"
                      FontSize="12" Padding="8,5" />
          </DockPanel>
        </Border>

        <ListBox x:Name="Optagelser" Grid.Row="2" Background="Transparent" BorderThickness="0"
                 Margin="8,0,8,10" SelectionChanged="Optagelse_Valgt"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="10,8" />
              <Setter Property="Margin" Value="0,0,0,2" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="kant" CornerRadius="6" Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="kant" Property="Background" Value="#FF2C323D" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="kant" Property="Background" Value="#FF33405A" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Titel}" FontSize="13" Foreground="{StaticResource Tekst}" />
                <TextBlock Text="{Binding Detaljer}" FontSize="11" Foreground="{StaticResource TekstSvag}"
                           Margin="0,2,0,0" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <!-- =========================== Resultat ============================ -->
    <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="10"
            BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Her stod fire store tal: lyd, tid brugt, realtidsfaktor og ord.
             Realtidsfaktoren var udviklertelemetri — ingen handler på «0,42».
             Det, man skal vide, står nu i statuslinjen nederst, og tallene
             ligger stadig i Historik. -->

        <!-- Forklaringen. Den fylder feltet, indtil der er en tekst at vise.
             Et tomt felt under en fremdriftslinje fortæller ikke, om man
             venter på noget godt, hvor længe det tager, eller hvad man må
             gøre imens — og så sidder man og ser på det i stedet for at
             lave noget andet. -->
        <ScrollViewer x:Name="Forklaring" Grid.Row="1" Padding="26,20,26,18"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="560" HorizontalAlignment="Left">

            <TextBlock x:Name="ForklaringOverskrift" FontSize="19" FontWeight="SemiBold"
                       TextWrapping="Wrap" Text="Fra lyd til tekst" />
            <TextBlock x:Name="ForklaringUnder" FontSize="13.5" LineHeight="22" Margin="0,10,0,0"
                       TextWrapping="Wrap" Foreground="{StaticResource TekstSvag}"
                       Text="Vælg en optagelse i listen til venstre og tryk «Transskribér» nederst til højre. Så skriver appen alt det talte ud som tekst, du kan læse, søge i og rette." />

            <!-- Tre trin. Ikke fordi det er teknisk interessant, men fordi det
                 svarer på "hvor lang tid tager det" og "hvad sker der nu". -->
            <StackPanel Margin="0,22,0,0">
              <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="30" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="1" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource Accent}" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Modellen indlæses" FontSize="13.5" FontWeight="SemiBold" />
                  <TextBlock FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,3,0,0"
                             Foreground="{StaticResource TekstMeget}"
                             Text="Tager typisk et halvt minut første gang. Der sker ikke noget på skærmen imens — det er normalt." />
                </StackPanel>
              </Grid>

              <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="30" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="2" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource Accent}" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Lyden skrives ud" FontSize="13.5" FontWeight="SemiBold" />
                  <TextBlock FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,3,0,0"
                             Foreground="{StaticResource TekstMeget}"
                             Text="Fremdriften står nederst. Med grafikkort går det hurtigere end lyden varer; uden tager det længere tid end selve mødet." />
                </StackPanel>
              </Grid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="30" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="3" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource Accent}" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Teksten står her" FontSize="13.5" FontWeight="SemiBold" />
                  <TextBlock FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,3,0,0"
                             Foreground="{StaticResource TekstMeget}"
                             Text="Den gemmes automatisk ved siden af optagelsen. Du skal ikke gemme noget selv." />
                </StackPanel>
              </Grid>
            </StackPanel>

            <Border Background="#334CBE72" BorderBrush="{StaticResource Godkendt}" BorderThickness="1"
                    CornerRadius="10" Padding="16,13" Margin="0,22,0,0">
              <StackPanel>
                <TextBlock Text="Du kan roligt lave noget andet imens" FontSize="13"
                           FontWeight="SemiBold" Foreground="{StaticResource Tekst}" />
                <TextBlock FontSize="12.5" LineHeight="20" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource Tekst}"
                           Text="Du kan lukke skærmen, skifte til en anden fane — og du kan optage et nyt møde, mens det forrige bliver skrevet ud. Optagelse bruger hverken grafikkort eller nævneværdig plads, og den kan derfor aldrig blive blokeret af det her." />
              </StackPanel>
            </Border>

            <TextBlock FontSize="12.5" LineHeight="20" Margin="2,18,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TekstMeget}"
                       Text="Teksten bliver ikke perfekt. Navne og fagord er det, der oftest rammes forkert — dem retter du i «Din ordbog», og så bliver de ramt bedre næste gang." />
          </StackPanel>
        </ScrollViewer>

        <!-- Teksten er en TextBox, ikke en TextBlock. Grunden er ikke kosmetisk:
             man skal kunne MARKERE et ord, der er hørt forkert, og lære appen
             det rigtige. Uden det er «appen lærer af dine rettelser» en
             påstand, der ikke kan indfries. -->
        <Grid x:Name="ResultatRude" Grid.Row="1" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Background="#FF1D2530" BorderBrush="{StaticResource PanelKant}"
                  BorderThickness="0,0,0,1" Padding="18,10">
            <Grid>
              <TextBlock x:Name="RetTekst" VerticalAlignment="Center" FontSize="12.5"
                         TextWrapping="Wrap" Foreground="{StaticResource TekstMeget}"
                         Text="Er et ord hørt forkert? Markér det i teksten og tryk «Ret ordet» — så retter appen det af sig selv i alle fremtidige udskrifter." />
              <Button x:Name="RetKnap" Content="Ret ordet …" Click="Ret_Click" HorizontalAlignment="Right"
                      Padding="14,7" IsEnabled="False" />
            </Grid>
          </Border>

          <!-- TextBox har ingen LineHeight; linjeafstanden kommer fra
               skrifttypen. Det er den eneste pris for at kunne markere. -->
          <TextBox x:Name="Resultat" Grid.Row="1" FontSize="13"
                   Foreground="{StaticResource TekstSvag}" Background="Transparent"
                   BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" Padding="18,10,18,16"
                   SelectionChanged="Resultat_SelectionChanged" />
        </Grid>
      </Grid>
    </Border>

    <!-- ========================== Bundbjælke =========================== -->
    <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
        <ProgressBar x:Name="Fremdrift" Height="6" Minimum="0" Maximum="100" Visibility="Collapsed"
                     Background="#FF2C323D" Foreground="{StaticResource Accent}" BorderThickness="0" />
        <TextBlock x:Name="Status" Style="{StaticResource Underskrift}" Margin="0,6,0,0" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="FlytKnap" Content="Flyt til mappe" Click="Flyt_Click" IsEnabled="False"
                Margin="0,0,8,0" />
        <Button x:Name="OmdoebKnap" Content="Omdøb" Click="Omdoeb_Click" IsEnabled="False"
                Margin="0,0,8,0" />
        <Button x:Name="ArkivKnap" Content="Arkivér" Click="Arkiver_Click" IsEnabled="False"
                Margin="0,0,8,0" />
        <Button x:Name="SletKnap" Content="Slet optagelse" Click="Slet_Click" IsEnabled="False"
                Margin="0,0,8,0" />
        <Button x:Name="AabnKnap" Content="Åbn mappen" Click="Aabn_Click" IsEnabled="False" Margin="0,0,8,0" />
        <Button x:Name="AfbrydKnap" Content="Afbryd" Click="Afbryd_Click" Visibility="Collapsed" Margin="0,0,8,0" />

        <!-- Vejen videre. Den er der først, når der ER en tekst — et dokument
             kan ikke laves af lyd, kun af det, lyden er skrevet ud til. -->
        <Button x:Name="ReferatKnap" Content="Opret dokument  →" Click="Referat_Click"
                Margin="0,0,8,0" MinWidth="160" IsEnabled="False" Padding="14,8" />

        <Button x:Name="KoerKnap" Content="Transskribér" Click="Koer_Click" Style="{StaticResource Primaer}"
                MinWidth="150" IsEnabled="False" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
