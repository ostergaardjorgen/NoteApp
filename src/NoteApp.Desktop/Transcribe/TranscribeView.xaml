<UserControl x:Class="NoteApp.Desktop.Transcribe.TranscribeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Baggrund}">

  <!-- ======================== LAYOUTET, OG HVORFOR =======================

       To spalter, som i Stifinder: træet til venstre, indholdet til højre.

       HER LÅ TRE. Træ, liste, tekst. Den midterste var overflødig — når et
       bibliotek kan foldes ud, hører dets optagelser til DERINDE, ikke i en
       spalte for sig. Filerne ligger nu i træet, hvor de hører hjemme, og
       teksten har fået den plads, listen tog.

       HER LÅ OTTE KNAPPER NEDERST. «Flyt til mappe», «Omdøb», «Arkivér»,
       «Slet optagelse», «Åbn mappen», «Opret dokument», «Transskribér» — én
       bred række, som øjet faldt på, og hvor fire af dem handler om at rydde
       op frem for at komme videre.

       Alt ligger nu i ÉN værktøjslinje øverst: oprydningen som ikoner til
       venstre, de to handlinger, der fører arbejdet videre, til højre. De to
       står i den rækkefølge, arbejdet går — «Transskribér», så «Opret
       dokument» — og den anden kan først bruges, når den første er gjort.
       Det er hele guidningen, og den koster ikke en linje tekst.

       IKONERNE SKAL HAVE FontFamily SAT LOKALT. App.xaml har en implicit stil
       for TextBlock med Segoe UI. Den slår igennem på den TextBlock, en
       ContentPresenter selv laver ud af en tekststreng — en stil-setter
       vinder over nedarvning — og så bliver hver eneste glyf til en tom
       firkant. Det skete, og det er derfor glyfferne står i en TextBlock med
       sin egen FontFamily. -->

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="Optagelser" Style="{StaticResource Overskrift}" />
      <TextBlock Style="{StaticResource Underskrift}"
                 Text="Vælg en optagelse i træet, og skriv den ud til tekst. Det sker på denne pc — ingen lyd forlader maskinen." />
    </StackPanel>

    <!-- ========================= Værktøjslinje ========================== -->
    <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="8"
            BorderBrush="{StaticResource PanelKant}" BorderThickness="1" Padding="8,6">
      <DockPanel>

        <!-- Til højre: vejen videre. De to eneste handlinger, der flytter
             arbejdet fremad, står yderst — hvor øjet ender. -->
        <Button DockPanel.Dock="Right" x:Name="ReferatKnap" Click="Referat_Click"
                MinWidth="150" IsEnabled="False" Padding="14,7" Content="Opret dokument"
                ToolTip="Lav et referat eller et andet dokument ud af udskriften" />

        <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                   FontSize="11" VerticalAlignment="Center" Margin="10,0"
                   Foreground="{StaticResource PanelKant}" />

        <Button DockPanel.Dock="Right" x:Name="AfbrydKnap" Content="Afbryd" Click="Afbryd_Click"
                Visibility="Collapsed" Margin="8,0,0,0" />

        <Button DockPanel.Dock="Right" x:Name="KoerKnap" Click="Koer_Click"
                Style="{StaticResource Primaer}" MinWidth="178" IsEnabled="False"
                Content="Opret transskription"
                ToolTip="Skriv lyden ud til tekst her på maskinen" />

        <Border DockPanel.Dock="Right" Width="1" Margin="10,4,14,4"
                Background="{StaticResource PanelKant}" />

        <!-- Til venstre: oprydningen. «Ny mappe» står først og alene, fordi
             den er den eneste, der virker uden et valg. -->
        <Button DockPanel.Dock="Left" x:Name="NyMappeKnap" Style="{StaticResource IkonKnap}"
                Click="NyMappe_Click" AutomationProperties.Name="Ny mappe"
                ToolTip="Ny mappe — til fx en kunde eller et projekt">
          <TextBlock Text="&#xE8F4;" FontFamily="Segoe MDL2 Assets" />
        </Button>

        <Border DockPanel.Dock="Left" Width="1" Margin="6,4,8,4"
                Background="{StaticResource PanelKant}" />

        <Button DockPanel.Dock="Left" x:Name="FlytKnap" Style="{StaticResource IkonKnap}"
                Click="Flyt_Click" IsEnabled="False" AutomationProperties.Name="Flyt til mappe"
                ToolTip="Flyt til mappe — eller træk optagelsen hen på en mappe i træet">
          <TextBlock Text="&#xE8DE;" FontFamily="Segoe MDL2 Assets" />
        </Button>

        <Button DockPanel.Dock="Left" x:Name="OmdoebKnap" Style="{StaticResource IkonKnap}"
                Click="Omdoeb_Click" IsEnabled="False" AutomationProperties.Name="Omdøb"
                ToolTip="Omdøb optagelsen">
          <TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" />
        </Button>

        <!-- HER LAA «Arkivér».
             Den gjorde praecis det samme som at traekke optagelsen hen paa
             «Arkiv» i traeet, og traek og slip er den vej, man alligevel
             tager. To knapper til den samme handling er ikke et valg, det er
             noget, man skal laere at se bort fra. Fjernet 18-08-2026. -->

        <Button DockPanel.Dock="Left" x:Name="AabnKnap" Style="{StaticResource IkonKnap}"
                Click="Aabn_Click" IsEnabled="False" AutomationProperties.Name="Åbn mappen"
                ToolTip="Åbn mappen på disken">
          <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" />
        </Button>

        <Border DockPanel.Dock="Left" Width="1" Margin="6,4,8,4"
                Background="{StaticResource PanelKant}" />

        <Button DockPanel.Dock="Left" x:Name="SletKnap" Style="{StaticResource IkonKnapFare}"
                Click="Slet_Click" IsEnabled="False" AutomationProperties.Name="Slet optagelse"
                ToolTip="Slet optagelsen med lyd og udskrift. Kan ikke fortrydes">
          <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" />
        </Button>

        <Grid />
      </DockPanel>
    </Border>

    <!-- HER LAA FREMDRIFTEN OG STATUS, UNDER VAERKTOEJSLINJEN.
         To kontroller i den samme gittercelle - den ene toppet, den anden
         bundet - saa teksten laa hen over bjaelken, saa snart begge var
         fremme. Og stedet var forkert: fremdriften hoerer til DET, den
         handler om, og det staar i spalten til hoejre.

         Den ligger nu nederst i indholdsruden, hvor teksten om, hvad der
         sker, ogsaa staar. Dokumenter melder samme sted hen, saa bjaelken
         ikke flytter sig alt efter, hvad man venter paa. -->

    <!-- ======================= Træ · indhold =========================== -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- =========================== Biblioteker ====================== -->
      <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="10"
              BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="BIBLIOTEKER" FontSize="10.5" FontWeight="SemiBold"
                     Margin="16,14,16,8" Foreground="{StaticResource TekstMeget}" />

          <TextBlock DockPanel.Dock="Bottom" Margin="16,8,16,12" FontSize="11" TextWrapping="Wrap"
                     LineHeight="17" Foreground="{StaticResource TekstMeget}"
                     Text="Træk en optagelse hen på en mappe for at flytte den." />

          <TreeView x:Name="Trae" Background="Transparent" BorderThickness="0"
                    Margin="6,0,6,0" SelectedItemChanged="Bibliotek_Valgt"
                    AllowDrop="True" DragOver="Trae_TraekOver" DragLeave="Trae_TraekForlod"
                    Drop="Trae_Slip"
                    PreviewMouseLeftButtonDown="Trae_MusNed"
                    PreviewMouseMove="Trae_MusBevaeget"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <TreeView.ItemContainerStyle>
              <Style TargetType="TreeViewItem">
                <Style.Resources>
                  <!-- WPF tegner sin EGEN markering under vores skabelon, med
                       systemets fremhaevningsfarve og hvid tekst. Paa et
                       moerkt tema bliver navnet dermed usynligt, naar man
                       vaelger det. De tre noegler slukker den, saa det er
                       DataTriggeren paa ErValgt nedenfor, der tegner
                       markeringen - i temaets egne farver. -->
                  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFF4F6FA" />
                </Style.Resources>
                <Setter Property="Padding" Value="2,1" />
                <Setter Property="AllowDrop" Value="True" />
                <Setter Property="Foreground" Value="{StaticResource TekstSvag}" />
                <!-- Tovejsbinding: knuden husker selv, om den er foldet ud og
                     valgt, saa traeet ikke klapper sammen og mister sin
                     markering, hver gang det bygges forfra. -->
                <Setter Property="IsExpanded" Value="{Binding ErUdfoldet, Mode=TwoWay}" />
                <Setter Property="IsSelected" Value="{Binding ErValgt, Mode=TwoWay}" />
              </Style>
            </TreeView.ItemContainerStyle>

            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate ItemsSource="{Binding Boern}">
                <!-- Rammen er dropmaalet. Den lyser op, naar man holder noget
                     hen over den, saa man kan se HVOR man slipper. -->
                <Border x:Name="rk" CornerRadius="5" Padding="6,4" Background="Transparent"
                        AutomationProperties.Name="{Binding Visning}"
                        BorderThickness="1" BorderBrush="Transparent">
                  <!-- Hjaelpeteksten staar KUN paa optagelser - se
                       udloeseren for ErBeholder nedenfor. En mappe har ikke
                       noget tidsrum, og en tom boble er stoej.

                       To linjer: hvornaar, og hvor laenge. Raekken selv har
                       kun plads til en forkortet dato, og naar der ligger to
                       moeder paa samme dag, er det klokkeslaettet fra og til,
                       der afgoer, hvilket man leder efter. -->
                  <Border.ToolTip>
                    <StackPanel MaxWidth="360">
                      <TextBlock Text="{Binding Navn}" FontWeight="SemiBold" FontSize="13"
                                 TextWrapping="Wrap" Margin="0,0,0,6" />
                      <TextBlock Text="{Binding Optagelse.Tidsrum}" FontSize="12.5" />
                      <TextBlock Text="{Binding Optagelse.Varighed}" FontSize="12.5"
                                 Margin="0,3,0,0" />
                    </StackPanel>
                  </Border.ToolTip>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Glyf}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,9,0"
                               Foreground="{StaticResource Accent}" />
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Visning}" FontSize="12.5"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Under}" FontSize="10.5" Margin="0,1,0,0"
                                 Foreground="{StaticResource TekstMeget}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Under}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <HierarchicalDataTemplate.Triggers>
                  <DataTrigger Binding="{Binding ErValgt}" Value="True">
                    <Setter TargetName="rk" Property="Background" Value="#FF33405A" />
                  </DataTrigger>
                  <!-- Beholdere har ingen hjaelpetekst: en mappe har intet
                       tidsrum, og en tom boble er stoej. -->
                  <DataTrigger Binding="{Binding ErBeholder}" Value="True">
                    <Setter TargetName="rk" Property="ToolTipService.IsEnabled" Value="False" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding ErDropmaal}" Value="True">
                    <Setter TargetName="rk" Property="Background" Value="#FF33405A" />
                    <Setter TargetName="rk" Property="BorderBrush" Value="{StaticResource Accent}" />
                  </DataTrigger>
                </HierarchicalDataTemplate.Triggers>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch"
                    Background="Transparent" />

      <!-- ============================= Indholdet ====================== -->
      <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="10"
              BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- FREMDRIFTEN NEDERST I INDHOLDSRUDEN.
               Den staar under den tekst, der forklarer hvad der sker, og den
               er kun fremme, mens der koeres. Baade transskription og
               dokumenter melder hertil, saa bjaelken ikke flytter sig alt
               efter, hvad man venter paa. -->
          <Border x:Name="Fremdriftsrude" Grid.Row="1" Visibility="Collapsed"
                  Background="#FF1A2230" BorderBrush="{StaticResource Accent}"
                  BorderThickness="0,1,0,0" CornerRadius="0,0,10,10" Padding="20,12">
            <StackPanel>
              <Grid>
                <TextBlock x:Name="Status" FontSize="12.5" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" Margin="0,0,60,0" />
                <TextBlock x:Name="Fremdriftstal" FontSize="12.5" HorizontalAlignment="Right"
                           Foreground="{StaticResource Accent}" FontFamily="Consolas" />
              </Grid>
              <ProgressBar x:Name="Fremdrift" Height="5" Minimum="0" Maximum="100" Margin="0,9,0,0"
                           Background="#FF2C323D" Foreground="{StaticResource Accent}"
                           BorderThickness="0" />
            </StackPanel>
          </Border>

          <!-- HorizontalScrollBarVisibility="Disabled" er ikke pynt: uden den
               maaler ScrollViewer sit indhold med UENDELIG bredde, og saa
               ombrydes teksten slet ikke. Foer holdt en MaxWidth paa 620
               teksten i en smal soejle og skjulte det - da den blev fjernet,
               saa man fejlen. -->
          <ScrollViewer x:Name="Forklaring" Grid.Row="0" Padding="26,20,26,18"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <!-- Ingen MaxWidth. Der stod 620, og saa blev teksten staaende i
                 en smal soejle, naar man trak spalten bredere - pladsen blev
                 lavet, men ikke brugt. En laesekolonne paa en fast bredde er
                 paen i en artikel; her er det brugeren, der bestemmer
                 bredden ved at traekke i skillelinjen. -->
            <StackPanel HorizontalAlignment="Stretch">

              <TextBlock x:Name="ForklaringOverskrift" FontSize="19" FontWeight="SemiBold"
                         TextWrapping="Wrap" Text="Fra lyd til tekst" />
              <TextBlock x:Name="ForklaringUnder" FontSize="13.5" LineHeight="22" Margin="0,10,0,0"
                         TextWrapping="Wrap" Foreground="{StaticResource TekstSvag}"
                         Text="Fold «Møder» ud i træet til venstre, vælg en optagelse, og tryk «Opret transskription» øverst. Så skriver appen alt det talte ud som tekst, du kan læse, søge i og rette." />

              <StackPanel Margin="0,22,0,0">
                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="1" FontSize="15" FontWeight="SemiBold"
                             Foreground="{StaticResource Accent}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Modellen indlæses" FontSize="13.5" FontWeight="SemiBold" />
                    <TextBlock FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,3,0,0"
                               Foreground="{StaticResource TekstMeget}"
                               Text="Tager typisk et halvt minut første gang. Der sker ikke noget på skærmen imens — det er normalt." />
                  </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="2" FontSize="15" FontWeight="SemiBold"
                             Foreground="{StaticResource Accent}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Lyden skrives ud" FontSize="13.5" FontWeight="SemiBold" />
                    <TextBlock FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,3,0,0"
                               Foreground="{StaticResource TekstMeget}"
                               Text="Fremdriften står under værktøjslinjen. Med grafikkort går det hurtigere end lyden varer; uden tager det længere tid end selve mødet." />
                  </StackPanel>
                </Grid>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="3" FontSize="15" FontWeight="SemiBold"
                             Foreground="{StaticResource Accent}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Teksten står her" FontSize="13.5" FontWeight="SemiBold" />
                    <TextBlock FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,3,0,0"
                               Foreground="{StaticResource TekstMeget}"
                               Text="Den gemmes automatisk ved siden af optagelsen. Du skal ikke gemme noget selv." />
                  </StackPanel>
                </Grid>
              </StackPanel>

              <Border Background="#334CBE72" BorderBrush="{StaticResource Godkendt}" BorderThickness="1"
                      CornerRadius="10" Padding="16,13" Margin="0,22,0,0">
                <StackPanel>
                  <TextBlock Text="Du kan roligt lave noget andet imens" FontSize="13"
                             FontWeight="SemiBold" Foreground="{StaticResource Tekst}" />
                  <TextBlock FontSize="12.5" LineHeight="20" Margin="0,6,0,0" TextWrapping="Wrap"
                             Foreground="{StaticResource Tekst}"
                             Text="Du kan lukke skærmen, skifte til en anden fane — og du kan optage et nyt møde, mens det forrige bliver skrevet ud. Optagelse bruger hverken grafikkort eller nævneværdig plads, og den kan derfor aldrig blive blokeret af det her." />
                </StackPanel>
              </Border>

              <TextBlock FontSize="12.5" LineHeight="20" Margin="2,18,0,0" TextWrapping="Wrap"
                         Foreground="{StaticResource TekstMeget}"
                         Text="Teksten bliver ikke perfekt. Navne og fagord er det, der oftest rammes forkert. Du kan rette direkte i udskriften, før du laver et dokument ud af den." />
            </StackPanel>
          </ScrollViewer>

          <TextBox x:Name="Resultat" Grid.Row="0" FontSize="13" Visibility="Collapsed"
                   Foreground="{StaticResource TekstSvag}" Background="Transparent"
                   BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" Padding="22,18,22,18" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
