<UserControl x:Class="NoteApp.Desktop.Transcribe.TranscribeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:NoteApp.Desktop"
             xmlns:local="clr-namespace:NoteApp.Desktop.Transcribe"
             Background="{DynamicResource Baggrund}">

  <!-- ======================== LAYOUTET, OG HVORFOR =======================

       To spalter, som i Stifinder: træet til venstre, indholdet til højre.

       HER LÅ TRE. Træ, liste, tekst. Den midterste var overflødig — når et
       bibliotek kan foldes ud, hører dets optagelser til DERINDE, ikke i en
       spalte for sig. Filerne ligger nu i træet, hvor de hører hjemme, og
       teksten har fået den plads, listen tog.

       HER LÅ OTTE KNAPPER NEDERST. «Flyt til mappe», «Omdøb», «Arkivér»,
       «Slet optagelse», «Åbn mappen», «Opret dokument», «Transskribér» — én
       bred række, som øjet faldt på, og hvor fire af dem handler om at rydde
       op frem for at komme videre.

       De blev samlet i ÉN værktøjslinje øverst. Det var rigtigt for
       oprydningen, som gælder OPTAGELSEN, og forkert for de to sidste:
       «Kopiér teksten» og «Opret dokument» gælder UDSKRIFTEN, og de stod tre
       knapper væk fra den. Begge er flyttet ned i udskriftsruden, hvor
       teksten er — se kommentaren ved værktøjslinjen nedenfor.

       Linjen øverst handler nu om ét: den optagelse, der er valgt i træet.

       IKONERNE SKAL HAVE FontFamily SAT LOKALT. App.xaml har en implicit stil
       for TextBlock med Segoe UI. Den slår igennem på den TextBlock, en
       ContentPresenter selv laver ud af en tekststreng — en stil-setter
       vinder over nedarvning — og så bliver hver eneste glyf til en tom
       firkant. Det skete, og det er derfor glyfferne står i en TextBlock med
       sin egen FontFamily. -->

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="{i18n:Oversat transcribeview.optagelser}" Style="{StaticResource Overskrift}" />
      <TextBlock Style="{StaticResource Underskrift}"
                 Text="{i18n:Oversat transcribeview.vaelg_en_optagelse_i_traeet_og_skriv_den_u}" />
    </StackPanel>

    <!-- ========================= Værktøjslinje ========================== -->
    <Border Grid.Row="1" Background="{DynamicResource Panel}" CornerRadius="8"
            BorderBrush="{DynamicResource PanelKant}" BorderThickness="1" Padding="8,6">
      <DockPanel>

        <!-- ============ HER LAA «KOPIÉR TEKSTEN» OG «OPRET DOKUMENT» ============

             Begge er flyttet ned i udskriftsruden, hvor teksten staar. To
             grunde, og de er ikke den samme:

             «Kopiér teksten» fandtes BEGGE steder. Den her laeste den raa
             .txt-fil fra disken - maskinens foerste bud, uden rettelser og
             uden talernes navne. Den i udskriftsruden tager den tekst, man
             kigger paa, og kan give den med eller uden tidsstempel og taler.
             Den var altsaa ikke bare overfloedig; den gav den RINGERE tekst,
             og det er den samme fejl, dokumentvejen lavede indtil 20-08-2026.

             «Opret dokument» stod tre knapper vaek fra den udskrift, det
             skulle laves af. Nu staar det ved teksten: saa er der ikke tvivl
             om hvilken optagelse det gaelder, og der er kun moedetypen
             tilbage at vaelge.

             Tilbage staar den ene handling, der gaelder OPTAGELSEN - at skrive
             lyden ud. Pilen imellem er ogsaa vaek; den viste raekkefoelgen
             «transskribér, saa opret dokument», og de to trin staar ikke
             laengere ved siden af hinanden. -->
        <Button DockPanel.Dock="Right" x:Name="AfbrydKnap" Content="{i18n:Oversat faelles.afbryd}" Click="Afbryd_Click"
                Visibility="Collapsed" Margin="8,0,0,0" />

        <Button DockPanel.Dock="Right" x:Name="KoerKnap" Click="Koer_Click"
                Style="{StaticResource Primaer}" MinWidth="178" IsEnabled="False"
                Content="{i18n:Oversat transcribeview.opret_transskription}"
                ToolTip="{i18n:Oversat transcribeview.skriv_lyden_ud_til_tekst_her_paa_maskinen}" />

        <Border DockPanel.Dock="Right" Width="1" Margin="10,4,14,4"
                Background="{DynamicResource PanelKant}" />

        <!-- Til venstre: oprydningen. «Ny mappe» står først og alene, fordi
             den er den eneste, der virker uden et valg. -->
        <Button DockPanel.Dock="Left" x:Name="NyMappeKnap" Style="{StaticResource IkonKnap}"
                Click="NyMappe_Click" AutomationProperties.Name="{i18n:Oversat faelles.ny_mappe}"
                ToolTip="{i18n:Oversat faelles.ny_mappe_til_fx_en_kunde_eller_et_projekt}">
          <TextBlock Text="&#xE8F4;" Style="{StaticResource Ikonglyf}" />
        </Button>

        <!-- INDLÆS EN LYDFIL UDEFRA.
             Den står ved siden af «Ny mappe», fordi de to er de eneste
             knapper her, der LAVER noget. Resten flytter rundt på det, der
             allerede er.

             Møder holdes ikke altid ved pc'en. En talememo fra telefonen er
             lige så meget et møde som et onlinemøde, og uden en vej ind er
             appen kun noget værd for det, den selv var med til. -->
        <Button DockPanel.Dock="Left" x:Name="IndlaesKnap" Style="{StaticResource IkonKnap}"
                Click="Indlaes_Click" AutomationProperties.Name="{i18n:Oversat transcribeview.indlaes_lydfil}"
                ToolTip="{i18n:Oversat transcribeview.indlaes_en_lydfil_udefra_eller_traek_den_i}">
          <TextBlock Text="&#xE898;" Style="{StaticResource Ikonglyf}" />
        </Button>

        <Border DockPanel.Dock="Left" Width="1" Margin="6,4,8,4"
                Background="{DynamicResource PanelKant}" />

        <Button DockPanel.Dock="Left" x:Name="FlytKnap" Style="{StaticResource IkonKnap}"
                Click="Flyt_Click" IsEnabled="False" AutomationProperties.Name="{i18n:Oversat faelles.flyt_til_mappe}"
                ToolTip="{i18n:Oversat transcribeview.flyt_til_mappe_eller_traek_optagelsen_hen}">
          <TextBlock Text="&#xE8DE;" Style="{StaticResource Ikonglyf}" />
        </Button>

        <Button DockPanel.Dock="Left" x:Name="OmdoebKnap" Style="{StaticResource IkonKnap}"
                Click="Omdoeb_Click" IsEnabled="False" AutomationProperties.Name="{i18n:Oversat faelles.omdoeb}"
                ToolTip="{i18n:Oversat transcribeview.omdoeb_optagelsen}">
          <TextBlock Text="&#xE8AC;" Style="{StaticResource Ikonglyf}" />
        </Button>

        <!-- HER LAA «Arkivér».
             Den gjorde praecis det samme som at traekke optagelsen hen paa
             «Arkiv» i traeet, og traek og slip er den vej, man alligevel
             tager. To knapper til den samme handling er ikke et valg, det er
             noget, man skal laere at se bort fra. Fjernet 18-08-2026. -->

        <Button DockPanel.Dock="Left" x:Name="AabnKnap" Style="{StaticResource IkonKnap}"
                Click="Aabn_Click" IsEnabled="False" AutomationProperties.Name="{i18n:Oversat faelles.aabn_mappen}"
                ToolTip="{i18n:Oversat transcribeview.aabn_mappen_paa_disken}">
          <TextBlock Text="&#xE838;" Style="{StaticResource Ikonglyf}" />
        </Button>

        <Border DockPanel.Dock="Left" Width="1" Margin="6,4,8,4"
                Background="{DynamicResource PanelKant}" />

        <!-- RYD LYDEN PAA DEN ENE OPTAGELSE.
             Et heldagsseminar fylder en halv gigabyte. Har man skrevet det ud
             og laest teksten igennem, er der ingen grund til at vente et aar
             paa den automatiske oprydning. Knappen staar KUN, naar der er en
             udskrift og en lydfil - ellers er der ingenting at rydde. -->
        <Button DockPanel.Dock="Left" x:Name="RydLydKnap" Style="{StaticResource IkonKnap}"
                Click="RydLyd_Click" IsEnabled="False"
                AutomationProperties.Name="{i18n:Oversat transcribeview.ryd_lyden}"
                ToolTip="{i18n:Oversat transcribeview.slet_lydfilerne_men_behold_transkriptionen}">
          <TextBlock Text="&#xEC4E;" Style="{StaticResource Ikonglyf}" />
        </Button>

        <Button DockPanel.Dock="Left" x:Name="SletKnap" Style="{StaticResource IkonKnapFare}"
                Click="Slet_Click" IsEnabled="False" AutomationProperties.Name="{i18n:Oversat transcribeview.slet_optagelse}"
                ToolTip="{i18n:Oversat transcribeview.slet_optagelsen_med_lyd_og_transkription_k}">
          <TextBlock Text="&#xE74D;" Style="{StaticResource Ikonglyf}" />
        </Button>

        <Grid />
      </DockPanel>
    </Border>

    <!-- HER LAA FREMDRIFTEN OG STATUS, UNDER VAERKTOEJSLINJEN.
         To kontroller i den samme gittercelle - den ene toppet, den anden
         bundet - saa teksten laa hen over bjaelken, saa snart begge var
         fremme. Og stedet var forkert: fremdriften hoerer til DET, den
         handler om, og det staar i spalten til hoejre.

         Den ligger nu nederst i indholdsruden, hvor teksten om, hvad der
         sker, ogsaa staar. Dokumenter melder samme sted hen, saa bjaelken
         ikke flytter sig alt efter, hvad man venter paa. -->

    <!-- STILINJEN OG DENS MELLEMRUM.
         Spalterne laa klods op ad vaerktoejslinjen her, mens Dokumenter og
         Skabeloner havde luft. Forskellen var ikke et valg - de to andre
         skaerme har en linje med stien under bjaelken, og den skabte
         mellemrummet. Nu har alle tre den samme linje det samme sted.

         Linjen er ikke bare luft: den siger, hvor filen ligger. Det er
         praecis det spoergsmaal, man staar med, naar noget skal findes frem
         uden om appen. -->
    <Grid Grid.Row="2" Margin="2,8,2,10">
      <TextBlock x:Name="Stilinje" Style="{StaticResource Underskrift}" VerticalAlignment="Bottom"
                 TextTrimming="CharacterEllipsis" />
    </Grid>

    <!-- ======================= Træ · indhold =========================== -->
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <!-- ============ SPALTEN FOELGER NAVNENE ============

             HER STOD 225 FAST, og navnene blev klippet: «Møde med Cloudwork…»,
             «1. Saviynt møde med E…». Man kunne trække i skillelinjen, men
             det skulle man gøre igen for hver mappe, man foldede ud - og et
             navn, man ikke kan læse, er en optagelse, man ikke kan finde.

             Auto måler det, der FAKTISK står i træet lige nu. Kun de
             udfoldede rækker tælles med, så spalten følger med, når man
             folder ud og klapper sammen igen.

             225 SOM MINIMUM, saa den ikke bliver smallere end foer paa korte
             navne. 420 SOM LOFT, fordi pladsen goer mere gavn til hoejre,
             hvor udskriften staar - et navn, der er laengere end det, bliver
             klippet som foer, og hele navnet staar i boblen.

             Skillelinjen virker stadig. Traekker man i den, vinder det valg
             over det automatiske - som i Stifinder.

             DE OEVRIGE TEKSTER I RUDEN HAR FAAET MaxWidth. En TextBlock med
             TextWrapping maaler sig selv som EEN lang linje, naar bredden er
             uendelig, og saa var det hjaelpeteksten nederst - ikke navnene -
             der bestemte spaltens bredde.

             Samme opbygning paa alle tre skaerme med et bibliotekstrae. -->
        <ColumnDefinition Width="Auto" MinWidth="225" MaxWidth="420" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <!-- SENESTE OPTAGELSER. Den stod i Cockpittet og fyldte den plads,
             kalenderen har brug for - og den hoerer hjemme her, hvor man
             arbejder med optagelser. 260 raekker til en titel og en linje
             med dato, laengde og tilstand. -->
        <ColumnDefinition Width="260" />
      </Grid.ColumnDefinitions>

      <!-- =========================== Biblioteker ====================== -->
      <Border Grid.Column="0" Background="{DynamicResource Panel}" CornerRadius="10"
              BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{i18n:Oversat faelles.biblioteker}" FontSize="10.5" FontWeight="SemiBold"
                     Margin="16,14,16,8" Foreground="{DynamicResource TekstMeget}" />

          <!-- MaxWidth ER IKKE PYNT. Spalten er Auto, og en TextBlock med
               TextWrapping maaler sig selv som EEN lang linje under en
               uendelig bredde. Uden loftet var det hjaelpeteksten - ikke
               navnene i traeet - der bestemte, hvor bred ruden blev. -->
          <TextBlock DockPanel.Dock="Bottom" Margin="16,8,16,12" FontSize="11" TextWrapping="Wrap"
                     MaxWidth="193" HorizontalAlignment="Left"
                     LineHeight="17" Foreground="{DynamicResource TekstMeget}"
                     Text="{i18n:Oversat transcribeview.traek_en_optagelse_hen_paa_en_mappe_for_at}" />

          <!-- ============ NYE FILER I DE OVERVAAGEDE MAPPER ============

               DEN STAAR HER OG IKKE I EN NOTIFIKATION.

               En besked, der popper op, kommer paa et tidspunkt, man ikke
               selv har valgt - og hvis man er midt i noget, klikker man den
               vaek uden at laese den. Bjaelken bliver staaende, indtil der er
               taget stilling, og den staar praecis der, hvor optagelserne er.

               DER SPOERGES, DER TAGES IKKE. Filen bliver liggende i mappen,
               uanset hvad man svarer. "Nej tak" betyder kun, at den ikke
               bliver tilbudt igen. -->
          <!-- MaxWidth af samme grund som ved hjaelpeteksten nedenfor:
               bjaelkens to tekster ombryder, og de maa ikke saette
               spaltens bredde. -->
          <Border DockPanel.Dock="Top" x:Name="Fundbjaelke" Visibility="Collapsed" MaxWidth="209"
                  HorizontalAlignment="Left"
                  Background="{DynamicResource AccentFlade}" CornerRadius="0,8,8,0" Margin="8,0,8,10"
                  BorderBrush="{DynamicResource Accent}" BorderThickness="3,0,0,0"
                  Padding="12,10">
            <StackPanel>
              <TextBlock x:Name="Fundtekst" FontSize="12" FontWeight="SemiBold"
                         TextWrapping="Wrap" Foreground="{DynamicResource Tekst}" />

              <TextBlock x:Name="Fundlinje" FontSize="11" TextWrapping="Wrap" LineHeight="17"
                         Margin="0,5,0,0" Foreground="{DynamicResource TekstMeget}" />

              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="{i18n:Oversat transcribeview.laeg_ind}" Click="FundLaegInd_Click" Padding="14,6"
                        Style="{StaticResource Primaer}" Margin="0,0,8,0" />
                <Button Content="{i18n:Oversat transcribeview.nej_tak}" Click="FundAfvis_Click" Padding="12,6"
                        ToolTip="{i18n:Oversat transcribeview.filen_bliver_liggende_i_mappen_den_bliver}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <TreeView x:Name="Trae" Background="Transparent" BorderThickness="0"
                    Margin="6,0,6,0" SelectedItemChanged="Bibliotek_Valgt"
                    AllowDrop="True" DragOver="Trae_TraekOver" DragLeave="Trae_TraekForlod"
                    Drop="Trae_Slip"
                    PreviewMouseLeftButtonDown="Trae_MusNed"
                    PreviewMouseMove="Trae_MusBevaeget"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <TreeView.ItemContainerStyle>
              <Style TargetType="TreeViewItem">
                <Style.Resources>
                  <!-- WPF tegner sin EGEN markering under vores skabelon, med
                       systemets fremhaevningsfarve og hvid tekst. Paa et
                       moerkt tema bliver navnet dermed usynligt, naar man
                       vaelger det. De tre noegler slukker den, saa det er
                       DataTriggeren paa ErValgt nedenfor, der tegner
                       markeringen - i temaets egne farver. -->
                  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                  <!-- MARKERINGSFARVEN SAETTES I TEMAET, ikke her. Der stod
                       «Color="{Binding Color, Source={DynamicResource Tekst}}"»,
                       og det er ulovligt: Source paa en Binding er ikke en
                       afhaengighedsegenskab. Det kastede foerst, naar
                       skabelonen skulle tegnes. Se Temaskift. -->
                </Style.Resources>
                <Setter Property="Padding" Value="2,1" />
                <Setter Property="AllowDrop" Value="True" />
                <Setter Property="Foreground" Value="{DynamicResource TekstSvag}" />
                <!-- Tovejsbinding: knuden husker selv, om den er foldet ud og
                     valgt, saa traeet ikke klapper sammen og mister sin
                     markering, hver gang det bygges forfra. -->
                <Setter Property="IsExpanded" Value="{Binding ErUdfoldet, Mode=TwoWay}" />
                <Setter Property="IsSelected" Value="{Binding ErValgt, Mode=TwoWay}" />
              </Style>
            </TreeView.ItemContainerStyle>

            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate ItemsSource="{Binding Boern}">
                <!-- Rammen er dropmaalet. Den lyser op, naar man holder noget
                     hen over den, saa man kan se HVOR man slipper. -->
                <Border x:Name="rk" CornerRadius="5" Padding="6,4" Background="Transparent"
                        AutomationProperties.Name="{Binding Visning}"
                        BorderThickness="1" BorderBrush="Transparent">
                  <!-- Hjaelpeteksten staar KUN paa optagelser - se
                       udloeseren for ErBeholder nedenfor. En mappe har ikke
                       noget tidsrum, og en tom boble er stoej.

                       To linjer: hvornaar, og hvor laenge. Raekken selv har
                       kun plads til en forkortet dato, og naar der ligger to
                       moeder paa samme dag, er det klokkeslaettet fra og til,
                       der afgoer, hvilket man leder efter. -->
                  <Border.ToolTip>
                    <StackPanel MaxWidth="360">
                      <TextBlock Text="{Binding Navn}" FontWeight="SemiBold" FontSize="13"
                                 TextWrapping="Wrap" Margin="0,0,0,6" />
                      <TextBlock Text="{Binding Optagelse.Tidsrum}" FontSize="12.5" />
                      <TextBlock Text="{Binding Optagelse.Varighed}" FontSize="12.5"
                                 Margin="0,3,0,0" />

                      <!-- KUN PÅ INDLÆSTE FILER. Tom tekst folder sig selv
                           væk, så en almindelig optagelse ser ud som før. -->
                      <TextBlock Text="{Binding Optagelse.Indlaestfra}" FontSize="12"
                                 Margin="0,6,0,0" TextWrapping="Wrap"
                                 Foreground="{DynamicResource TekstMeget}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Optagelse.Indlaestfra}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding Optagelse.Indlaestfra}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </Border.ToolTip>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Glyf}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,9,0"
                               Foreground="{DynamicResource Accent}" />
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Visning}" FontSize="12.5"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Under}" FontSize="11.5" Margin="0,1,0,0"
                                 Foreground="{DynamicResource TekstMeget}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Under}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <HierarchicalDataTemplate.Triggers>
                  <DataTrigger Binding="{Binding ErValgt}" Value="True">
                    <Setter TargetName="rk" Property="Background" Value="{DynamicResource Valgt}" />
                  </DataTrigger>
                  <!-- Beholdere har ingen hjaelpetekst: en mappe har intet
                       tidsrum, og en tom boble er stoej. -->
                  <DataTrigger Binding="{Binding ErBeholder}" Value="True">
                    <Setter TargetName="rk" Property="ToolTipService.IsEnabled" Value="False" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding ErDropmaal}" Value="True">
                    <Setter TargetName="rk" Property="Background" Value="{DynamicResource Valgt}" />
                    <Setter TargetName="rk" Property="BorderBrush" Value="{DynamicResource Accent}" />
                  </DataTrigger>
                </HierarchicalDataTemplate.Triggers>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch"
                    Background="Transparent" />

      <!-- ============================= Indholdet ====================== -->
      <Border Grid.Column="2" Background="{DynamicResource Panel}" CornerRadius="10"
              BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- ============ UDSKRIFT OG DOKUMENTER, SAMME OPTAGELSE ============

               HER LAA INTET. Udskriften stod her, og dokumenterne stod paa et
               MENUPUNKT FOR SIG. To indgange til det samme moede.

               Sammenhaengen var der i data hele tiden - hvert dokument baerer
               optagelsens id - men den var ikke noget, man kunne SE. Ville man
               vide, hvad der var lavet ud af et moede, skulle man gaa til
               «Dokumenter» og laese «Fra optagelse» paa hver enkelt.

               Nu er det to faner om den samme optagelse. Vaelger man en anden
               i traeet, foelger begge med.

               TALLET STAAR PAA FANEN. En fane, der bare hedder «Dokumenter»,
               siger ikke, om der er noget derinde - og saa skal man klikke for
               at finde ud af, at der ikke er. -->
          <Border Grid.Row="0" BorderBrush="{DynamicResource PanelKant}" BorderThickness="0,0,0,1"
                  Padding="20,12">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="FaneUdskrift" GroupName="indholdsfane" IsChecked="True"
                           Checked="Fane_Skiftet" Style="{StaticResource Fanevalg}"
                           Content="{i18n:Oversat transcribeview.udskrift}" Margin="0,0,8,0" />

              <!-- NAVNET STAAR HER OG IKKE KUN I KODEN.
                   Tallet saettes af OpdaterDokumentfane, som foerst koerer, naar
                   der er valgt en optagelse. Uden en tekst her stod knappen
                   TOM, hver gang man klikkede «Optagelser» i menuen og endnu
                   ikke havde valgt noget - en lille blank pille ved siden af
                   «Udskrift». Set 04-09-2026. -->
              <RadioButton x:Name="FaneDokumenter" GroupName="indholdsfane"
                           Checked="Fane_Skiftet" Style="{StaticResource Fanevalg}"
                           Content="{i18n:Oversat transcribeview.dokumenter}" Margin="0,0,8,0" />

              <!-- ============ HVAD DER ER SKET MED DEN HER ============

                   Den globale historik under «Historik» i menuen er et
                   driftslog: hvad appen har lavet, hvor laenge det tog, og om
                   det gik galt. Den her er en sagsmappe for eet moede - hvad
                   det hed foer, hvornaar det blev skrevet ud, hvilke
                   dokumenter der kom ud af det.

                   To spoergsmaal, to lister. Den globale kunne ikke bruges:
                   «Dokument oprettet» peger sin sti paa DOKUMENTETS mappe og
                   ikke paa optagelsens, og et navneskift blev slet ikke
                   skrevet ned. Der var ingen noegle at samle paa. -->
              <RadioButton x:Name="FaneHistorik" GroupName="indholdsfane"
                           Checked="Fane_Skiftet" Style="{StaticResource Fanevalg}"
                           Content="{i18n:Oversat transcribeview.historik}" />
            </StackPanel>
          </Border>

          <!-- FREMDRIFTEN NEDERST I INDHOLDSRUDEN.
               Den staar under den tekst, der forklarer hvad der sker, og den
               er kun fremme, mens der koeres. Baade transskription og
               dokumenter melder hertil, saa bjaelken ikke flytter sig alt
               efter, hvad man venter paa. -->
          <Border x:Name="Fremdriftsrude" Grid.Row="2" Visibility="Collapsed"
                  Background="{DynamicResource Valgt}" BorderBrush="{DynamicResource Accent}"
                  BorderThickness="0,1,0,0" CornerRadius="0,0,10,10" Padding="20,12">
            <StackPanel>
              <Grid>
                <TextBlock x:Name="Status" FontSize="12.5" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" Margin="0,0,60,0" />
                <TextBlock x:Name="Fremdriftstal" FontSize="12.5" HorizontalAlignment="Right"
                           Foreground="{DynamicResource Accent}" FontFamily="Consolas" />
              </Grid>
              <ProgressBar x:Name="Fremdrift" Height="5" Minimum="0" Maximum="100" Margin="0,9,0,0"
                           Background="{DynamicResource Svaev}" Foreground="{DynamicResource Accent}"
                           BorderThickness="0" />
            </StackPanel>
          </Border>

          <!-- ============ UDSKRIFTSFANEN SOM EEN BEHOLDER ============

               Forklaringen og resultatet skiftes ud efter, om optagelsen er
               skrevet ud - den logik ligger fem steder i kodebagsiden og er
               ikke roert. Fanevalget skjuler BEHOLDEREN, ikke de to hver for
               sig; ellers skulle hvert af de fem steder ogsaa kende fanen, og
               saa ville et af dem foer eller siden glemme den. -->
          <Grid x:Name="Udskriftsfane" Grid.Row="1">

          <!-- HorizontalScrollBarVisibility="Disabled" er ikke pynt: uden den
               maaler ScrollViewer sit indhold med UENDELIG bredde, og saa
               ombrydes teksten slet ikke. Foer holdt en MaxWidth paa 620
               teksten i en smal soejle og skjulte det - da den blev fjernet,
               saa man fejlen. -->
          <ScrollViewer x:Name="Forklaring" Padding="26,20,26,18"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <!-- Ingen MaxWidth. Der stod 620, og saa blev teksten staaende i
                 en smal soejle, naar man trak spalten bredere - pladsen blev
                 lavet, men ikke brugt. En laesekolonne paa en fast bredde er
                 paen i en artikel; her er det brugeren, der bestemmer
                 bredden ved at traekke i skillelinjen. -->
            <StackPanel HorizontalAlignment="Stretch">

              <TextBlock x:Name="ForklaringOverskrift" FontSize="19" FontWeight="SemiBold"
                         TextWrapping="Wrap" Text="{i18n:Oversat transcribeview.fra_lyd_til_tekst}" />
              <TextBlock x:Name="ForklaringUnder" FontSize="13.5" LineHeight="22" Margin="0,10,0,0"
                         TextWrapping="Wrap" Foreground="{DynamicResource TekstSvag}"
                         Text="{i18n:Oversat transcribeview.fold_foldere_ud_i_traeet_til_venstre_vaelg}" />

              <StackPanel Margin="0,22,0,0">
                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="1" FontSize="15" FontWeight="SemiBold"
                             Foreground="{DynamicResource Accent}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{i18n:Oversat transcribeview.modellen_indlaeses}" FontSize="13.5" FontWeight="SemiBold" />
                    <TextBlock FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,3,0,0"
                               Foreground="{DynamicResource TekstMeget}"
                               Text="{i18n:Oversat transcribeview.tager_typisk_et_halvt_minut_foerste_gang_d}" />
                  </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="2" FontSize="15" FontWeight="SemiBold"
                             Foreground="{DynamicResource Accent}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{i18n:Oversat transcribeview.lyden_skrives_ud}" FontSize="13.5" FontWeight="SemiBold" />
                    <TextBlock FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,3,0,0"
                               Foreground="{DynamicResource TekstMeget}"
                               Text="{i18n:Oversat transcribeview.fremdriften_staar_nederst_i_denne_rude_med}" />
                    <TextBlock FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{DynamicResource TekstMeget}"
                               Text="{i18n:Oversat transcribeview.var_moedet_online_blev_der_optaget_to_spor}" />
                  </StackPanel>
                </Grid>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="3" FontSize="15" FontWeight="SemiBold"
                             Foreground="{DynamicResource Accent}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{i18n:Oversat transcribeview.teksten_staar_her}" FontSize="13.5" FontWeight="SemiBold" />
                    <TextBlock FontSize="12.5" LineHeight="19" TextWrapping="Wrap" Margin="0,3,0,0"
                               Foreground="{DynamicResource TekstMeget}"
                               Text="{i18n:Oversat transcribeview.den_gemmes_automatisk_ved_siden_af_optagel}" />
                  </StackPanel>
                </Grid>
              </StackPanel>

              <Border Background="#334CBE72" BorderBrush="{DynamicResource Godkendt}" BorderThickness="1"
                      CornerRadius="10" Padding="16,13" Margin="0,22,0,0">
                <StackPanel>
                  <TextBlock Text="{i18n:Oversat transcribeview.du_kan_roligt_lave_noget_andet_imens}" FontSize="13"
                             FontWeight="SemiBold" Foreground="{DynamicResource Tekst}" />
                  <TextBlock FontSize="12.5" LineHeight="20" Margin="0,6,0,0" TextWrapping="Wrap"
                             Foreground="{DynamicResource Tekst}"
                             Text="{i18n:Oversat transcribeview.du_kan_lukke_skaermen_skifte_til_en_anden}" />
                </StackPanel>
              </Border>

              <TextBlock FontSize="12.5" LineHeight="20" Margin="2,18,0,0" TextWrapping="Wrap"
                         Foreground="{DynamicResource TekstMeget}"
                         Text="{i18n:Oversat transcribeview.teksten_bliver_ikke_perfekt_navne_og_fagor}" />
            </StackPanel>
          </ScrollViewer>

          <!-- HER LAA EN SKRIVEBESKYTTET TEKSTBLOK.
               Udskriften kunne laeses og intet andet. Nu er den en liste af
               replikker med tidsstempel og taler, og hver enkelt kan rettes.

               Det er ikke bare bekvemmeligt: kan man finpudse teksten selv,
               kan man tit noejes med at kopiere det, man skal bruge - uden at
               bede en sprogmodel om noget, og dermed uden at sende noget ud af
               maskinen overhovedet. -->
          <local:UdskriftView x:Name="Resultat" Visibility="Collapsed" />
          </Grid>

          <!-- Dokumenterne fra den samme optagelse. Bygget een gang og
               fyldt op ved hvert skift af optagelse - se Vis(). -->
          <local:Dokumentrude x:Name="Dokumentrude" Grid.Row="1" Visibility="Collapsed" />

          <!-- ============ OPTAGELSENS EGEN HISTORIK ============
               Nyeste oeverst. Tidspunktet staar i sin egen spalte med fast
               bredde, saa linjerne flugter og kan skimmes lodret. -->
          <Grid x:Name="Historikfane" Grid.Row="1" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,12,0">
              <StackPanel Margin="20,16,20,20">

                <TextBlock x:Name="IngenHistorik" Style="{StaticResource Underskrift}"
                           TextWrapping="Wrap" LineHeight="21" Visibility="Collapsed"
                           Text="{i18n:Oversat transcribeview.historik_tom}" />

                <ItemsControl x:Name="Historikrude">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{DynamicResource Trykket}"
                              BorderBrush="{DynamicResource PanelKant}"
                              BorderThickness="1" CornerRadius="6" Margin="0,0,0,6">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>

                          <Border Grid.Column="0" Background="{Binding Farve}"
                                  CornerRadius="5,0,0,5" />

                          <Grid Grid.Column="1" Margin="14,11,14,11">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="128" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                              <TextBlock Text="{Binding Klokken}" FontSize="13"
                                         FontFamily="Consolas" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding Dato}" FontSize="11" Margin="0,2,0,0"
                                         Foreground="{DynamicResource TekstMeget}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                              <TextBlock Text="{Binding Hvad}" FontSize="12.5"
                                         TextWrapping="Wrap" />
                              <TextBlock Text="{Binding Detaljer}" FontSize="11.5"
                                         Margin="0,3,0,0" TextWrapping="Wrap"
                                         Visibility="{Binding Detaljervis}"
                                         Foreground="{DynamicResource TekstSvag}" />
                            </StackPanel>
                          </Grid>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>

      <!-- ==================== SENESTE OPTAGELSER ======================

           En optagelse, der aldrig blev skrevet ud, er et hul i arkivet - og
           det opdager man ikke ved at lede efter det. Her staar de nyeste med
           en gul kant, hvis teksten mangler.

           Kun de seks nyeste. Listen er en paamindelse, ikke et arkiv; hele
           arkivet staar i traeet til venstre. -->
      <Border Grid.Column="4" Background="{DynamicResource Panel}" CornerRadius="10"
              BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{i18n:Oversat transcribeview.seneste_optagelser}" FontSize="11"
                     FontWeight="SemiBold" Margin="14,13,14,8"
                     Foreground="{DynamicResource TekstMeget}" />

          <ScrollViewer Padding="7,0,7,10" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <ItemsControl x:Name="Senesterude">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Tag="{Binding}" Click="Seneste_Klik" Cursor="Hand"
                            HorizontalContentAlignment="Stretch" Margin="0,0,0,5"
                            BorderThickness="0" Padding="0" Background="Transparent">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="kort" Background="{DynamicResource Trykket}" CornerRadius="6"
                                  BorderBrush="{Binding Kant}" BorderThickness="3,0,0,0"
                                  Padding="11,8">
                            <ContentPresenter />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="kort" Property="Background" Value="{DynamicResource Svaev}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>

                      <StackPanel>
                        <TextBlock Text="{Binding Titel}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Tekst}" />
                        <TextBlock Text="{Binding Under}" FontSize="11.5" Margin="0,3,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TekstMeget}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock x:Name="IngenOptagelser" FontSize="12" Margin="4,6,4,0"
                         TextWrapping="Wrap" LineHeight="18" Visibility="Collapsed"
                         Foreground="{DynamicResource TekstSvag}"
                         Text="{i18n:Oversat transcribeview.der_er_ikke_optaget_noget_endnu_tryk_optag}" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
