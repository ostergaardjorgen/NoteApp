<UserControl x:Class="NoteApp.Desktop.Transcribe.UdskriftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:NoteApp.Desktop"
             xmlns:local="clr-namespace:NoteApp.Desktop">

  <!-- ================== UDSKRIFTEN, SOM MAN KAN RETTE I ==================

       Kan man finpudse teksten selv, kan man i mange tilfælde nøjes med at
       kopiere det, man skal bruge — uden at bede en sprogmodel om noget, og
       dermed uden at sende noget ud af maskinen overhovedet. -->

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ===================== Værktøjslinjen =====================

         SØGEFELTET STÅR YDERST TIL VENSTRE.
         Her stod navnefelterne før, og de blev læst som en søgning — hvilket
         er den rigtige forventning: et felt øverst til venstre i en tekst er
         en søgning. Navngivningen er flyttet til sin egen knap. -->
    <Border x:Name="Hoved" Grid.Row="0" Background="#FF1B2029"
            BorderBrush="{StaticResource PanelKant}" BorderThickness="0,0,0,1"
            Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FF12151B" CornerRadius="6"
                BorderBrush="{StaticResource PanelKant}" BorderThickness="1"
                Width="240" HorizontalAlignment="Left" Padding="4">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="Soeg" Grid.Column="0" FontSize="12.5" Padding="8,5"
                     BorderThickness="0" Background="Transparent"
                     TextChanged="Soeg_Aendret" KeyDown="Soeg_Tast" />
            <TextBlock x:Name="SoegPladsholder" Grid.Column="0" IsHitTestVisible="False"
                       FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource TekstMeget}"
                       Text="{i18n:Oversat udskriftview.soeg_i_transkriptionen}" />

            <!-- Krydset rydder feltet i eet klik. Et soegeord paa tyve tegn
                 skal ellers slettes tegn for tegn, eller markeres foerst - og
                 det er nok til, at man lader det staa og glemmer, at listen
                 stadig er filtreret. Escape goer det samme. -->
            <Button x:Name="SoegRyd" Grid.Column="1" Content="✕" Click="SoegRyd_Klik"
                    Visibility="Collapsed" Cursor="Hand" FontSize="11"
                    Padding="0" BorderThickness="0" Background="Transparent"
                    Width="24" Height="24" Margin="0,0,3,0"
                    ToolTip="{i18n:Oversat faelles.ryd_soegningen_escape}">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="flade" CornerRadius="12" Background="Transparent">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="flade" Property="Background" Value="#FF2C323D" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </Grid>
        </Border>

        <!-- ================= AFGRÆNSNING PÅ TALER =================
             Den staar ved siden af soegningen, fordi den goer det samme:
             skaerer udskriften ned til det, man leder efter. De to virker
             sammen - «alt hvad Espen sagde om pipeline» er begge dele paa
             een gang.

             Den vises kun, naar der ER nogen at vaelge imellem. Med een
             taler ville den vaere en rulleliste med eet punkt. -->
        <ComboBox x:Name="Talervalg" Grid.Column="1" Width="160" Margin="10,0,0,0"
                  FontSize="12.5" VerticalAlignment="Center" Visibility="Collapsed"
                  SelectionChanged="Taler_Valgt"
                  ToolTip="{i18n:Oversat udskriftview.vis_kun_det_en_taler_sagde}" />

        <TextBlock x:Name="SoegStatus" Grid.Column="2" FontSize="11.5" VerticalAlignment="Center"
                   Margin="12,0,0,0" Foreground="{StaticResource TekstMeget}" />

        <!-- HER LAA «NAVNGIV TALERE».
             Den aabnede en raekke felter i en rude for sig, hvor man skulle
             regne ud, hvilket felt der hoerte til hvilken stemme. Navngivningen
             sidder nu paa taleren selv: man klikker paa «Gæst 2» i teksten og
             skriver navnet dér. Rettelsen slaar igennem alle steder, den stemme
             taler. -->

        <Button Grid.Column="3" Content="{i18n:Oversat udskriftview.kopier}" Click="Kopier_Klik"
                Padding="12,6" FontSize="12.5"
                ToolTip="{i18n:Oversat udskriftview.kopier_transkriptionen_med_eller_uden_tids}">
          <Button.ContextMenu>
            <ContextMenu x:Name="Kopimenu">
              <MenuItem Header="{i18n:Oversat udskriftview.kopier_med_tidsstempel_og_taler}" Click="KopierAlt_Klik" />
              <MenuItem Header="{i18n:Oversat udskriftview.kopier_med_tidsstempel}" Click="KopierTid_Klik" />
              <MenuItem Header="{i18n:Oversat udskriftview.kopier_kun_teksten}" Click="KopierRen_Klik" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </Grid>
    </Border>

    <!-- ===================== Navngivningen =====================
         Den åbner VED den taler, man klikkede på, og lukker af sig selv.
         Navnet hører til den ene stemme, så ruden skal heller ikke handle om
         andet end den. -->
    <Popup x:Name="Navnerude" Placement="Bottom" StaysOpen="False"
           AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-6">
      <Border Background="#FF1D2530" BorderBrush="{StaticResource Accent}"
              BorderThickness="1" CornerRadius="9" Padding="14,12" Margin="8">
        <Border.Effect>
          <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.5" Color="#FF000000" />
        </Border.Effect>
        <StackPanel Width="264">
          <TextBlock x:Name="NavnTitel" FontSize="13" FontWeight="SemiBold" />
          <TextBlock x:Name="NavnUnder" FontSize="11.5" TextWrapping="Wrap" LineHeight="18"
                     Margin="0,5,0,0" Foreground="{StaticResource TekstSvag}" />

          <!-- ============ HENFØR ÉN REPLIK TIL EN KENDT TALER ============
               Maskinen kan ikke altid knytte en replik til en stemme - et kort
               indskud paa to ord giver for lidt at gaa efter. Uden det her
               ville man skrive navnet i feltet nedenunder, og saa navngav man
               HELE sporet: der ville staa to «Espen» i baade rullelisten og
               statistikken, med hver sin taletid.

               Her flyttes kun den ene replik. -->
          <StackPanel x:Name="HenfoerRude" Visibility="Collapsed" Margin="0,12,0,0">
            <TextBlock Text="{i18n:Oversat udskriftview.laeg_replikken_hos}" FontSize="9.5" FontWeight="SemiBold"
                       Foreground="{StaticResource Accent}" />

            <ItemsControl x:Name="Henfoer" Margin="0,7,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Content="{Binding Navn}" Tag="{Binding Noegle}" Click="Henfoer_Klik"
                          Padding="11,5" FontSize="12" Margin="0,0,6,6" Cursor="Hand" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock FontSize="11" TextWrapping="Wrap" LineHeight="17"
                       Foreground="{StaticResource TekstMeget}"
                       Text="{i18n:Oversat udskriftview.kun_denne_ene_replik_flyttes_de_oevrige_ro}" />

            <!-- ============ ELLER DEM ALLE SAMMEN ============
                 De replikker, maskinen ikke kunne placere, er typisk korte
                 indskud - «Ja. Ja.», «Mm.» - og de kommer sjaeldent enkeltvis.
                 Otte klik for otte stumper er for meget, og saa lader man dem
                 staa; saa bliver «Gæster» ved med at vaere en gruppe i baade
                 rullelisten og statistikken.

                 Raekken staar kun, naar der ER mere end een tilbage. -->
            <StackPanel x:Name="HenfoerAlleRude" Visibility="Collapsed" Margin="0,12,0,0">
              <TextBlock x:Name="HenfoerAlleMaerkat" FontSize="9.5" FontWeight="SemiBold"
                         Foreground="{StaticResource TekstMeget}" />

              <ItemsControl x:Name="HenfoerAlle" Margin="0,7,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Content="{Binding Navn}" Tag="{Binding Noegle}"
                            Click="HenfoerAlle_Klik" Padding="11,5" FontSize="12"
                            Margin="0,0,6,6" Cursor="Hand" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <Rectangle Height="1" Fill="{StaticResource PanelKant}" Margin="0,12,0,0" />
          </StackPanel>

          <TextBlock x:Name="NavnFeltMaerkat" FontSize="9.5" FontWeight="SemiBold"
                     Margin="0,12,0,0" Visibility="Collapsed"
                     Foreground="{StaticResource TekstMeget}" />

          <TextBox x:Name="NavnFelt" FontSize="13" Padding="9,6" Margin="0,7,0,0"
                   KeyDown="Navn_Tast" />

          <StackPanel Orientation="Horizontal" Margin="0,11,0,0" HorizontalAlignment="Right">
            <Button Content="{i18n:Oversat udskriftview.fjern_navnet}" Click="NavnRyd_Klik" Padding="11,5"
                    FontSize="12" Margin="0,0,8,0" />
            <Button Content="{i18n:Oversat udskriftview.gem}" Click="NavnGem_Klik" Padding="16,5"
                    FontSize="12" FontWeight="SemiBold" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Popup>

    <!-- ===================== Fanerne ===================== -->
    <TabControl x:Name="Faner" Grid.Row="2" Style="{StaticResource Fanerude}"
                Background="Transparent" BorderThickness="0">

      <TabItem Header="{i18n:Oversat udskriftview.redigeret_tekst}" Style="{StaticResource Fane}">
        <ScrollViewer x:Name="Rude" Padding="8,10,8,20"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock x:Name="IntetFundet" FontSize="13" Margin="10,20,10,0"
                       TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{StaticResource TekstSvag}" />

            <!-- ============ LYDEN KOM UDEFRA ============

                 En optagelse herfra har to sider, HERFRA og DERFRA, og hele
                 udskriften bygger på det: hvem der sagde hvad, navnene på
                 talerne, fletningen af de to spor.

                 En fil fra en telefon har ét spor. Alt står under den samme
                 taler, uanset hvor mange der var med — og det kan ikke
                 skilles ad bagefter. Står det ikke her, opdages det først,
                 når nogen undrer sig over, at gæsten aldrig siger noget. -->
            <Border x:Name="Indlaestnote" Visibility="Collapsed"
                    Background="#FF1D2530" CornerRadius="0,6,6,0"
                    BorderBrush="{StaticResource Accent}" BorderThickness="3,0,0,0"
                    Padding="12,9" Margin="4,6,4,14">
              <TextBlock x:Name="Indlaesttekst" FontSize="12" TextWrapping="Wrap"
                         LineHeight="19" Foreground="{StaticResource TekstSvag}" />
            </Border>

            <ItemsControl x:Name="Liste">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                 <StackPanel>

                  <!-- ============ HVOR ET TRÆF BEGYNDER ============
                       Ved en soegning vises replikken FOER og EFTER hvert
                       traef, saa man kan se sammenhaengen. Uden en tydelig
                       adskillelse ville de tre-linjers stumper loebe sammen til
                       een lang liste, og saa kan man ikke se, hvor det ene
                       resultat slutter og det naeste begynder.

                       Overskriften taeller traeffene, saa man ved, hvor mange
                       der er, og hvor langt man er naaet. -->
                  <StackPanel Visibility="{Binding BlokSynlig}" Margin="0,26,0,12">

                    <!-- Stregen gaar helt ud i begge sider. Et maerkat alene
                         var for spinkelt: blokkene laa taet, og oejet loeb
                         videre uden at registrere skiftet. En streg tvaers over
                         ruden er det, der faktisk skiller to ting ad. -->
                    <Rectangle Height="1" Fill="#FF303845" Margin="4,0,4,0" />

                    <Border Background="#FF1D2530" CornerRadius="0,6,6,0"
                            BorderBrush="{StaticResource Accent}" BorderThickness="3,0,0,0"
                            Padding="11,6" HorizontalAlignment="Left"
                            Margin="4,-11,0,0">
                      <TextBlock Text="{Binding Bloktitel}" FontSize="10.5"
                                 FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                    </Border>
                  </StackPanel>

                  <Border CornerRadius="7" Padding="10,7" Margin="0,0,0,3"
                          Background="Transparent" BorderThickness="2,0,0,0"
                          BorderBrush="Transparent">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" MinWidth="26" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>

                      <!-- Tidsstemplet staar i margen og ikke inde i teksten.
                           Saa kan man loebe listen igennem paa tid uden at
                           laese. -->
                      <TextBlock Grid.Column="0" Text="{Binding Tid}" FontSize="11"
                                 FontFamily="Consolas" VerticalAlignment="Top"
                                 Margin="0,4,12,0" Foreground="{StaticResource TekstMeget}" />

                      <!-- TALEREN ER EN KNAP.
                           Navngivningen laa foer bag en knap i vaerktoejslinjen,
                           som aabnede en raekke felter. Det var et sted at gaa
                           hen for at rette noget, man sad og kiggede paa - og
                           man skulle selv finde ud af, hvilket felt der svarede
                           til hvilken stemme. Nu klikker man paa den, det
                           handler om. -->
                      <Button Grid.Column="1" Click="Taler_Klik" Cursor="Hand"
                              VerticalAlignment="Top" Margin="0,2,12,0"
                              Padding="0" BorderThickness="0" Background="Transparent"
                              ToolTip="{Binding Hjaelp}"
                              AutomationProperties.Name="{Binding Navn}">
                        <Button.Template>
                          <ControlTemplate TargetType="Button">
                            <Border x:Name="flade" CornerRadius="6" Padding="5,3"
                                    Background="Transparent">
                              <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="flade" Property="Background" Value="#FF262D3A" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Button.Template>

                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Ikon}" FontFamily="Segoe MDL2 Assets"
                                     FontSize="13" VerticalAlignment="Center"
                                     Foreground="{Binding Farve}"
                                     Visibility="{Binding IkonSynlig}" />
                          <TextBlock Text="{Binding Navn}" FontSize="12" FontWeight="SemiBold"
                                     VerticalAlignment="Center" Margin="6,0,0,0"
                                     Foreground="{Binding Farve}"
                                     Visibility="{Binding NavnSynlig}" />
                        </StackPanel>
                      </Button>

                      <!-- ============ DEN GULE MARKERING ============
                           En TextBox kan ikke give enkelte ord en baggrund.
                           Derfor ligger der en TextBlock BAG feltet med samme
                           skrift, samme stoerrelse og samme ombrydning, hvor
                           det soegte ord staar gult - og selve feltets tekst
                           goeres gennemsigtig, mens der soeges.

                           Feltet bliver ved at virke: markoeren staar der,
                           man kan rette, og markeringen tegnes om, naar
                           teksten aendrer sig. Kun farven flytter. -->
                      <Grid Grid.Column="2">
                        <TextBlock FontSize="13.5" TextWrapping="Wrap"
                                   Visibility="{Binding FremhaevSynlig}"
                                   Foreground="{StaticResource Tekst}"
                                   Loaded="Fremhaev_Ind" Unloaded="Fremhaev_Ud" />

                        <TextBox Text="{Binding Tekst, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13.5" TextWrapping="Wrap"
                                 AcceptsReturn="True" BorderThickness="0" Padding="0"
                                 Background="Transparent"
                                 Foreground="{Binding Tekstfarve}"
                                 CaretBrush="{StaticResource Tekst}"
                                 VerticalScrollBarVisibility="Disabled"
                                 HorizontalScrollBarVisibility="Disabled" />
                      </Grid>
                    </Grid>

                    <Border.Style>
                      <Style TargetType="Border">
                        <Style.Triggers>
                          <!-- En rettet replik faar en streg i margen. Ikke en
                               anden baggrund: rettede og urettede skal kunne
                               staa i samme liste, uden at listen bliver til
                               to lister. -->
                          <DataTrigger Binding="{Binding Rettet}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                  </Border>
                 </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============ OPSUMMERINGEN ============
           Den lille vej. Dokumenterne er den store: vaelg skabelon, giv det
           et navn, faa en Word-fil. Opsummeringen er ti linjer om, hvad
           moedet handlede om - til at huske det, ikke til at sende videre.

           DEN LAVES IKKE AF SIG SELV. At lave den sender udskriften til
           Mistral, og det maa aldrig ske, fordi man klikkede paa en fane. -->
      <TabItem Header="{i18n:Oversat faelles.opsummering}" Style="{StaticResource Fane}">
        <Grid>
          <ScrollViewer x:Name="OpsumRude" Padding="18,14,18,18" Visibility="Collapsed"
                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <Grid Margin="0,0,0,12">
                <TextBlock x:Name="OpsumHoved" FontSize="11.5" VerticalAlignment="Center"
                           TextWrapping="Wrap" Foreground="{StaticResource TekstMeget}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Content="{i18n:Oversat udskriftview.kopier_2}" Click="OpsumKopier_Klik" Padding="12,6"
                          FontSize="12" Margin="0,0,8,0" />
                  <Button Content="{i18n:Oversat udskriftview.lav_den_om}" Click="OpsumLokal_Klik" Padding="12,6"
                          FontSize="12" />
                </StackPanel>
              </Grid>

              <TextBlock x:Name="OpsumAdvarsel" FontSize="12" TextWrapping="Wrap" LineHeight="19"
                         Margin="0,0,0,12" Visibility="Collapsed"
                         Foreground="{StaticResource Advarsel}" />

              <!-- ============ EFTERPRØVNINGEN ============

                   Hver påstand i opsummeringen slås op i udskriften. Det, der
                   ikke kan findes, står her.

                   Målt 20-08-2026: en lokal model skrev «allerede seks kunder i
                   Danmark» om et møde, hvor ordene ikke faldt én eneste gang.
                   Det læses som et faktum. Opslaget tager millisekunder, og
                   kilden ligger på maskinen — så der er ingen grund til at lade
                   være.

                   Der SLETTES ikke noget. En påstand kan være rigtig, selvom
                   ordene står anderledes; at fjerne den ville være at rette en
                   fejl, der måske ikke er der. -->
              <Border x:Name="OpsumTjek" Visibility="Collapsed" Margin="0,0,0,12"
                      Background="#FF2A2318" CornerRadius="7" Padding="12,9"
                      BorderBrush="{StaticResource Advarsel}" BorderThickness="0,0,0,2">
                <StackPanel>
                  <TextBlock x:Name="OpsumTjekTitel" FontSize="12" FontWeight="SemiBold"
                             Foreground="{StaticResource Advarsel}" />
                  <TextBlock x:Name="OpsumTjekListe" FontSize="12" TextWrapping="Wrap"
                             LineHeight="19" Margin="0,5,0,0"
                             Foreground="{StaticResource Tekst}" />
                  <TextBlock FontSize="11" TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0"
                             Foreground="{StaticResource TekstMeget}"
                             Text="{i18n:Oversat udskriftview.det_kan_godt_vaere_rigtigt_alligevel_orden}" />
                </StackPanel>
              </Border>

              <TextBox x:Name="OpsumTekst" IsReadOnly="True" FontSize="13.5" TextWrapping="Wrap"
                       BorderThickness="0" Background="Transparent" Padding="0"
                       Foreground="{StaticResource Tekst}"
                       VerticalScrollBarVisibility="Disabled"
                       HorizontalScrollBarVisibility="Disabled" />
            </StackPanel>
          </ScrollViewer>

          <StackPanel x:Name="OpsumTom" VerticalAlignment="Center" HorizontalAlignment="Center"
                      MaxWidth="480">
            <!-- Overskrift og forklaring sættes i koden: et webinar spørges om
                 noget andet end et møde. «Hvad blev der besluttet» er et
                 spørgsmål uden svar, når nogen har undervist i en time. -->
            <TextBlock x:Name="OpsumOverskrift" Text="{i18n:Oversat udskriftview.hvad_handlede_moedet_om}" FontSize="17"
                       FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock x:Name="OpsumForklaring" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap"
                       LineHeight="21" TextAlignment="Center" Foreground="{StaticResource TekstSvag}"
                       Text="{i18n:Oversat udskriftview.en_kort_opsummering_paa_ti_linjer_hvad_der}" />

            <!-- ============ TO VEJE, OG FORSKELLEN STÅR DER ============

                 Tallene er målt 20-08-2026 på det samme møde på en time.
                 Mistral: 25 sekunder. Qwen3-4B på maskinen: 76 sekunder.

                 Den lokale fandt på et tal, der aldrig blev sagt — «allerede
                 seks kunder i Danmark» — og missede mødets eneste aftale. Det
                 står der, fordi valget ellers ikke kan træffes. Efterprøvningen
                 fanger tal og navne, der ikke er i udskriften, uanset hvilken
                 vej der blev brugt. -->
            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- LOKALT STÅR FØRST.
                   Det er den vej, der ikke sender noget nogen steder, og
                   rækkefølgen er i sig selv en anbefaling. Skyen er der, når
                   teksten skal være bedre end kort. -->
              <Border Grid.Column="0" Background="#FF181B22" CornerRadius="9" Padding="14,12"
                      Margin="0,0,7,0" BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
                <StackPanel>
                  <TextBlock Text="{i18n:Oversat udskriftview.paa_maskinen}" FontSize="9.5" FontWeight="SemiBold"
                             Foreground="{StaticResource Accent}" />
                  <TextBlock x:Name="OpsumLokalTekst" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                             Margin="0,6,0,0" Foreground="{StaticResource TekstSvag}"
                             Text="{i18n:Oversat udskriftview.cirka_et_halvt_minut_intet_forlader_maskin}" />
                  <Button x:Name="OpsumLokalKnap" Content="{i18n:Oversat udskriftview.kort_lokal_opsummering}"
                          Click="OpsumLokal_Klik" Margin="0,12,0,0" Padding="14,8"
                          Style="{StaticResource Primaer}" />
                </StackPanel>
              </Border>

              <!-- HER LÅ «LAV DET I SKYEN», OG DEN ER FJERNET.
                   Den gjorde det samme som et dokument, bare uden skabelon og
                   uden et navn at gemme det under — to veje til det samme, hvor
                   den ene var ringere. Skal teksten være et rigtigt referat,
                   er dokumenter vejen, og så skal skærmen sige hvor. -->
              <Border Grid.Column="1" Background="#FF181B22" CornerRadius="9" Padding="14,12"
                      Margin="7,0,0,0" BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
                <StackPanel>
                  <TextBlock Text="{i18n:Oversat udskriftview.skal_det_vaere_et_referat}" FontSize="9.5" FontWeight="SemiBold"
                             Foreground="{StaticResource TekstMeget}" />
                  <TextBlock FontSize="12" LineHeight="18" TextWrapping="Wrap" Margin="0,6,0,0"
                             Foreground="{StaticResource TekstSvag}"
                             Text="{i18n:Oversat udskriftview.et_rigtigt_moedereferat_en_opgaveliste_ell}" />
                  <TextBlock FontSize="12" LineHeight="18" TextWrapping="Wrap" Margin="0,8,0,0"
                             Foreground="{StaticResource TekstMeget}"
                             Text="{i18n:Oversat udskriftview.tryk_opret_dokument_oeverst_til_hoejre_moe}" />
                </StackPanel>
              </Border>
            </Grid>

            <TextBlock x:Name="OpsumStatus" FontSize="12" Margin="0,12,0,0"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{StaticResource TekstMeget}" />
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- RAA TEKST ER IKKE PYNT.
           Har man rettet i en udskrift, er spoergsmaalet et halvt aar senere,
           om en formulering er ens egen eller maskinens. Her staar maskinens
           ord, uroerte, som de kom ud. -->
      <!-- ===================== Opgaverne =====================

           MASKINEN FORESLÅR, DU AFGØR.

           Der står ingen sprogmodel bag fundene. Målt 17-08-2026 havde den
           lokale model 12 % dækning og fandt selv på navne; en opgaveliste,
           der stille mangler syv af otte, er værre end ingen, fordi man
           stoler på den. Appen leder i stedet efter det, folk FAKTISK siger,
           når de påtager sig noget — «jeg sender», «kan du», «inden fredag».

           Den tager for meget med. Det er den rigtige vej at fejle, når et
           menneske alligevel skal sige ja eller nej til hvert forslag. -->
      <TabItem Header="{i18n:Oversat udskriftview.opgaver_2}" Style="{StaticResource Fane}">
        <DockPanel>

          <Border DockPanel.Dock="Top" Background="#FF1B2029" Padding="16,10"
                  BorderBrush="{StaticResource PanelKant}" BorderThickness="0,0,0,1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <Button Grid.Column="0" x:Name="FindOpgaverKnap" Content="{i18n:Oversat udskriftview.find_opgaver}"
                      Click="FindOpgaver_Klik" Padding="14,7" FontSize="12.5"
                      Style="{StaticResource Primaer}"
                      ToolTip="{i18n:Oversat udskriftview.gennemgaa_transkriptionen_igen_for_steder}" />

              <TextBlock Grid.Column="1" x:Name="OpgaveStatus" FontSize="11.5"
                         VerticalAlignment="Center" Margin="14,0,0,0"
                         TextWrapping="Wrap" Foreground="{StaticResource TekstMeget}" />

              <CheckBox Grid.Column="2" x:Name="VisSvage" Content="{i18n:Oversat udskriftview.vis_ogsaa_svage_forslag}"
                        Click="VisSvage_Klik" VerticalAlignment="Center" FontSize="12" />
            </Grid>
          </Border>

          <ScrollViewer Padding="16,12,16,20" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

              <!-- De oprettede opgaver. -->
              <TextBlock x:Name="OpgaveOverskrift" Text="{i18n:Oversat udskriftview.opgaver}" FontSize="10.5"
                         FontWeight="SemiBold" Margin="2,0,0,8" Visibility="Collapsed"
                         Foreground="{StaticResource Accent}" />

              <ItemsControl x:Name="Opgaverude">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#FF181B22" CornerRadius="8" Padding="14,11" Margin="0,0,0,7"
                            BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,14,0">

                          <!-- NAVNET OEVERST, FORDI DET ER DET, MAN SER ANDRE
                               STEDER. Listerne viser navnet; hele teksten
                               laeses foerst, naar man standser op ved den ene.
                               Staar navnet nederst, retter man det aldrig. -->
                          <TextBox Text="{Binding Navn, UpdateSourceTrigger=PropertyChanged}"
                                   FontSize="13" FontWeight="SemiBold"
                                   BorderThickness="0" Padding="0" Background="Transparent"
                                   Foreground="{StaticResource Tekst}"
                                   ToolTip="{i18n:Oversat udskriftview.det_korte_navn_det_der_staar_paa_listen_i}" />

                          <TextBox Text="{Binding Tekst, UpdateSourceTrigger=PropertyChanged}"
                                   FontSize="12.5" TextWrapping="Wrap" AcceptsReturn="True"
                                   Margin="0,4,0,0"
                                   BorderThickness="0" Padding="0" Background="Transparent"
                                   Foreground="{StaticResource TekstSvag}"
                                   ToolTip="{i18n:Oversat udskriftview.hele_opgaven_det_der_blev_sagt}" />
                          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding Ejer}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource Accent}"
                                       Visibility="{Binding EjerSynlig}" />
                            <TextBlock Text="{Binding Kilde}" FontSize="11" Margin="10,0,0,0"
                                       FontFamily="Consolas" Foreground="{StaticResource TekstMeget}" />
                          </StackPanel>
                        </StackPanel>

                        <!-- Deadline er DET ENESTE felt. Se Opgave: en liste,
                             der kraever syv felter, bliver ikke udfyldt. -->
                        <DatePicker Grid.Column="1" SelectedDate="{Binding Deadline}"
                                    VerticalAlignment="Top" Width="132" FontSize="12"
                                    ToolTip="{i18n:Oversat udskriftview.senest_dato_kan_staa_tom}" />

                        <Button Grid.Column="2" Content="✕" Click="SletOpgave_Klik"
                                Tag="{Binding Id}" Margin="8,0,0,0" Padding="8,4"
                                VerticalAlignment="Top" FontSize="11" Cursor="Hand"
                                ToolTip="{i18n:Oversat udskriftview.slet_opgaven}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Button x:Name="NyOpgaveKnap" Content="{i18n:Oversat udskriftview.tilfoej_en_opgave_i_haanden}"
                      Click="NyOpgave_Klik" HorizontalAlignment="Left" Margin="0,4,0,0"
                      Padding="12,6" FontSize="12"
                      ToolTip="{i18n:Oversat udskriftview.til_en_der_ikke_var_med_paa_moedet_det_kan}" />

              <!-- Forslagene, der ikke er taget stilling til endnu. -->
              <TextBlock x:Name="ForslagOverskrift" Text="{i18n:Oversat udskriftview.forslag}" FontSize="10.5"
                         FontWeight="SemiBold" Margin="2,26,0,8" Visibility="Collapsed"
                         Foreground="{StaticResource Accent}" />

              <ItemsControl x:Name="Forslagliste">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#FF14181F" CornerRadius="8" Padding="14,11" Margin="0,0,0,8"
                            BorderBrush="#FF2A313D" BorderThickness="1">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                          <TextBlock Text="{Binding Taler}" FontSize="11.5" FontWeight="SemiBold"
                                     Foreground="{StaticResource Accent}" />
                          <TextBlock Text="{Binding Tid}" FontSize="11" FontFamily="Consolas"
                                     Margin="10,0,0,0" Foreground="{StaticResource TekstMeget}" />
                          <TextBlock Text="{Binding Grund}" FontSize="11" Margin="14,0,0,0"
                                     Foreground="{StaticResource TekstMeget}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Tekst}" FontSize="13" TextWrapping="Wrap"
                                   LineHeight="20" Foreground="{StaticResource Tekst}" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                          <Button Content="{i18n:Oversat udskriftview.opret_opgave}" Click="OpretOpgave_Klik"
                                  Tag="{Binding Noegle}" Padding="13,6" FontSize="12"
                                  Style="{StaticResource Primaer}" Cursor="Hand" />
                          <Button Content="{i18n:Oversat udskriftview.ikke_en_opgave}" Click="AfvisOpgave_Klik"
                                  Tag="{Binding Noegle}" Padding="13,6" FontSize="12"
                                  Margin="8,0,0,0" Cursor="Hand" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock x:Name="OpgaveTom" FontSize="13" TextWrapping="Wrap" LineHeight="21"
                         Margin="2,18,0,0" Visibility="Collapsed"
                         Foreground="{StaticResource TekstSvag}" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- ===================== Tallene =====================
           Kort med vilje. Der er tre ting, man vil vide efter et møde: hvornår
           det var, hvor længe det varede, og hvem der fyldte. Alt andet er
           noget, man kan læse sig til i selve udskriften. -->
      <TabItem Header="{i18n:Oversat udskriftview.tal}" Style="{StaticResource Fane}">
        <ScrollViewer Padding="18,16,18,18" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel>

            <!-- Mødet: hvornår og hvor længe -->
            <Border Background="#FF181B22" CornerRadius="10" Padding="20,16"
                    BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="{i18n:Oversat udskriftview.moedet}" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{StaticResource Accent}" Margin="0,0,0,10" />

                <TextBlock x:Name="StatDato" FontSize="16" FontWeight="SemiBold" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <StackPanel Margin="0,0,34,0">
                    <TextBlock Text="{i18n:Oversat udskriftview.begyndte}" FontSize="9.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TekstMeget}" />
                    <TextBlock x:Name="StatStart" FontSize="19" FontFamily="Consolas"
                               Margin="0,3,0,0" />
                  </StackPanel>
                  <StackPanel Margin="0,0,34,0">
                    <TextBlock Text="{i18n:Oversat udskriftview.sluttede}" FontSize="9.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TekstMeget}" />
                    <TextBlock x:Name="StatSlut" FontSize="19" FontFamily="Consolas"
                               Margin="0,3,0,0" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="{i18n:Oversat udskriftview.varighed}" FontSize="9.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TekstMeget}" />
                    <TextBlock x:Name="StatVarighed" FontSize="19" FontFamily="Consolas"
                               Margin="0,3,0,0" Foreground="{StaticResource Accent}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Taletiden pr. taler -->
            <Border Background="#FF181B22" CornerRadius="10" Padding="20,16" Margin="0,14,0,0"
                    BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="{i18n:Oversat udskriftview.taletid}" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{StaticResource Accent}" Margin="0,0,0,14" />

                <ItemsControl x:Name="StatTalere">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,13">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="120" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Navn}" FontSize="13"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                                   Foreground="{Binding Farve}" />

                        <!-- Bjaelken er baggrund plus forgrund i samme celle.
                             Saa staar alle bjaelker lige lange paa skaermen, og
                             det, oejet sammenligner, er den fyldte del. -->
                        <Grid Grid.Column="1" Height="16" VerticalAlignment="Center">
                          <Border Background="#FF232A35" CornerRadius="4" />
                          <Border Background="{Binding Farve}" CornerRadius="4"
                                  HorizontalAlignment="Left" Width="{Binding Bredde}" />
                        </Grid>

                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="16,0,0,0">
                          <TextBlock Text="{Binding Minutter}" FontSize="13" FontFamily="Consolas"
                                     VerticalAlignment="Center" MinWidth="74"
                                     TextAlignment="Right" />
                          <TextBlock Text="{Binding Procent}" FontSize="13" FontWeight="SemiBold"
                                     FontFamily="Consolas" VerticalAlignment="Center"
                                     MinWidth="52" TextAlignment="Right"
                                     Foreground="{StaticResource TekstSvag}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="StatNote" FontSize="11.5" TextWrapping="Wrap" LineHeight="18"
                           Margin="0,4,0,0" Foreground="{StaticResource TekstMeget}" />
              </StackPanel>
            </Border>

            <TextBlock x:Name="StatTom" FontSize="13" TextWrapping="Wrap" Margin="2,16,0,0"
                       Visibility="Collapsed" Foreground="{StaticResource TekstSvag}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{i18n:Oversat udskriftview.raa_tekst}" Style="{StaticResource Fane}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" FontSize="11.5" Margin="10,8,10,10"
                     TextWrapping="Wrap" Foreground="{StaticResource TekstMeget}"
                     Text="{i18n:Oversat udskriftview.maskinens_egne_ord_som_de_kom_ud_uden_dine}" />
          <TextBox x:Name="RaaTekst" IsReadOnly="True" FontSize="12.5" TextWrapping="Wrap"
                   BorderThickness="0" Background="Transparent" Padding="10,0,10,10"
                   Foreground="{StaticResource TekstSvag}"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Disabled" />
        </DockPanel>
      </TabItem>
    </TabControl>

    <!-- ============ NÅR DER IKKE ER NOGEN UDSKRIFT ============

         Her stod INTET. Valgte man en optagelse, der ikke var skrevet ud,
         blev fanerne stående tomme — ingen tekst, ingen forklaring, ingen
         knap. Man kunne ikke se forskel på «den er ikke skrevet ud endnu»,
         «den er i gang» og «noget er gået galt».

         Ruden ligger OVEN PÅ fanerne i samme række, så den dækker dem helt.
         En halvtom fane bagved ville se ud som et resultat. -->
    <Border x:Name="IngenUdskrift" Grid.Row="2" Visibility="Collapsed"
            Background="{StaticResource Baggrund}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520"
                  Margin="30">
        <TextBlock x:Name="IngenOverskrift" FontSize="15" FontWeight="SemiBold"
                   TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
        <TextBlock x:Name="IngenTekst" FontSize="12.5" LineHeight="21" TextWrapping="Wrap"
                   Margin="0,10,0,0" TextAlignment="Center"
                   Foreground="{StaticResource TekstMeget}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
