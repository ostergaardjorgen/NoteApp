<UserControl x:Class="NoteApp.Desktop.Transcribe.UdskriftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ================== UDSKRIFTEN, SOM MAN KAN RETTE I ==================

       Udskriften var indtil nu én tekstblok, man kun kunne læse. Den er nu en
       liste af replikker med tidsstempel og taler, og hver enkelt kan rettes.

       HVORFOR DET BETYDER NOGET UD OVER BEKVEMMELIGHED

       Kan man finpudse teksten selv, kan man i mange tilfælde nøjes med at
       kopiere det, man skal bruge — uden at bede en sprogmodel om noget, og
       dermed uden at sende noget ud af maskinen overhovedet. Redigering er
       ikke bare en bekvemmelighed; det er den funktion, der kan gøre skyen
       unødvendig for en stor del af arbejdet. -->

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ===================== Talernavne og status ===================== -->
    <Border x:Name="Hoved" Grid.Row="0" Background="#FF1B2029"
            BorderBrush="{StaticResource PanelKant}" BorderThickness="0,0,0,1"
            Padding="20,11">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="Navnefelter" Grid.Column="0" Orientation="Horizontal">
          <TextBlock Text="HVEM TALTE" FontSize="10.5" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="0,0,12,0"
                     Foreground="{StaticResource TekstMeget}" />

          <TextBlock Text="Herfra" FontSize="11.5" VerticalAlignment="Center"
                     Margin="0,0,6,0" Foreground="{StaticResource TekstMeget}" />
          <TextBox x:Name="NavnHerfra" Width="150" FontSize="12.5" Padding="8,4"
                   Margin="0,0,16,0" TextChanged="Navn_Aendret"
                   ToolTip="Dit navn — og navnet på dem, der sad i samme lokale" />

          <TextBlock Text="Derfra" FontSize="11.5" VerticalAlignment="Center"
                     Margin="0,0,6,0" Foreground="{StaticResource TekstMeget}" />
          <TextBox x:Name="NavnDerfra" Width="180" FontSize="12.5" Padding="8,4"
                   TextChanged="Navn_Aendret"
                   ToolTip="De øvrige deltagere. Skriv gerne flere navne — der kan være flere personer bag sporet" />
        </StackPanel>

        <TextBlock x:Name="Status" Grid.Column="1" FontSize="11.5"
                   VerticalAlignment="Center" Margin="16,0,0,0"
                   Foreground="{StaticResource TekstMeget}" />
      </Grid>
    </Border>

    <ScrollViewer x:Name="Rude" Grid.Row="1" Padding="14,12,14,20"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="Liste">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border x:Name="rk" CornerRadius="7" Padding="10,7" Margin="0,0,0,3"
                    Background="Transparent" BorderThickness="2,0,0,0"
                    BorderBrush="Transparent">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Tidsstemplet staar i margen og ikke inde i teksten. Saa
                     kan man loebe listen igennem paa tid uden at laese. -->
                <TextBlock Grid.Column="0" Text="{Binding Tid}" FontSize="11"
                           FontFamily="Consolas" VerticalAlignment="Top"
                           Margin="0,4,12,0" Foreground="{StaticResource TekstMeget}" />

                <TextBlock Grid.Column="1" Text="{Binding Hvem}" FontSize="12"
                           FontWeight="SemiBold" VerticalAlignment="Top"
                           Margin="0,3,12,0" MinWidth="70"
                           Foreground="{Binding Farve}"
                           Visibility="{Binding HvemSynlig}" />

                <TextBox Grid.Column="2" Text="{Binding Tekst, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="13.5" TextWrapping="Wrap"
                         AcceptsReturn="True" BorderThickness="0" Padding="0"
                         Background="Transparent" Foreground="{StaticResource Tekst}"
                         VerticalScrollBarVisibility="Disabled"
                         HorizontalScrollBarVisibility="Disabled" />
              </Grid>

              <Border.Style>
                <Style TargetType="Border">
                  <Style.Triggers>
                    <!-- En rettet replik faar en streg i margen. Ikke en anden
                         baggrund: rettede og urettede skal kunne staa i den
                         samme liste, uden at listen bliver til to lister. -->
                    <DataTrigger Binding="{Binding Rettet}" Value="True">
                      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
