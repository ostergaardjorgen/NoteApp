<Window x:Class="NoteApp.Desktop.Transcribe.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Omdøb optagelse" Height="230" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Baggrund}">

  <StackPanel Margin="24">
    <TextBlock Text="Hvad skal optagelsen hedde?" FontSize="17" FontWeight="SemiBold" />
    <TextBlock Style="{StaticResource Underskrift}" Margin="0,6,0,0" TextWrapping="Wrap"
               Text="Kun navnet ændres. Mappen på disken bliver liggende, så dokumenter, der allerede er lavet, stadig kan finde tilbage." />

    <TextBox x:Name="Felt" Margin="0,16,0,0" FontSize="15" Padding="10,8" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="Annullér" Click="Annuller_Click" Padding="18,9" Margin="0,0,10,0" IsCancel="True" />
      <Button Content="Gem navnet" Click="Gem_Click" Padding="20,9" IsDefault="True"
              Background="{StaticResource Accent}" Foreground="#FF0B1220" BorderThickness="0"
              FontWeight="SemiBold" />
    </StackPanel>
  </StackPanel>
</Window>
