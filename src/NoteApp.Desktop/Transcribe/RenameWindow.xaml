<Window x:Class="NoteApp.Desktop.Transcribe.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:NoteApp.Desktop"
        x:Name="Vindue" Width="520" SizeToContent="Height" MinHeight="220"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Baggrund}">
  <!-- SizeToContent frem for en fast højde: en fast højde holder kun ved
       præcis den skriftstørrelse og skalering, den blev prøvet på, og med
       NoResize er der ingen vej ud, hvis den ikke passer. -->

  <StackPanel Margin="26">
    <TextBlock x:Name="Overskrift" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock x:Name="Forklaring" Style="{StaticResource Underskrift}" Margin="0,8,0,0"
               TextWrapping="Wrap" LineHeight="20" />

    <TextBox x:Name="Felt" Margin="0,18,0,0" FontSize="15" Padding="12,10" />

    <TextBlock x:Name="Hjaelp" FontSize="12" Margin="2,8,0,0" TextWrapping="Wrap"
               Foreground="{DynamicResource TekstMeget}" />

    <Grid Margin="0,22,0,0">
      <!-- Kassér står til VENSTRE og alene. Den er den eneste handling her,
           der ikke kan fortrydes, og den skal ikke ligge ved siden af den, man
           trykker på hver gang. -->
      <Button x:Name="KasserKnap" Content="{i18n:Oversat renamewindow.kasser_optagelsen}" Click="Kasser_Click"
              HorizontalAlignment="Left" Padding="16,9" Visibility="Collapsed"
              Foreground="{DynamicResource Optager}" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="AnnullerKnap" Content="{i18n:Oversat faelles.annuller}" Click="Annuller_Click" Padding="18,9"
              Margin="0,0,10,0" IsCancel="True" />
      <Button x:Name="GemKnap" Content="{i18n:Oversat renamewindow.gem_navnet}" Click="Gem_Click" Padding="22,9" IsDefault="True"
              Background="{DynamicResource Accent}" Foreground="{DynamicResource PaaAccent}" BorderThickness="0"
              FontWeight="SemiBold" />
    </StackPanel>
    </Grid>
  </StackPanel>
</Window>
