<Window x:Class="NoteApp.Desktop.Projekter.TilknytVindue"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:NoteApp.Desktop"
        Title="{i18n:Oversat tilknytvindue.titel}"
        Height="640" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Baggrund}">

  <!-- ======================= TILKNYT =======================

       Der KOPIERES ingenting. Vinduet saetter medlemskaber: projektet husker,
       at et moede hoerer med, og moedet bliver liggende under Optagelser.
       Se NoteApp.Core.Projekt for hvorfor det er den eneste vej, der holder.

       HAKKENE ER SAT EFTER DET, DER ALLEREDE ER TILKNYTTET, og OK skriver
       hele listen. Saa er «fjern» og «tilfoej» den samme handling, og der er
       ingen tredje tilstand, hvor skaermen og filen er uenige. -->

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="{i18n:Oversat tilknytvindue.titel}" Style="{StaticResource Overskrift}" />
      <TextBlock Style="{StaticResource Underskrift}" TextWrapping="Wrap"
                 Text="{i18n:Oversat tilknytvindue.under}" />
    </StackPanel>

    <Border Grid.Row="1" Background="{DynamicResource Panel}" CornerRadius="10"
            BorderBrush="{DynamicResource PanelKant}" BorderThickness="1" Padding="18">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
        <StackPanel>

          <TextBlock Text="{i18n:Oversat tilknytvindue.optagelser}"
                     FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8" />

          <ItemsControl x:Name="Optagelser">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding Valgt, Mode=TwoWay}" Margin="0,0,0,7">
                  <StackPanel>
                    <TextBlock Text="{Binding Navn}" FontSize="12.5" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Linje}" FontSize="11.5" Margin="0,2,0,0"
                               Foreground="{DynamicResource TekstMeget}" />
                  </StackPanel>
                </CheckBox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock x:Name="IngenOptagelser" Style="{StaticResource Underskrift}"
                     Visibility="Collapsed"
                     Text="{i18n:Oversat tilknytvindue.intet_at_vaelge}" />

          <TextBlock Text="{i18n:Oversat tilknytvindue.noter}"
                     FontSize="12.5" FontWeight="SemiBold" Margin="0,20,0,8" />

          <ItemsControl x:Name="Noter">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox IsChecked="{Binding Valgt, Mode=TwoWay}" Margin="0,0,0,7">
                  <StackPanel>
                    <TextBlock Text="{Binding Navn}" FontSize="12.5" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Linje}" FontSize="11.5" Margin="0,2,0,0"
                               Foreground="{DynamicResource TekstMeget}" />
                  </StackPanel>
                </CheckBox>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock x:Name="IngenNoter" Style="{StaticResource Underskrift}"
                     Visibility="Collapsed"
                     Text="{i18n:Oversat tilknytvindue.intet_at_vaelge}" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <Button Content="{i18n:Oversat faelles.annuller}" Click="Annuller_Klik"
              Padding="18,7" Margin="0,0,10,0" IsCancel="True" />
      <Button Content="{i18n:Oversat tilknytvindue.tilknyt}" Click="Tilknyt_Klik"
              Padding="20,7" Style="{StaticResource Primaer}" IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>
