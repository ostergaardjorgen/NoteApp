<UserControl x:Class="NoteApp.Desktop.Compliance.ComplianceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:NoteApp.Desktop"
             Background="{DynamicResource Baggrund}">

  <!-- ======================= HVORFOR SKÆRMEN FINDES =====================

       Oplysningerne stod spredt: modellernes licenser i koden, Mistrals
       vilkår i doc/mistral-dpa.md, målingerne i doc/maaling-sky.md. Skal man
       svare en indkøber, en revisor eller en databeskyttelsesrådgiver, skal
       de tre steder findes og læses sammen — og så bliver svaret formet af,
       hvad man huskede.

       Her står det samlet, og det står som det ER: hvor data går hen, hvem
       der kan røre dem, og hvilke licenser der følger med. Ingen af tallene
       er nye — de kommer fra dokumenterne i repoet, og datoen for hver
       gennemgang står ved siden af, så man kan se, hvor gammelt svaret er.

       DER STÅR IKKE «VI ER GDPR-COMPLIANT». Det er ikke noget, en app kan
       erklære om sin bruger. Der står, hvad der sker med data, og hvad
       leverandøren har forpligtet sig til. Konklusionen er brugerens. -->

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="{i18n:Oversat complianceview.compliance}" Style="{StaticResource Overskrift}" />
      <TextBlock Style="{StaticResource Underskrift}"
                 Text="{i18n:Oversat complianceview.hvor_dine_data_gaar_hen_hvem_der_kan_roere}" />
    </StackPanel>

    <!-- FANER FREM FOR EN LANG RULLE.
         Siden var over to skaerme lang, og det, der betyder mest - hvad vi
         ved, og hvad vi ikke ved - laa oeverst og forsvandt, saa snart man
         rullede. En compliance-side laeses ikke forfra hver gang; man kommer
         med eet spoergsmaal og skal kunne finde svaret.

         Fanerne er de fem spoergsmaal, folk faktisk stiller: hvad ved vi,
         hvem er leverandoeren, hvem roerer data, hvad koerer vi paa, og hvad
         staar der med smaat. Samme fanestil som skabelonruden - se
         Fanerude i App.xaml. -->
    <TabControl Grid.Row="1" Style="{StaticResource Fanerude}">

      <TabItem Header="{i18n:Oversat complianceview.overblik}" Style="{StaticResource Fane}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
    <!-- ============ Det, vi ved, og det, vi ikke ved =============
                 Den staar OEVERST og ikke som en fodnote. En compliance-side, der
                 foerst opregner alt det betryggende og saa til sidst tager
                 forbehold, er skrevet for at berolige. Tvivlen hoerer til dér,
                 hvor man laeser foerst.

                 At leverandoeren er europaeisk er ikke det samme som, at
                 databehandlingen ER efterproevet europaeisk. Det er hele
                 forskellen, og den skal staa. -->
            <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="20,16"
                    BorderBrush="{DynamicResource Advarsel}" BorderThickness="2" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="{i18n:Oversat complianceview.laes_dette_foerst}" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource Advarsel}" Margin="0,0,0,8" />

                <TextBlock FontSize="13.5" LineHeight="22" TextWrapping="Wrap" FontWeight="SemiBold"
                           Text="{i18n:Oversat complianceview.leverandoeren_er_europaeisk_det_er_ikke_de}" />

                <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{DynamicResource TekstSvag}"
                           Text="{i18n:Oversat complianceview.mistral_ai_er_fransk_og_underlagt_gdpr_dir}" />

                <!-- DET, DER ER EFTERPROEVET OG SIKKERT, SKAL OGSAA STAA
                     OEVERST. Rammen her er en advarsel, og en advarsel uden
                     det, man kan stole paa, giver et skaevt billede: tvivlen
                     gaelder ét skridt i kaeden - teksten - og ikke lyden. -->
                <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{DynamicResource Godkendt}" FontWeight="SemiBold"
                           Text="{i18n:Oversat complianceview.tvivlen_gaelder_teksten_den_gaelder_ikke_l}" />

                <Grid Margin="0,16,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <Border Grid.Column="0" Background="{DynamicResource GodkendtFlade}" BorderBrush="{DynamicResource Godkendt}"
                          BorderThickness="1" CornerRadius="8" Padding="16,13">
                    <StackPanel>
                      <TextBlock Text="{i18n:Oversat complianceview.det_der_er_efterproevet}" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Godkendt}" Margin="0,0,0,10" />
                      <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap"
                                 Foreground="{DynamicResource TekstSvag}"
                                 Text="{i18n:Oversat complianceview.lyd_og_transkription_forlader_aldrig_maski}" />
                      <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,7,0,0"
                                 Foreground="{DynamicResource TekstSvag}"
                                 Text="{i18n:Oversat complianceview.appen_kan_kun_kalde_det_europaeiske_endepu}" />
                      <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,7,0,0"
                                 Foreground="{DynamicResource TekstSvag}"
                                 Text="{i18n:Oversat complianceview.mistral_ai_er_et_fransk_selskab_underlagt}" />
                      <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,7,0,0"
                                 Foreground="{DynamicResource TekstSvag}"
                                 Text="{i18n:Oversat complianceview.databehandleraftalen_gaelder_automatisk_de}" />
                      <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,7,0,0"
                                 Foreground="{DynamicResource TekstSvag}"
                                 Text="{i18n:Oversat complianceview.traening_paa_dine_data_kan_fravaelges_og_f}" />
                      <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,7,0,0"
                                 Foreground="{DynamicResource TekstSvag}"
                                 Text="{i18n:Oversat complianceview.iso_iec_27001_iso_iec_27701_og_soc_2_type}" />
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="2" Background="{DynamicResource FejlFlade}" BorderBrush="{DynamicResource FejlTekst}"
                          BorderThickness="1" CornerRadius="8" Padding="16,13">
                    <StackPanel>
                      <TextBlock Text="{i18n:Oversat complianceview.det_der_er_uafklaret}" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{DynamicResource FejlTekst}" Margin="0,0,0,10" />
                      <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap"
                                 Foreground="{DynamicResource TekstSvag}"
                                 Text="{i18n:Oversat complianceview.om_behandlingen_kontraktligt_er_bundet_til}" />
                      <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,7,0,0"
                                 Foreground="{DynamicResource TekstSvag}"
                                 Text="{i18n:Oversat complianceview.om_cloudflares_worldwide_og_crowdstrikes_u}" />
                      <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,7,0,0"
                                 Foreground="{DynamicResource TekstSvag}"
                                 Text="{i18n:Oversat complianceview.om_listen_har_aendret_sig_siden_17_08_2026}" />
                      <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,7,0,0"
                                 Foreground="{DynamicResource TekstSvag}"
                                 Text="{i18n:Oversat complianceview.hvor_laenge_den_enkelte_api_anmodning_opbe}" />
                      <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,7,0,0"
                                 Foreground="{DynamicResource TekstSvag}"
                                 Text="{i18n:Oversat complianceview.hvad_der_faktisk_sker_hos_de_amerikansk_ej}" />
                    </StackPanel>
                  </Border>
                </Grid>

                <Border Background="{DynamicResource Trykket}" CornerRadius="8" Padding="16,12" Margin="0,14,0,0"
                        BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
                  <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap"
                             Foreground="{DynamicResource Tekst}"
                             Text="{i18n:Oversat complianceview.hvad_det_betyder_i_praksis_loesningen_er_e}" />
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{i18n:Oversat complianceview.hvor_data_gaar_hen_2}" Style="{StaticResource Fane}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
    <!-- ==================== Datastrømmen ========================= -->
            <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="20,16"
                    BorderBrush="{DynamicResource PanelKant}" BorderThickness="1" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="{i18n:Oversat complianceview.hvor_data_gaar_hen}" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TekstMeget}" Margin="0,0,0,12" />

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <Border Grid.Column="0" Background="{DynamicResource GodkendtFlade}" BorderBrush="{DynamicResource Godkendt}"
                          BorderThickness="1" CornerRadius="8" Padding="16,13">
                    <StackPanel>
                      <TextBlock Text="{i18n:Oversat complianceview.lyd_og_transkription}" FontSize="14" FontWeight="SemiBold" />
                      <TextBlock Text="{i18n:Oversat complianceview.bliver_paa_denne_pc}" FontSize="12.5" Margin="0,4,0,0"
                                 Foreground="{DynamicResource Godkendt}" FontWeight="SemiBold" />
                      <TextBlock FontSize="12.5" LineHeight="20" Margin="0,8,0,0" TextWrapping="Wrap"
                                 Foreground="{DynamicResource TekstSvag}"
                                 Text="{i18n:Oversat complianceview.optagelsen_laves_lokalt_og_whisper_skriver}" />
                    </StackPanel>
                  </Border>

                  <TextBlock Grid.Column="1" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                             VerticalAlignment="Center" Margin="14,0"
                             Foreground="{DynamicResource PanelKant}" />

                  <Border Grid.Column="2" Background="{DynamicResource AccentFlade}" BorderBrush="{DynamicResource Accent}"
                          BorderThickness="1" CornerRadius="8" Padding="16,13">
                    <StackPanel>
                      <TextBlock Text="{i18n:Oversat complianceview.den_faerdige_tekst}" FontSize="14" FontWeight="SemiBold" />
                      <TextBlock x:Name="SkyLinje" FontSize="12.5" Margin="0,4,0,0"
                                 Foreground="{DynamicResource Accent}" FontWeight="SemiBold" />
                      <TextBlock FontSize="12.5" LineHeight="20" Margin="0,8,0,0" TextWrapping="Wrap"
                                 Foreground="{DynamicResource TekstSvag}"
                                 Text="{i18n:Oversat complianceview.skal_der_laves_et_referat_eller_et_andet_d}" />
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </Border>

            <!-- ============ HVORFOR DET ER LYDEN, DER TAELLER ============
                 Det staerkeste argument for den her app stod ingen steder:
                 forskellen paa en lydfil og en tekst er ikke en gradsforskel.

                 FORMULERINGEN ER EFTERPROEVET OG BEVIDST FORSIGTIG. En
                 stemmeoptagelse er ikke i sig selv biometriske data efter
                 forordningen - den bliver det, naar den behandles med det
                 formaal at identificere nogen entydigt. Paastanden "en stemme
                 ER biometriske data" ville vaere forkert, og en overdrivelse
                 paa netop den her side er vaerre end ingen tekst. -->
            <Border Background="{DynamicResource GodkendtFlade}" BorderBrush="{DynamicResource Godkendt}" BorderThickness="1"
                    CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="{i18n:Oversat complianceview.derfor_betyder_det_noget_at_det_er_lyden_d}"
                           FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock FontSize="12.5" LineHeight="21" Margin="0,8,0,14" TextWrapping="Wrap"
                           Foreground="{DynamicResource TekstSvag}"
                           Text="{i18n:Oversat complianceview.forskellen_paa_en_lydfil_og_en_transkripti}" />

                <TextBlock Text="{i18n:Oversat complianceview.lyden_kan_blive_til_biometri_teksten_kan_i}" FontSize="13.5"
                           FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,0,0,12"
                           Foreground="{DynamicResource TekstSvag}"
                           Text="{i18n:Oversat complianceview.en_stemmeoptagelse_er_personoplysninger_bl}" />

                <TextBlock Text="{i18n:Oversat complianceview.lyden_indeholder_mere_end_ordene}" FontSize="13.5"
                           FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,0,0,12"
                           Foreground="{DynamicResource TekstSvag}"
                           Text="{i18n:Oversat complianceview.hvem_der_talte_kan_hoeres_ogsaa_naar_navne}" />

                <TextBlock Text="{i18n:Oversat complianceview.fortael_altid_deltagerne_at_du_optager}" FontSize="13.5"
                           FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,0,0,10"
                           Foreground="{DynamicResource TekstSvag}"
                           Text="{i18n:Oversat complianceview.sig_det_inden_moedet_gaar_i_gang_det_er_go}" />
                <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap"
                           Foreground="{DynamicResource TekstSvag}"
                           Text="{i18n:Oversat complianceview.og_du_kan_sige_mere_end_at_du_optager_du_k}" />

                <Border Background="{DynamicResource GodkendtFlade}" BorderBrush="{DynamicResource Godkendt}" BorderThickness="0,1,0,0"
                        Padding="0,12,0,0" Margin="0,14,0,0">
                  <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap"
                             Foreground="{DynamicResource Tekst}"
                             Text="{i18n:Oversat complianceview.det_er_et_designvalg_ikke_en_begraensning}" />
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{i18n:Oversat complianceview.leverandoeren}" Style="{StaticResource Fane}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
    <!-- ==================== Leverandøren ========================= -->
            <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="20,16"
                    BorderBrush="{DynamicResource PanelKant}" BorderThickness="1" Margin="0,0,0,14">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <TextBlock Text="{i18n:Oversat complianceview.leverandoeren_mistral_ai}" FontSize="10.5" FontWeight="SemiBold"
                             Foreground="{DynamicResource TekstMeget}" VerticalAlignment="Center" />
                  <TextBlock Text="{i18n:Oversat complianceview.vilkaar_gennemgaaet_17_08_2026}" FontSize="11"
                             HorizontalAlignment="Right" VerticalAlignment="Center"
                             Foreground="{DynamicResource TekstMeget}" />
                </Grid>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{i18n:Oversat complianceview.selskab}" Margin="0,0,28,0"
                             FontSize="12.5" Foreground="{DynamicResource TekstMeget}" />
                  <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12.5" TextWrapping="Wrap"
                             Text="{i18n:Oversat complianceview.mistral_ai_fransk_selskab_med_adresse_i_pa}" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{i18n:Oversat complianceview.databehandleraftale}" Margin="0,9,28,0"
                             FontSize="12.5" Foreground="{DynamicResource TekstMeget}" />
                  <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12.5" Margin="0,9,0,0" TextWrapping="Wrap"
                             Text="{i18n:Oversat complianceview.gaelder_automatisk_incorporated_to_the_agr}" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="{i18n:Oversat complianceview.endepunkt}" Margin="0,9,28,0"
                             FontSize="12.5" Foreground="{DynamicResource TekstMeget}" />
                  <TextBlock Grid.Row="2" Grid.Column="1" x:Name="Endepunkt" FontSize="12.5"
                             Margin="0,9,0,0" TextWrapping="Wrap" FontFamily="Consolas" />

                  <TextBlock Grid.Row="3" Grid.Column="0" Text="{i18n:Oversat complianceview.certificeringer}" Margin="0,9,28,0"
                             FontSize="12.5" Foreground="{DynamicResource TekstMeget}" />
                  <TextBlock Grid.Row="3" Grid.Column="1" FontSize="12.5" Margin="0,9,0,0" TextWrapping="Wrap"
                             Text="{i18n:Oversat complianceview.iso_iec_27001_iso_iec_27701_og_soc_2_type_2}" />

                  <TextBlock Grid.Row="4" Grid.Column="0" Text="{i18n:Oversat complianceview.opbevaring}" Margin="0,9,28,0"
                             FontSize="12.5" Foreground="{DynamicResource TekstMeget}" />
                  <TextBlock Grid.Row="4" Grid.Column="1" FontSize="12.5" Margin="0,9,0,0" TextWrapping="Wrap"
                             Text="{i18n:Oversat complianceview.aftalens_punkt_10_1_personoplysninger_er_u}" />

                  <TextBlock Grid.Row="5" Grid.Column="0" Text="{i18n:Oversat complianceview.traening_paa_dine_data}" Margin="0,9,28,0"
                             FontSize="12.5" Foreground="{DynamicResource TekstMeget}" />
                  <TextBlock Grid.Row="5" Grid.Column="1" FontSize="12.5" Margin="0,9,0,0" TextWrapping="Wrap"
                             Foreground="{DynamicResource Advarsel}"
                             Text="{i18n:Oversat complianceview.aftalen_mistral_maa_behandle_oplysningerne}" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                  <Button Content="{i18n:Oversat complianceview.databehandleraftalen}" Click="Dpa_Klik" Padding="14,7" Margin="0,0,8,0"
                          ToolTip="{i18n:Oversat complianceview.aabner_legal_mistral_ai_hvor_databehandler}" />
                  <Button Content="{i18n:Oversat complianceview.trust_center}" Click="Trust_Klik" Padding="14,7" Margin="0,0,8,0"
                          ToolTip="{i18n:Oversat complianceview.aabner_trust_mistral_ai_med_certificeringe}" />
                  <Button Content="{i18n:Oversat complianceview.din_konto}" Click="Konsol_Klik" Padding="14,7"
                          ToolTip="{i18n:Oversat complianceview.aabner_console_mistral_ai_hvor_du_slaar_tr}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{i18n:Oversat complianceview.underdatabehandlere}" Style="{StaticResource Fane}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
    <!-- ============== Det, der kræver præcision ================== -->
            <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="20,16"
                    BorderBrush="{DynamicResource Advarsel}" BorderThickness="1" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="{i18n:Oversat complianceview.det_der_kraever_praecision_i_formuleringen}" FontSize="10.5"
                           FontWeight="SemiBold" Foreground="{DynamicResource Advarsel}" Margin="0,0,0,10" />

                <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap"
                           Foreground="{DynamicResource TekstSvag}"
                           Text="{i18n:Oversat complianceview.listen_i_trust_center_er_gennemgaaet_navn}" />

                <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{DynamicResource TekstSvag}"
                           Text="{i18n:Oversat complianceview.tilbage_i_selve_behandlingskaeden_mistral}" />

                <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{DynamicResource FejlTekst}" FontWeight="SemiBold"
                           Text="{i18n:Oversat complianceview.to_undtagelser_er_vaerd_at_kende_crowdstri}" />

                <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{DynamicResource TekstSvag}"
                           Text="{i18n:Oversat complianceview.bortset_fra_google_skelner_listen_ikke_mel}" />

                <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{DynamicResource TekstSvag}"
                           Text="{i18n:Oversat complianceview.ejerskabet_er_den_anden_halvdel_microsoft}" />

                <Border Background="{DynamicResource Trykket}" CornerRadius="8" Padding="16,13" Margin="0,14,0,0"
                        BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
                  <StackPanel>
                    <TextBlock Text="{i18n:Oversat complianceview.det_der_kan_siges_og_som_holder_hele_vejen}" FontSize="12.5"
                               FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock FontSize="13" LineHeight="22" TextWrapping="Wrap"
                               Foreground="{DynamicResource Tekst}"
                               Text="{i18n:Oversat complianceview.optagelse_og_transskription_forlader_aldri}" />
                    <TextBlock FontSize="12" LineHeight="20" TextWrapping="Wrap" Margin="0,10,0,0"
                               Foreground="{DynamicResource TekstMeget}"
                               Text="{i18n:Oversat complianceview.ingen_amerikansk_virksomhed_er_involveret}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ================= ANDRE INTEGRATIONER =====================
           EN EGEN FANE, FORDI DET ER EN ANDEN SLAGS AFTALE.

           Resten af siden handler om Mistral: en leverandoer, appen SENDER
           noget til. En kalenderintegration er det modsatte - data ligger der
           i forvejen, og appen henter dem ned. Blandes de to sammen paa den
           samme side, laeser man den ene som den anden, og saa er begge
           forklaret forkert. -->
      <TabItem Header="{i18n:Oversat complianceview.andre_integrationer}" Style="{StaticResource Fane}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>

            <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="20,16"
                    BorderBrush="{DynamicResource PanelKant}" BorderThickness="1" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="{i18n:Oversat complianceview.den_anden_vej_rundt}" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TekstMeget}" Margin="0,0,0,10" />

                <TextBlock FontSize="13" LineHeight="22" TextWrapping="Wrap"
                           Foreground="{DynamicResource TekstSvag}"
                           Text="{i18n:Oversat complianceview.resten_af_denne_side_handler_om_det_appen}" />

                <TextBlock FontSize="13" LineHeight="22" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{DynamicResource TekstSvag}"
                           Text="{i18n:Oversat complianceview.har_du_valgt_google_workspace_eller_micros}" />

