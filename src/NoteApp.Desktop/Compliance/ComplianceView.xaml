<UserControl x:Class="NoteApp.Desktop.Compliance.ComplianceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Baggrund}">

  <!-- ======================= HVORFOR SKÆRMEN FINDES =====================

       Oplysningerne stod spredt: modellernes licenser i koden, Mistrals
       vilkår i doc/mistral-dpa.md, målingerne i doc/maaling-sky.md. Skal man
       svare en indkøber, en revisor eller en databeskyttelsesrådgiver, skal
       de tre steder findes og læses sammen — og så bliver svaret formet af,
       hvad man huskede.

       Her står det samlet, og det står som det ER: hvor data går hen, hvem
       der kan røre dem, og hvilke licenser der følger med. Ingen af tallene
       er nye — de kommer fra dokumenterne i repoet, og datoen for hver
       gennemgang står ved siden af, så man kan se, hvor gammelt svaret er.

       DER STÅR IKKE «VI ER GDPR-COMPLIANT». Det er ikke noget, en app kan
       erklære om sin bruger. Der står, hvad der sker med data, og hvad
       leverandøren har forpligtet sig til. Konklusionen er brugerens. -->

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="Compliance" Style="{StaticResource Overskrift}" />
      <TextBlock Style="{StaticResource Underskrift}"
                 Text="Hvor dine data går hen, hvem der kan røre dem, og hvilke licenser der følger med." />
    </StackPanel>

    <!-- FEM FANER FREM FOR EN LANG RULLE.
         Siden var over to skaerme lang, og det, der betyder mest - hvad vi
         ved, og hvad vi ikke ved - laa oeverst og forsvandt, saa snart man
         rullede. En compliance-side laeses ikke forfra hver gang; man kommer
         med eet spoergsmaal og skal kunne finde svaret.

         Fanerne er de fem spoergsmaal, folk faktisk stiller: hvad ved vi,
         hvem er leverandoeren, hvem roerer data, hvad koerer vi paa, og hvad
         staar der med smaat. Samme fanestil som skabelonruden - se
         Fanerude i App.xaml. -->
    <TabControl Grid.Row="1" Style="{StaticResource Fanerude}">

      <TabItem Header="Overblik" Style="{StaticResource Fane}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
    <!-- ============ Det, vi ved, og det, vi ikke ved =============
                 Den staar OEVERST og ikke som en fodnote. En compliance-side, der
                 foerst opregner alt det betryggende og saa til sidst tager
                 forbehold, er skrevet for at berolige. Tvivlen hoerer til dér,
                 hvor man laeser foerst.

                 At leverandoeren er europaeisk er ikke det samme som, at
                 databehandlingen ER efterproevet europaeisk. Det er hele
                 forskellen, og den skal staa. -->
            <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="20,16"
                    BorderBrush="{StaticResource Advarsel}" BorderThickness="2" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="LÆS DETTE FØRST" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{StaticResource Advarsel}" Margin="0,0,0,8" />

                <TextBlock FontSize="13.5" LineHeight="22" TextWrapping="Wrap" FontWeight="SemiBold"
                           Text="Leverandøren er europæisk. Det er ikke det samme som, at databehandlingen er efterprøvet europæisk." />

                <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{StaticResource TekstSvag}"
                           Text="Mistral AI er fransk og underlagt GDPR direkte. Men de to dokumenter, der juridisk binder — databehandleraftalen og de kommercielle vilkår — forpligter ikke behandlingen til et bestemt område, og de skelner ikke mellem de tre endepunkter. Derfor står der herunder både, hvad der er efterprøvet, og hvad der ikke er." />

                <!-- DET, DER ER EFTERPROEVET OG SIKKERT, SKAL OGSAA STAA
                     OEVERST. Rammen her er en advarsel, og en advarsel uden
                     det, man kan stole paa, giver et skaevt billede: tvivlen
                     gaelder ét skridt i kaeden - teksten - og ikke lyden. -->
                <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{StaticResource Godkendt}" FontWeight="SemiBold"
                           Text="Tvivlen gælder teksten. Den gælder ikke lyden: optagelsen forlader aldrig maskinen, og det er den, der vejer tungest — se «Hvor data går hen»." />

                <Grid Margin="0,16,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <Border Grid.Column="0" Background="#FF16241C" BorderBrush="{StaticResource Godkendt}"
                          BorderThickness="1" CornerRadius="8" Padding="16,13">
                    <StackPanel>
                      <TextBlock Text="DET, VI VED" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{StaticResource Godkendt}" Margin="0,0,0,10" />
                      <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap"
                                 Foreground="{StaticResource TekstSvag}"
                                 Text="Lyd og transkription forlader aldrig maskinen. Det sker i appens egen kode, og den kan efterprøves." />
                      <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,7,0,0"
                                 Foreground="{StaticResource TekstSvag}"
                                 Text="Appen kan kun kalde det europæiske endepunkt. Det er spærret i koden, ikke en indstilling." />
                      <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,7,0,0"
                                 Foreground="{StaticResource TekstSvag}"
                                 Text="Mistral AI er et fransk selskab, underlagt GDPR direkte og ikke via en aftalekonstruktion." />
                      <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,7,0,0"
                                 Foreground="{StaticResource TekstSvag}"
                                 Text="Databehandleraftalen gælder automatisk. Den skal hverken bestilles eller underskrives." />
                      <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,7,0,0"
                                 Foreground="{StaticResource TekstSvag}"
                                 Text="Træning på dine data kan fravælges, og fravalget er dit eget. Aftalen siger det udtrykkeligt." />
                      <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,7,0,0"
                                 Foreground="{StaticResource TekstSvag}"
                                 Text="ISO/IEC 27001, ISO/IEC 27701 og SOC 2 Type II. Attesterne ligger i Trust Center." />
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="2" Background="#FF2A1A1A" BorderBrush="{StaticResource FejlTekst}"
                          BorderThickness="1" CornerRadius="8" Padding="16,13">
                    <StackPanel>
                      <TextBlock Text="DET, VI IKKE VED" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{StaticResource FejlTekst}" Margin="0,0,0,10" />
                      <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap"
                                 Foreground="{StaticResource TekstSvag}"
                                 Text="Om behandlingen KONTRAKTLIGT er bundet til Europa. Det står ikke i de to bindende dokumenter — kun i produktdokumentationen, som er en beskrivelse, ikke et løfte." />
                      <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,7,0,0"
                                 Foreground="{StaticResource TekstSvag}"
                                 Text="Om Cloudflares «Worldwide» og CrowdStrikes «United States» i praksis betyder, at data kan ligge uden for EØS. Begge gælder alle produkter." />
                      <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,7,0,0"
                                 Foreground="{StaticResource TekstSvag}"
                                 Text="Om listen har ændret sig siden 17-08-2026. Mistral varsler ændringer med ti dages frist, men der er ikke abonneret på varsler." />
                      <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,7,0,0"
                                 Foreground="{StaticResource TekstSvag}"
                                 Text="Hvor længe den enkelte API-anmodning opbevares. Der står kun noget om, hvad der sker, når aftalen ophører." />
                      <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,7,0,0"
                                 Foreground="{StaticResource TekstSvag}"
                                 Text="Hvad der faktisk sker hos de amerikansk ejede underleverandører i kæden. Det kan ikke efterprøves udefra." />
                    </StackPanel>
                  </Border>
                </Grid>

                <Border Background="#FF181B22" CornerRadius="8" Padding="16,12" Margin="0,14,0,0"
                        BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
                  <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap"
                             Foreground="{StaticResource Tekst}"
                             Text="Hvad det betyder i praksis: løsningen er et velbegrundet valg, og den er bedre stillet end en amerikansk tjeneste. Men den er ikke en efterprøvet garanti for, at data bliver i Europa — og den forskel skal frem, INDEN nogen skriver det i et tilbud. Vil du kunne stå på mål for det, skal leverandøren bekræfte det skriftligt." />
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Hvor data går hen" Style="{StaticResource Fane}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
    <!-- ==================== Datastrømmen ========================= -->
            <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="20,16"
                    BorderBrush="{StaticResource PanelKant}" BorderThickness="1" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="HVOR DATA GÅR HEN" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TekstMeget}" Margin="0,0,0,12" />

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <Border Grid.Column="0" Background="#FF16241C" BorderBrush="{StaticResource Godkendt}"
                          BorderThickness="1" CornerRadius="8" Padding="16,13">
                    <StackPanel>
                      <TextBlock Text="Lyd og transkription" FontSize="14" FontWeight="SemiBold" />
                      <TextBlock Text="Bliver på denne pc" FontSize="12.5" Margin="0,4,0,0"
                                 Foreground="{StaticResource Godkendt}" FontWeight="SemiBold" />
                      <TextBlock FontSize="12.5" LineHeight="20" Margin="0,8,0,0" TextWrapping="Wrap"
                                 Foreground="{StaticResource TekstSvag}"
                                 Text="Optagelsen laves lokalt, og Whisper skriver den ud lokalt. Appen har ingen kode, der kan sende en lydfil nogen steder hen." />
                    </StackPanel>
                  </Border>

                  <TextBlock Grid.Column="1" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                             VerticalAlignment="Center" Margin="14,0"
                             Foreground="{StaticResource PanelKant}" />

                  <Border Grid.Column="2" Background="#FF1D2530" BorderBrush="{StaticResource Accent}"
                          BorderThickness="1" CornerRadius="8" Padding="16,13">
                    <StackPanel>
                      <TextBlock Text="Den færdige tekst" FontSize="14" FontWeight="SemiBold" />
                      <TextBlock x:Name="SkyLinje" FontSize="12.5" Margin="0,4,0,0"
                                 Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                      <TextBlock FontSize="12.5" LineHeight="20" Margin="0,8,0,0" TextWrapping="Wrap"
                                 Foreground="{StaticResource TekstSvag}"
                                 Text="Skal der laves et referat eller et andet dokument, sendes transkriptionens tekst til Mistral AI. Kun teksten — aldrig lyden, og aldrig dine noter, medmindre mødetypen beder om dem." />
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </Border>

            <!-- ============ HVORFOR DET ER LYDEN, DER TAELLER ============
                 Det staerkeste argument for den her app stod ingen steder:
                 forskellen paa en lydfil og en tekst er ikke en gradsforskel.

                 FORMULERINGEN ER EFTERPROEVET OG BEVIDST FORSIGTIG. En
                 stemmeoptagelse er ikke i sig selv biometriske data efter
                 forordningen - den bliver det, naar den behandles med det
                 formaal at identificere nogen entydigt. Paastanden "en stemme
                 ER biometriske data" ville vaere forkert, og en overdrivelse
                 paa netop den her side er vaerre end ingen tekst. -->
            <Border Background="#FF16241C" BorderBrush="{StaticResource Godkendt}" BorderThickness="1"
                    CornerRadius="10" Padding="20,16" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Derfor betyder det noget, at det er LYDEN, der bliver hos dig"
                           FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock FontSize="12.5" LineHeight="21" Margin="0,8,0,14" TextWrapping="Wrap"
                           Foreground="{StaticResource TekstSvag}"
                           Text="Forskellen på en lydfil og en transkription er ikke en gradsforskel. Det er to forskellige slags oplysninger, og den ene af dem forlader aldrig din maskine." />

                <TextBlock Text="Lyden kan blive til biometri. Teksten kan ikke." FontSize="13.5"
                           FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,0,0,12"
                           Foreground="{StaticResource TekstSvag}"
                           Text="En stemmeoptagelse er personoplysninger. Bliver den behandlet med det formål at genkende, HVEM der taler, er den samtidig biometriske data efter databeskyttelsesforordningens artikel 4, nr. 14 — og dermed en særlig kategori efter artikel 9, hvor kravene er skærpede. En optagelse er råstoffet til den behandling. En transkription er det ikke: tekst kan ikke laves om til et stemmeaftryk." />

                <TextBlock Text="Lyden indeholder mere end ordene." FontSize="13.5"
                           FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,0,0,12"
                           Foreground="{StaticResource TekstSvag}"
                           Text="Hvem der talte, kan høres, også når navnet aldrig bliver sagt. Dertil kommer tonefald, tøven, accent og ting om helbred og sindstilstand, som ingen har sagt højt. Intet af det følger med en transkription." />

                <TextBlock Text="Fortæl altid deltagerne, at du optager." FontSize="13.5"
                           FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,0,0,10"
                           Foreground="{StaticResource TekstSvag}"
                           Text="Sig det, inden mødet går i gang. Det er god skik, og ved onlinemøder er det nødvendigt: mødeprogrammet giver ikke besked, når lyden optages på denne måde." />
                <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap"
                           Foreground="{StaticResource TekstSvag}"
                           Text="Og du kan sige mere end at du optager. Du kan fortælle, hvor optagelsen ender: den bliver på din maskine. Den lægges ikke i en skytjeneste — hverken en amerikansk eller en anden — og den sendes ikke videre. Det er en besked, de færreste mødeværktøjer kan give, og den gør samtykket nemt at give." />

                <Border Background="#FF16241C" BorderBrush="{StaticResource Godkendt}" BorderThickness="0,1,0,0"
                        Padding="0,12,0,0" Margin="0,14,0,0">
                  <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap"
                             Foreground="{StaticResource Tekst}"
                             Text="Det er et designvalg, ikke en begrænsning, der venter på at blive ophævet. Talegenkendelse i skyen ville være hurtigere, og det er fravalgt. Bliver transkriptionen for langsom, løses det med bedre lokale modeller — ikke ved at sende lyden væk." />
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Leverandøren" Style="{StaticResource Fane}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
    <!-- ==================== Leverandøren ========================= -->
            <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="20,16"
                    BorderBrush="{StaticResource PanelKant}" BorderThickness="1" Margin="0,0,0,14">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <TextBlock Text="LEVERANDØREN — MISTRAL AI" FontSize="10.5" FontWeight="SemiBold"
                             Foreground="{StaticResource TekstMeget}" VerticalAlignment="Center" />
                  <TextBlock Text="Vilkår gennemgået 17-08-2026" FontSize="11"
                             HorizontalAlignment="Right" VerticalAlignment="Center"
                             Foreground="{StaticResource TekstMeget}" />
                </Grid>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Selskab" Margin="0,0,28,0"
                             FontSize="12.5" Foreground="{StaticResource TekstMeget}" />
                  <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12.5" TextWrapping="Wrap"
                             Text="Mistral AI, fransk selskab med adresse i Paris. Underlagt GDPR direkte — ikke via en aftalekonstruktion." />

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Databehandleraftale" Margin="0,9,28,0"
                             FontSize="12.5" Foreground="{StaticResource TekstMeget}" />
                  <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12.5" Margin="0,9,0,0" TextWrapping="Wrap"
                             Text="Gælder automatisk — «incorporated to the Agreement by reference». Den skal hverken bestilles hos salg eller underskrives særskilt." />

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Endepunkt" Margin="0,9,28,0"
                             FontSize="12.5" Foreground="{StaticResource TekstMeget}" />
                  <TextBlock Grid.Row="2" Grid.Column="1" x:Name="Endepunkt" FontSize="12.5"
                             Margin="0,9,0,0" TextWrapping="Wrap" FontFamily="Consolas" />

                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Certificeringer" Margin="0,9,28,0"
                             FontSize="12.5" Foreground="{StaticResource TekstMeget}" />
                  <TextBlock Grid.Row="3" Grid.Column="1" FontSize="12.5" Margin="0,9,0,0" TextWrapping="Wrap"
                             Text="ISO/IEC 27001, ISO/IEC 27701 og SOC 2 Type II. Attesterne ligger i deres Trust Center." />

                  <TextBlock Grid.Row="4" Grid.Column="0" Text="Opbevaring" Margin="0,9,28,0"
                             FontSize="12.5" Foreground="{StaticResource TekstMeget}" />
                  <TextBlock Grid.Row="4" Grid.Column="1" FontSize="12.5" Margin="0,9,0,0" TextWrapping="Wrap"
                             Text="Aftalens punkt 10.1: personoplysninger er utilgængelige senest tredive dage efter, aftalen ophører. Der står ingen opbevaringstid for den enkelte API-anmodning." />

                  <TextBlock Grid.Row="5" Grid.Column="0" Text="Træning på dine data" Margin="0,9,28,0"
                             FontSize="12.5" Foreground="{StaticResource TekstMeget}" />
                  <TextBlock Grid.Row="5" Grid.Column="1" FontSize="12.5" Margin="0,9,0,0" TextWrapping="Wrap"
                             Foreground="{StaticResource Advarsel}"
                             Text="Aftalen: Mistral må behandle oplysningerne som DATAANSVARLIG med henblik på at træne deres modeller, «unless Customer is or has opted-out of training». Slås fra på din konto. Det er en indstilling under Workspace → Data, og appen kan ikke sætte den for dig." />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                  <Button Content="Databehandleraftalen" Click="Dpa_Klik" Padding="14,7" Margin="0,0,8,0"
                          ToolTip="Åbner legal.mistral.ai, hvor databehandleraftalen står" />
                  <Button Content="Trust Center" Click="Trust_Klik" Padding="14,7" Margin="0,0,8,0"
                          ToolTip="Åbner trust.mistral.ai med certificeringer og listen over underdatabehandlere" />
                  <Button Content="Din konto" Click="Konsol_Klik" Padding="14,7"
                          ToolTip="Åbner console.mistral.ai, hvor du slår træning fra" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Underdatabehandlere" Style="{StaticResource Fane}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
    <!-- ============== Det, der kræver præcision ================== -->
            <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="20,16"
                    BorderBrush="{StaticResource Advarsel}" BorderThickness="1" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="DET, DER KRÆVER PRÆCISION I FORMULERINGEN" FontSize="10.5"
                           FontWeight="SemiBold" Foreground="{StaticResource Advarsel}" Margin="0,0,0,10" />

                <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap"
                           Foreground="{StaticResource TekstSvag}"
                           Text="Listen i Trust Center er gennemgået navn for navn 18-08-2026. Den opdeler efter PRODUKT — Vibe, Studio/API, Vibe Code Web — og det kan bruges: ni af de femogtyve hører til Vibe eller Vibe Code Web og er ude af billedet, fordi appen kun kalder API'et. Fem mere rører kun konto og betaling, ikke mødeindhold." />

                <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{StaticResource TekstSvag}"
                           Text="Tilbage i selve behandlingskæden: Mistral Compute (Frankrig) og Mistral AI Affiliates; Microsoft som infrastruktur i Sverige og Norge; CoreWeave, som leverer selve inferensen, i EØS; Ory til brugergodkendelse i Belgien og Tyskland; samt Kong, Sentry og Wiz i EØS. Google står med Holland og Belgien — deres amerikanske placering er udtrykkeligt knyttet til «US API endpoint», som appen hverken bruger eller kan bruge." />

                <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{StaticResource FejlTekst}" FontWeight="SemiBold"
                           Text="TO UNDTAGELSER ER VÆRD AT KENDE. CrowdStrike står med «EØS, United States» og gælder alle produkter — altså en amerikansk placering i leverandørkæden, ikke kun amerikansk ejerskab. Cloudflare står med «Worldwide», dog med bemærkningen «Local to Customer», hvilket peger på, at trafikken føres til nærmeste knudepunkt." />

                <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{StaticResource TekstSvag}"
                           Text="Bortset fra Google skelner listen ikke mellem endepunkter, kun mellem produkter. At bruge det europæiske endepunkt fjerner altså ikke i sig selv et navn fra listen — og databehandleraftalen opdeler dem heller ikke." />

                <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{StaticResource TekstSvag}"
                           Text="Ejerskabet er den anden halvdel: Microsoft, CoreWeave, Cloudflare, Kong, Sentry, Wiz og CrowdStrike er amerikansk ejede, også når serverne står i EØS. Derfor kan «ingen amerikansk virksomhed er involveret» ikke siges — uanset endepunkt." />

                <Border Background="#FF181B22" CornerRadius="8" Padding="16,13" Margin="0,14,0,0"
                        BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
                  <StackPanel>
                    <TextBlock Text="Det, der kan siges — og som holder hele vejen" FontSize="12.5"
                               FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock FontSize="13" LineHeight="22" TextWrapping="Wrap"
                               Foreground="{StaticResource Tekst}"
                               Text="«Optagelse og transskription forlader aldrig din pc. Bearbejdningen sker hos Mistral AI, et fransk selskab underlagt GDPR og omfattet af databehandleraftale, og appen kalder alene deres europæiske endepunkt.»" />
                    <TextBlock FontSize="12" LineHeight="20" TextWrapping="Wrap" Margin="0,10,0,0"
                               Foreground="{StaticResource TekstMeget}"
                               Text="«Ingen amerikansk virksomhed er involveret» holder IKKE, og «databehandleraftalen garanterer, at data bliver i Europa» holder heller ikke — den forpligtelse står ikke i aftalen. «100 % europæisk» er et absolut ord om noget, hvor leverandørens egne dokumenter tager forbehold — og en påstand, der ikke kan holdes hele vejen, er dyrere end en, der siger lidt mindre." />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Modeller og licenser" Style="{StaticResource Fane}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
    <!-- ==================== Modeller og licenser ================= -->
            <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="20,16"
                    BorderBrush="{StaticResource PanelKant}" BorderThickness="1" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="MODELLER OG LICENSER" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TekstMeget}" Margin="0,0,0,6" />

                <!-- HVORFOR DER STAAR TRE HER OG TO PAA AI-MODELLER.
                     De to skaerme taeller ikke det samme. AI-modeller taeller LAG
                     - lyd til tekst, tekst til dokument. Her taelles KOMPONENTER
                     med hver sin licens, og det foerste lag er to: programmet,
                     der koerer modellen, og modelfilen selv. De har hver sin
                     rettighedshaver, og saa skal de staa hver for sig. -->
                <TextBlock FontSize="12" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,12"
                           Foreground="{StaticResource TekstMeget}"
                           Text="Syv komponenter. De tæller ikke som fanerne under «AI-modeller»: her står hver komponent med sin egen rettighedshaver og sin egen licens. Lyd til tekst er to — motoren og modelfilen. Talergenkendelsen er tre — programmet og to modeller, én der finder talen og én der kender stemmerne fra hinanden. Den korte opsummering er den sjette og kører på maskinen. Dokumenter er den syvende, og den er en tjeneste frem for en licens — den eneste, der sender noget ud af huset." />

                <ItemsControl x:Name="Modeller">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#FF181B22" CornerRadius="8" Padding="16,13" Margin="0,0,0,8"
                              BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
                        <StackPanel>
                          <Grid>
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding Navn}" FontSize="13.5" FontWeight="SemiBold" />
                              <Border Background="{Binding Farve}" CornerRadius="3" Padding="7,2"
                                      Margin="10,1,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Licens}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="#FF0B1220" />
                              </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Hvor}" FontSize="11.5" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Foreground="{StaticResource TekstMeget}" />
                          </Grid>
                          <TextBlock Text="{Binding Rolle}" FontSize="12.5" LineHeight="20" Margin="0,7,0,0"
                                     TextWrapping="Wrap" Foreground="{StaticResource TekstSvag}" />
                          <TextBlock Text="{Binding Note}" FontSize="11.5" LineHeight="19" Margin="0,6,0,0"
                                     TextWrapping="Wrap" Foreground="{StaticResource TekstMeget}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ==================== KVITTERINGER ====================
           Resten af skaermen beskriver, hvad appen GOER. Den her fane siger,
           hvad der FAKTISK skete - og det er to forskellige ting.

           En revision spoerger ikke "hvordan virker det", men "hvad skete der
           den 14. august". Det kan en beskrivelse af koden ikke svare paa. -->
      <TabItem Header="Kvitteringer" Style="{StaticResource Fane}">
        <DockPanel>

          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Hvad der faktisk er sendt" FontSize="15" FontWeight="SemiBold" />
            <TextBlock FontSize="12.5" LineHeight="21" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TekstSvag}"
                       Text="Hver gang noget forlader maskinen, bogføres det her: tidspunkt, adresse, model, hvor mange tegn der gik, hvad det kostede — og en kontrolsum af de nøjagtige bytes. Også når kaldet fejler; en fejlet afsendelse har stadig sendt." />
            <TextBlock FontSize="12" LineHeight="20" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TekstMeget}"
                       Text="Selve teksten gemmes IKKE. Den ligger allerede ved mødet, og en kopi mere ville være endnu et sted, den kunne slippe ud fra. Kontrolsummen kan holdes op mod originalen — passer den ikke, er transkriptionen ændret siden." />
          </StackPanel>

          <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" CornerRadius="10"
                  BorderBrush="{StaticResource PanelKant}" BorderThickness="1"
                  Padding="18,14" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <TextBlock Text="AFSENDELSER" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TekstMeget}" />
                <TextBlock x:Name="KvitAntal" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0" />
              </StackPanel>

              <StackPanel Grid.Column="1">
                <TextBlock Text="TEGN SENDT I ALT" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TekstMeget}" />
                <TextBlock x:Name="KvitTegn" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0" />
              </StackPanel>

              <StackPanel Grid.Column="2">
                <TextBlock Text="SAMLET PRIS (SKØN)" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TekstMeget}" />
                <TextBlock x:Name="KvitPris" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0" />
                <TextBlock x:Name="KvitPrisKr" FontSize="11.5" Margin="0,2,0,0"
                           Foreground="{StaticResource TekstMeget}" />
              </StackPanel>

              <Button Grid.Column="3" Content="Åbn mappen" Click="Kvitteringer_Klik"
                      VerticalAlignment="Center" Padding="14,8"
                      ToolTip="Filerne er almindelig JSONL — én linje pr. afsendelse. De kan læses af et regneark eller et script uden appen" />
            </Grid>
          </Border>

          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <!-- PRISEN ER ET SKOEN, OG DET SKAL STAA.
                   Tokentallene er leverandoerens egne og er noejagtige. Det
                   er OMREGNINGEN, der ikke er: listeprisen er noteret i
                   dollar, og hvad der faktisk staar paa fakturaen - valuta,
                   kurs, moms - er ikke efterproevet. Et tal uden det
                   forbehold ville blive laest som et regnskab. -->
              <Border Background="#FF181B22" BorderBrush="{StaticResource PanelKant}" BorderThickness="1"
                      CornerRadius="8" Padding="14,11" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="Om prisen" FontSize="12.5" FontWeight="SemiBold" />
                  <TextBlock FontSize="12" LineHeight="19" Margin="0,4,0,0" TextWrapping="Wrap"
                             Foreground="{StaticResource TekstMeget}"
                             Text="Antallet af tokens kommer fra leverandøren og er det, der faktureres. Prisen herover er derimod et skøn: den er regnet ud fra listeprisen på Mistrals prisside, som er noteret i dollar. Kronebeløbet bruger en fast kurs på 6,50 kr./USD — ikke en dagskurs." />
                  <TextBlock FontSize="12" LineHeight="19" Margin="0,6,0,0" TextWrapping="Wrap"
                             Foreground="{StaticResource TekstMeget}"
                             Text="Hvilken valuta Mistral rent faktisk fakturerer i, og om der lægges moms oveni, er ikke efterprøvet. Skal tallet bruges til bogføring, så tag det fra fakturaen — ikke herfra." />
                </StackPanel>
              </Border>

              <TextBlock x:Name="KvitTom" FontSize="13" LineHeight="21" TextWrapping="Wrap"
                         Margin="4,10,4,0" Visibility="Collapsed"
                         Foreground="{StaticResource TekstSvag}"
                         Text="Der er ikke sendt noget endnu. Første gang du laver et dokument, står afsendelsen her." />

              <ItemsControl x:Name="KvitListe">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border CornerRadius="8" Padding="14,11" Margin="0,0,0,6"
                            Background="#FF181B22" BorderThickness="1"
                            BorderBrush="{Binding Kant}">
                      <StackPanel>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="{Binding Hvad}" FontSize="13.5"
                                     FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Grid.Column="1" Text="{Binding Naar}" FontSize="11.5"
                                     Margin="12,0,0,0" VerticalAlignment="Top"
                                     Foreground="{StaticResource TekstMeget}" />
                        </Grid>

                        <TextBlock Text="{Binding Linje}" FontSize="12" Margin="0,6,0,0"
                                   TextWrapping="Wrap" LineHeight="19"
                                   Foreground="{StaticResource TekstSvag}" />

                        <TextBlock Text="{Binding Sum}" FontSize="11" Margin="0,5,0,0"
                                   FontFamily="Consolas" TextWrapping="Wrap"
                                   Foreground="{StaticResource TekstMeget}" />

                        <TextBlock Text="{Binding Fejl}" FontSize="12" Margin="0,5,0,0"
                                   TextWrapping="Wrap" Visibility="{Binding FejlSynlig}"
                                   Foreground="{StaticResource FejlTekst}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <TabItem Header="Forbehold" Style="{StaticResource Fane}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
    <!-- ==================== Det uafklarede ======================= -->
            <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="20,16"
                    BorderBrush="{StaticResource PanelKant}" BorderThickness="1" Margin="0,0,0,4">
              <StackPanel>
                <TextBlock Text="DET, DER IKKE ER EFTERPRØVET" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TekstMeget}" Margin="0,0,0,10" />

                <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap"
                           Foreground="{StaticResource TekstSvag}"
                           Text="Listen over underdatabehandlere kan ændre sig. Mistral varsler ændringer med ti dages indsigelsesfrist, og der kan abonneres på varsler i Trust Center — det bør nogen gøre." />

                <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{StaticResource TekstSvag}"
                           Text="Opbevaringstiden for API-anmodninger er ikke slået op." />

                <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{StaticResource TekstSvag}"
                           Text="Trust Center oplyste 14-05-2026 om en sikkerhedshændelse i forsyningskæden. Mistral skriver, at hverken hostede tjenester eller kundedata blev berørt. Nævnt for fuldstændighedens skyld, ikke som en indvending." />

                <TextBlock FontSize="11.5" LineHeight="19" TextWrapping="Wrap" Margin="0,14,0,0"
                           Foreground="{StaticResource TekstMeget}"
                           Text="Hele gennemgangen med kildehenvisninger står i doc/mistral-dpa.md i projektmappen. Målingerne, der ligger bag valget af model, står i doc/maaling-sky.md og doc/maaling-whisper.md." />
              </StackPanel>
            </Border>
    <!-- ==================== Ansvarsfraskrivelse ==================
                 Den staar til SIDST og ikke foerst. Oeverst ville den vaere det,
                 man laeser i stedet for indholdet; nederst er den det, man
                 laeser bagefter - naar man ved, hvad den handler om.

                 Den siger ikke "vi tager intet ansvar" og saa alligevel
                 "compliant" oeverst. Hele skaermen er skrevet som en gengivelse
                 med dato paa, netop for at den her afslutning kan vaere sand. -->
            <Border Background="#FF181B22" CornerRadius="10" Padding="20,16" Margin="0,14,0,0"
                    BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="ANSVARSFRASKRIVELSE" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TekstMeget}" Margin="0,0,0,10" />

                <TextBlock FontSize="12" LineHeight="20" TextWrapping="Wrap"
                           Foreground="{StaticResource TekstMeget}"
                           Text="Oplysningerne under «Compliance» er en gengivelse af tredjepartsvilkår, licensbetingelser og offentligt tilgængelig dokumentation, som forelå på de anførte gennemgangsdatoer. De udgør ikke juridisk rådgivning og kan ikke træde i stedet for en selvstændig vurdering." />

                <TextBlock FontSize="12" LineHeight="20" TextWrapping="Wrap" Margin="0,9,0,0"
                           Foreground="{StaticResource TekstMeget}"
                           Text="Vilkår, underdatabehandlerlister, certificeringer og licenser kan være ændret, efter teksten blev indsat, uden at det fremgår her. Brugeren er selv ansvarlig for at efterprøve rigtigheden hos de pågældende leverandører og for løbende at kontrollere, om der er sket ændringer." />

                <TextBlock FontSize="12" LineHeight="20" TextWrapping="Wrap" Margin="0,9,0,0"
                           Foreground="{StaticResource TekstMeget}"
                           Text="Ansvaret for, at anvendelsen af programmet er i overensstemmelse med databeskyttelsesforordningen og øvrig gældende ret — herunder rollefordelingen som dataansvarlig, behandlingsgrundlag, oplysningspligt og fortegnelse over behandlingsaktiviteter — påhviler alene brugeren som dataansvarlig. Der påtages intet ansvar for direkte eller indirekte tab som følge af, at oplysningerne under «Compliance» lægges til grund." />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>
  </Grid>
</UserControl>
