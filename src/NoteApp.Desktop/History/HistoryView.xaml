<UserControl x:Class="NoteApp.Desktop.History.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:NoteApp.Desktop"
             Background="{StaticResource Baggrund}">

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="{i18n:Oversat historyview.historik}" Style="{StaticResource Overskrift}" />
      <TextBlock Style="{StaticResource Underskrift}"
                 Text="{i18n:Oversat historyview.alt_appen_har_gjort_hvornaar_med_hvilken_m}" />
    </StackPanel>

    <!-- HER STOD «Intet har forladt denne pc» med et stort nul ved siden af.
         Den blev bygget dengang, appen ikke havde et netvaerkskald i sig.
         Det har den nu: dokumenter laves hos Mistral i Europa, og teksten
         SENDES. Paastanden var altsaa ikke laengere sand - og en paastand om
         databehandling, der ikke holder, er den slags, der bliver opdaget af
         en anden end en selv.

         Den er ikke erstattet af en ny paastand. Hvad der er sendt hvorhen,
         staar i listen nedenfor, post for post, med model og udfald. Det er
         det, en revision kan bruge; en overskrift, der opsummerer, kan kun
         tage fejl. Fjernet 18-08-2026. -->

    <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="10"
            BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="20,16,20,10">
          <TextBlock x:Name="Antal" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
          <ComboBox x:Name="Filter" HorizontalAlignment="Right" Width="200"
                    SelectionChanged="Filter_Valgt" />
        </Grid>

        <TextBlock x:Name="TomTekst" DockPanel.Dock="Top" Margin="20,10,20,0" FontSize="13"
                   TextWrapping="Wrap" LineHeight="21" Visibility="Collapsed"
                   Foreground="{StaticResource TekstMeget}"
                   Text="{i18n:Oversat historyview.der_er_ikke_sket_noget_endnu_historikken_f}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,0,8,10">
          <ItemsControl x:Name="Liste">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{StaticResource Trykket}" CornerRadius="8" Padding="16,12" Margin="12,4"
                        BorderThickness="1" BorderBrush="{Binding Kantfarve}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0" MinWidth="110">
                      <TextBlock Text="{Binding Klokkeslet}" FontFamily="Consolas" FontSize="13"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Dato}" FontSize="12" Margin="0,2,0,0"
                                 Foreground="{StaticResource TekstMeget}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Hvad}" FontSize="13.5" FontWeight="SemiBold"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Detaljer}" FontSize="12" Margin="0,3,0,0"
                                 TextWrapping="Wrap" Foreground="{StaticResource TekstSvag}" />
                      <TextBlock Text="{Binding Model}" FontSize="11.5" Margin="0,3,0,0"
                                 TextWrapping="Wrap" Foreground="{StaticResource TekstMeget}" />

                      <!-- VEJEN TILBAGE TIL KILDEN.
                           Teksten er slaaet op paa id'et, da linjen blev
                           vist - ikke da den blev skrevet. Derfor staar det
                           NUVAERENDE navn, ogsaa hvis noget er omdoebt siden,
                           og der staar "slettet", hvis kilden er vaek.

                           En knap og ikke et hyperlink: hyperlinket arver
                           ikke temaets farver og stod blaat paa blaat. -->
                      <Button Content="{Binding LinkTekst}" Tag="{Binding}" Click="Kilde_Klik"
                              HorizontalAlignment="Left" Margin="0,6,0,0" Padding="0"
                              FontSize="11.5" Cursor="Hand" BorderThickness="0"
                              Background="Transparent" Foreground="{Binding LinkFarve}"
                              IsEnabled="{Binding Findes}"
                              ToolTip="{i18n:Oversat historyview.gaa_til_den_linjen_handler_om}">
                        <Button.Style>
                          <Style TargetType="Button">
                            <Setter Property="Template">
                              <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                  <TextBlock Text="{TemplateBinding Content}"
                                             Foreground="{TemplateBinding Foreground}"
                                             FontSize="{TemplateBinding FontSize}"
                                             TextDecorations="Underline" />
                                </ControlTemplate>
                              </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                              <!-- Er kilden slettet, er teksten en oplysning
                                   og ikke et link. Saa skal den heller ikke
                                   se ud som et. -->
                              <DataTrigger Binding="{Binding Findes}" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding HarLink}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding UdfaldTekst}" FontSize="12"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"
                               Foreground="{Binding Kantfarve}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <TextBlock x:Name="Status" VerticalAlignment="Center" FontSize="12"
                 Foreground="{StaticResource TekstMeget}" TextWrapping="Wrap" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{i18n:Oversat historyview.aabn_logfilen}" Click="Aabn_Click" Padding="14,8" Margin="0,0,8,0" />
        <Button Content="{i18n:Oversat historyview.opdater}" Click="Genindlaes_Click" Padding="14,8" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
