<UserControl x:Class="NoteApp.Desktop.History.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:NoteApp.Desktop"
             Background="{DynamicResource Baggrund}">

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="{i18n:Oversat historyview.historik}" Style="{StaticResource Overskrift}" />
      <TextBlock Style="{StaticResource Underskrift}"
                 Text="{i18n:Oversat historyview.alt_appen_har_gjort_hvornaar_med_hvilken_m}" />
    </StackPanel>

    <!-- HER STOD «Intet har forladt denne pc» med et stort nul ved siden af.
         Den blev bygget dengang, appen ikke havde et netvaerkskald i sig.
         Det har den nu: dokumenter laves hos Mistral i Europa, og teksten
         SENDES. Paastanden var altsaa ikke laengere sand - og en paastand om
         databehandling, der ikke holder, er den slags, der bliver opdaget af
         en anden end en selv.

         Den er ikke erstattet af en ny paastand. Hvad der er sendt hvorhen,
         staar i listen nedenfor, post for post, med model og udfald. Det er
         det, en revision kan bruge; en overskrift, der opsummerer, kan kun
         tage fejl. Fjernet 18-08-2026. -->

    <Border Grid.Row="1" Background="{DynamicResource Panel}" CornerRadius="10"
            BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
      <DockPanel>
        <!-- ============ FANER I STEDET FOR EN RULLELISTE ============

             Her stod en ComboBox med «Alt» i. En rulleliste skjuler sine
             muligheder, indtil man klikker - saa man kunne ikke se, at der
             OVERHOVEDET kunne afgraenses, og hvad man kunne afgraense paa.
             Resten af appen skifter indhold med faner: udskrift/dokumenter paa
             optagelsen, dokumentraekken inde i fanen. Historikken goer det nu
             ogsaa.

             Raekken bygges i kode ud fra den samme liste, som filtrerer - saa
             en ny slags haendelse ikke kan blive en fane uden et filter eller
             omvendt. Se Byg_Faner. -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource PanelKant}"
                BorderThickness="0,0,0,1" Padding="20,14,20,12">
          <WrapPanel x:Name="Faner" Orientation="Horizontal" />
        </Border>

        <!-- ============ SØGNINGEN OG PERIODEN ============

             Historikken er tusinder af poster efter et par ugers brug.
             «Hvornaar sendte vi det referat» kan ikke besvares ved at rulle.

             Perioden er den samme som i Cockpit - de samme fem valg og den
             samme «Fra og til …» med to datovaelgere - fordi det er det samme
             spoergsmaal stillet et andet sted. To maader at afgraense en
             periode paa i den samme app er een for mange. -->
        <Grid DockPanel.Dock="Top" Margin="20,14,20,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock x:Name="Antal" Grid.Column="0" FontSize="13.5" FontWeight="SemiBold"
                     VerticalAlignment="Center" />

          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Border x:Name="Soegefelt" Background="{DynamicResource Trykket}" CornerRadius="6"
                    BorderBrush="{DynamicResource PanelKant}" BorderThickness="1"
                    Width="240" Padding="4" Margin="0,0,8,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="Soeg" Grid.Column="0" FontSize="12.5" Padding="8,4"
                         BorderThickness="0" Background="Transparent"
                         TextChanged="Soeg_Aendret" KeyDown="Soeg_Tast" />
                <TextBlock x:Name="SoegPladsholder" Grid.Column="0" IsHitTestVisible="False"
                           FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TekstMeget}"
                           Text="{i18n:Oversat historyview.soeg_i_historikken}" />

                <Button x:Name="SoegRyd" Grid.Column="1" Content="✕" Click="SoegRyd_Klik"
                        Visibility="Collapsed" Cursor="Hand" FontSize="11"
                        Padding="0" BorderThickness="0" Background="Transparent"
                        Width="24" Height="24" Margin="0,0,3,0"
                        ToolTip="{i18n:Oversat faelles.ryd_soegningen_escape}">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="flade" CornerRadius="12" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="flade" Property="Background" Value="{DynamicResource Svaev}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
              </Grid>
            </Border>

            <ComboBox x:Name="Periodefilter" MinWidth="140" FontSize="12" Padding="8,5"
                      SelectionChanged="Periode_Aendret"
                      ToolTip="{i18n:Oversat historyview.kun_poster_fra_denne_periode}">
              <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Navn}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <Button x:Name="RydKnap" Content="{i18n:Oversat searchview.ryd}" Click="Ryd_Klik"
                    Margin="8,0,0,0" Padding="10,5" FontSize="11.5" Visibility="Collapsed"
                    ToolTip="{i18n:Oversat historyview.vis_det_hele_igen}" />
          </StackPanel>
        </Grid>

        <StackPanel x:Name="Datoraekke" DockPanel.Dock="Top" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="20,0,20,8" Visibility="Collapsed">
          <TextBlock Text="{i18n:Oversat searchview.fra}" FontSize="11.5" VerticalAlignment="Center"
                     Margin="0,0,7,0" Foreground="{DynamicResource TekstMeget}" />
          <DatePicker x:Name="FraDato" Width="135" FontSize="12" SelectedDateChanged="Dato_Aendret" />

          <TextBlock Text="{i18n:Oversat searchview.til}" FontSize="11.5" VerticalAlignment="Center"
                     Margin="10,0,7,0" Foreground="{DynamicResource TekstMeget}" />
          <DatePicker x:Name="TilDato" Width="135" FontSize="12" SelectedDateChanged="Dato_Aendret" />

          <TextBlock x:Name="Datofejl" FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0"
                     Foreground="{DynamicResource Advarsel}" />
        </StackPanel>

        <TextBlock x:Name="TomTekst" DockPanel.Dock="Top" Margin="20,10,20,0" FontSize="13"
                   TextWrapping="Wrap" LineHeight="21" Visibility="Collapsed"
                   Foreground="{DynamicResource TekstMeget}"
                   Text="{i18n:Oversat historyview.der_er_ikke_sket_noget_endnu_historikken_f}" />

        <!-- AFGRAENSET, MEN TOMT, ER IKKE DET SAMME SOM TOMT.
             «Der er ikke sket noget endnu» ville vaere forkert, naar der ER
             sket noget - det er soegningen eller perioden, der ikke rammer. -->
        <TextBlock x:Name="IngenTraef" DockPanel.Dock="Top" Margin="20,10,20,0" FontSize="13"
                   TextWrapping="Wrap" LineHeight="21" Visibility="Collapsed"
                   Foreground="{DynamicResource TekstMeget}"
                   Text="{i18n:Oversat historyview.ingen_poster_passer_paa_det_valgte}" />

        <!-- ============ LISTEN VIRTUALISERER ============

             Her stod en ItemsControl inde i en ScrollViewer. Den bygger ALLE
             raekker med det samme - ogsaa dem, ingen kan se. Med de 500, der
             blev laest, gik det; historikken laeses nu hel, og et par tusind
             raekker paa een gang er et sekunds hak, hver gang man klikker en
             fane.

             En ListBox med VirtualizingStackPanel bygger kun de raekker, der
             er i billedet, og genbruger dem under rulningen. Markeringen er
             slaaet fra: listen er til at laese i, ikke til at vaelge i. -->
        <!-- Padding og ikke Margin til hoejre: rullebjaelken ligger INDE i
             listen, og en margen ville skubbe bjaelken med ind. Raekkerne skal
             holde sig fri af den, bjaelken skal blive, hvor den er. -->
        <ListBox x:Name="Liste" Margin="8,0,8,10" Padding="0,0,12,0" Background="Transparent"
                 BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <ContentPresenter />
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource Trykket}" CornerRadius="6" Padding="14,7" Margin="12,2"
                        BorderThickness="1" BorderBrush="{Binding Kantfarve}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0" MinWidth="96">
                      <TextBlock Text="{Binding Klokkeslet}" FontFamily="Consolas" FontSize="13"
                                 FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Dato}" FontSize="11.5" Margin="0,1,0,0"
                                 Foreground="{DynamicResource TekstMeget}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Hvad}" FontSize="13.5" FontWeight="SemiBold"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Detaljer}" FontSize="11.5" Margin="0,1,0,0"
                                 TextWrapping="Wrap" Foreground="{DynamicResource TekstSvag}" />
                      <TextBlock Text="{Binding Model}" FontSize="11" Margin="0,1,0,0"
                                 TextWrapping="Wrap" Foreground="{DynamicResource TekstMeget}" />

                      <!-- VEJEN TILBAGE TIL KILDEN.
                           Teksten er slaaet op paa id'et, da linjen blev
                           vist - ikke da den blev skrevet. Derfor staar det
                           NUVAERENDE navn, ogsaa hvis noget er omdoebt siden,
                           og der staar "slettet", hvis kilden er vaek.

                           En knap og ikke et hyperlink: hyperlinket arver
                           ikke temaets farver og stod blaat paa blaat. -->
                      <Button Content="{Binding LinkTekst}" Tag="{Binding}" Click="Kilde_Klik"
                              HorizontalAlignment="Left" Margin="0,4,0,0" Padding="0"
                              FontSize="11.5" Cursor="Hand" BorderThickness="0"
                              Background="Transparent" Foreground="{Binding LinkFarve}"
                              IsEnabled="{Binding Findes}"
                              ToolTip="{i18n:Oversat historyview.gaa_til_den_linjen_handler_om}">
                        <Button.Style>
                          <Style TargetType="Button">
                            <Setter Property="Template">
                              <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                  <TextBlock Text="{TemplateBinding Content}"
                                             Foreground="{TemplateBinding Foreground}"
                                             FontSize="{TemplateBinding FontSize}"
                                             TextDecorations="Underline" />
                                </ControlTemplate>
                              </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                              <!-- Er kilden slettet, er teksten en oplysning
                                   og ikke et link. Saa skal den heller ikke
                                   se ud som et. -->
                              <DataTrigger Binding="{Binding Findes}" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding HarLink}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding UdfaldTekst}" FontSize="12"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"
                               Foreground="{Binding Kantfarve}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
      </DockPanel>
    </Border>

    <Grid Grid.Row="2" Margin="0,14,0,0">
      <TextBlock x:Name="Status" VerticalAlignment="Center" FontSize="12"
                 Foreground="{DynamicResource TekstMeget}" TextWrapping="Wrap" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{i18n:Oversat historyview.aabn_logfilen}" Click="Aabn_Click" Padding="14,8" Margin="0,0,8,0" />
        <Button Content="{i18n:Oversat historyview.opdater}" Click="Genindlaes_Click" Padding="14,8" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
