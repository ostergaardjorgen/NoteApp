<UserControl x:Class="NoteApp.Desktop.ReadAloud.ReadAloudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Baggrund}"
             Focusable="True">

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ============================ Topbjælke ============================ -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock x:Name="BlokTitel" Style="{StaticResource Overskrift}" Text="Klar til oplæsning" />
        <TextBlock x:Name="BlokUnder" Style="{StaticResource Underskrift}" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

        <!-- Tempoafvigelsen er det, der afgør om optagelsen bliver brugbar.
             Derfor står den ved siden af uret, ikke gemt i en statuslinje. -->
        <StackPanel Margin="0,0,20,0" HorizontalAlignment="Right">
          <TextBlock x:Name="Tempo" Text="—" FontSize="13" HorizontalAlignment="Right"
                     Foreground="{StaticResource TekstSvag}" />
          <TextBlock Text="tempo" Style="{StaticResource Underskrift}" HorizontalAlignment="Right" />
        </StackPanel>

        <StackPanel Margin="0,0,20,0" HorizontalAlignment="Right">
          <TextBlock x:Name="Ur" Text="00:00" FontSize="26" FontWeight="SemiBold"
                     FontFamily="Consolas" HorizontalAlignment="Right" />
          <TextBlock x:Name="UrMaal" Style="{StaticResource Underskrift}" HorizontalAlignment="Right"
                     Text="mål 00:00" />
        </StackPanel>

        <Ellipse x:Name="OptagerPrik" Width="12" Height="12" Fill="{StaticResource TekstMeget}"
                 VerticalAlignment="Center" Margin="0,0,10,0" />
      </StackPanel>
    </Grid>

    <!-- ============================ Teleprompter ========================= -->
    <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="10"
            BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Startskærm: vejledningen fra tekstens indledning. Vises indtil
             optagelsen begynder, så instruktionerne læses FØR, ikke undervejs. -->
        <!-- Tre kort, der passer paa skaermen uden at rulle. Foerste udgave var
             en side tekst; ingen laeser en side tekst for at komme i gang med
             at laese en anden. Hvert kort svarer paa eet spoergsmaal med to
             linjer. -->
        <Grid x:Name="VejledningPanel" Grid.Row="0" Margin="36,30,36,24">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="0,0,0,26">
            <TextBlock Text="Læs teksten højt — cirka 20 minutter" FontSize="26" FontWeight="SemiBold" />
            <TextBlock x:Name="Indledning" FontSize="14" Margin="0,8,0,0"
                       Foreground="{StaticResource TekstSvag}" />
          </StackPanel>

          <Grid Grid.Row="1" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FF181B22" BorderBrush="{StaticResource PanelKant}"
                    BorderThickness="1" CornerRadius="10" Padding="20,18" Margin="0,0,7,0">
              <StackPanel>
                <TextBlock Text="Sådan gør du" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
                <TextBlock FontSize="13" LineHeight="21" Foreground="{StaticResource TekstSvag}"
                           Text="Der står ét afsnit på skærmen. Læs kun det — når du er færdig, henter mellemrum det næste." />
                <TextBlock FontSize="13" LineHeight="21" Margin="0,10,0,0" Foreground="{StaticResource TekstSvag}"
                           Text="Tal som til en kollega. Pauser og tøvelyde hører med." />
              </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#FF181B22" BorderBrush="{StaticResource PanelKant}"
                    BorderThickness="1" CornerRadius="10" Padding="20,18" Margin="7,0,7,0">
              <StackPanel>
                <TextBlock Text="Hvorfor så længe" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
                <TextBlock x:Name="HvorforLaengde" FontSize="13" LineHeight="21"
                           Foreground="{StaticResource TekstSvag}" />
                <TextBlock FontSize="13" LineHeight="21" Margin="0,10,0,0" Foreground="{StaticResource TekstSvag}"
                           Text="5 minutter viser, om det virker. 20 viser, om du kan stole på det." />
              </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#334CBE72" BorderBrush="{StaticResource Godkendt}"
                    BorderThickness="1" CornerRadius="10" Padding="20,18" Margin="7,0,0,0">
              <StackPanel>
                <TextBlock Text="Du kan afbryde" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
                <TextBlock FontSize="13" LineHeight="21" Foreground="{StaticResource Tekst}"
                           Text="Kommer der nogen? Tryk Pause — så optages der intet, før du selv fortsætter." />
                <TextBlock FontSize="13" LineHeight="21" Margin="0,10,0,0" Foreground="{StaticResource Tekst}"
                           Text="Stopper du, gemmes det du nåede. Et crash koster højst 30 sekunder." />
              </StackPanel>
            </Border>
          </Grid>

          <TextBlock Grid.Row="2" x:Name="Praktisk" FontSize="12" Margin="0,20,0,0"
                     Foreground="{StaticResource TekstMeget}" />
        </Grid>


        <!-- Oplæsningen: ét afsnit ad gangen, stort. Det næste står svagt
             nedenunder, så man kan tage tilløb til det uden at miste linjen. -->
        <!-- Teleprompteren viser KUN det afsnit, der skal læses. Første udgave
             havde det næste afsnit stående svagt nedenunder som tilløb — og
             det blev læst med. En skærm, hvor man skal forklares hvad der er
             tekst og hvad der er hjælp, er forkert designet; så er det bedre,
             at der kun står ét. -->
        <Grid x:Name="LaesePanel" Grid.Row="0" Margin="44,28" Visibility="Collapsed">
          <TextBlock x:Name="Afsnit" FontSize="32" LineHeight="52" TextWrapping="Wrap"
                     Foreground="#FFFFFFFF" VerticalAlignment="Center"
                     MaxWidth="980" HorizontalAlignment="Center" />
        </Grid>

        <!-- Fremdrift gennem teksten -->
        <Grid Grid.Row="1" Margin="36,0,36,20">
          <ProgressBar x:Name="Fremdrift" Height="4" Minimum="0" Maximum="100" Value="0"
                       Background="#FF2C323D" Foreground="{StaticResource Accent}"
                       BorderThickness="0" />
        </Grid>
      </Grid>
    </Border>

    <!-- ============================ Bundbjælke =========================== -->
    <Grid Grid.Row="2" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <TextBlock Text="Mikrofon" Style="{StaticResource Underskrift}" Width="62" />
          <Border Width="220" Height="8" Background="#FF2C323D" CornerRadius="4" VerticalAlignment="Center">
            <Border x:Name="Niveau" HorizontalAlignment="Left" Width="0" Height="8"
                    CornerRadius="4" Background="{StaticResource Godkendt}" />
          </Border>
          <TextBlock x:Name="MikrofonNavn" Style="{StaticResource Underskrift}" Margin="12,0,0,0"
                     VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <CheckBox x:Name="FoelgMed" Content="Skift afsnit automatisk, når jeg har læst det"
                    Click="FoelgMed_Klik" FontSize="12" Margin="0,0,10,0" />
          <TextBlock x:Name="FoelgStatus" Style="{StaticResource Underskrift}"
                     VerticalAlignment="Center" Foreground="{StaticResource TekstMeget}" />
        </StackPanel>
        <TextBlock x:Name="Status" Style="{StaticResource Underskrift}" Margin="0,4,0,0" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="ForrigeKnap" Content="◀ Forrige" Click="Forrige_Click"
                Margin="0,0,8,0" IsEnabled="False" />
        <Button x:Name="NaesteKnap" Content="Næste afsnit  (mellemrum)" Click="Naeste_Click"
                Margin="0,0,16,0" IsEnabled="False" Style="{StaticResource Primaer}" />
        <Button x:Name="PauseKnap" Content="❚❚ Pause" Click="Pause_Click"
                Margin="0,0,8,0" Visibility="Collapsed" MinWidth="120" />
        <Button x:Name="OptagKnap" Content="● Start optagelse" Click="Optag_Click"
                Style="{StaticResource Fare}" MinWidth="170" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
