<UserControl x:Class="NoteApp.Desktop.ReadAloud.ReadAloudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Baggrund}"
             Focusable="True">

  <UserControl.Resources>
    <!-- Et valgkort. Det ER en RadioButton — kun én kan være valgt, og
         tastaturet virker som man forventer — men den ser ud som en boks, man
         trykker på. Prikken er væk: kortet i sig selv viser valget med kant og
         baggrund, og en prik oveni ville sige det samme to gange.

         Hover løfter kortet en anelse. Bevægelsen er lille med vilje — den skal
         bekræfte, at boksen kan trykkes på, ikke tage opmærksomheden. -->
    <Style x:Key="Tekstkort" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      <Setter Property="RenderTransform">
        <Setter.Value><ScaleTransform ScaleX="1" ScaleY="1" /></Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Kant" CornerRadius="10" BorderThickness="1" Padding="18,15"
                    Background="#FF181B22" BorderBrush="{StaticResource PanelKant}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Kant" Property="BorderBrush" Value="{StaticResource TekstMeget}" />
                <Setter TargetName="Kant" Property="Background" Value="#FF212832" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Kant" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="Kant" Property="BorderThickness" Value="2" />
                <Setter TargetName="Kant" Property="Padding" Value="17,14" />
                <Setter TargetName="Kant" Property="Background" Value="#FF1D2530" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                               To="1.02" Duration="0:0:0.12" />
              <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                               To="1.02" Duration="0:0:0.12" />
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                               To="1" Duration="0:0:0.12" />
              <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                               To="1" Duration="0:0:0.12" />
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </Style.Triggers>
    </Style>

    <!-- Knappen på hvert kort. Den er hele handlingen: den vælger teksten OG
         starter optagelsen. Før skulle man først klikke på boksen og derefter
         finde en knap i modsatte hjørne — to skridt til noget, der er ét, og
         intet på boksen fortalte, at man skulle videre et andet sted hen. -->
    <Style x:Key="Kortknap" TargetType="Button">
      <Setter Property="Margin" Value="0,14,0,0" />
      <Setter Property="Padding" Value="0,9" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Flade" CornerRadius="7" Background="#FF2A3240"
                    BorderBrush="{StaticResource PanelKant}" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Flade" Property="Background" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="#FF0B1220" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- De tre oplysningskort. Samme opførsel som valgkortene, så det er
         tydeligt, at man også kan pege på dem — det er dér, hele teksten
         ligger, når der ikke er plads til den på skærmen. -->
    <Style x:Key="Infokort" TargetType="Border">
      <Setter Property="Background" Value="#FF181B22" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelKant}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="18,14" />
      <Setter Property="Cursor" Value="Help" />
      <Setter Property="ToolTipService.InitialShowDelay" Value="220" />
      <Setter Property="ToolTipService.ShowDuration" Value="60000" />
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      <Setter Property="RenderTransform">
        <Setter.Value><ScaleTransform ScaleX="1" ScaleY="1" /></Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Trigger>
        <EventTrigger RoutedEvent="MouseEnter">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                               To="1.025" Duration="0:0:0.12" />
              <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                               To="1.025" Duration="0:0:0.12" />
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                               To="1" Duration="0:0:0.12" />
              <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                               To="1" Duration="0:0:0.12" />
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ============================ Topbjælke ============================ -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock x:Name="BlokTitel" Style="{StaticResource Overskrift}" Text="Klar til oplæsning" />
        <TextBlock x:Name="BlokUnder" Style="{StaticResource Underskrift}" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

        <!-- Tempoafvigelsen er det, der afgør om optagelsen bliver brugbar.
             Derfor står den ved siden af uret, ikke gemt i en statuslinje. -->
        <StackPanel Margin="0,0,20,0" HorizontalAlignment="Right">
          <TextBlock x:Name="Tempo" Text="—" FontSize="13" HorizontalAlignment="Right"
                     Foreground="{StaticResource TekstSvag}" />
          <TextBlock Text="tempo" Style="{StaticResource Underskrift}" HorizontalAlignment="Right" />
        </StackPanel>

        <StackPanel Margin="0,0,20,0" HorizontalAlignment="Right">
          <TextBlock x:Name="Ur" Text="00:00" FontSize="26" FontWeight="SemiBold"
                     FontFamily="Consolas" HorizontalAlignment="Right" />
          <TextBlock x:Name="UrMaal" Style="{StaticResource Underskrift}" HorizontalAlignment="Right"
                     Text="mål 00:00" />
        </StackPanel>

        <Ellipse x:Name="OptagerPrik" Width="12" Height="12" Fill="{StaticResource TekstMeget}"
                 VerticalAlignment="Center" Margin="0,0,10,0" />
      </StackPanel>
    </Grid>

    <!-- ============================ Teleprompter ========================= -->
    <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="10"
            BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Startskærm: vejledningen fra tekstens indledning. Vises indtil
             optagelsen begynder, så instruktionerne læses FØR, ikke undervejs. -->
        <!-- Tre kort, der passer paa skaermen uden at rulle. Foerste udgave var
             en side tekst; ingen laeser en side tekst for at komme i gang med
             at laese en anden. Hvert kort svarer paa eet spoergsmaal med to
             linjer. -->
        <Grid x:Name="VejledningPanel" Grid.Row="0" Margin="36,26,36,20">
          <!-- Alt fylder det, det har brug for, og luften ligger i bunden.
               Sætningslisten lå her engang og krævede en *-række; den ligger nu
               i sit eget vindue, og så er der ikke noget her, der skal strækkes. -->
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="0" />
          </Grid.RowDefinitions>

          <!-- ============ Overskrift ============ -->
          <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock x:Name="Overskrift" FontSize="26" FontWeight="SemiBold"
                       Text="Lær appen din stemme at kende" />
            <TextBlock x:Name="Indledning" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TekstSvag}" />
          </StackPanel>

          <!-- ============ De tre tekster ============
               Boksene ER fanerne. Man vælger en, og alt om den står nedenunder
               — hvorfor den er værd at læse, eller hvad den gav. Tallet står
               på boksen selv, så man kan se på ét blik, hvor man er.

               Beskrivelsen er flyttet ned i detaljen. Tre bokse, der hver
               bærer fire linjer tekst, er ikke et overblik; det er en side,
               man skal læse for at kunne vælge. -->
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <RadioButton x:Name="Valg0" Grid.Column="0" GroupName="tekst" IsChecked="True"
                         Style="{StaticResource Tekstkort}" Margin="0,0,7,0" Checked="Tekst_Valgt" Tag="0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="1 · DANSK" FontSize="11" FontWeight="SemiBold"
                             Foreground="{StaticResource Accent}" />
                  <TextBlock Text="Grundlaget" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" />
                  <TextBlock x:Name="Status0" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock x:Name="Tal0" Grid.Column="1" FontSize="21" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="8,0,0,0" />
              </Grid>
            </RadioButton>

            <RadioButton x:Name="Valg1" Grid.Column="1" GroupName="tekst"
                         Style="{StaticResource Tekstkort}" Margin="7,0,7,0" Checked="Tekst_Valgt" Tag="1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="2 · SPROGSKIFT" FontSize="11" FontWeight="SemiBold"
                             Foreground="{StaticResource TekstMeget}" />
                  <TextBlock Text="Blandet" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" />
                  <TextBlock x:Name="Status1" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock x:Name="Tal1" Grid.Column="1" FontSize="21" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="8,0,0,0" />
              </Grid>
            </RadioButton>

            <RadioButton x:Name="Valg2" Grid.Column="2" GroupName="tekst"
                         Style="{StaticResource Tekstkort}" Margin="7,0,0,0" Checked="Tekst_Valgt" Tag="2">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="3 · ACCENT" FontSize="11" FontWeight="SemiBold"
                             Foreground="{StaticResource TekstMeget}" />
                  <TextBlock Text="Engelsk" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" />
                  <TextBlock x:Name="Status2" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock x:Name="Tal2" Grid.Column="1" FontSize="21" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="8,0,0,0" />
              </Grid>
            </RadioButton>
          </Grid>

          <!-- ==================== Detaljer for den valgte ====================
               Hele indholdet om ÉN tekst ligger her, under den boks, det hører
               til. Før lå det på en selvstændig skærm, «Træning», ved siden af
               denne: man skulle skifte skærm for at se resultatet af sin egen
               oplæsning, og de to skærme kunne stå og sige noget forskelligt om
               det samme.

               Der er tre tilstande, og de er de tre trin i arbejdet:
                 1. ikke læst op    → hvorfor teksten er værd at læse + knap
                 2. læst, ikke skrevet ud → én knap: skriv den ud
                 3. målt            → tallet og hver sætning, med det gule
               Kun én af dem vises ad gangen. -->

          <Grid Grid.Row="2" Margin="0,18,0,0">

            <!-- 1 · Ikke læst op endnu -->
            <Border x:Name="TrinLaes" Background="#FF181B22" CornerRadius="10"
                    BorderBrush="{StaticResource PanelKant}" BorderThickness="1"
                    Padding="24,20" VerticalAlignment="Top">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                  <TextBlock x:Name="HvorforOverskrift" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock x:Name="HvorforLaengde" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"
                             LineHeight="21" Foreground="{StaticResource TekstSvag}" />
                  <TextBlock x:Name="HvorforFuld" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"
                             LineHeight="21" Foreground="{StaticResource TekstMeget}" />

                  <TextBlock FontSize="12.5" Margin="0,14,0,0" TextWrapping="Wrap" LineHeight="20"
                             Foreground="{StaticResource TekstMeget}"
                             Text="Sådan gør du: der står ét afsnit ad gangen. Læs det, tryk mellemrum, læs det næste. Tal som til en kollega — pauser og tøvelyde hører med. Du kan sætte på pause når som helst, og intet går tabt." />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <Button x:Name="StartKnap" Content="● Start oplæsning" Click="StartValgte_Click"
                          Style="{StaticResource Primaer}" Padding="22,12" FontSize="14" MinWidth="190" />
                  <TextBlock x:Name="StartUnder" FontSize="11.5" Margin="0,8,0,0"
                             HorizontalAlignment="Center" Foreground="{StaticResource TekstMeget}" />
                </StackPanel>
              </Grid>
            </Border>

            <!-- 2 · Læst op, men ikke skrevet ud -->
            <Border x:Name="TrinSkrivUd" Background="#FF181B22" CornerRadius="10"
                    BorderBrush="{StaticResource Advarsel}" BorderThickness="1"
                    Padding="24,20" VerticalAlignment="Top" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                  <TextBlock Text="Optagelsen er ikke skrevet ud endnu" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock x:Name="SkrivUdTekst" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"
                             LineHeight="21" Foreground="{StaticResource TekstSvag}" />
                </StackPanel>

                <Button Grid.Column="1" Content="Skriv ud til tekst  →" Click="SkrivUd_Click"
                        Style="{StaticResource Primaer}" Padding="22,12" FontSize="14"
                        VerticalAlignment="Center" MinWidth="190" />
              </Grid>
            </Border>

            <!-- 3 · Målt -->
            <ContentControl x:Name="TrinResultat" Visibility="Collapsed" />
          </Grid>
        </Grid>


        <!-- Oplæsningen: ét afsnit ad gangen, stort. Det næste står svagt
             nedenunder, så man kan tage tilløb til det uden at miste linjen. -->
        <!-- Teleprompteren viser KUN det afsnit, der skal læses. Første udgave
             havde det næste afsnit stående svagt nedenunder som tilløb — og
             det blev læst med. En skærm, hvor man skal forklares hvad der er
             tekst og hvad der er hjælp, er forkert designet; så er det bedre,
             at der kun står ét. -->
        <Grid x:Name="LaesePanel" Grid.Row="0" Margin="44,28" Visibility="Collapsed">
          <TextBlock x:Name="Afsnit" FontSize="32" LineHeight="52" TextWrapping="Wrap"
                     Foreground="#FFFFFFFF" VerticalAlignment="Center"
                     MaxWidth="980" HorizontalAlignment="Center" />
        </Grid>

        <!-- Kvitteringen. Foerste udgave sluttede med en dialog, der spurgte om
             mappen skulle aabnes — og saa stod man i en mappe med tre filer
             uden at vide, hvilken der betoed noget, eller hvad der skulle ske
             nu. Tyve minutters oplaesning skal kvitteres, og der skal peges paa
             det naeste skridt. Ellers er arbejdet gjort, uden at nogen kan se
             det. -->
        <Grid x:Name="KvitteringPanel" Grid.Row="0" Margin="44,30" Visibility="Collapsed">
          <StackPanel VerticalAlignment="Center" MaxWidth="820">

            <TextBlock x:Name="KvitOverskrift" FontSize="30" FontWeight="SemiBold"
                       Text="Godt læst op" />
            <TextBlock x:Name="KvitUnder" FontSize="14" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TekstSvag}" />

            <!-- Tallene fra optagelsen. De staar her, fordi de er det eneste,
                 der afgoer om oplaesningen kan bruges til noget. -->
            <Border Background="#FF181B22" BorderBrush="{StaticResource PanelKant}"
                    BorderThickness="1" CornerRadius="10" Padding="22,18" Margin="0,22,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock x:Name="KvitLaengde" FontSize="24" FontWeight="SemiBold" Text="—" />
                  <TextBlock Text="lyd optaget" Style="{StaticResource Underskrift}" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                  <TextBlock x:Name="KvitAfsnit" FontSize="24" FontWeight="SemiBold" Text="—" />
                  <TextBlock Text="afsnit læst" Style="{StaticResource Underskrift}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock x:Name="KvitTempo" FontSize="24" FontWeight="SemiBold" Text="—" />
                  <TextBlock Text="ord i minuttet" Style="{StaticResource Underskrift}" />
                </StackPanel>
              </Grid>
            </Border>

            <TextBlock x:Name="KvitVurdering" FontSize="14" Margin="2,16,0,0" TextWrapping="Wrap"
                       LineHeight="22" Foreground="{StaticResource Tekst}" />

            <!-- Naeste skridt. Det primaere er transskription: uden den er
                 optagelsen bare en lydfil, og maalingen er ikke lavet endnu. -->
            <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
              <Button x:Name="KvitTransskriber" Content="Transskribér optagelsen  →"
                      Click="KvitTransskriber_Click" Padding="20,11" FontSize="14"
                      Background="{StaticResource Accent}" Foreground="#FF0B1220"
                      BorderThickness="0" Cursor="Hand" />

              <Button x:Name="KvitNaesteTekst" Content="Læs næste tekst" Margin="12,0,0,0"
                      Click="KvitNaesteTekst_Click" Padding="18,11" FontSize="14" Cursor="Hand" />
            </StackPanel>

            <TextBlock x:Name="KvitNaesteHvad" FontSize="12" Margin="2,12,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TekstMeget}" />

            <!-- Mappen ligger nederst og daempet. Den er sjaeldent det, man har
                 brug for, og naar man er, skal det staa hvad der ligger i den. -->
            <TextBlock Margin="2,18,0,0" FontSize="12" Foreground="{StaticResource TekstMeget}">
              <Hyperlink Click="KvitAabnMappe_Click" Foreground="{StaticResource TekstSvag}">Åbn mappen med optagelsen</Hyperlink>
              <Run Text=" — mikrofon.wav er lyden, notes.jsonl er blokmærkerne, meeting.json er oplysningerne om optagelsen. Du skal ikke bruge nogen af dem manuelt." />
            </TextBlock>
          </StackPanel>
        </Grid>

        <!-- Fremdrift gennem teksten -->
        <Grid Grid.Row="1" Margin="36,0,36,20">
          <ProgressBar x:Name="Fremdrift" Height="4" Minimum="0" Maximum="100" Value="0"
                       Background="#FF2C323D" Foreground="{StaticResource Accent}"
                       BorderThickness="0" />
        </Grid>
      </Grid>
    </Border>

    <!-- ============================ Bundbjælke =========================== -->
    <Grid Grid.Row="2" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <TextBlock Text="Mikrofon" Style="{StaticResource Underskrift}" Width="62" />
          <Border Width="220" Height="8" Background="#FF2C323D" CornerRadius="4" VerticalAlignment="Center">
            <Border x:Name="Niveau" HorizontalAlignment="Left" Width="0" Height="8"
                    CornerRadius="4" Background="{StaticResource Godkendt}" />
          </Border>
          <TextBlock x:Name="MikrofonNavn" Style="{StaticResource Underskrift}" Margin="12,0,0,0"
                     VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <!-- Her stod «Skift afsnit automatisk, når jeg har læst det». Den
             lyttede med under oplæsningen med en ekstra model og en ekstra
             exe, havde en vagthund fordi den kunne køre uden at høre noget,
             og kunne dø undervejs. Alt sammen for at spare et tryk på
             mellemrum — og den åbnede mikrofonen ved siden af optagelsen. -->
        <TextBlock x:Name="Status" Style="{StaticResource Underskrift}" Margin="0,4,0,0" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="ForrigeKnap" Content="◀ Forrige" Click="Forrige_Click"
                Margin="0,0,8,0" IsEnabled="False" />
        <Button x:Name="NaesteKnap" Content="Næste afsnit  (mellemrum)" Click="Naeste_Click"
                Margin="0,0,16,0" IsEnabled="False" Style="{StaticResource Primaer}" />
        <Button x:Name="PauseKnap" Content="❚❚ Pause" Click="Pause_Click"
                Margin="0,0,8,0" Visibility="Collapsed" MinWidth="120" />
        <Button x:Name="OptagKnap" Content="● Start optagelse" Click="Optag_Click"
                Style="{StaticResource Fare}" MinWidth="170" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
