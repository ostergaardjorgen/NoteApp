<UserControl x:Class="NoteApp.Desktop.ReadAloud.ReadAloudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Baggrund}"
             Focusable="True">

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ============================ Topbjælke ============================ -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock x:Name="BlokTitel" Style="{StaticResource Overskrift}" Text="Klar til oplæsning" />
        <TextBlock x:Name="BlokUnder" Style="{StaticResource Underskrift}" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

        <!-- Tempoafvigelsen er det, der afgør om optagelsen bliver brugbar.
             Derfor står den ved siden af uret, ikke gemt i en statuslinje. -->
        <StackPanel Margin="0,0,20,0" HorizontalAlignment="Right">
          <TextBlock x:Name="Tempo" Text="—" FontSize="13" HorizontalAlignment="Right"
                     Foreground="{StaticResource TekstSvag}" />
          <TextBlock Text="tempo" Style="{StaticResource Underskrift}" HorizontalAlignment="Right" />
        </StackPanel>

        <StackPanel Margin="0,0,20,0" HorizontalAlignment="Right">
          <TextBlock x:Name="Ur" Text="00:00" FontSize="26" FontWeight="SemiBold"
                     FontFamily="Consolas" HorizontalAlignment="Right" />
          <TextBlock x:Name="UrMaal" Style="{StaticResource Underskrift}" HorizontalAlignment="Right"
                     Text="mål 00:00" />
        </StackPanel>

        <Ellipse x:Name="OptagerPrik" Width="12" Height="12" Fill="{StaticResource TekstMeget}"
                 VerticalAlignment="Center" Margin="0,0,10,0" />
      </StackPanel>
    </Grid>

    <!-- ============================ Teleprompter ========================= -->
    <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="10"
            BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Startskærm: vejledningen fra tekstens indledning. Vises indtil
             optagelsen begynder, så instruktionerne læses FØR, ikke undervejs. -->
        <ScrollViewer x:Name="VejledningPanel" Grid.Row="0" Padding="36,28"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Inden du begynder" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
            <ItemsControl x:Name="Vejledning">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" FontSize="14" Margin="0,0,0,10"
                             Foreground="{StaticResource TekstSvag}" LineHeight="22" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Background="#22E0A030" BorderBrush="{StaticResource Advarsel}" BorderThickness="1"
                    CornerRadius="6" Padding="14,10" Margin="0,10,0,0">
              <StackPanel>
                <TextBlock x:Name="NavneAdvarsel" FontSize="13" Foreground="{StaticResource Tekst}" />
                <TextBlock x:Name="TekstKilde" Style="{StaticResource Underskrift}" Margin="0,6,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Oplæsningen: ét afsnit ad gangen, stort. Det næste står svagt
             nedenunder, så man kan tage tilløb til det uden at miste linjen. -->
        <Grid x:Name="LaesePanel" Grid.Row="0" Margin="36,28" Visibility="Collapsed">
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="Afsnit" FontSize="30" LineHeight="46" TextWrapping="Wrap" />
            <TextBlock x:Name="NaesteAfsnit" FontSize="17" LineHeight="28" Margin="0,28,0,0"
                       Foreground="{StaticResource TekstMeget}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>

        <!-- Fremdrift gennem teksten -->
        <Grid Grid.Row="1" Margin="36,0,36,20">
          <ProgressBar x:Name="Fremdrift" Height="4" Minimum="0" Maximum="100" Value="0"
                       Background="#FF232833" Foreground="{StaticResource Accent}"
                       BorderThickness="0" />
        </Grid>
      </Grid>
    </Border>

    <!-- ============================ Bundbjælke =========================== -->
    <Grid Grid.Row="2" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <TextBlock Text="Mikrofon" Style="{StaticResource Underskrift}" Width="62" />
          <Border Width="220" Height="8" Background="#FF232833" CornerRadius="4" VerticalAlignment="Center">
            <Border x:Name="Niveau" HorizontalAlignment="Left" Width="0" Height="8"
                    CornerRadius="4" Background="{StaticResource Godkendt}" />
          </Border>
          <TextBlock x:Name="MikrofonNavn" Style="{StaticResource Underskrift}" Margin="12,0,0,0"
                     VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock x:Name="Status" Style="{StaticResource Underskrift}" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="ForrigeKnap" Content="◀ Forrige" Click="Forrige_Click"
                Margin="0,0,8,0" IsEnabled="False" />
        <Button x:Name="NaesteKnap" Content="Næste afsnit  (mellemrum)" Click="Naeste_Click"
                Margin="0,0,16,0" IsEnabled="False" Style="{StaticResource Primaer}" />
        <Button x:Name="OptagKnap" Content="● Start optagelse" Click="Optag_Click"
                Style="{StaticResource Fare}" MinWidth="170" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
