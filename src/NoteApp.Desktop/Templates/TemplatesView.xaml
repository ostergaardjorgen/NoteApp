<UserControl x:Class="NoteApp.Desktop.Templates.TemplatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Baggrund}">

  <!-- Samme opbygning som «Optagelser» og «Dokumenter»: vaerktoejslinje med
       ikoner oeverst, bibliotekstrae til venstre, indhold til hoejre.

       Skabeloner har ingen mapper og intet arkiv - de er faa, og de er alle
       sammen i brug. Traeet har derfor eet bibliotek uden undermapper, og der
       er ikke noget at traekke nogen steder hen. Formen er den samme
       alligevel: skaermene skal kunne genkendes, ogsaa naar den ene har
       mindre at vise end de andre. -->

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="Skabeloner" Style="{StaticResource Overskrift}" />
      <TextBlock Style="{StaticResource Underskrift}"
                 Text="Hvad der skal laves ud af en optagelse" />
    </StackPanel>

    <!-- HER LAA ET PANEL: "Dokumenter laves af Mistral Medium 3.5 i Europa".
         Det staar nu to andre steder - under AI-modeller, hvor man vaelger
         det, og under Compliance, hvor det hoerer juridisk hjemme. Tre steder
         er ikke tre gange saa tydeligt; det er stoej de to af gangene, og her
         tog det den plads, skabelonens egne felter havde brug for.
         Fjernet 18-08-2026. -->

    <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="8"
            BorderBrush="{StaticResource PanelKant}" BorderThickness="1" Padding="8,6">
      <DockPanel>
        <Button DockPanel.Dock="Right" x:Name="GemKnap" Content="Gem ændringer" Click="Gem_Click"
                Style="{StaticResource Primaer}" MinWidth="150" IsEnabled="False"
                ToolTip="Gem det, du har rettet i skabelonen" />

        <Border DockPanel.Dock="Right" Width="1" Margin="10,4,14,4"
                Background="{StaticResource PanelKant}" />

        <Button DockPanel.Dock="Left" x:Name="NyKnap" Style="{StaticResource IkonKnap}"
                Click="Ny_Click" AutomationProperties.Name="Ny skabelon"
                ToolTip="Ny skabelon — start fra en tom og skriv din egen">
          <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" />
        </Button>

        <Border DockPanel.Dock="Left" Width="1" Margin="6,4,8,4"
                Background="{StaticResource PanelKant}" />

        <Button DockPanel.Dock="Left" x:Name="MappeKnap" Style="{StaticResource IkonKnap}"
                Click="Mappe_Click" AutomationProperties.Name="Åbn skabelonmappen"
                ToolTip="Åbn skabelonmappen på disken">
          <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" />
        </Button>

        <Border DockPanel.Dock="Left" Width="1" Margin="6,4,8,4"
                Background="{StaticResource PanelKant}" />

        <Button DockPanel.Dock="Left" x:Name="SletKnap" Style="{StaticResource IkonKnapFare}"
                Click="Slet_Click" IsEnabled="False" AutomationProperties.Name="Slet skabelon"
                ToolTip="Slet den valgte skabelon. Kan ikke fortrydes">
          <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" />
        </Button>

        <Grid />
      </DockPanel>
    </Border>

    <Grid Grid.Row="2" Margin="2,8,2,10">
      <TextBlock x:Name="Status" Style="{StaticResource Underskrift}" VerticalAlignment="Bottom" />
    </Grid>

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="10"
              BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="BIBLIOTEKER" FontSize="10.5" FontWeight="SemiBold"
                     Margin="16,14,16,8" Foreground="{StaticResource TekstMeget}" />

          <TreeView x:Name="Trae" Background="Transparent" BorderThickness="0"
                    Margin="6,0,6,10" SelectedItemChanged="Trae_Valgt"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <TreeView.ItemContainerStyle>
              <Style TargetType="TreeViewItem">
                <Style.Resources>
                  <!-- WPF tegner sin EGEN markering under vores skabelon, med
                       systemets fremhaevningsfarve og hvid tekst. Paa et
                       moerkt tema bliver navnet dermed usynligt, naar man
                       vaelger det. De tre noegler slukker den, saa det er
                       DataTriggeren paa ErValgt nedenfor, der tegner
                       markeringen - i temaets egne farver. -->
                  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFF4F6FA" />
                </Style.Resources>
                <Setter Property="Padding" Value="2,1" />
                <Setter Property="Foreground" Value="{StaticResource TekstSvag}" />
                <Setter Property="IsExpanded" Value="{Binding ErUdfoldet, Mode=TwoWay}" />
                <Setter Property="IsSelected" Value="{Binding ErValgt, Mode=TwoWay}" />
              </Style>
            </TreeView.ItemContainerStyle>

            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate ItemsSource="{Binding Boern}">
                <Border x:Name="rk" CornerRadius="5" Padding="6,4" Background="Transparent"
                        AutomationProperties.Name="{Binding Visning}">
                  <Border.ToolTip>
                    <StackPanel MaxWidth="360">
                      <TextBlock Text="{Binding Navn}" FontWeight="SemiBold" FontSize="13"
                                 TextWrapping="Wrap" Margin="0,0,0,6" />
                      <TextBlock Text="{Binding Linje1}" FontSize="12.5" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Linje2}" FontSize="12.5" Margin="0,3,0,0"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Border.ToolTip>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Glyf}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,9,0"
                               Foreground="{StaticResource Accent}" />
                    <TextBlock Text="{Binding Visning}" FontSize="12.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Border>
                <HierarchicalDataTemplate.Triggers>
                  <DataTrigger Binding="{Binding ErValgt}" Value="True">
                    <Setter TargetName="rk" Property="Background" Value="#FF33405A" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding ErBeholder}" Value="True">
                    <Setter TargetName="rk" Property="ToolTipService.IsEnabled" Value="False" />
                  </DataTrigger>
                </HierarchicalDataTemplate.Triggers>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch"
                    Background="Transparent" />

      <!-- Højre: den valgte skabelon -->
      <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="10"
              BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
        <!-- FIRE FANER FREM FOR FIRE FELTER OVEN PAA HINANDEN.
             Ruden skulle vise navn, beskrivelse, to prompter og en feltliste
             paa een gang. Hver af de to store tekstfelter fik derfor en
             tredjedel af hoejden, og man redigerede en prompt paa halvfems
             linjer gennem en rude paa fem.

             Med faner faar det, man arbejder i, hele pladsen. Raekkefoelgen
             er den, man bruger dem i: hvad skabelonen hedder, hvad modellen
             skal goere, hvad den faar at arbejde med - og til sidst
             opslagslisten over felter. -->
        <TabControl x:Name="Detaljer" Style="{StaticResource Fanerude}" Margin="22,16,22,18">

          <TabItem Header="Navn og indstillinger" Style="{StaticResource Fane}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                  <TextBlock Text="Navn" Style="{StaticResource Underskrift}" />
                  <TextBox x:Name="FeltNavn" Margin="0,4,0,0" TextChanged="Aendret" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                  <TextBlock Text="Beskrivelse" Style="{StaticResource Underskrift}" />
                  <TextBox x:Name="FeltBeskrivelse" Margin="0,4,0,0" TextChanged="Aendret" />
                </StackPanel>
              </Grid>

              <TextBlock FontSize="11.5" Margin="2,6,0,0" TextWrapping="Wrap"
                         Foreground="{StaticResource TekstMeget}"
                         Text="Navnet står på knappen, når du vælger skabelon. Beskrivelsen står under den, så valget ikke er et gæt." />

              <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                  <TextBlock Text="Temperatur" Style="{StaticResource Underskrift}" />
                  <TextBox x:Name="FeltTemperatur" Margin="0,4,0,0" TextChanged="Aendret" />
                  <TextBlock FontSize="11.5" Margin="2,6,0,0" TextWrapping="Wrap" LineHeight="18"
                             Foreground="{StaticResource TekstMeget}"
                             Text="0,0 holder sig tæt på udskriften. Over 0,4 begynder den at formulere sig frit — og til et referat er det en fejl, ikke en stil." />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                  <TextBlock Text="Maks. længde (tokens)" Style="{StaticResource Underskrift}" />
                  <TextBox x:Name="FeltMaksTokens" Margin="0,4,0,0" TextChanged="Aendret" />
                  <TextBlock FontSize="11.5" Margin="2,6,0,0" TextWrapping="Wrap" LineHeight="18"
                             Foreground="{StaticResource TekstMeget}"
                             Text="Loftet over svaret. Cirka 3 tegn pr. token — 2048 rækker til et fyldigt referat." />
                </StackPanel>
              </Grid>
            </StackPanel>
          </TabItem>

          <TabItem Header="Instruktion til modellen" Style="{StaticResource Fane}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" FontSize="11.5" Margin="2,0,0,8" TextWrapping="Wrap"
                         Foreground="{StaticResource TekstMeget}"
                         Text="Reglerne, modellen arbejder efter. Det er her, du bestemmer, hvad et referat SKAL og ikke må — og det er her, en fejl i et referat oftest skal rettes." />
              <TextBox x:Name="FeltSystem" AcceptsReturn="True" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto" AcceptsTab="True"
                       FontFamily="Consolas" FontSize="12.5" TextChanged="Aendret" />
            </DockPanel>
          </TabItem>

          <TabItem Header="Det, modellen får at arbejde med" Style="{StaticResource Fane}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" FontSize="11.5" Margin="2,0,0,8" TextWrapping="Wrap"
                         Foreground="{StaticResource TekstMeget}"
                         Text="Selve opgaven, med udskriften sat ind. Felterne i krøllede parenteser bliver erstattet, når dokumentet laves — se fanen «Felter»." />
              <TextBox x:Name="FeltBruger" AcceptsReturn="True" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto" AcceptsTab="True"
                       FontFamily="Consolas" FontSize="12.5" TextChanged="Aendret" />
            </DockPanel>
          </TabItem>

          <TabItem Header="Felter" Style="{StaticResource Fane}">
            <StackPanel>
              <TextBlock FontSize="12.5" TextWrapping="Wrap" LineHeight="21"
                         Foreground="{StaticResource TekstSvag}"
                         Text="Skriv et af disse felter ind i teksten, så bliver det erstattet med mødets egne oplysninger, når dokumentet laves." />
              <Border Background="#FF181B22" BorderBrush="{StaticResource PanelKant}"
                      BorderThickness="1" CornerRadius="8" Padding="16,13" Margin="0,12,0,0">
                <TextBlock x:Name="Felter" FontSize="12.5" TextWrapping="Wrap"
                           LineHeight="22" Foreground="{StaticResource TekstMeget}" />
              </Border>
            </StackPanel>
          </TabItem>

        </TabControl>
      </Border>
    </Grid>
  </Grid>
</UserControl>
