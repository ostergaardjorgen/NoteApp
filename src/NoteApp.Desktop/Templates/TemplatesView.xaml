<UserControl x:Class="NoteApp.Desktop.Templates.TemplatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:NoteApp.Desktop"
             Background="{StaticResource Baggrund}">

  <!-- Samme opbygning som «Optagelser» og «Dokumenter»: vaerktoejslinje med
       ikoner oeverst, bibliotekstrae til venstre, indhold til hoejre.

       Skabeloner har ingen mapper og intet arkiv - de er faa, og de er alle
       sammen i brug. Traeet har derfor eet bibliotek uden undermapper, og der
       er ikke noget at traekke nogen steder hen. Formen er den samme
       alligevel: skaermene skal kunne genkendes, ogsaa naar den ene har
       mindre at vise end de andre. -->

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <!-- MØDETYPER UDADTIL, SKABELONER INDADTIL.
           Se MainWindow.xaml for hvorfor. Kort: mødetypen kan man svare på,
           FØR mødet går i gang, og det er dér, den bliver valgt. «Skabelon»
           kan man foerst svare paa, naar man taenker i dokumenter. -->
      <TextBlock Text="{i18n:Oversat templatesview.moedetyper}" Style="{StaticResource Overskrift}" />
      <TextBlock Style="{StaticResource Underskrift}"
                 Text="{i18n:Oversat templatesview.hvilken_slags_moede_det_er_og_hvad_der_ska}" />
    </StackPanel>

    <!-- HER LAA ET PANEL: "Dokumenter laves af Mistral Medium 3.5 i Europa".
         Det staar nu to andre steder - under AI-modeller, hvor man vaelger
         det, og under Compliance, hvor det hoerer juridisk hjemme. Tre steder
         er ikke tre gange saa tydeligt; det er stoej de to af gangene, og her
         tog det den plads, skabelonens egne felter havde brug for.
         Fjernet 18-08-2026. -->

    <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="8"
            BorderBrush="{StaticResource PanelKant}" BorderThickness="1" Padding="8,6">
      <DockPanel>
        <Button DockPanel.Dock="Right" x:Name="GemKnap" Content="{i18n:Oversat templatesview.gem_aendringer}" Click="Gem_Click"
                Style="{StaticResource Primaer}" MinWidth="150" IsEnabled="False"
                ToolTip="{i18n:Oversat templatesview.gem_det_du_har_rettet_i_moedetypen}" />

        <Border DockPanel.Dock="Right" Width="1" Margin="10,4,14,4"
                Background="{StaticResource PanelKant}" />

        <Button DockPanel.Dock="Left" x:Name="NyKnap" Style="{StaticResource IkonKnap}"
                Click="Ny_Click" AutomationProperties.Name="{i18n:Oversat faelles.ny_moedetype}"
                ToolTip="{i18n:Oversat templatesview.ny_moedetype_start_fra_en_tom_og_skriv_din}">
          <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" />
        </Button>

        <Border DockPanel.Dock="Left" Width="1" Margin="6,4,8,4"
                Background="{StaticResource PanelKant}" />

        <Button DockPanel.Dock="Left" x:Name="MappeKnap" Style="{StaticResource IkonKnap}"
                Click="Mappe_Click" AutomationProperties.Name="{i18n:Oversat templatesview.aabn_mappen_med_moedetyper}"
                ToolTip="{i18n:Oversat templatesview.aabn_mappen_med_moedetyper_paa_disken}">
          <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" />
        </Button>

        <Border DockPanel.Dock="Left" Width="1" Margin="6,4,8,4"
                Background="{StaticResource PanelKant}" />

        <Button DockPanel.Dock="Left" x:Name="SletKnap" Style="{StaticResource IkonKnapFare}"
                Click="Slet_Click" IsEnabled="False" AutomationProperties.Name="{i18n:Oversat templatesview.slet_moedetype}"
                ToolTip="{i18n:Oversat templatesview.slet_den_valgte_moedetype_kan_ikke_fortryd}">
          <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" />
        </Button>

        <Grid />
      </DockPanel>
    </Border>

    <Grid Grid.Row="2" Margin="2,8,2,10">
      <TextBlock x:Name="Status" Style="{StaticResource Underskrift}" VerticalAlignment="Bottom" />
    </Grid>

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <!-- Samme bredde som paa Optagelser og Dokumenter. Se TranscribeView. -->
        <ColumnDefinition Width="225" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="10"
              BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{i18n:Oversat faelles.biblioteker}" FontSize="10.5" FontWeight="SemiBold"
                     Margin="16,14,16,8" Foreground="{StaticResource TekstMeget}" />

          <TreeView x:Name="Trae" Background="Transparent" BorderThickness="0"
                    Margin="6,0,6,10" SelectedItemChanged="Trae_Valgt"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <TreeView.ItemContainerStyle>
              <Style TargetType="TreeViewItem">
                <Style.Resources>
                  <!-- WPF tegner sin EGEN markering under vores skabelon, med
                       systemets fremhaevningsfarve og hvid tekst. Paa et
                       moerkt tema bliver navnet dermed usynligt, naar man
                       vaelger det. De tre noegler slukker den, saa det er
                       DataTriggeren paa ErValgt nedenfor, der tegner
                       markeringen - i temaets egne farver. -->
                  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFF4F6FA" />
                </Style.Resources>
                <Setter Property="Padding" Value="2,1" />
                <Setter Property="Foreground" Value="{StaticResource TekstSvag}" />
                <Setter Property="IsExpanded" Value="{Binding ErUdfoldet, Mode=TwoWay}" />
                <Setter Property="IsSelected" Value="{Binding ErValgt, Mode=TwoWay}" />
              </Style>
            </TreeView.ItemContainerStyle>

            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate ItemsSource="{Binding Boern}">
                <Border x:Name="rk" CornerRadius="5" Padding="6,4" Background="Transparent"
                        AutomationProperties.Name="{Binding Visning}">
                  <Border.ToolTip>
                    <StackPanel MaxWidth="360">
                      <TextBlock Text="{Binding Navn}" FontWeight="SemiBold" FontSize="13"
                                 TextWrapping="Wrap" Margin="0,0,0,6" />
                      <TextBlock Text="{Binding Linje1}" FontSize="12.5" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Linje2}" FontSize="12.5" Margin="0,3,0,0"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Border.ToolTip>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Glyf}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,9,0"
                               Foreground="{StaticResource Accent}" />
                    <TextBlock Text="{Binding Visning}" FontSize="12.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Border>
                <HierarchicalDataTemplate.Triggers>
                  <DataTrigger Binding="{Binding ErValgt}" Value="True">
                    <Setter TargetName="rk" Property="Background" Value="#FF33405A" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding ErBeholder}" Value="True">
                    <Setter TargetName="rk" Property="ToolTipService.IsEnabled" Value="False" />
                  </DataTrigger>
                </HierarchicalDataTemplate.Triggers>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch"
                    Background="Transparent" />

      <!-- Højre: den valgte skabelon -->
      <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="10"
              BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
        <!-- FIRE FANER FREM FOR FIRE FELTER OVEN PAA HINANDEN.
             Ruden skulle vise navn, beskrivelse, to prompter og en feltliste
             paa een gang. Hver af de to store tekstfelter fik derfor en
             tredjedel af hoejden, og man redigerede en prompt paa halvfems
             linjer gennem en rude paa fem.

             Med faner faar det, man arbejder i, hele pladsen. Raekkefoelgen
             er den, man bruger dem i: hvad skabelonen hedder, hvad modellen
             skal goere, hvad den faar at arbejde med - og til sidst
             opslagslisten over felter. -->
        <TabControl x:Name="Detaljer" Style="{StaticResource Fanerude}" Margin="22,16,22,18">

          <TabItem Header="{i18n:Oversat faelles.indstillinger}" Style="{StaticResource Fane}">
            <StackPanel>

              <!-- De tre korte felter paa een raekke. Beskrivelsen fik foer
                   halvdelen af bredden og een linje - og den er den eneste
                   af dem, der kan blive lang. Nu staar de smaa sammen
                   foroven, og beskrivelsen faar hele bredden og plads til
                   flere linjer. -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                  <TextBlock Text="{i18n:Oversat templatesview.navn}" Style="{StaticResource Underskrift}" />
                  <TextBox x:Name="FeltNavn" Margin="0,4,0,0" TextChanged="Aendret" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                  <TextBlock Text="{i18n:Oversat templatesview.temperatur}" Style="{StaticResource Underskrift}" />
                  <TextBox x:Name="FeltTemperatur" Margin="0,4,0,0" TextChanged="Aendret" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="{i18n:Oversat templatesview.maks_laengde_tokens}" Style="{StaticResource Underskrift}" />
                  <TextBox x:Name="FeltMaksTokens" Margin="0,4,0,0" TextChanged="Aendret" />
                </StackPanel>
              </Grid>

              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="11.5" TextWrapping="Wrap" Margin="2,0,10,0"
                           Foreground="{StaticResource TekstMeget}"
                           Text="{i18n:Oversat templatesview.staar_paa_knappen_naar_du_vaelger_moedetyp}" />
                <TextBlock Grid.Column="1" FontSize="11.5" TextWrapping="Wrap" Margin="2,0,10,0"
                           Foreground="{StaticResource TekstMeget}"
                           Text="{i18n:Oversat templatesview.0_0_holder_sig_taet_paa_transkriptionen_ov}" />
                <TextBlock Grid.Column="2" FontSize="11.5" TextWrapping="Wrap" Margin="2,0,0,0"
                           Foreground="{StaticResource TekstMeget}"
                           Text="{i18n:Oversat templatesview.loftet_over_svaret_cirka_3_tegn_pr_token}" />
              </Grid>

              <TextBlock Text="{i18n:Oversat templatesview.beskrivelse}" Style="{StaticResource Underskrift}" Margin="0,20,0,0" />
              <TextBox x:Name="FeltBeskrivelse" Margin="0,4,0,0" TextChanged="Aendret"
                       AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58"
                       VerticalScrollBarVisibility="Auto" />
              <TextBlock FontSize="11.5" Margin="2,6,0,0" TextWrapping="Wrap"
                         Foreground="{StaticResource TekstMeget}"
                         Text="{i18n:Oversat templatesview.staar_under_navnet_naar_du_vaelger_moedety}" />
            </StackPanel>
          </TabItem>

          <TabItem Header="{i18n:Oversat templatesview.instruktion}" Style="{StaticResource Fane}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" FontSize="11.5" Margin="2,0,0,8" TextWrapping="Wrap"
                         Foreground="{StaticResource TekstMeget}"
                         Text="{i18n:Oversat templatesview.reglerne_modellen_arbejder_efter_det_er_he}" />

              <!-- DELTAGERREGLERNE HOERER TIL HER, IKKE PAA MATERIALEFANEN.
                   De er en REGEL, ikke en oplysning om moedet, og de bliver
                   kun sat ind i systemprompten. Stod feltet paa den anden
                   fane, blev det erstattet med ingenting - reglerne forsvandt
                   uden en lyd, og det viste sig foerst som en opfundet
                   deltager i et referat. -->
              <Border DockPanel.Dock="Bottom" Background="#FF181B22" CornerRadius="8"
                      BorderBrush="{StaticResource PanelKant}" BorderThickness="1"
                      Padding="14,11" Margin="0,10,0,0">
                <StackPanel>
                  <TextBlock Text="{i18n:Oversat templatesview.faelles_regler_du_kan_saette_ind}" FontSize="12.5" FontWeight="SemiBold" />
                  <TextBlock FontSize="11.5" Margin="0,4,0,8" TextWrapping="Wrap" LineHeight="18"
                             Foreground="{StaticResource TekstMeget}"
                             Text="{i18n:Oversat templatesview.reglerne_for_hvem_der_kommer_paa_deltagerl}" />
                  <!-- {} foerst: ellers laeser XAML den kroellede parentes som en
                       markup-extension og vil ikke bygge. -->
                  <Button Content="{}{{deltagerregler}}" Tag="{}{{deltagerregler}}" Click="Systemfelt_Klik"
                          HorizontalAlignment="Left" Padding="10,5" FontFamily="Consolas" FontSize="12"
                          ToolTip="{i18n:Oversat templatesview.saetter_de_faelles_deltagerregler_ind_hvor}" />
                </StackPanel>
              </Border>

              <TextBox x:Name="FeltSystem" AcceptsReturn="True" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto" AcceptsTab="True"
                       FontFamily="Consolas" FontSize="12.5" TextChanged="Aendret" />
            </DockPanel>
          </TabItem>

          <!-- «OPGAVE» SAGDE IKKE, HVAD MAN KIGGEDE PAA.
               Fanen er ikke en kvalitetsknap. Den afgoer, hvilke data der
               overhovedet naar frem til modellen: staar {{noter}} ikke her,
               bliver dine noter aldrig sendt. Det er et roer, ikke en
               indstilling - og navnet skal sige det. -->
          <TabItem x:Name="MaterialeFane" Header="{i18n:Oversat templatesview.hvad_modellen_faar}" Style="{StaticResource Fane}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                <TextBlock FontSize="11.5" TextWrapping="Wrap" LineHeight="18"
                           Foreground="{StaticResource TekstMeget}"
                           Text="{i18n:Oversat templatesview.instruktion_er_reglerne_hvad_modellen_skal}" />
                <TextBlock FontSize="11.5" Margin="0,5,0,0" TextWrapping="Wrap" LineHeight="18"
                           Foreground="{StaticResource TekstMeget}"
                           Text="{i18n:Oversat templatesview.staar_et_felt_ikke_her_naar_de_oplysninger}" />

                <!-- KONTROLLEN AF FELTERNE.
                     En skabelon uden {{transskription}} beder en model om at
                     skrive et referat af ingenting. Den fejl opdages foerst i
                     et faerdigt dokument, man skulle bruge til noget - derfor
                     staar den her, mens man skriver, og ikke som en
                     overraskelse bagefter. -->
                <Border x:Name="Feltkontrol" Visibility="Collapsed" CornerRadius="7"
                        BorderThickness="1" Padding="12,9" Margin="0,9,0,0">
                  <TextBlock x:Name="Feltbesked" FontSize="12" LineHeight="19" TextWrapping="Wrap" />
                </Border>
              </StackPanel>

              <!-- FELTERNE STAAR HER, IKKE I EN FANE FOR SIG.
                   De var en fane med en liste, man kunne laese. Det svarede
                   ikke paa det, man staar med: hvor skal de hen? Svaret er
                   HER, i denne tekst - og nu kan man klikke dem ind, hvor
                   markoeren staar, i stedet for at skrive kroellede
                   parenteser af i haanden. -->
              <Border DockPanel.Dock="Bottom" Background="#FF181B22" CornerRadius="8"
                      BorderBrush="{StaticResource PanelKant}" BorderThickness="1"
                      Padding="14,11" Margin="0,10,0,0">
                <StackPanel>
                  <TextBlock Text="{i18n:Oversat templatesview.saet_et_felt_ind_hvor_markoeren_staar}" FontSize="12.5"
                             FontWeight="SemiBold" />
                  <TextBlock FontSize="11.5" Margin="0,4,0,8" TextWrapping="Wrap" LineHeight="18"
                             Foreground="{StaticResource TekstMeget}"
                             Text="{i18n:Oversat templatesview.klik_paa_et_felt_for_at_saette_det_ind_i_t}" />
                  <ItemsControl x:Name="Felter">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Content="{Binding Felt}" Tag="{Binding Felt}" Click="Felt_Klik"
                                ToolTip="{Binding Forklaring}" Margin="0,0,6,6"
                                Padding="10,5" FontFamily="Consolas" FontSize="12" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <TextBox x:Name="FeltBruger" AcceptsReturn="True" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto" AcceptsTab="True"
                       FontFamily="Consolas" FontSize="12.5" TextChanged="Aendret" />
            </DockPanel>
          </TabItem>

          <TabItem x:Name="AgendaFane" Header="{i18n:Oversat templatesview.agenda}" Style="{StaticResource Fane}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock x:Name="AgendaOverskrift" FontSize="13.5" FontWeight="SemiBold"
                           Text="{i18n:Oversat templatesview.hvorfor_en_fast_dagsorden}" />
                <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{StaticResource TekstSvag}"
                           Text="{i18n:Oversat templatesview.et_referat_kan_kun_indeholde_det_der_blev}" />
                <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{StaticResource TekstSvag}"
                           Text="{i18n:Oversat templatesview.dagsordenen_herunder_er_bygget_saa_moedet}" />
                <TextBlock FontSize="12" LineHeight="20" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{StaticResource TekstMeget}"
                           Text="{i18n:Oversat templatesview.kopier_den_ind_i_moedeindkaldelsen_det_vig}" />

                <!-- DAGSORDENEN HOERER TIL SKABELONEN.
                     Foerst viste den det samme, uanset hvad man stod paa. Det
                     var forkert: et referat skal bruge beslutninger og
                     frister sagt hoejt, en brainstorm skal bruge de idéer,
                     der blev forkastet - og det er praecis dét, ingen siger,
                     medmindre dagsordenen beder om det.

                     Har skabelonen ikke sin egen, staar standarden. Den kan
                     tilpasses med een knap, og den kan altid rulles tilbage. -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button x:Name="AgendaKopierKnap" Content="{i18n:Oversat templatesview.kopier_dagsordenen}"
                          Click="KopierAgenda_Click" Padding="14,7" Margin="0,0,8,0"
                          ToolTip="{i18n:Oversat templatesview.laeg_hele_dagsordenen_i_udklipsholderen}" />
                  <Button x:Name="AgendaTilpasKnap" Content="{i18n:Oversat templatesview.tilpas_til_denne_moedetype}"
                          Click="TilpasAgenda_Click" Padding="14,7" Margin="0,0,8,0"
                          ToolTip="{i18n:Oversat templatesview.lad_mistral_skrive_en_dagsorden_der_passer}" />
                  <Button x:Name="AgendaNulstilKnap" Content="{i18n:Oversat templatesview.tilbage_til_standarden}"
                          Click="NulstilAgenda_Click" Padding="14,7" Visibility="Collapsed"
                          ToolTip="{i18n:Oversat templatesview.slet_moedetypens_egen_dagsorden_og_brug_de}" />
                </StackPanel>
              </StackPanel>

              <TextBox x:Name="FeltAgenda" IsReadOnly="True" AcceptsReturn="True"
                       TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                       FontFamily="Consolas" FontSize="12.5" />
            </DockPanel>
          </TabItem>

        </TabControl>
      </Border>
    </Grid>
  </Grid>
</UserControl>
