<UserControl x:Class="NoteApp.Desktop.Templates.TemplatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:NoteApp.Desktop"
             Background="{DynamicResource Baggrund}">

  <!-- Samme opbygning som «Optagelser» og «Dokumenter»: vaerktoejslinje med
       ikoner oeverst, bibliotekstrae til venstre, indhold til hoejre.

       Skabeloner har ingen mapper og intet arkiv - de er faa, og de er alle
       sammen i brug. Traeet har derfor eet bibliotek uden undermapper, og der
       er ikke noget at traekke nogen steder hen. Formen er den samme
       alligevel: skaermene skal kunne genkendes, ogsaa naar den ene har
       mindre at vise end de andre. -->

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <!-- MØDETYPER UDADTIL, SKABELONER INDADTIL.
           Se MainWindow.xaml for hvorfor. Kort: mødetypen kan man svare på,
           FØR mødet går i gang, og det er dér, den bliver valgt. «Skabelon»
           kan man foerst svare paa, naar man taenker i dokumenter. -->
      <TextBlock Text="{i18n:Oversat templatesview.moedetyper}" Style="{StaticResource Overskrift}" />
      <TextBlock Style="{StaticResource Underskrift}"
                 Text="{i18n:Oversat templatesview.hvilken_slags_moede_det_er_og_hvad_der_ska}" />
    </StackPanel>

    <!-- HER LAA ET PANEL: "Dokumenter laves af Mistral Medium 3.5 i Europa".
         Det staar nu to andre steder - under AI-modeller, hvor man vaelger
         det, og under Compliance, hvor det hoerer juridisk hjemme. Tre steder
         er ikke tre gange saa tydeligt; det er stoej de to af gangene, og her
         tog det den plads, skabelonens egne felter havde brug for.
         Fjernet 18-08-2026. -->

    <Border Grid.Row="1" Background="{DynamicResource Panel}" CornerRadius="8"
            BorderBrush="{DynamicResource PanelKant}" BorderThickness="1" Padding="8,6">
      <DockPanel>
        <Button DockPanel.Dock="Right" x:Name="GemKnap" Content="{i18n:Oversat templatesview.gem_aendringer}" Click="Gem_Click"
                Style="{StaticResource Primaer}" MinWidth="150" IsEnabled="False"
                ToolTip="{i18n:Oversat templatesview.gem_det_du_har_rettet_i_moedetypen}" />

        <Border DockPanel.Dock="Right" Width="1" Margin="10,4,14,4"
                Background="{DynamicResource PanelKant}" />

        <Button DockPanel.Dock="Left" x:Name="NyKnap" Style="{StaticResource IkonKnap}"
                Click="Ny_Click" AutomationProperties.Name="{i18n:Oversat faelles.ny_moedetype}"
                ToolTip="{i18n:Oversat templatesview.ny_moedetype_start_fra_en_tom_og_skriv_din}">
          <TextBlock Text="&#xE710;" Style="{StaticResource Ikonglyf}" />
        </Button>

        <Border DockPanel.Dock="Left" Width="1" Margin="6,4,8,4"
                Background="{DynamicResource PanelKant}" />

        <Button DockPanel.Dock="Left" x:Name="MappeKnap" Style="{StaticResource IkonKnap}"
                Click="Mappe_Click" AutomationProperties.Name="{i18n:Oversat templatesview.aabn_mappen_med_moedetyper}"
                ToolTip="{i18n:Oversat templatesview.aabn_mappen_med_moedetyper_paa_disken}">
          <TextBlock Text="&#xE838;" Style="{StaticResource Ikonglyf}" />
        </Button>

        <Border DockPanel.Dock="Left" Width="1" Margin="6,4,8,4"
                Background="{DynamicResource PanelKant}" />

        <Button DockPanel.Dock="Left" x:Name="SletKnap" Style="{StaticResource IkonKnapFare}"
                Click="Slet_Click" IsEnabled="False" AutomationProperties.Name="{i18n:Oversat templatesview.slet_moedetype}"
                ToolTip="{i18n:Oversat templatesview.slet_den_valgte_moedetype_kan_ikke_fortryd}">
          <TextBlock Text="&#xE74D;" Style="{StaticResource Ikonglyf}" />
        </Button>

        <Grid />
      </DockPanel>
    </Border>

    <Grid Grid.Row="2" Margin="2,8,2,10">
      <TextBlock x:Name="Status" Style="{StaticResource Underskrift}" VerticalAlignment="Bottom" />
    </Grid>

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <!-- Samme opbygning som paa Optagelser og Dokumenter. Se TranscribeView:
             Auto med 225 som minimum og 420 som loft, saa spalten foelger
             navnene i traeet frem for at klippe dem. -->
        <ColumnDefinition Width="Auto" MinWidth="225" MaxWidth="420" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource Panel}" CornerRadius="10"
              BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{i18n:Oversat faelles.biblioteker}" FontSize="10.5" FontWeight="SemiBold"
                     Margin="16,14,16,8" Foreground="{DynamicResource TekstMeget}" />

          <TreeView x:Name="Trae" Background="Transparent" BorderThickness="0"
                    Margin="6,0,6,10" SelectedItemChanged="Trae_Valgt"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <TreeView.ItemContainerStyle>
              <Style TargetType="TreeViewItem">
                <Style.Resources>
                  <!-- WPF tegner sin EGEN markering under vores skabelon, med
                       systemets fremhaevningsfarve og hvid tekst. Paa et
                       moerkt tema bliver navnet dermed usynligt, naar man
                       vaelger det. De tre noegler slukker den, saa det er
                       DataTriggeren paa ErValgt nedenfor, der tegner
                       markeringen - i temaets egne farver. -->
                  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                  <!-- MARKERINGSFARVEN SAETTES I TEMAET, ikke her. Der stod
                       «Color="{Binding Color, Source={DynamicResource Tekst}}"»,
                       og det er ulovligt: Source paa en Binding er ikke en
                       afhaengighedsegenskab. Det kastede foerst, naar
                       skabelonen skulle tegnes. Se Temaskift. -->
                </Style.Resources>
                <Setter Property="Padding" Value="2,1" />
                <Setter Property="Foreground" Value="{DynamicResource TekstSvag}" />
                <Setter Property="IsExpanded" Value="{Binding ErUdfoldet, Mode=TwoWay}" />
                <Setter Property="IsSelected" Value="{Binding ErValgt, Mode=TwoWay}" />
              </Style>
            </TreeView.ItemContainerStyle>

            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate ItemsSource="{Binding Boern}">
                <Border x:Name="rk" CornerRadius="5" Padding="6,4" Background="Transparent"
                        AutomationProperties.Name="{Binding Visning}">
                  <Border.ToolTip>
                    <StackPanel MaxWidth="360">
                      <TextBlock Text="{Binding Navn}" FontWeight="SemiBold" FontSize="13"
                                 TextWrapping="Wrap" Margin="0,0,0,6" />
                      <TextBlock Text="{Binding Linje1}" FontSize="12.5" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Linje2}" FontSize="12.5" Margin="0,3,0,0"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Border.ToolTip>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Glyf}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,9,0"
                               Foreground="{DynamicResource Accent}" />
                    <TextBlock Text="{Binding Visning}" FontSize="12.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Border>
                <HierarchicalDataTemplate.Triggers>
                  <DataTrigger Binding="{Binding ErValgt}" Value="True">
                    <Setter TargetName="rk" Property="Background" Value="{DynamicResource Valgt}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding ErBeholder}" Value="True">
                    <Setter TargetName="rk" Property="ToolTipService.IsEnabled" Value="False" />
                  </DataTrigger>
                </HierarchicalDataTemplate.Triggers>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch"
                    Background="Transparent" />

      <!-- Højre: den valgte skabelon -->
      <Border Grid.Column="2" Background="{DynamicResource Panel}" CornerRadius="10"
              BorderBrush="{DynamicResource PanelKant}" BorderThickness="1">
        <!-- FIRE FANER FREM FOR FIRE FELTER OVEN PAA HINANDEN.
             Ruden skulle vise navn, beskrivelse, to prompter og en feltliste
             paa een gang. Hver af de to store tekstfelter fik derfor en
             tredjedel af hoejden, og man redigerede en prompt paa halvfems
             linjer gennem en rude paa fem.

             Med faner faar det, man arbejder i, hele pladsen. Raekkefoelgen
             er den, man bruger dem i: hvad skabelonen hedder, hvad modellen
             skal goere, hvad den faar at arbejde med - og til sidst
             opslagslisten over felter. -->
        <TabControl x:Name="Detaljer" Style="{StaticResource Fanerude}" Margin="22,16,22,18">

          <TabItem Header="{i18n:Oversat templatesview.fanen_navn_og_mappe}" Style="{StaticResource Fane}">
            <StackPanel>

              <!-- ============ HER STOD «TEMPERATUR» OG «MAKS. LAENGDE (TOKENS)» ============

                   Begge var modellens sprog, ikke brugerens. «Temperatur 0,2»
                   og «32000 tokens - cirka 3 tegn pr. token» kan man kun svare
                   paa, hvis man ved hvad en sprogmodel er. Skaermen skal kunne
                   bruges af en, der bare vil optage sit moede og faa et referat.

                   TEMPERATUREN VISES SLET IKKE. Den staar stadig i filen og
                   bliver brugt uaendret - vi lader bare vaere med at spoerge om
                   den. Det rigtige svar er 0,2 til alt, hvad appen laver; et
                   felt, hvor der kun er eet fornuftigt svar, er ikke et valg.

                   LAENGDEN ER OVERSAT TIL SIDER. Det er det samme tal bagved -
                   se Laengder i TemplatesView.xaml.cs - men spurgt paa en maade,
                   man kan svare paa uden at kende til tokens. -->
              <TextBlock Text="{i18n:Oversat templatesview.navn}" Style="{StaticResource Underskrift}" />
              <TextBox x:Name="FeltNavn" Margin="0,4,0,0" TextChanged="Aendret" />
              <TextBlock FontSize="11.5" Margin="2,6,0,0" TextWrapping="Wrap"
                         Foreground="{DynamicResource TekstMeget}"
                         Text="{i18n:Oversat templatesview.staar_paa_knappen_naar_du_vaelger_moedetyp}" />

              <TextBlock Text="{i18n:Oversat templatesview.hvor_langt_maa_dokumentet_blive}"
                         Style="{StaticResource Underskrift}" Margin="0,20,0,0" />
              <ComboBox x:Name="FeltLaengde" Margin="0,4,0,0" IsEditable="False"
                        SelectionChanged="Laengde_Valgt">
                <ComboBox.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding Navn}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock FontSize="11.5" Margin="2,6,0,0" TextWrapping="Wrap"
                         Foreground="{DynamicResource TekstMeget}"
                         Text="{i18n:Oversat templatesview.et_loft_ikke_et_maal_bliver_moedet_kort}" />

              <!-- ============ MAPPEN ============
                   Et webinar hoerer i «Webinarer». Hver gang. Saa skal man
                   ikke vaelge det hver gang - man har allerede sagt det ved
                   at vaelge moedetypen. -->
              <TextBlock Text="{i18n:Oversat templatesview.mappe}" Style="{StaticResource Underskrift}" Margin="0,20,0,0" />

              <!-- ============ HER STOD EN RULLELISTE MED FULDE STIER ============

                   «Møder/Ibrar» stod som een lang linje blandt andre lange
                   linjer, og man skulle laese sig frem til strukturen. Under
                   «Optagelser» ser man den samme mappe i et TRAE.

                   Nu aabner knappen den samme mappevaelger, som «Flyt til
                   mappe» bruger paa optagelserne - og den viser et trae. Eet
                   billede af mapperne i hele appen. -->
              <DockPanel Margin="0,4,0,0">
                <Button x:Name="MappeKnap2" DockPanel.Dock="Right" Content="{i18n:Oversat templatesview.vaelg_mappe}"
                        Click="VaelgMappe_Klik" Padding="14,7" Margin="8,0,0,0" />
                <Border BorderBrush="{DynamicResource FeltKant}" BorderThickness="1" CornerRadius="6"
                        Background="{DynamicResource Trykket}" Padding="10,8">
                  <TextBlock x:Name="MappeTekst" VerticalAlignment="Center" TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" />
                </Border>
              </DockPanel>
              <TextBlock FontSize="11.5" Margin="2,6,0,0" TextWrapping="Wrap"
                         Foreground="{DynamicResource TekstMeget}"
                         Text="{i18n:Oversat templatesview.optagelser_med_den_her_moedetype_laegges}" />

              <TextBlock Text="{i18n:Oversat templatesview.beskrivelse}" Style="{StaticResource Underskrift}" Margin="0,20,0,0" />
              <TextBox x:Name="FeltBeskrivelse" Margin="0,4,0,0" TextChanged="Aendret"
                       AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58"
                       VerticalScrollBarVisibility="Auto" />
              <TextBlock FontSize="11.5" Margin="2,6,0,0" TextWrapping="Wrap"
                         Foreground="{DynamicResource TekstMeget}"
                         Text="{i18n:Oversat templatesview.staar_under_navnet_naar_du_vaelger_moedety}" />
            </StackPanel>
          </TabItem>

          <TabItem Header="{i18n:Oversat templatesview.fanen_saadan_skal_det_skrives}" Style="{StaticResource Fane}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" FontSize="11.5" Margin="2,0,0,8" TextWrapping="Wrap"
                         Foreground="{DynamicResource TekstMeget}"
                         Text="{i18n:Oversat templatesview.reglerne_modellen_arbejder_efter_det_er_he}" />

              <!-- ============ AFSNITTENE SOM AFKRYDSNING ============

                   Det almindelige oenske er ikke at skrive en instruktion om -
                   det er at faa et afsnit med eller ud. «Skal der vaere citater
                   i referatet?» kunne man kun svare paa ved at redigere
                   prompten, og saa lod man vaere.

                   Hakkene SLETTER IKKE TEKST. Overskrifterne, man tager fra,
                   staar i skabelonens frontmatter som «udeladte_afsnit», og
                   afsnittet springes over, naar dokumentet laves - se
                   PromptTemplate.RenderSystem. Teksten nedenfor er uroert, og
                   et hak kan saettes tilbage.

                   Boksen er der kun, naar skabelonen HAR afsnit. En skabelon,
                   der ikke bruger «## »-overskrifter, faar ingen tom ramme. -->
              <Border x:Name="Afsnitsrude" DockPanel.Dock="Top" Background="{DynamicResource Trykket}"
                      CornerRadius="8" BorderBrush="{DynamicResource PanelKant}" BorderThickness="1"
                      Padding="14,11" Margin="0,0,0,10" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock Text="{i18n:Oversat templatesview.hvad_skal_dokumentet_indeholde}"
                             FontSize="12.5" FontWeight="SemiBold" />
                  <TextBlock FontSize="11.5" Margin="0,4,0,8" TextWrapping="Wrap" LineHeight="18"
                             Foreground="{DynamicResource TekstMeget}"
                             Text="{i18n:Oversat templatesview.tag_hakket_fra_saa_springes_afsnittet_over}" />
                  <!-- ============ DELTAGERREGLERNE ER OGSAA ET HAK ============

                       De laa i en kasse for sig NEDERST paa fanen, med en knap,
                       der satte «{{deltagerregler}}» ind i teksten. Det er den
                       samme slags spoergsmaal som afsnittene - «skal det med?» -
                       men besvaret paa en helt anden maade, og den ene af dem
                       kraevede, at man kendte til kroellede parenteser.

                       Nu staar det her, sammen med det oevrige, der skal med. -->
                  <CheckBox x:Name="HakDeltagere" Margin="0,0,0,8" FontSize="12.5"
                            Checked="Deltagere_Aendret" Unchecked="Deltagere_Aendret"
                            ToolTip="{i18n:Oversat templatesview.reglerne_for_hvem_der_kommer_paa_deltagerl}">
                    <TextBlock Text="{i18n:Oversat templatesview.deltagerregler_hvem_kommer_paa_listen}" />
                  </CheckBox>

                  <WrapPanel x:Name="Afsnit" Orientation="Horizontal" />

                  <!-- HVAD DER SKER, NAAR MAN KLIKKER. Uden den her skete der
                       ingenting synligt: teksten bliver jo staaende med vilje,
                       saa et hak, der blev taget fra, saa ud som om det ikke
                       virkede. Linjen siger hvad hakket betyder, og selve
                       afsnittet bliver markeret i teksten nedenfor. -->
                  <TextBlock x:Name="Afsnitsbesked" FontSize="11.5" Margin="0,6,0,0"
                             TextWrapping="Wrap" LineHeight="18" Visibility="Collapsed"
                             Foreground="{DynamicResource Advarsel}" />
                </StackPanel>
              </Border>

              <!-- HER LAA EN KASSE MED «Sæt deltagerreglerne ind».
                   Den er blevet til et hak oeverst i «Hvad skal dokumentet
                   indeholde?», hvor de oevrige valg staar. -->

              <!-- ALMINDELIG SKRIFT, IKKE CONSOLAS. Monospace siger «det her
                   er kode» - og det er det ikke: det er saetninger paa dansk om,
                   hvordan referatet skal skrives. -->
              <!-- ============ RichTextBox OG IKKE TextBox ============

                   De fravalgte afsnit og felter skal kunne STREGES OVER inde i
                   selve teksten. Hakket sagde det, og linjen under sagde det,
                   men i boksen saa alt ens ud - saa maatte man selv holde styr
                   paa, hvilke linjer der ikke blev sendt.

                   En TextBox kan kun have een farve og een streg for hele sit
                   indhold. Derfor en RichTextBox med eet afsnit pr. linje; se
                   Streg_Linjer. -->
              <RichTextBox x:Name="FeltSystem" AcceptsReturn="True" AcceptsTab="True"
                           VerticalScrollBarVisibility="Auto"
                           HorizontalScrollBarVisibility="Disabled"
                           FontSize="13" TextChanged="Aendret" />
            </DockPanel>
          </TabItem>

          <!-- «OPGAVE» SAGDE IKKE, HVAD MAN KIGGEDE PAA.
               Fanen er ikke en kvalitetsknap. Den afgoer, hvilke data der
               overhovedet naar frem til modellen: staar {{noter}} ikke her,
               bliver dine noter aldrig sendt. Det er et roer, ikke en
               indstilling - og navnet skal sige det. -->
          <TabItem x:Name="MaterialeFane" Header="{i18n:Oversat templatesview.fanen_hvad_der_kommer_med}" Style="{StaticResource Fane}">
            <DockPanel>
              <!-- ============ SAMME OPBYGNING SOM DEN ANDEN FANE ============

                   Hakkene laa NEDERST her og OEVERST paa «Saadan skal det
                   skrives». To faner ved siden af hinanden, samme slags valg,
                   og oejet skulle lede efter dem to forskellige steder.

                   Raekkefoelgen er nu den samme begge steder: forklaring,
                   hakkene, og saa teksten. -->
              <StackPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                <TextBlock FontSize="11.5" TextWrapping="Wrap" LineHeight="18"
                           Foreground="{DynamicResource TekstMeget}"
                           Text="{i18n:Oversat templatesview.instruktion_er_reglerne_hvad_modellen_skal}" />
                <TextBlock FontSize="11.5" Margin="0,5,0,0" TextWrapping="Wrap" LineHeight="18"
                           Foreground="{DynamicResource TekstMeget}"
                           Text="{i18n:Oversat templatesview.staar_et_felt_ikke_her_naar_de_oplysninger}" />
              </StackPanel>

              <!-- ============ FELTERNE ER OGSAA HAK ============

                   De var knapper, der satte «{{titel}}» ind, hvor markoeren
                   stod. Det gav to slags fejl: man kunne saette det samme felt
                   ind to gange, og man kunne saette det ind midt i en saetning
                   uden at opdage det. Og «skal titlen med?» er et ja/nej, ikke
                   en indsaetningsopgave. -->
              <Border DockPanel.Dock="Top" Background="{DynamicResource Trykket}" CornerRadius="8"
                      BorderBrush="{DynamicResource PanelKant}" BorderThickness="1"
                      Padding="14,11" Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock Text="{i18n:Oversat templatesview.det_der_kan_komme_med_fra_moedet}" FontSize="12.5"
                             FontWeight="SemiBold" />
                  <TextBlock FontSize="11.5" Margin="0,4,0,8" TextWrapping="Wrap" LineHeight="18"
                             Foreground="{DynamicResource TekstMeget}"
                             Text="{i18n:Oversat templatesview.tag_hakket_fra_saa_sendes_linjen_ikke}" />

                  <WrapPanel x:Name="Feltvalg" Orientation="Horizontal" />

                  <TextBlock x:Name="Feltbesked2" FontSize="11.5" Margin="0,6,0,0"
                             TextWrapping="Wrap" LineHeight="18" Visibility="Collapsed"
                             Foreground="{DynamicResource Advarsel}" />
                </StackPanel>
              </Border>

              <!-- KONTROLLEN AF FELTERNE.
                   En skabelon uden {{transskription}} beder en model om at
                   skrive et referat af ingenting. Den fejl opdages foerst i et
                   faerdigt dokument, man skulle bruge til noget - derfor staar
                   den her, mens man skriver, og ikke som en overraskelse
                   bagefter.

                   DEN STAAR KUN, NAAR DER ER NOGET GALT. Foer stod der ogsaa
                   «Sendes med: transskription, titel, dato ...», og det siger
                   hakkene ovenfor nu - paa dansk. To lister over det samme er
                   een for meget. -->
              <Border x:Name="Feltkontrol" DockPanel.Dock="Top" Visibility="Collapsed" CornerRadius="7"
                      BorderThickness="1" Padding="12,9" Margin="0,0,0,10">
                <TextBlock x:Name="Feltbesked" FontSize="12" LineHeight="19" TextWrapping="Wrap" />
              </Border>

              <RichTextBox x:Name="FeltBruger" AcceptsReturn="True" AcceptsTab="True"
                           VerticalScrollBarVisibility="Auto"
                           HorizontalScrollBarVisibility="Disabled"
                           FontSize="13" TextChanged="Aendret" />
            </DockPanel>
          </TabItem>

          <TabItem x:Name="AgendaFane" Header="{i18n:Oversat templatesview.fanen_dagsorden}" Style="{StaticResource Fane}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock x:Name="AgendaOverskrift" FontSize="13.5" FontWeight="SemiBold"
                           Text="{i18n:Oversat templatesview.hvorfor_en_fast_dagsorden}" />
                <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{DynamicResource TekstSvag}"
                           Text="{i18n:Oversat templatesview.et_referat_kan_kun_indeholde_det_der_blev}" />
                <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{DynamicResource TekstSvag}"
                           Text="{i18n:Oversat templatesview.dagsordenen_herunder_er_bygget_saa_moedet}" />
                <TextBlock FontSize="12" LineHeight="20" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{DynamicResource TekstMeget}"
                           Text="{i18n:Oversat templatesview.kopier_den_ind_i_moedeindkaldelsen_det_vig}" />

                <!-- DAGSORDENEN HOERER TIL SKABELONEN.
                     Foerst viste den det samme, uanset hvad man stod paa. Det
                     var forkert: et referat skal bruge beslutninger og
                     frister sagt hoejt, en brainstorm skal bruge de idéer,
                     der blev forkastet - og det er praecis dét, ingen siger,
                     medmindre dagsordenen beder om det.

                     Har skabelonen ikke sin egen, staar standarden. Den kan
                     tilpasses med een knap, og den kan altid rulles tilbage. -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button x:Name="AgendaKopierKnap" Content="{i18n:Oversat templatesview.kopier_dagsordenen}"
                          Click="KopierAgenda_Click" Padding="14,7" Margin="0,0,8,0"
                          ToolTip="{i18n:Oversat templatesview.laeg_hele_dagsordenen_i_udklipsholderen}" />
                  <Button x:Name="AgendaTilpasKnap" Content="{i18n:Oversat templatesview.tilpas_til_denne_moedetype}"
                          Click="TilpasAgenda_Click" Padding="14,7" Margin="0,0,8,0"
                          ToolTip="{i18n:Oversat templatesview.lad_mistral_skrive_en_dagsorden_der_passer}" />
                  <Button x:Name="AgendaNulstilKnap" Content="{i18n:Oversat templatesview.tilbage_til_standarden}"
                          Click="NulstilAgenda_Click" Padding="14,7" Visibility="Collapsed"
                          ToolTip="{i18n:Oversat templatesview.slet_moedetypens_egen_dagsorden_og_brug_de}" />
                </StackPanel>
              </StackPanel>

              <TextBox x:Name="FeltAgenda" IsReadOnly="True" AcceptsReturn="True"
                       TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                       FontSize="13" />
            </DockPanel>
          </TabItem>

        </TabControl>
      </Border>
    </Grid>
  </Grid>
</UserControl>
