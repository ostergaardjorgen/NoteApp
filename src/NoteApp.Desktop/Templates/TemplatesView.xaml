<UserControl x:Class="NoteApp.Desktop.Templates.TemplatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Baggrund}">

  <!-- Samme opbygning som «Optagelser» og «Dokumenter»: vaerktoejslinje med
       ikoner oeverst, bibliotekstrae til venstre, indhold til hoejre.

       Skabeloner har ingen mapper og intet arkiv - de er faa, og de er alle
       sammen i brug. Traeet har derfor eet bibliotek uden undermapper, og der
       er ikke noget at traekke nogen steder hen. Formen er den samme
       alligevel: skaermene skal kunne genkendes, ogsaa naar den ene har
       mindre at vise end de andre. -->

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="Skabeloner" Style="{StaticResource Overskrift}" />
      <TextBlock Style="{StaticResource Underskrift}"
                 Text="Hvad der skal laves ud af en optagelse" />
    </StackPanel>

    <!-- Hvad dokumenterne bliver lavet af. Det er ikke et valg her — det
         står, fordi man skal kunne se det uden at lede. -->
    <Border Grid.Row="1" Background="#FF181B22" BorderBrush="{StaticResource PanelKant}"
            BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock x:Name="ModelStatus" FontSize="13.5" TextWrapping="Wrap"
                   Foreground="{StaticResource TekstSvag}" />
        <TextBlock FontSize="12.5" Margin="0,7,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource TekstMeget}"
                   Text="Optagelse og transskription virker uændret, også før den er sat op. Du bliver ikke mindet om det igen." />
      </StackPanel>
    </Border>


    <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="8"
            BorderBrush="{StaticResource PanelKant}" BorderThickness="1" Padding="8,6">
      <DockPanel>
        <Button DockPanel.Dock="Right" x:Name="GemKnap" Content="Gem ændringer" Click="Gem_Click"
                Style="{StaticResource Primaer}" MinWidth="150" IsEnabled="False"
                ToolTip="Gem det, du har rettet i skabelonen" />

        <Border DockPanel.Dock="Right" Width="1" Margin="10,4,14,4"
                Background="{StaticResource PanelKant}" />

        <Button DockPanel.Dock="Left" x:Name="NyKnap" Style="{StaticResource IkonKnap}"
                Click="Ny_Click" AutomationProperties.Name="Ny skabelon"
                ToolTip="Ny skabelon — start fra en tom og skriv din egen">
          <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" />
        </Button>

        <Border DockPanel.Dock="Left" Width="1" Margin="6,4,8,4"
                Background="{StaticResource PanelKant}" />

        <Button DockPanel.Dock="Left" x:Name="MappeKnap" Style="{StaticResource IkonKnap}"
                Click="Mappe_Click" AutomationProperties.Name="Åbn skabelonmappen"
                ToolTip="Åbn skabelonmappen på disken">
          <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" />
        </Button>

        <Border DockPanel.Dock="Left" Width="1" Margin="6,4,8,4"
                Background="{StaticResource PanelKant}" />

        <Button DockPanel.Dock="Left" x:Name="SletKnap" Style="{StaticResource IkonKnapFare}"
                Click="Slet_Click" IsEnabled="False" AutomationProperties.Name="Slet skabelon"
                ToolTip="Slet den valgte skabelon. Kan ikke fortrydes">
          <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" />
        </Button>

        <Grid />
      </DockPanel>
    </Border>

    <Grid Grid.Row="3" Margin="2,8,2,10">
      <TextBlock x:Name="Status" Style="{StaticResource Underskrift}" VerticalAlignment="Bottom" />
    </Grid>

    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="10"
              BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="BIBLIOTEKER" FontSize="10.5" FontWeight="SemiBold"
                     Margin="16,14,16,8" Foreground="{StaticResource TekstMeget}" />

          <TreeView x:Name="Trae" Background="Transparent" BorderThickness="0"
                    Margin="6,0,6,10" SelectedItemChanged="Trae_Valgt"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <TreeView.ItemContainerStyle>
              <Style TargetType="TreeViewItem">
                <Setter Property="Padding" Value="2,1" />
                <Setter Property="Foreground" Value="{StaticResource TekstSvag}" />
                <Setter Property="IsExpanded" Value="{Binding ErUdfoldet, Mode=TwoWay}" />
                <Setter Property="IsSelected" Value="{Binding ErValgt, Mode=TwoWay}" />
              </Style>
            </TreeView.ItemContainerStyle>

            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate ItemsSource="{Binding Boern}">
                <Border x:Name="rk" CornerRadius="5" Padding="6,4" Background="Transparent"
                        AutomationProperties.Name="{Binding Visning}">
                  <Border.ToolTip>
                    <StackPanel MaxWidth="360">
                      <TextBlock Text="{Binding Navn}" FontWeight="SemiBold" FontSize="13"
                                 TextWrapping="Wrap" Margin="0,0,0,6" />
                      <TextBlock Text="{Binding Linje1}" FontSize="12.5" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Linje2}" FontSize="12.5" Margin="0,3,0,0"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Border.ToolTip>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Glyf}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,9,0"
                               Foreground="{StaticResource Accent}" />
                    <TextBlock Text="{Binding Visning}" FontSize="12.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Border>
                <HierarchicalDataTemplate.Triggers>
                  <DataTrigger Binding="{Binding ErBeholder}" Value="True">
                    <Setter TargetName="rk" Property="ToolTipService.IsEnabled" Value="False" />
                  </DataTrigger>
                </HierarchicalDataTemplate.Triggers>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch"
                    Background="Transparent" />

      <!-- Højre: den valgte skabelon -->
      <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="10"
              BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18">
          <StackPanel x:Name="Detaljer">

            <TextBlock Text="Navn" Style="{StaticResource Underskrift}" />
            <TextBox x:Name="FeltNavn" Margin="0,4,0,0" TextChanged="Aendret" />

            <TextBlock Text="Beskrivelse" Style="{StaticResource Underskrift}" Margin="0,14,0,0" />
            <TextBox x:Name="FeltBeskrivelse" Margin="0,4,0,0" TextChanged="Aendret" />

            <!-- HER LAA ET VALG AF SPROGMODEL PR. SKABELON.
                 Der er kun een sprogmodel tilbage, og den er valgt paa
                 forhaand — se doc/maaling-sky.md. Et felt med eet svar er
                 ikke et valg, det er en oplysning, og den staar oeverst. -->

            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Temperatur" Style="{StaticResource Underskrift}" />
                <TextBox x:Name="FeltTemperatur" Margin="0,4,0,0" TextChanged="Aendret" />
                <TextBlock FontSize="11.5" Margin="2,5,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource TekstMeget}"
                           Text="0,0 holder sig tæt på udskriften. Over 0,4 begynder den at formulere sig frit — og til et referat er det en fejl, ikke en stil." />
              </StackPanel>

              <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Maks. længde (tokens)" Style="{StaticResource Underskrift}" />
                <TextBox x:Name="FeltMaksTokens" Margin="0,4,0,0" TextChanged="Aendret" />
                <TextBlock FontSize="11.5" Margin="2,5,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource TekstMeget}"
                           Text="Loftet over svaret. Cirka 3 tegn pr. token — 2048 rækker til et fyldigt referat." />
              </StackPanel>
            </Grid>

            <TextBlock Text="Instruktion til modellen" Style="{StaticResource Underskrift}" Margin="0,18,0,0" />
            <TextBox x:Name="FeltSystem" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="150" MaxHeight="260" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12.5" TextChanged="Aendret" />

            <TextBlock Text="Det, modellen får at arbejde med" Style="{StaticResource Underskrift}" Margin="0,18,0,0" />
            <TextBox x:Name="FeltBruger" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="110" MaxHeight="200" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12.5" TextChanged="Aendret" />

            <Border Background="#FF181B22" BorderBrush="{StaticResource PanelKant}" BorderThickness="1"
                    CornerRadius="8" Padding="14,11" Margin="0,10,0,0">
              <StackPanel>
                <TextBlock Text="Felter du kan sætte ind" FontSize="12.5" FontWeight="SemiBold" />
                <TextBlock x:Name="Felter" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                           LineHeight="20" Foreground="{StaticResource TekstMeget}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
