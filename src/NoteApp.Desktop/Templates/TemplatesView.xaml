<UserControl x:Class="NoteApp.Desktop.Templates.TemplatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Baggrund}">

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ============================ Topbjælke ============================ -->
    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="Skabeloner" Style="{StaticResource Overskrift}" />
      <TextBlock Style="{StaticResource Underskrift}"
                 Text="Hvad der skal laves ud af en optagelse — og hvilken sprogmodel der skal lave det" />
    </StackPanel>

    <!-- Det valgfrie skal stå som det første, ikke i en fodnote. Bruger man
         ikke sprogmodellerne, virker resten af appen præcis som før. -->
    <Border Grid.Row="1" Background="#FF181B22" BorderBrush="{StaticResource PanelKant}"
            BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock x:Name="ModelStatus" FontSize="13.5" TextWrapping="Wrap"
                   Foreground="{StaticResource TekstSvag}" />
        <TextBlock FontSize="12.5" Margin="0,7,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource TekstMeget}"
                   Text="Hele det her lag er frivilligt. Optagelse og transskription virker uændret uden en eneste sprogmodel — du bliver ikke mindet om det igen." />
      </StackPanel>
    </Border>

    <!-- ===================== Liste + redigering ===================== -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Venstre: skabelonerne -->
      <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="10"
              BorderBrush="{StaticResource PanelKant}" BorderThickness="1" Margin="0,0,10,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,12">
            <Button x:Name="NyKnap" Content="+ Ny skabelon" Click="Ny_Click" Padding="10,7" />
            <Button x:Name="SletKnap" Content="Slet den valgte" Click="Slet_Click"
                    Padding="10,7" Margin="0,6,0,0" />
          </StackPanel>

          <ListBox x:Name="Liste" DockPanel.Dock="Top" Margin="8" BorderThickness="0"
                   Background="Transparent" SelectionChanged="Liste_Valgt">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="4,6">
                  <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Description}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                             Foreground="{StaticResource TekstMeget}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Højre: den valgte skabelon -->
      <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="10"
              BorderBrush="{StaticResource PanelKant}" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18">
          <StackPanel x:Name="Detaljer">

            <TextBlock Text="Navn" Style="{StaticResource Underskrift}" />
            <TextBox x:Name="FeltNavn" Margin="0,4,0,0" TextChanged="Aendret" />

            <TextBlock Text="Beskrivelse" Style="{StaticResource Underskrift}" Margin="0,14,0,0" />
            <TextBox x:Name="FeltBeskrivelse" Margin="0,4,0,0" TextChanged="Aendret" />

            <!-- Modelvalget. Der står, hvad valget koster i tid og hukommelse,
                 fordi det er dét, der adskiller modellerne i praksis — ikke
                 hvilken der lyder bedst. -->
            <TextBlock Text="Sprogmodel" Style="{StaticResource Underskrift}" Margin="0,18,0,0" />
            <ComboBox x:Name="FeltModel" Margin="0,4,0,0" SelectionChanged="Model_Valgt">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Visning}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock x:Name="ModelForklaring" FontSize="12" Margin="2,7,0,0" TextWrapping="Wrap"
                       LineHeight="19" Foreground="{StaticResource TekstMeget}" />

            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Temperatur" Style="{StaticResource Underskrift}" />
                <TextBox x:Name="FeltTemperatur" Margin="0,4,0,0" TextChanged="Aendret" />
                <TextBlock FontSize="11.5" Margin="2,5,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource TekstMeget}"
                           Text="0,0 holder sig tæt på udskriften. Over 0,4 begynder den at formulere sig frit — og til et referat er det en fejl, ikke en stil." />
              </StackPanel>

              <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Maks. længde (tokens)" Style="{StaticResource Underskrift}" />
                <TextBox x:Name="FeltMaksTokens" Margin="0,4,0,0" TextChanged="Aendret" />
                <TextBlock FontSize="11.5" Margin="2,5,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource TekstMeget}"
                           Text="Loftet over svaret. Cirka 3 tegn pr. token — 2048 rækker til et fyldigt referat." />
              </StackPanel>
            </Grid>

            <TextBlock Text="Instruktion til modellen" Style="{StaticResource Underskrift}" Margin="0,18,0,0" />
            <TextBox x:Name="FeltSystem" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="150" MaxHeight="260" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12.5" TextChanged="Aendret" />

            <TextBlock Text="Det, modellen får at arbejde med" Style="{StaticResource Underskrift}" Margin="0,18,0,0" />
            <TextBox x:Name="FeltBruger" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="110" MaxHeight="200" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12.5" TextChanged="Aendret" />

            <Border Background="#FF181B22" BorderBrush="{StaticResource PanelKant}" BorderThickness="1"
                    CornerRadius="8" Padding="14,11" Margin="0,10,0,0">
              <StackPanel>
                <TextBlock Text="Felter du kan sætte ind" FontSize="12.5" FontWeight="SemiBold" />
                <TextBlock x:Name="Felter" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                           LineHeight="20" Foreground="{StaticResource TekstMeget}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- ============================ Bundlinje ============================ -->
    <Grid Grid.Row="3" Margin="0,14,0,0">
      <TextBlock x:Name="Status" VerticalAlignment="Center" FontSize="12"
                 Foreground="{StaticResource TekstMeget}" TextWrapping="Wrap" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="MappeKnap" Content="Åbn skabelonmappen" Click="Mappe_Click" Padding="14,8" />
        <Button x:Name="GemKnap" Content="Gem ændringer" Click="Gem_Click" Margin="10,0,0,0"
                Padding="18,8" IsEnabled="False"
                Background="{StaticResource Accent}" Foreground="#FF0B1220" BorderThickness="0" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
