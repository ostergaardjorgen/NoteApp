<Window x:Class="NoteApp.Desktop.Templates.NyTemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:NoteApp.Desktop"
        Title="Ny mødetype" Height="700" Width="680" MinHeight="560" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Baggrund}" Foreground="{DynamicResource Tekst}">

  <!-- ================== HVORFOR DER SPØRGES FØRST ======================

       En tom skabelon er ubrugelig for alle andre end den, der har skrevet
       de tre, der findes i forvejen. Den kræver, at man ved, hvad en
       systemprompt er, hvilke afsnit der giver mening, og hvordan man
       formulerer en regel, en model faktisk følger.

       Her svarer man i stedet på fem spørgsmål om det, man KENDER — hvad
       dokumentet skal bruges til, og hvem der læser det — og Mistral skriver
       skabelonen. Reglerne om deltagere kommer med af sig selv; de er
       fælles og sættes ind som felt.

       Resultatet er et UDKAST. Det åbnes til redigering som enhver anden
       skabelon, og det er med vilje: en skabelon, man ikke selv har set
       igennem, er en, man ikke opdager fejl i. -->

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="{i18n:Oversat faelles.ny_moedetype}" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"
                 Foreground="{DynamicResource TekstSvag}"
                 Text="{i18n:Oversat nytemplatewindow.svar_paa_det_du_kender_hvad_dokumentet_ska}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel>

        <TextBlock Text="{i18n:Oversat nytemplatewindow.hvad_skal_dokumentet_hedde}" Style="{StaticResource Underskrift}" />
        <TextBox x:Name="FeltNavn" Margin="0,4,0,0" FontSize="14" Padding="9,7" />
        <TextBlock FontSize="11.5" Margin="2,5,0,0" Foreground="{DynamicResource TekstMeget}"
                   Text="{i18n:Oversat nytemplatewindow.fx_beslutningsnotat_kundemoede_eller_tekni}" />

        <TextBlock Text="{i18n:Oversat nytemplatewindow.hvad_skal_der_komme_ud_af_det}" Style="{StaticResource Underskrift}"
                   Margin="0,18,0,0" />
        <TextBox x:Name="FeltFormaal" Margin="0,4,0,0" FontSize="13" Padding="9,7"
                 AcceptsReturn="True" TextWrapping="Wrap" Height="66"
                 VerticalScrollBarVisibility="Auto" />
        <TextBlock FontSize="11.5" Margin="2,5,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TekstMeget}"
                   Text="{i18n:Oversat nytemplatewindow.skriv_det_som_du_ville_forklare_en_kollega}" />

        <TextBlock Text="{i18n:Oversat nytemplatewindow.hvem_skal_laese_det}" Style="{StaticResource Underskrift}" Margin="0,18,0,0" />
        <TextBox x:Name="FeltLaeser" Margin="0,4,0,0" FontSize="13" Padding="9,7" />
        <TextBlock FontSize="11.5" Margin="2,5,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TekstMeget}"
                   Text="{i18n:Oversat nytemplatewindow.det_afgoer_baade_laengden_og_sproget_en_ku}" />

        <TextBlock Text="{i18n:Oversat nytemplatewindow.hvad_skal_altid_med}" Style="{StaticResource Underskrift}" Margin="0,18,0,0" />
        <TextBox x:Name="FeltSkalMed" Margin="0,4,0,0" FontSize="13" Padding="9,7"
                 AcceptsReturn="True" TextWrapping="Wrap" Height="66"
                 VerticalScrollBarVisibility="Auto" />
        <TextBlock FontSize="11.5" Margin="2,5,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TekstMeget}"
                   Text="{i18n:Oversat nytemplatewindow.et_pr_linje_fx_beslutninger_med_begrundels}" />

        <TextBlock Text="{i18n:Oversat nytemplatewindow.hvor_langt_maa_det_vaere}" Style="{StaticResource Underskrift}" Margin="0,18,0,0" />
        <ComboBox x:Name="FeltLaengde" Margin="0,4,0,0" FontSize="13" Padding="9,7"
                  SelectedIndex="1" />
        <TextBlock FontSize="11.5" Margin="2,5,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TekstMeget}"
                   Text="{i18n:Oversat nytemplatewindow.laengden_er_en_beslutning_ikke_et_tilfaeld}" />

        <Border Background="{DynamicResource Trykket}" BorderBrush="{DynamicResource PanelKant}" BorderThickness="1"
                CornerRadius="8" Padding="14,11" Margin="0,20,0,0">
          <StackPanel>
            <TextBlock Text="{i18n:Oversat nytemplatewindow.det_kommer_med_af_sig_selv}" FontSize="12.5" FontWeight="SemiBold" />
            <TextBlock FontSize="12" LineHeight="19" Margin="0,5,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TekstMeget}"
                       Text="{i18n:Oversat nytemplatewindow.reglerne_for_hvem_der_kommer_paa_deltagerl}" />
          </StackPanel>
        </Border>

        <TextBlock x:Name="Fejl" Margin="0,14,0,0" TextWrapping="Wrap" LineHeight="19"
                   Foreground="{DynamicResource FejlTekst}" Visibility="Collapsed" />
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2" Margin="0,16,0,0">
      <TextBlock x:Name="Status" VerticalAlignment="Center" FontSize="12"
                 Foreground="{DynamicResource TekstMeget}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <!-- HER LAA "Start fra en tom".
             En tom skabelon er kun brugbar for en, der ved hvad en
             systemprompt er, hvilke afsnit der giver mening, og hvordan man
             formulerer en regel, en model faktisk foelger. Resultatet blev
             daarligt, og en daarlig skabelon opdages foerst i et dokument,
             man skulle bruge til noget. Fjernet 19-08-2026.

             Uden en API-noegle er der derfor ingen vej frem her - saa peges
             der paa opsaetningen i stedet. -->
        <Button x:Name="SaetOpKnap" Content="{i18n:Oversat nytemplatewindow.saet_mistral_op}" Click="SaetOp_Click"
                Padding="14,9" Margin="0,0,10,0" Visibility="Collapsed"
                ToolTip="{i18n:Oversat nytemplatewindow.moedetypen_skrives_af_mistral_den_skal_sae}" />
        <Button Content="{i18n:Oversat faelles.annuller}" Click="Annuller_Click" Padding="18,9" Margin="0,0,10,0" />
        <Button x:Name="LavKnap" Content="{i18n:Oversat nytemplatewindow.lav_moedetypen}" Click="Lav_Click" Padding="20,9"
                Style="{StaticResource Primaer}" IsDefault="True" MinWidth="150" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
