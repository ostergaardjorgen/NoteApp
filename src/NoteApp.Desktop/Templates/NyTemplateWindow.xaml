<Window x:Class="NoteApp.Desktop.Templates.NyTemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ny mødetype" Height="700" Width="680" MinHeight="560" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Baggrund}" Foreground="{StaticResource Tekst}">

  <!-- ================== HVORFOR DER SPØRGES FØRST ======================

       En tom skabelon er ubrugelig for alle andre end den, der har skrevet
       de tre, der findes i forvejen. Den kræver, at man ved, hvad en
       systemprompt er, hvilke afsnit der giver mening, og hvordan man
       formulerer en regel, en model faktisk følger.

       Her svarer man i stedet på fem spørgsmål om det, man KENDER — hvad
       dokumentet skal bruges til, og hvem der læser det — og Mistral skriver
       skabelonen. Reglerne om deltagere kommer med af sig selv; de er
       fælles og sættes ind som felt.

       Resultatet er et UDKAST. Det åbnes til redigering som enhver anden
       skabelon, og det er med vilje: en skabelon, man ikke selv har set
       igennem, er en, man ikke opdager fejl i. -->

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="Ny mødetype" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"
                 Foreground="{StaticResource TekstSvag}"
                 Text="Svar på det, du kender — hvad dokumentet skal bruges til, og hvem der læser det. Så skriver Mistral mødetypen, og du retter i den bagefter." />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel>

        <TextBlock Text="Hvad skal dokumentet hedde?" Style="{StaticResource Underskrift}" />
        <TextBox x:Name="FeltNavn" Margin="0,4,0,0" FontSize="14" Padding="9,7" />
        <TextBlock FontSize="11.5" Margin="2,5,0,0" Foreground="{StaticResource TekstMeget}"
                   Text="Fx «Beslutningsnotat», «Kundemøde» eller «Teknisk gennemgang»." />

        <TextBlock Text="Hvad skal der komme ud af det?" Style="{StaticResource Underskrift}"
                   Margin="0,18,0,0" />
        <TextBox x:Name="FeltFormaal" Margin="0,4,0,0" FontSize="13" Padding="9,7"
                 AcceptsReturn="True" TextWrapping="Wrap" Height="66"
                 VerticalScrollBarVisibility="Auto" />
        <TextBlock FontSize="11.5" Margin="2,5,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource TekstMeget}"
                   Text="Skriv det, som du ville forklare en kollega. «Et kort notat til ledelsen med de beslutninger, der blev truffet, og hvad de koster.»" />

        <TextBlock Text="Hvem skal læse det?" Style="{StaticResource Underskrift}" Margin="0,18,0,0" />
        <TextBox x:Name="FeltLaeser" Margin="0,4,0,0" FontSize="13" Padding="9,7" />
        <TextBlock FontSize="11.5" Margin="2,5,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource TekstMeget}"
                   Text="Det afgør både længden og sproget. En kunde, en styregruppe og en udvikler skal ikke have det samme." />

        <TextBlock Text="Hvad SKAL altid med?" Style="{StaticResource Underskrift}" Margin="0,18,0,0" />
        <TextBox x:Name="FeltSkalMed" Margin="0,4,0,0" FontSize="13" Padding="9,7"
                 AcceptsReturn="True" TextWrapping="Wrap" Height="66"
                 VerticalScrollBarVisibility="Auto" />
        <TextBlock FontSize="11.5" Margin="2,5,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource TekstMeget}"
                   Text="Ét pr. linje. Fx «beslutninger med begrundelse», «hvad det koster», «hvem der følger op og hvornår», «åbne spørgsmål»." />

        <TextBlock Text="Hvor langt må det være?" Style="{StaticResource Underskrift}" Margin="0,18,0,0" />
        <ComboBox x:Name="FeltLaengde" Margin="0,4,0,0" FontSize="13" Padding="9,7"
                  SelectedIndex="1" />
        <TextBlock FontSize="11.5" Margin="2,5,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource TekstMeget}"
                   Text="Længden er en beslutning, ikke et tilfælde. Et notat, ingen orker at læse, bliver ikke læst — og et for kort mister det, der skulle bruges." />

        <Border Background="#FF181B22" BorderBrush="{StaticResource PanelKant}" BorderThickness="1"
                CornerRadius="8" Padding="14,11" Margin="0,20,0,0">
          <StackPanel>
            <TextBlock Text="Det kommer med af sig selv" FontSize="12.5" FontWeight="SemiBold" />
            <TextBlock FontSize="12" LineHeight="19" Margin="0,5,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TekstMeget}"
                       Text="Reglerne for, hvem der kommer på deltagerlisten, sættes ind som fælles felt — de er ens for alle mødetyper. Det samme gælder kravet om at skrive på dansk og aldrig finde på tal, navne eller datoer, der ikke står i transkriptionen." />
          </StackPanel>
        </Border>

        <TextBlock x:Name="Fejl" Margin="0,14,0,0" TextWrapping="Wrap" LineHeight="19"
                   Foreground="{StaticResource FejlTekst}" Visibility="Collapsed" />
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2" Margin="0,16,0,0">
      <TextBlock x:Name="Status" VerticalAlignment="Center" FontSize="12"
                 Foreground="{StaticResource TekstMeget}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <!-- HER LAA "Start fra en tom".
             En tom skabelon er kun brugbar for en, der ved hvad en
             systemprompt er, hvilke afsnit der giver mening, og hvordan man
             formulerer en regel, en model faktisk foelger. Resultatet blev
             daarligt, og en daarlig skabelon opdages foerst i et dokument,
             man skulle bruge til noget. Fjernet 19-08-2026.

             Uden en API-noegle er der derfor ingen vej frem her - saa peges
             der paa opsaetningen i stedet. -->
        <Button x:Name="SaetOpKnap" Content="Sæt Mistral op …" Click="SaetOp_Click"
                Padding="14,9" Margin="0,0,10,0" Visibility="Collapsed"
                ToolTip="Mødetypen skrives af Mistral. Den skal sættes op først" />
        <Button Content="Annullér" Click="Annuller_Click" Padding="18,9" Margin="0,0,10,0" />
        <Button x:Name="LavKnap" Content="Lav mødetypen" Click="Lav_Click" Padding="20,9"
                Style="{StaticResource Primaer}" IsDefault="True" MinWidth="150" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
