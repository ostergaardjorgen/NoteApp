<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NoteApp.Core</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Skemaet indlejres, så appen ikke afhænger af at repo-mappen findes
         ved siden af den publicerede exe. -->
    <EmbeddedResource Include="..\schema\learning.sql" LogicalName="NoteApp.Core.learning.sql" />
  </ItemGroup>

</Project>
