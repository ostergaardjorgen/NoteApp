<?xml version="1.0" encoding="utf-8"?>
<!--
  Installationspakke til HeyPia.

  Bygges med scripts\byg-installer.ps1. Resultatet er en .msi, en kollega kan
  dobbeltklikke: den lander under Tilføj/fjern programmer, får en genvej i
  Startmenuen og kan afinstalleres rent.

  VIGTIGT: afinstallation rører ikke brugerens data. Pakken kender kun til
  C:\Program Files\HeyPia. Optagelser, udskrifter, dokumenter, skabeloner og
  indstillinger ligger i
  C:\AppNoter (eller hvor brugeren har valgt), og de bliver liggende. En
  afinstallation, der sletter et halvt års mødeoptagelser uden at spørge, er
  præcis den fejl, der ikke kan fortrydes.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="HeyPia"
           Manufacturer="HeyPia"
           Version="$(var.Version)"
           UpgradeCode="8f3a5c21-4d7e-4b19-9c6a-2e51f0d8a7b3"
           Scope="perMachine"
           Compressed="yes">

    <!-- Opgradering: en nyere udgave fjerner den gamle af sig selv, saa der
         ikke ligger to poster i Tilfoej/fjern. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="En nyere udgave af HeyPia er allerede installeret. Afinstallér den først, hvis du vil gå tilbage." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Det, der staar i Tilfoej/fjern programmer. -->
    <Icon Id="AppIkon" SourceFile="..\src\NoteApp.Desktop\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIkon" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <!-- TEKSTEN SKAL PASSE MED, HVAD APPEN GOER.
         Der stod "Moede-noter der bliver paa din egen pc". Det var sandt, da
         alt kunne koere lokalt, men det holder ikke laengere: lyden og
         udskriften bliver paa maskinen, mens selve referatet skrives af en
         sprogmodel hos Mistral i EU. En genvejstekst, der lover for meget om
         data, er vaerre end ingen tekst.

         "ordbog" er ogsaa vaek - den funktion findes ikke mere. -->
    <Property Id="ARPCOMMENTS"
              Value="Optager møder og skriver dem ud til tekst på din egen pc. Referater og dokumenter laves af en sprogmodel i EU. Afinstallation fjerner kun programmet — dine optagelser, udskrifter og dokumenter bliver liggende i datamappen." />

    <!-- Programmet i Program Files. Mappen er skrivebeskyttet for almindelige
         brugere, og det er en fordel: koden ligger ét sted, data et andet, og
         graensen haandhaeves af Windows i stedet for kun af vores egen kode.

         ============ DEN LOESES AF PAKKENS BITTAL ============

         ProgramFiles6432Folder er C:\Program Files i en 64-bit pakke og
         C:\Program Files (x86) i en 32-bit. Filerne indeni er win-x64, saa
         pakken bygges med -arch x64 - se scripts\byg-installer.ps1. Indtil
         07-09-2026 blev den bygget uden, og appen laa i (x86), mens teksten
         i installationsprogrammet sagde noget andet. -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="HeyPia" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartMenuMappe" Name="HeyPia" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- Alle filer fra den udgivne app-mappe. -->
    <ComponentGroup Id="Programfiler" Directory="INSTALLFOLDER">
      <Files Include="..\app\**">
        <Exclude Files="..\app\*.pdb" />
      </Files>
    </ComponentGroup>

    <ComponentGroup Id="Genveje">
      <Component Directory="StartMenuMappe" Guid="c4e7b902-16fa-4d38-8a55-9b0e3c7d41f6">
        <Shortcut Id="StartMenuGenvej"
                  Name="HeyPia"
                  Description="Optager møder og skriver dem ud til tekst på din egen pc. Referater laves af en sprogmodel i EU."
                  Target="[INSTALLFOLDER]HeyPia.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIkon" />

        <Shortcut Id="SkrivebordsGenvej"
                  Directory="DesktopFolder"
                  Name="HeyPia"
                  Description="Optager møder og skriver dem ud til tekst på din egen pc. Referater laves af en sprogmodel i EU."
                  Target="[INSTALLFOLDER]HeyPia.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIkon" />

        <RemoveFolder Id="FjernStartMenuMappe" Directory="StartMenuMappe" On="uninstall" />

        <!-- En genvejskomponent skal have en noegle, MSI kan taelle paa. En
             registreringsvaerdi under HKCU er den saedvanlige loesning. -->
        <RegistryValue Root="HKCU" Key="Software\NoteApp"
                       Name="Installeret" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Hovedprogram" Title="HeyPia" Level="1">
      <ComponentGroupRef Id="Programfiler" />
      <ComponentGroupRef Id="Genveje" />
    </Feature>

    <!-- Almindelig installationsdialog med mulighed for at vaelge mappe. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="vilkaar.rtf" />

  </Package>
</Wix>
