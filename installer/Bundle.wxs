<?xml version="1.0" encoding="utf-8"?>
<!--
  Selve installationsfilen: NoteApp-setup.exe.

  Hvorfor en exe, når en .msi allerede kan dobbeltklikkes: fordi det er dét,
  folk forventer at modtage, og fordi mailfiltre og firmapolitikker rutinemæssigt
  blokerer .msi-filer. Exe'en beder selv om administratorrettigheder, så man
  ikke skal vide, at den skal højreklikkes.

  Indholdet er præcis den samme NoteApp.msi. Bundle'en er en indpakning, ikke
  en anden installation — afinstallation sker samme sted og med samme resultat:
  programmet fjernes, dine data bliver liggende.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">

  <Bundle Name="NoteApp"
          Manufacturer="NoteApp"
          Version="$(var.Version)"
          UpgradeCode="3b6f1d84-9a27-4c5e-b0f3-6d8e2a71c904"
          IconSourceFile="..\src\NoteApp.Desktop\app.ico">

    <!-- rtfLargeLicense frem for hyperlinkLicense: den foerste udgave havde
         et tomt felt, hvor teksten skulle staa, fordi hyperlink-temaet kun
         viser et link. Her vises hele introen, saa man kan se hvad der bliver
         installeret, foer man trykker. -->
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
          Theme="rtfLargeLicense"
          ThemeFile="tema.thm"
          LicenseFile="vilkaar.rtf"
          LogoFile="..\src\NoteApp.Desktop\app.png"
          SuppressOptionsUI="yes" />
    </BootstrapperApplication>

    <!-- Dansk tekst paa knapper og overskrifter. Uden den staar der engelsk
         i en app, der ellers er helt paa dansk. -->
    <WixVariable Id="WixStdbaThemeWxl" Value="da-DK.wxl" />

    <Chain>
      <MsiPackage SourceFile="NoteApp.msi" Vital="yes" Compressed="yes" />
    </Chain>

  </Bundle>
</Wix>
