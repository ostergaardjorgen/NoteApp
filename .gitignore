# =============================================================================
#  DINE DATA MÅ ALDRIG HAVNE HER
# =============================================================================
#  Den primære beskyttelse er ikke denne fil, men placeringen: alt personligt
#  ligger i datamappen — som standard C:\AppNoter, uden for dette arbejdstræ.
#  Reglerne herunder er et sikkerhedsnet, hvis noget alligevel bliver
#  kopieret ind.
#
#  Se doc\mine-data.md.
# -----------------------------------------------------------------------------

# Den indlærte ordbog og rettelseshistorik — unik for din installation
*.db
*.db-wal
*.db-shm
learning.db
ordliste.txt

# Optagelser, noter og transskriptioner
fase0/optagelser/
fase0/transskriptioner/
Optagelser/
moeder/
*.wav
*.mp3
*.m4a
notes.jsonl
meeting.json

# Måleresultater fra enkeltkørsler — kun konklusion.md hører i versionsstyring
fase0/resultater/rtf_*.csv
fase0/resultater/noejagtighed_*.csv

# Personlige varianter af testmaterialet: teksten på GitHub bruger opdigtede
# navne. Din version med rigtige kollegaer og kunder gør ikke.
*.personlig.md
*.personlig.txt

# Backup-arkiver
noteapp-data_*.zip

# -----------------------------------------------------------------------------
#  Byggeartefakter og værktøjer
# -----------------------------------------------------------------------------

# Whisper-modeller og binærer — hentes med scripts, hører ikke i git
models/
tools/

# Publiceret app — genskabes med dotnet publish
app/

# .NET build-output
bin/
obj/
*.user

# UNDTAGET: talergenkendelsens program er ikke byggeoutput.
#
# "bin/" ovenfor rammer også talere/bin/, hvor sherpa-onnx og onnxruntime.dll
# ligger. De hentes ikke og bygges ikke — de følger med appen, fordi tærsklen
# i Diarisering.cs er målt mod præcis de filer. Blev de udeladt, ville et
# frisk klon bygge en installationsfil uden talergenkendelse.
!talere/bin/
!talere/bin/**

# Byggeresultater fra installationspakken. Kilden (NoteApp.wxs) hører i git,
# den færdige pakke gør ikke — den er 100+ MB og kan bygges igen.
installer/*.msi
installer/*.exe
installer/*.wixpdb
installer/*.cab

# Windows
Thumbs.db
desktop.ini

# Lokale arbejdsregler - maa ikke i versionsstyring
CLAUDE.md

# Roadmappen som Word og PDF er GENGIVELSER af doc/roadmap.md.
# Kilden er markdown-filen; de her genskabes, naar der er brug for dem.
doc/*.docx
doc/*.pdf

# Appens legitimation hos leverandoerer - Googles klient-id og lignende.
#
# Den er ikke hemmelig i egentlig forstand (Google kalder en desktop-app for
# en offentlig klient), men en legitimation i et repo bliver liggende i
# historikken for evigt, ogsaa efter den er fjernet. Den hoerer i udgivelsen,
# ikke i koden.
hemmeligheder/
app/google-klient.json

# Googles EGEN fil hedder client_secret_<tal>-<tegn>.apps.googleusercontent.com
# .json, og appen laeser den nu, som den hentes - uden omdoebning. Saa skal
# det navn ogsaa vaere daekket, ellers gaar den med i naeste commit fra app/.
client_secret*.json
